/****** Object:  StoredProcedure [dbo].[usp_ReserveSalesOrder]    Script Date: 9/21/2026 9:03:24 AM ******/
SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO

CREATE   PROCEDURE [dbo].[usp_ReserveSalesOrder]
    @SalesOrderID BIGINT,
    @UserID       BIGINT
AS
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;

    BEGIN TRANSACTION;
    BEGIN TRY
        IF NOT EXISTS
        (
            SELECT 1
            FROM dbo.SalesOrders WITH (UPDLOCK, HOLDLOCK)
            WHERE SalesOrderID = @SalesOrderID
              AND Status IN ('CONFIRMED', 'ALLOCATED')
        )
            THROW 51102, N'Chi don ban CONFIRMED hoac ALLOCATED moi duoc giu ton.', 1;

        DECLARE @SalesOrderDetailID BIGINT,
                @ProductID BIGINT,
                @Need DECIMAL(18,4);

        DECLARE DetailCursor CURSOR LOCAL FAST_FORWARD FOR
            SELECT SalesOrderDetailID, ProductID, OrderedQuantity - ReservedQuantity
            FROM dbo.SalesOrderDetails
            WHERE IsActive = 1
              AND SalesOrderID = @SalesOrderID
              AND OrderedQuantity > ReservedQuantity;

        OPEN DetailCursor;
        FETCH NEXT FROM DetailCursor INTO @SalesOrderDetailID, @ProductID, @Need;

        WHILE @@FETCH_STATUS = 0
        BEGIN
            DECLARE @LocationID BIGINT,
                    @LotID BIGINT,
                    @Available DECIMAL(18,4),
                    @Take DECIMAL(18,4),
                    @ReservationID BIGINT;

            DECLARE StockCursor CURSOR LOCAL FAST_FORWARD FOR
                SELECT inventory.StorageLocationID,
                       inventory.ProductLotID,
                       inventory.AvailableQuantity
                FROM dbo.Inventory AS inventory WITH (UPDLOCK, HOLDLOCK)
                JOIN dbo.ProductLots AS lot ON lot.ProductLotID = inventory.ProductLotID
                JOIN dbo.Products AS product ON product.ProductID = inventory.ProductID
                JOIN dbo.StorageLocations AS location ON location.StorageLocationID = inventory.StorageLocationID
                WHERE inventory.ProductID = @ProductID
                  AND inventory.AvailableQuantity > 0
                  AND lot.Status = 'AVAILABLE'
                  AND location.IsPickable = 1
                  AND location.Status NOT IN ('BLOCKED', 'INACTIVE')
                  AND location.LocationType <> 'QUARANTINE'
                ORDER BY
                    CASE WHEN product.RotationMethod = 'FEFO' THEN lot.ExpiryDate END,
                    lot.FirstReceivedDate,
                    inventory.InventoryID;

            OPEN StockCursor;
            FETCH NEXT FROM StockCursor INTO @LocationID, @LotID, @Available;

            WHILE @@FETCH_STATUS = 0 AND @Need > 0
            BEGIN
                SET @Take = CASE WHEN @Available >= @Need THEN @Need ELSE @Available END;

                INSERT dbo.InventoryReservations
                (
                    SalesOrderDetailID,
                    ProductID,
                    StorageLocationID,
                    ProductLotID,
                    ReservedQuantity,
                    ReservedByUserID
                )
                VALUES
                (
                    @SalesOrderDetailID,
                    @ProductID,
                    @LocationID,
                    @LotID,
                    @Take,
                    @UserID
                );

                SET @ReservationID = SCOPE_IDENTITY();

                INSERT dbo.InventoryTransactions
                (
                    TransactionType,
                    ProductID,
                    StorageLocationID,
                    ProductLotID,
                    OnHandDelta,
                    ReservedDelta,
                    InventoryReservationID,
                    PerformedByUserID,
                    Notes
                )
                VALUES
                (
                    'RESERVE',
                    @ProductID,
                    @LocationID,
                    @LotID,
                    0,
                    @Take,
                    @ReservationID,
                    @UserID,
                    N'Tai giu ton cho Sales Order sau kiem kho'
                );

                SET @Need = @Need - @Take;
                FETCH NEXT FROM StockCursor INTO @LocationID, @LotID, @Available;
            END;

            CLOSE StockCursor;
            DEALLOCATE StockCursor;

            IF @Need > 0
                THROW 51103, N'Ton kha dung khong du de giu cho toan bo Sales Order.', 1;

            UPDATE detail
            SET ReservedQuantity = totals.ReservedQuantity
            FROM dbo.SalesOrderDetails AS detail
            CROSS APPLY
            (
                SELECT COALESCE(SUM(reservation.ReservedQuantity - reservation.ConsumedQuantity), 0)
                    AS ReservedQuantity
                FROM dbo.InventoryReservations AS reservation
                WHERE reservation.SalesOrderDetailID = detail.SalesOrderDetailID
                  AND reservation.Status IN ('ACTIVE', 'PARTIALLY_CONSUMED')
            ) AS totals
            WHERE detail.SalesOrderDetailID = @SalesOrderDetailID;

            FETCH NEXT FROM DetailCursor INTO @SalesOrderDetailID, @ProductID, @Need;
        END;

        CLOSE DetailCursor;
        DEALLOCATE DetailCursor;

        UPDATE dbo.SalesOrders
        SET Status = 'ALLOCATED',
            UpdatedAt = SYSUTCDATETIME()
        WHERE SalesOrderID = @SalesOrderID;

        COMMIT TRANSACTION;
    END TRY
    BEGIN CATCH
        IF CURSOR_STATUS('local', 'StockCursor') >= -1
        BEGIN
            IF CURSOR_STATUS('local', 'StockCursor') > -1 CLOSE StockCursor;
            DEALLOCATE StockCursor;
        END;

        IF CURSOR_STATUS('local', 'DetailCursor') >= -1
        BEGIN
            IF CURSOR_STATUS('local', 'DetailCursor') > -1 CLOSE DetailCursor;
            DEALLOCATE DetailCursor;
        END;

        IF @@TRANCOUNT > 0 ROLLBACK TRANSACTION;
        THROW;
    END CATCH;
END;
GO
/****** Object:  StoredProcedure [dbo].[usp_StartStocktakeSession]    Script Date: 9/21/2026 9:03:24 AM ******/
