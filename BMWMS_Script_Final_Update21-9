CREATE   TRIGGER [dbo].[trg_StorageRacks_HierarchicalCapacity]
ON [dbo].[StorageRacks]
AFTER INSERT, UPDATE, DELETE
AS
BEGIN
    SET NOCOUNT ON;
    IF EXISTS
    (
        SELECT 1
        FROM dbo.StorageRacks AS rack
        JOIN inserted AS changed ON changed.RackID = rack.RackID
        OUTER APPLY
        (
            SELECT SUM(ISNULL(bin.MaxCapacityQuantity, 0)) AS ChildCapacity
            FROM dbo.StorageLocations AS bin
            WHERE bin.RackID = rack.RackID
        ) AS total
        WHERE rack.MaxCapacityQuantity IS NOT NULL
          AND total.ChildCapacity > rack.MaxCapacityQuantity
    )
        THROW 51311, N'Sức chứa Rack nhỏ hơn tổng sức chứa các Bin.', 1;

    IF EXISTS
    (
        SELECT 1
        FROM dbo.WarehouseZones AS zone
        JOIN
        (
            SELECT ZoneID FROM inserted
            UNION
            SELECT ZoneID FROM deleted
        ) AS changed ON changed.ZoneID = zone.ZoneID
        OUTER APPLY
        (
            SELECT SUM(ISNULL(rack.MaxCapacityQuantity, 0)) AS ChildCapacity
            FROM dbo.StorageRacks AS rack
            WHERE rack.ZoneID = zone.ZoneID
        ) AS total
        WHERE zone.MaxCapacityQuantity IS NOT NULL
          AND total.ChildCapacity > zone.MaxCapacityQuantity
    )
        THROW 51312, N'Tổng sức chứa các Rack vượt sức chứa Zone.', 1;
END;
GO
