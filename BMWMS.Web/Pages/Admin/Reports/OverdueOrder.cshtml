@page
@model BMWMS.Web.Pages.Admin.Reports.OverdueOrderModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Cảnh báo phiếu quá hạn";
    ViewData["HeaderTitle"] = "Cảnh báo phiếu nhập/xuất quá hạn";
    ViewData["FooterVersion"] = "UC49 Premium UI";
}

<style>
    /* Premium UI Styles */
    .premium-container {
        padding: 24px 0;
        max-width: 100%;
        animation: fadeIn 0.4s ease-out forwards;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Glassmorphism Header */
    .glass-header {
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.1), rgba(248, 113, 113, 0.05));
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .glass-header-title {
        font-size: 24px;
        font-weight: 700;
        background: linear-gradient(to right, #991b1b, #ef4444);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 4px;
    }

    .glass-header-sub {
        color: #64748b;
        font-size: 14px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    /* Premium Stats Grid */
    .premium-stats-grid {
        display: grid;
        gap: 20px;
        margin-bottom: 24px;
        grid-template-columns: repeat(3, 1fr);
    }
    
    .premium-stat-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
        border: 1px solid #f1f5f9;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .premium-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 30px -5px rgba(0, 0, 0, 0.08);
    }
    
    .premium-stat-card::after {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 4px;
    }
    .stat-red::after { background: linear-gradient(90deg, #ef4444, #f87171); }
    .stat-orange::after { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
    .stat-blue::after { background: linear-gradient(90deg, #3b82f6, #60a5fa); }

    .stat-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
    }
    
    .stat-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }
    
    .stat-red .stat-icon { background: #fef2f2; color: #ef4444; }
    .stat-orange .stat-icon { background: #fffbeb; color: #f59e0b; }
    .stat-blue .stat-icon { background: #eff6ff; color: #3b82f6; }

    .stat-title {
        color: #64748b;
        font-size: 14px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .stat-value {
        font-size: 32px;
        font-weight: 700;
        color: #0f172a;
        font-family: 'JetBrains Mono', 'Courier New', monospace;
    }

    /* Premium Card */
    .premium-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
        border: 1px solid #f1f5f9;
        overflow: hidden;
    }

    /* Filter Section */
    .filter-wrapper {
        padding: 24px;
        background: #f8fafc;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        gap: 20px;
        align-items: center;
        flex-wrap: wrap;
    }

    .form-group-float {
        position: relative;
        flex: 1;
        min-width: 250px;
    }

    .form-label-float {
        position: absolute;
        top: -8px;
        left: 12px;
        background: #f8fafc;
        padding: 0 4px;
        font-size: 12px;
        font-weight: 600;
        color: #3b82f6;
        z-index: 1;
    }

    .form-control-float, .form-select-float {
        width: 100%;
        height: 48px;
        border-radius: 12px;
        border: 2px solid #e2e8f0;
        padding: 0 16px;
        font-size: 14px;
        background: transparent;
        color: #1e293b;
        transition: all 0.3s ease;
    }

    .form-control-float:focus, .form-select-float:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
        outline: none;
    }

    .btn-premium {
        height: 48px;
        padding: 0 32px;
        border-radius: 12px;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: white;
        font-weight: 600;
        font-size: 15px;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
        transition: all 0.3s ease;
        white-space: nowrap;
    }

    .btn-premium:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(37, 99, 235, 0.3);
    }

    /* Premium Data Grid */
    .data-grid {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .data-grid th {
        background: #ffffff;
        color: #64748b;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 12px;
        letter-spacing: 0.5px;
        padding: 20px 24px;
        border-bottom: 2px solid #f1f5f9;
        white-space: nowrap;
    }

    .data-grid td {
        padding: 20px 24px;
        vertical-align: middle;
        border-bottom: 1px solid #f8fafc;
        transition: background-color 0.2s;
    }

    .data-grid tbody tr {
        transition: all 0.2s ease;
    }

    .data-grid tbody tr:hover {
        background-color: #f8fafc;
        box-shadow: inset 4px 0 0 #ef4444;
    }

    .item-info-premium {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .item-avatar {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: linear-gradient(135deg, #fef2f2, #fee2e2);
        color: #ef4444;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        box-shadow: 0 2px 4px rgba(239, 68, 68, 0.1);
    }
    
    .item-avatar-inbound { background: linear-gradient(135deg, #eff6ff, #dbeafe); color: #3b82f6; box-shadow: 0 2px 4px rgba(59, 130, 246, 0.1); }
    .item-avatar-outbound { background: linear-gradient(135deg, #fdf4ff, #fae8ff); color: #c026d3; box-shadow: 0 2px 4px rgba(192, 38, 211, 0.1); }

    .item-details .name {
        font-weight: 700;
        color: #0f172a;
        font-size: 15px;
        margin-bottom: 4px;
    }

    /* Vibrant Badges */
    .badge-vibrant {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 14px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 14px;
        min-width: 70px;
        letter-spacing: 0.5px;
        font-family: 'JetBrains Mono', 'Courier New', monospace;
    }

    .badge-danger { background: rgba(239, 68, 68, 0.1); color: #dc2626; box-shadow: 0 0 0 1px rgba(239, 68, 68, 0.2); }
    .badge-warning { background: rgba(245, 158, 11, 0.1); color: #d97706; box-shadow: 0 0 0 1px rgba(245, 158, 11, 0.2); }
    .badge-info { background: rgba(59, 130, 246, 0.1); color: #2563eb; box-shadow: 0 0 0 1px rgba(59, 130, 246, 0.2); }
    
    .status-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    
    .status-critical { background: #fee2e2; color: #b91c1c; }
    .status-warning { background: #fef3c7; color: #b45309; }

    /* Empty State */
    .empty-state-premium {
        padding: 60px 20px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    
    .empty-icon-wrapper {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: linear-gradient(135deg, #f8fafc, #f1f5f9);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 40px;
        color: #94a3b8;
        margin-bottom: 24px;
        box-shadow: inset 0 2px 4px rgba(0,0,0,0.02), 0 8px 16px rgba(0,0,0,0.02);
    }
    
    .empty-title {
        font-size: 18px;
        font-weight: 600;
        color: #334155;
        margin-bottom: 8px;
    }
    
    .empty-subtitle {
        color: #64748b;
        font-size: 14px;
    }
    
    .pagination-footer {
        padding: 20px 24px;
        background: #ffffff;
        border-top: 1px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 14px;
        color: #64748b;
    }
</style>

<div class="premium-container">
    <!-- Header -->
    <div class="glass-header">
        <div>
            <div class="glass-header-title"><i class="ri-alarm-warning-line"></i> Cảnh báo phiếu quá hạn</div>
            <div class="glass-header-sub">
                <i class="ri-time-line"></i> 
                Dữ liệu tính đến: @Model.ReportData.CutOffTime.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>
        <div>
            <button onclick="exportExcel()" class="btn btn-outline" style="border-radius: 10px; padding: 10px 20px; font-weight: 600; color: #475569; border: 1px solid #cbd5e1; background: white; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='white'" type="button">
                <i class="ri-file-excel-2-line" style="color: #10b981; margin-right: 6px;"></i> Xuất Excel
            </button>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="premium-stats-grid">
        <div class="premium-stat-card stat-red">
            <div class="stat-header">
                <div class="stat-icon"><i class="ri-file-warning-line"></i></div>
                <div class="stat-title">Quá hạn > 30 ngày</div>
            </div>
            <div class="stat-value">
                @Model.ReportData.Data.Items.Count(x => (x.DaysOverdue ?? 0) > 30).ToString("N0")
            </div>
        </div>
        
        <div class="premium-stat-card stat-orange">
            <div class="stat-header">
                <div class="stat-icon"><i class="ri-file-history-line"></i></div>
                <div class="stat-title">Quá hạn <= 30 ngày</div>
            </div>
            <div class="stat-value">
                @Model.ReportData.Data.Items.Count(x => (x.DaysOverdue ?? 0) > 0 && (x.DaysOverdue ?? 0) <= 30).ToString("N0")
            </div>
        </div>
        
        <div class="premium-stat-card stat-blue">
            <div class="stat-header">
                <div class="stat-icon"><i class="ri-file-list-3-line"></i></div>
                <div class="stat-title">Tổng số phiếu trễ</div>
            </div>
            <div class="stat-value">
                @Model.ReportData.Data.TotalCount.ToString("N0")
            </div>
        </div>
    </div>

    <!-- Main Card -->
    <div class="premium-card">
        <!-- Filter Form -->
        <form method="get" class="filter-wrapper">
            <div class="form-group-float">
                <label class="form-label-float">Loại phiếu</label>
                <select class="form-select-float" asp-for="Filter.DocumentType" asp-items="Model.DocumentTypes"></select>
            </div>
            <div class="form-group-float">
                <label class="form-label-float">Tìm kiếm mã phiếu</label>
                <input type="text" class="form-control-float" asp-for="Filter.Keyword" placeholder="Nhập mã phiếu nhập/xuất..." />
            </div>
            
            <button type="submit" class="btn-premium">
                <i class="ri-filter-3-line"></i> 
                <span>Lọc kết quả</span>
            </button>
        </form>

        <!-- Data Table -->
        <div class="table-responsive">
            <table class="data-grid">
                <thead>
                    <tr>
                        <th style="width: 25%;">Phiếu</th>
                        <th>Loại phiếu</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Ngày dự kiến</th>
                        <th class="text-center">Số ngày trễ</th>
                        <th class="text-center">Mức độ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ReportData.Data.Items.Any())
                    {
                        foreach (var item in Model.ReportData.Data.Items)
                        {
                            var days = item.DaysOverdue ?? 0;
                            var isCritical = days > 30;
                            var isWarning = days > 0 && days <= 30;
                            var isOutbound = item.DocumentType == "OUTBOUND";
                            
                            <tr>
                                <td>
                                    <div class="item-info-premium">
                                        <div class="item-avatar @(isOutbound ? "item-avatar-outbound" : "item-avatar-inbound")">
                                            <i class="@(isOutbound ? "ri-logout-box-r-line" : "ri-login-box-line")"></i>
                                        </div>
                                        <div class="item-details">
                                            <div class="name">@item.DocumentNumber</div>
                                            <div style="font-size: 13px; color: #64748b;">
                                                <i class="ri-building-line"></i> Kho: @item.WarehouseId
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (isOutbound)
                                    {
                                        <span class="badge-vibrant badge-warning">Xuất kho</span>
                                    }
                                    else
                                    {
                                        <span class="badge-vibrant badge-info">Nhập kho</span>
                                    }
                                </td>
                                <td>
                                    <span style="font-weight: 600; color: #334155;">@item.Status</span>
                                </td>
                                <td class="text-center">
                                    <span style="font-weight: 600; color: #0f172a;">
                                        @(item.DueDate?.ToString("dd/MM/yyyy") ?? "-")
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (days > 0)
                                    {
                                        <span class="badge-vibrant @(isCritical ? "badge-danger" : "badge-warning")">
                                            Trễ @days ngày
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-vibrant badge-info">Đúng hạn</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (isCritical)
                                    {
                                        <span class="status-badge status-critical">
                                            <i class="ri-alert-fill"></i> Nghiêm trọng
                                        </span>
                                    }
                                    else if (isWarning)
                                    {
                                        <span class="status-badge status-warning">
                                            <i class="ri-error-warning-fill"></i> Cảnh báo
                                        </span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-state-premium">
                                    <div class="empty-icon-wrapper" style="color: #10b981; background: #ecfdf5;">
                                        <i class="ri-checkbox-circle-line"></i>
                                    </div>
                                    <div class="empty-title">Tuyệt vời! Không có phiếu nào quá hạn.</div>
                                    <div class="empty-subtitle">Mọi quy trình nhập xuất đều đang theo đúng tiến độ.</div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Footer / Pagination -->
        <div class="pagination-footer">
            <div>
                Hiển thị <strong style="color: #0f172a;">@Model.ReportData.Data.Items.Count</strong> trên tổng số <strong style="color: #0f172a;">@Model.ReportData.Data.TotalCount</strong> bản ghi
            </div>
            <div>
                <!-- Pagination buttons -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function exportExcel() {
            var form = document.querySelector('.filter-wrapper');
            var formData = new FormData(form);
            var searchParams = new URLSearchParams();
            
            for (const [key, value] of formData) {
                if(value) {
                    searchParams.append(key, value);
                }
            }
            
            var url = '?handler=Export&' + searchParams.toString();
            window.location.href = url;
        }
    </script>
}
