@page
@model BMWMS.Web.Pages.Admin.Reports.OutboundModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Báo cáo xuất kho";
    ViewData["HeaderTitle"] = "Báo cáo xuất kho";
}

<div class="page-header">
    <div class="page-header-title">Báo cáo xuất kho</div>
    <div class="page-header-sub">Kỳ báo cáo: @Model.Filter.FromDate?.ToString("dd/MM/yyyy") - @Model.Filter.ToDate?.ToString("dd/MM/yyyy")</div>
</div>

<div class="stats-grid" style="grid-template-columns: repeat(2, 1fr);">
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-dot blue"></div>
            <div class="stat-badge blue">Yêu cầu xuất</div>
        </div>
        <div class="stat-number" style="color: #2563b8;">@Model.ReportData?.TotalRequested.ToString("N0")</div>
        <div class="stat-label">Tổng số lượng yêu cầu</div>
    </div>
    
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-dot green"></div>
            <div class="stat-badge green">Thực xuất</div>
        </div>
        <div class="stat-number" style="color: #16a34a;">@Model.ReportData?.TotalIssued.ToString("N0")</div>
        <div class="stat-label">Tổng số lượng đã xuất</div>
    </div>
</div>

<div class="panel">
    <div class="panel-header">
        <div class="panel-title">Chi tiết xuất kho</div>
        <div class="panel-actions">
            <button class="btn btn-outline" type="button" disabled>
                <i class="fas fa-file-export"></i> Xuất Excel
            </button>
        </div>
    </div>
    <div class="panel-body">
        <form method="get" class="filter-form mb-4" style="display: flex; gap: 16px; align-items: flex-end; padding-bottom: 20px; border-bottom: 1px solid #e2e8f0; margin-bottom: 20px;">
            <div class="form-group" style="margin-bottom: 0; min-width: 150px;">
                <label style="display: block; margin-bottom: 6px; font-weight: 500; font-size: 13px; color: #475569;">Từ ngày</label>
                <input type="date" class="form-control" asp-for="Filter.FromDate" style="width: 100%; height: 38px; border-radius: 6px; border: 1px solid #cbd5e1; padding: 0 12px; font-size: 14px;" />
            </div>
            
            <div class="form-group" style="margin-bottom: 0; min-width: 150px;">
                <label style="display: block; margin-bottom: 6px; font-weight: 500; font-size: 13px; color: #475569;">Đến ngày</label>
                <input type="date" class="form-control" asp-for="Filter.ToDate" style="width: 100%; height: 38px; border-radius: 6px; border: 1px solid #cbd5e1; padding: 0 12px; font-size: 14px;" />
            </div>

            <div class="form-group" style="margin-bottom: 0; min-width: 240px; flex: 1;">
                <label style="display: block; margin-bottom: 6px; font-weight: 500; font-size: 13px; color: #475569;">Sản phẩm</label>
                <input type="text" class="form-control" asp-for="Filter.ProductSearch" placeholder="Mã hoặc tên SP..." style="width: 100%; height: 38px; border-radius: 6px; border: 1px solid #cbd5e1; padding: 0 12px; font-size: 14px;" />
            </div>

            <div class="form-group" style="margin-bottom: 0; min-width: 180px;">
                <label style="display: block; margin-bottom: 6px; font-weight: 500; font-size: 13px; color: #475569;">Trạng thái</label>
                <select class="form-control" asp-for="Filter.Status" style="width: 100%; height: 38px; border-radius: 6px; border: 1px solid #cbd5e1; padding: 0 12px; font-size: 14px; background-color: white;">
                    <option value="">-- Tất cả --</option>
                    <option value="DRAFT">Nháp (Draft)</option>
                    <option value="CONFIRMED">Đã chốt (Confirmed)</option>
                    <option value="PICKING">Đang lấy hàng (Picking)</option>
                    <option value="PACKED">Đã đóng gói (Packed)</option>
                    <option value="SHIPPED">Đã xuất (Shipped)</option>
                    <option value="CANCELLED">Hủy (Cancelled)</option>
                </select>
            </div>
            
            <button type="submit" class="btn btn-primary" style="height: 38px; padding: 0 24px; font-weight: 500; border-radius: 6px; background-color: #2563b8; color: white; border: none; cursor: pointer; transition: background-color 0.2s;">
                <i class="ri-filter-3-line" style="margin-right: 4px;"></i> Lọc dữ liệu
            </button>
        </form>

        <table class="panel-table" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr>
                    <th>Mã phiếu xuất</th>
                    <th>Nguồn xuất</th>
                    <th>Sản phẩm</th>
                    <th>Ngày xuất (dự kiến)</th>
                    <th class="text-right">SL yêu cầu</th>
                    <th class="text-right">Đã xuất</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ReportData?.Items != null && Model.ReportData.Items.Any())
                {
                    foreach (var item in Model.ReportData.Items)
                    {
                        <tr>
                            <td>@item.OutboundOrderNumber</td>
                            <td>
                                @{
                                    string sourceBadge = item.SourceType switch {
                                        "SALES_ORDER" => "badge-primary",
                                        "TRANSFER" => "badge-warning",
                                        "RETURN_TO_SUPPLIER" => "badge-secondary",
                                        _ => "badge-secondary"
                                    };
                                }
                                <span class="badge @sourceBadge" style="font-size: 11px;">@item.SourceType</span>
                            </td>
                            <td>
                                <div style="font-weight: 500;">@item.ProductCode</div>
                                <div style="color: #64748b; font-size: 13px;">@item.ProductName</div>
                            </td>
                            <td>@item.ExpectedIssueDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-right" style="font-weight: bold;">@item.RequestedQuantity.ToString("N0")</td>
                            <td class="text-right" style="font-weight: bold; color: #16a34a;">@item.IssuedQuantity.ToString("N0")</td>
                            <td>
                                @{
                                    string statusBadge = item.Status switch {
                                        "DRAFT" => "badge-secondary",
                                        "CONFIRMED" => "badge-primary",
                                        "PICKING" => "badge-warning",
                                        "PACKED" => "badge-warning",
                                        "SHIPPED" => "badge-success",
                                        "CANCELLED" => "badge-danger",
                                        _ => "badge-secondary"
                                    };
                                }
                                <span class="badge @statusBadge">@item.Status</span>
                            </td>
                        </tr>
                    }
                    <!-- Totals Row -->
                    <tr style="background-color: #f8fafc; font-weight: 600;">
                        <td colspan="4" class="text-right">Tổng cộng:</td>
                        <td class="text-right">@Model.ReportData.TotalRequested.ToString("N0")</td>
                        <td class="text-right" style="color: #16a34a;">@Model.ReportData.TotalIssued.ToString("N0")</td>
                        <td></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted" style="padding: 32px;">
                            <i class="fas fa-truck-loading" style="font-size: 32px; color: #cbd5e1; margin-bottom: 12px; display: block;"></i>
                            Không có dữ liệu báo cáo khớp với điều kiện lọc.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        
        @if (Model.ReportData?.TotalCount > Model.Filter.PageSize)
        {
            <div class="text-center text-muted" style="margin-top: 16px; font-size: 13px;">
                Hiển thị @Model.ReportData.Items.Count trên tổng số @Model.ReportData.TotalCount bản ghi.
            </div>
        }
    </div>
</div>
