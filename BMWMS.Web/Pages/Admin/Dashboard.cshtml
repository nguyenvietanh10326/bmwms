@page
@model BMWMS.Web.Pages.Admin.DashboardModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tổng quan";
    ViewData["HeaderTitle"] = "Tổng quan";
    ViewData["FooterVersion"] = "Database aligned v3.0";
}

<div class="page-header">
    <div class="page-header-title">Chào mừng trở lại, @Model.FullName</div>
    <div class="page-header-sub">Tổng quan hoạt động kho ngày @DateTime.Now.ToString("dd/MM/yyyy")</div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-dot blue"></div>
            <div class="stat-badge blue">+@Model.DashboardData.NewProductsThisMonth tháng này</div>
        </div>
        <div class="stat-number">@Model.DashboardData.TotalProducts</div>
        <div class="stat-label">Tổng sản phẩm</div>
    </div>
    
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-dot green"></div>
            <div class="stat-badge green">100% sẵn sàng</div>
        </div>
        <div class="stat-number">@Model.DashboardData.ActiveWarehouses</div>
        <div class="stat-label">Kho đang hoạt động</div>
    </div>
    
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-dot orange"></div>
            <div class="stat-badge orange">Cần xử lý</div>
        </div>
        <div class="stat-number">@Model.DashboardData.LowStockCount</div>
        <div class="stat-label">Sắp hết hàng</div>
    </div>
    
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-dot red"></div>
            <div class="stat-badge red">Ưu tiên cao</div>
        </div>
        <div class="stat-number">@Model.DashboardData.OutOfStockCount</div>
        <div class="stat-label">Hết hàng</div>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-number" style="color: #7c3aed;">@Model.DashboardData.PendingPurchaseOrders</div>
        </div>
        <div class="stat-label">Đơn mua chờ xác nhận</div>
    </div>
    
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-number" style="color: #2563b8;">@Model.DashboardData.PendingSalesOrders</div>
        </div>
        <div class="stat-label">Đơn bán chờ giữ tồn</div>
    </div>
    
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-number" style="color: #16a34a;">@Model.DashboardData.ProcessingInboundOrders</div>
        </div>
        <div class="stat-label">Lệnh nhập đang xử lý</div>
    </div>
    
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-number" style="color: #d97706;">@Model.DashboardData.PickingOutboundOrders</div>
        </div>
        <div class="stat-label">Lệnh xuất đang picking</div>
    </div>
</div>

<div class="panels-grid">
    <div class="panel">
        <div class="panel-header">
            <div class="panel-title">Cảnh báo tồn kho</div>
            <div class="panel-sub">Theo tồn khả dụng sau khi trừ Reserved</div>
        </div>
        <div class="panel-body">
            <table class="panel-table">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Khả dụng</th>
                        <th>Ngưỡng</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DashboardData.InventoryAlerts.Any())
                    {
                        foreach (var alert in Model.DashboardData.InventoryAlerts)
                        {
                            var color = alert.AvailableQuantity <= 0 ? "#dc2626" : "#d97706";
                            var badgeClass = alert.AvailableQuantity <= 0 ? "danger" : "warning";
                            <tr>
                                <td>@alert.ProductName</td>
                                <td style="color: @color; font-weight: 500;">@alert.AvailableQuantity.ToString("G29") @alert.Unit</td>
                                <td>@alert.Threshold.ToString("G29")</td>
                                <td><span class="status-badge @badgeClass">@alert.Status</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted" style="padding: 24px;">Không có cảnh báo tồn kho nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    <div class="panel">
        <div class="panel-header">
            <div class="panel-title">Hoạt động gần đây</div>
            <div class="panel-sub">Các nghiệp vụ mới nhất trong hệ thống</div>
        </div>
        <div class="panel-body">
            <div class="activity-list">
                @if (Model.DashboardData.RecentActivities.Any())
                {
                    foreach (var activity in Model.DashboardData.RecentActivities)
                    {
                        var timeSpan = DateTime.Now - activity.CreatedAt;
                        var timeString = "";
                        if (timeSpan.TotalMinutes < 60)
                        {
                            timeString = $"{(int)timeSpan.TotalMinutes} phút trước";
                        }
                        else if (timeSpan.TotalHours < 24)
                        {
                            timeString = $"{(int)timeSpan.TotalHours} giờ trước";
                        }
                        else
                        {
                            timeString = $"{(int)timeSpan.TotalDays} ngày trước";
                        }
                        
                        <div class="activity-item">
                            <div class="activity-dot @activity.ColorType"></div>
                            <div class="activity-content">
                                <div class="activity-text">@activity.ActivityText</div>
                                <div class="activity-meta">@activity.PerformedBy &bull; @timeString</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted text-center" style="padding: 24px;">Chưa có hoạt động nào gần đây.</div>
                }
            </div>
        </div>
    </div>
</div>
