@page
@model BMWMS.Web.Pages.Admin.DashboardModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tổng quan";
    ViewData["HeaderTitle"] = "Tổng quan";
    ViewData["FooterVersion"] = "Database aligned v3.0";
}

<div class="page-header">
    <div class="page-header-title">Chào mừng trở lại, @Model.FullName</div>
    <div class="page-header-sub">Tổng quan hoạt động kho ngày @DateTime.Now.ToString("dd/MM/yyyy")</div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-dot blue"></div>
            <div class="stat-badge blue">+8 tháng này</div>
        </div>
        <div class="stat-number">156</div>
        <div class="stat-label">Tổng sản phẩm</div>
    </div>
    
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-dot green"></div>
            <div class="stat-badge green">100% sẵn sàng</div>
        </div>
        <div class="stat-number">5</div>
        <div class="stat-label">Kho đang hoạt động</div>
    </div>
    
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-dot orange"></div>
            <div class="stat-badge orange">Cần xử lý</div>
        </div>
        <div class="stat-number">24</div>
        <div class="stat-label">Sắp hết hàng</div>
    </div>
    
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-dot red"></div>
            <div class="stat-badge red">Ưu tiên cao</div>
        </div>
        <div class="stat-number">3</div>
        <div class="stat-label">Hết hàng</div>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-number" style="color: #7c3aed;">8</div>
        </div>
        <div class="stat-label">Đơn mua chờ xác nhận</div>
    </div>
    
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-number" style="color: #2563b8;">6</div>
        </div>
        <div class="stat-label">Đơn bán chờ giữ tồn</div>
    </div>
    
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-number" style="color: #16a34a;">4</div>
        </div>
        <div class="stat-label">Lệnh nhập đang xử lý</div>
    </div>
    
    <div class="stat-card">
        <div class="stat-card-header">
            <div class="stat-number" style="color: #d97706;">3</div>
        </div>
        <div class="stat-label">Lệnh xuất đang picking</div>
    </div>
</div>

<div class="panels-grid">
    <div class="panel">
        <div class="panel-header">
            <div class="panel-title">Cảnh báo tồn kho</div>
            <div class="panel-sub">Theo tồn khả dụng sau khi trừ Reserved</div>
        </div>
        <div class="panel-body">
            <table class="panel-table">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Khả dụng</th>
                        <th>Ngưỡng</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Xi măng PCB40</td>
                        <td style="color: #dc2626; font-weight: 500;">0 Tấn</td>
                        <td>250</td>
                        <td><span class="status-badge danger">Hết hàng</span></td>
                    </tr>
                    <tr>
                        <td>Thép cây D16</td>
                        <td style="color: #d97706; font-weight: 500;">120 Kg</td>
                        <td>300</td>
                        <td><span class="status-badge warning">Sắp hết</span></td>
                    </tr>
                    <tr>
                        <td>Cát vàng xây</td>
                        <td style="color: #d97706; font-weight: 500;">45 m³</td>
                        <td>100</td>
                        <td><span class="status-badge warning">Sắp hết</span></td>
                    </tr>
                    <tr>
                        <td>Gạch ống 8x8x18</td>
                        <td style="color: #d97706; font-weight: 500;">520 Viên</td>
                        <td>800</td>
                        <td><span class="status-badge warning">Theo dõi</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    
    <div class="panel">
        <div class="panel-header">
            <div class="panel-title">Hoạt động gần đây</div>
            <div class="panel-sub">Các nghiệp vụ mới nhất trong hệ thống</div>
        </div>
        <div class="panel-body">
            <div class="activity-list">
                <div class="activity-item">
                    <div class="activity-dot purple"></div>
                    <div class="activity-content">
                        <div class="activity-text">PO-2026-0078 đã được xác nhận</div>
                        <div class="activity-meta">Trần Thị Bình • 10 phút trước</div>
                    </div>
                </div>
                <div class="activity-item">
                    <div class="activity-dot blue"></div>
                    <div class="activity-content">
                        <div class="activity-text">SO-2026-0041 đã giữ tồn thành công</div>
                        <div class="activity-meta">Hoàng Minh • 25 phút trước</div>
                    </div>
                </div>
                <div class="activity-item">
                    <div class="activity-dot green"></div>
                    <div class="activity-content">
                        <div class="activity-text">Nhận hàng PN-2026-0042 hoàn tất</div>
                        <div class="activity-meta">Phạm Thị Cúc • 40 phút trước</div>
                    </div>
                </div>
                <div class="activity-item">
                    <div class="activity-dot orange"></div>
                    <div class="activity-content">
                        <div class="activity-text">Chuyển kho CK-2026-0086 đang vận chuyển</div>
                        <div class="activity-meta">Trần Văn An • 1 giờ trước</div>
                    </div>
                </div>
                <div class="activity-item">
                    <div class="activity-dot red"></div>
                    <div class="activity-content">
                        <div class="activity-text">Kiểm kho Bin A-01-01 có chênh lệch</div>
                        <div class="activity-meta">Phạm Thị Cúc • 2 giờ trước</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
