@page
@model BMWMS.Web.Pages.Admin.Suppliers.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Xem danh sách nhà cung cấp";
    ViewData["HeaderTitle"] = HttpContext.Session.GetString("RoleName") ?? "Nhân viên mua hàng";
    ViewData["FooterVersion"] = "Full coverage · UC01-UC63";
}

<div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
        <div class="page-header-title">Xem danh sách nhà cung cấp</div>
        <div class="page-header-sub">Tìm kiếm và xem các nhà cung cấp đã đăng ký · Actor chính: @(HttpContext.Session.GetString("RoleName") ?? "Nhân viên mua hàng")</div>
    </div>
    <div>
        @{
            var canEdit = new[] { "SYSTEM_ADMIN", "PURCHASING_STAFF" }.Contains(HttpContext.Session.GetString("RoleCode"));
        }
        @if (canEdit)
        {
            <a href="/Admin/Suppliers/Create" class="btn btn-primary" style="background-color: #27272a; color: white; border: none; padding: 10px 20px;">Tạo nhà cung cấp</a>
        }
    </div>
</div>

<div class="form-card" style="padding: 24px;">
    <form method="get" id="supplierFilterForm" style="display: flex; gap: 16px; margin-bottom: 24px; flex-wrap: wrap; align-items: center;">
        <input type="hidden" name="Filter.PageIndex" value="1" />
        <input type="hidden" name="Filter.PageSize" value="@(Model.Filter.PageSize > 0 ? Model.Filter.PageSize : 10)" id="supplierPageSizeInput" />

        <div style="flex: 1; min-width: 300px; position: relative;">
            <i class="ri-search-line" style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--text-muted);"></i>
            <input type="text" asp-for="Filter.Keyword" class="form-control" placeholder="Tìm mã hoặc tên nhà cung cấp..." style="padding-left: 44px; width: 100%; box-sizing: border-box;" />
        </div>
        
        <div style="width: 200px;">
            <select asp-for="Filter.Status" class="form-control">
                <option value="">Tất cả trạng thái</option>
                <option value="ACTIVE">Đang hoạt động</option>
                <option value="INACTIVE">Tạm ngừng</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary" style="background-color: #27272a; color: white; border: none; padding: 10px 24px;">Tìm kiếm</button>
        @if (!string.IsNullOrWhiteSpace(Model.Filter.Keyword) || !string.IsNullOrWhiteSpace(Model.Filter.Status))
        {
            <a href="/Admin/Suppliers" class="btn" style="background-color: #e4e4e7; color: #27272a; border: 1px solid #d4d4d8; padding: 10px 24px; text-decoration: none;">Đặt lại</a>
        }
    </form>

    <div style="overflow-x: auto; border: 1px solid #e2e8f0; border-radius: 8px;">
        <table class="table table-bordered table-hover" style="width: 100%; min-width: 1000px; margin-bottom: 0;">
            <thead style="background-color: #f8fafc;">
                <tr>
                    <th style="text-align: left; padding: 12px 16px;">Mã NCC</th>
                    <th style="text-align: left; padding: 12px 16px;">Nhà cung cấp</th>
                    <th style="text-align: left; padding: 12px 16px;">Liên hệ</th>
                    <th style="text-align: left; padding: 12px 16px;">Sản phẩm</th>
                    <th style="text-align: left; padding: 12px 16px;">Trạng thái</th>
                    <th style="text-align: left; padding: 12px 16px;">Cập nhật</th>
                    <th style="text-align: left; padding: 12px 16px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Suppliers.Items.Any())
                {
                    foreach (var supplier in Model.Suppliers.Items)
                    {
                        <tr>
                            <td style="color: #2563eb; font-weight: 500; padding: 12px 16px; vertical-align: middle;">@supplier.SupplierCode</td>
                            <td style="color: var(--text-main); padding: 12px 16px; vertical-align: middle;">@supplier.SupplierName</td>
                            <td style="color: var(--text-muted); padding: 12px 16px; vertical-align: middle;">@supplier.RepresentativeName</td>
                            <td style="color: var(--text-muted); padding: 12px 16px; vertical-align: middle;">@supplier.SuppliedProductCount sản phẩm</td>
                            <td style="padding: 12px 16px; vertical-align: middle;">
                                @if (supplier.Status == "ACTIVE")
                                {
                                    <span style="display: inline-flex; align-items: center; padding: 4px 12px; background-color: #dcfce7; color: #16a34a; border-radius: 100px; font-size: 13px; font-weight: 500;">Đang hoạt động</span>
                                }
                                else
                                {
                                    <span style="display: inline-flex; align-items: center; padding: 4px 12px; background-color: #f3f4f6; color: #4b5563; border-radius: 100px; font-size: 13px; font-weight: 500;">Tạm ngừng</span>
                                }
                            </td>
                            <td style="color: var(--text-muted); padding: 12px 16px; vertical-align: middle;">@(supplier.UpdatedAt?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td style="padding: 12px 16px; vertical-align: middle;">
                                <a href="/Admin/Suppliers/Detail/@supplier.SupplierCode" style="color: #2563eb; text-decoration: none; font-size: 14px;">Xem chi tiết</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 32px; color: var(--text-muted);">
                            Không có nhà cung cấp nào phù hợp với bộ lọc hiện tại.
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- SMART PAGINATION FOOTER -->
        @{
            var totalCount = Model.Suppliers.TotalCount;
            var pageSize = Model.Filter.PageSize > 0 ? Model.Filter.PageSize : 10;
            var currentPage = Model.Suppliers.PageIndex > 0 ? Model.Suppliers.PageIndex : 1;
            var totalPages = Model.Suppliers.TotalPages;
            var startEntry = totalCount == 0 ? 0 : (currentPage - 1) * pageSize + 1;
            var endEntry = Math.Min(currentPage * pageSize, totalCount);

            int windowSize = 5;
            int startPage = Math.Max(1, currentPage - windowSize / 2);
            int endPage = Math.Min(totalPages, startPage + windowSize - 1);
            if (endPage - startPage + 1 < windowSize)
            {
                startPage = Math.Max(1, endPage - windowSize + 1);
            }
        }

        <div style="display: flex; justify-content: space-between; align-items: center; padding: 14px 20px; border-top: 1px solid #e2e8f0; background: #fafafa; font-size: 13px; color: #64748b; flex-wrap: wrap; gap: 12px;">
            <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
                <div>
                    Hiển thị <strong>@startEntry</strong> đến <strong>@endEntry</strong> trong tổng số <strong>@totalCount</strong> nhà cung cấp
                </div>
                <div style="display: flex; align-items: center; gap: 6px;">
                    <label for="supplierPageSizeSelect" style="font-size: 12px; color: #64748b;">Số dòng / trang:</label>
                    <select id="supplierPageSizeSelect" onchange="changeSupplierPageSize(this.value)" style="padding: 4px 8px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 12px; background: #fff; color: #334155; outline: none; cursor: pointer;">
                        <!option value="10" @(pageSize == 10 ? "selected" : "")>10</!option>
                        <!option value="20" @(pageSize == 20 ? "selected" : "")>20</!option>
                        <!option value="50" @(pageSize == 50 ? "selected" : "")>50</!option>
                        <!option value="100" @(pageSize == 100 ? "selected" : "")>100</!option>
                    </select>
                </div>
            </div>

            @if (totalPages > 1)
            {
                <div style="display: flex; align-items: center; gap: 4px; flex-wrap: wrap;">
                    <!-- First & Prev -->
                    @if (currentPage > 1)
                    {
                        <a asp-page="./Index"
                           asp-route-Filter.PageIndex="1"
                           asp-route-Filter.PageSize="@pageSize"
                           asp-route-Filter.Keyword="@Model.Filter.Keyword"
                           asp-route-Filter.Status="@Model.Filter.Status"
                           title="Trang đầu"
                           style="min-width: 32px; height: 32px; padding: 0 8px; border: 1px solid #cbd5e1; border-radius: 6px; background: #fff; color: #334155; text-decoration: none; font-size: 12.5px; font-weight: 500; display: inline-flex; align-items: center; justify-content: center; transition: all 0.15s;">
                            &laquo;
                        </a>
                        <a asp-page="./Index"
                           asp-route-Filter.PageIndex="@(currentPage - 1)"
                           asp-route-Filter.PageSize="@pageSize"
                           asp-route-Filter.Keyword="@Model.Filter.Keyword"
                           asp-route-Filter.Status="@Model.Filter.Status"
                           title="Trang trước"
                           style="min-width: 32px; height: 32px; padding: 0 8px; border: 1px solid #cbd5e1; border-radius: 6px; background: #fff; color: #334155; text-decoration: none; font-size: 12.5px; font-weight: 500; display: inline-flex; align-items: center; justify-content: center; transition: all 0.15s;">
                            &lsaquo;
                        </a>
                    }
                    else
                    {
                        <span style="min-width: 32px; height: 32px; padding: 0 8px; border: 1px solid #e2e8f0; border-radius: 6px; background: #f8fafc; color: #cbd5e1; display: inline-flex; align-items: center; justify-content: center; font-size: 12.5px; cursor: not-allowed;">&laquo;</span>
                        <span style="min-width: 32px; height: 32px; padding: 0 8px; border: 1px solid #e2e8f0; border-radius: 6px; background: #f8fafc; color: #cbd5e1; display: inline-flex; align-items: center; justify-content: center; font-size: 12.5px; cursor: not-allowed;">&lsaquo;</span>
                    }

                    <!-- Ellipsis Before -->
                    @if (startPage > 1)
                    {
                        <a asp-page="./Index"
                           asp-route-Filter.PageIndex="1"
                           asp-route-Filter.PageSize="@pageSize"
                           asp-route-Filter.Keyword="@Model.Filter.Keyword"
                           asp-route-Filter.Status="@Model.Filter.Status"
                           style="min-width: 32px; height: 32px; padding: 0 8px; border: 1px solid #cbd5e1; border-radius: 6px; background: #fff; color: #334155; text-decoration: none; font-size: 12.5px; font-weight: 500; display: inline-flex; align-items: center; justify-content: center; transition: all 0.15s;">
                            1
                        </a>
                        @if (startPage > 2)
                        {
                            <span style="padding: 0 4px; color: #94a3b8; font-size: 12px;">...</span>
                        }
                    }

                    <!-- Numbered Pages -->
                    @for (int pNum = startPage; pNum <= endPage; pNum++)
                    {
                        if (pNum == currentPage)
                        {
                            <span style="min-width: 32px; height: 32px; padding: 0 8px; border-radius: 6px; background: #2563eb; color: #ffffff; border: 1px solid #2563eb; font-weight: 600; font-size: 12.5px; display: inline-flex; align-items: center; justify-content: center; box-shadow: 0 1px 2px rgba(37,99,235,0.2);">
                                @pNum
                            </span>
                        }
                        else
                        {
                            <a asp-page="./Index"
                               asp-route-Filter.PageIndex="@pNum"
                               asp-route-Filter.PageSize="@pageSize"
                               asp-route-Filter.Keyword="@Model.Filter.Keyword"
                               asp-route-Filter.Status="@Model.Filter.Status"
                               style="min-width: 32px; height: 32px; padding: 0 8px; border: 1px solid #cbd5e1; border-radius: 6px; background: #fff; color: #334155; text-decoration: none; font-size: 12.5px; font-weight: 500; display: inline-flex; align-items: center; justify-content: center; transition: all 0.15s;">
                                @pNum
                            </a>
                        }
                    }

                    <!-- Ellipsis After -->
                    @if (endPage < totalPages)
                    {
                        @if (endPage < totalPages - 1)
                        {
                            <span style="padding: 0 4px; color: #94a3b8; font-size: 12px;">...</span>
                        }
                        <a asp-page="./Index"
                           asp-route-Filter.PageIndex="@totalPages"
                           asp-route-Filter.PageSize="@pageSize"
                           asp-route-Filter.Keyword="@Model.Filter.Keyword"
                           asp-route-Filter.Status="@Model.Filter.Status"
                           style="min-width: 32px; height: 32px; padding: 0 8px; border: 1px solid #cbd5e1; border-radius: 6px; background: #fff; color: #334155; text-decoration: none; font-size: 12.5px; font-weight: 500; display: inline-flex; align-items: center; justify-content: center; transition: all 0.15s;">
                            @totalPages
                        </a>
                    }

                    <!-- Next & Last -->
                    @if (currentPage < totalPages)
                    {
                        <a asp-page="./Index"
                           asp-route-Filter.PageIndex="@(currentPage + 1)"
                           asp-route-Filter.PageSize="@pageSize"
                           asp-route-Filter.Keyword="@Model.Filter.Keyword"
                           asp-route-Filter.Status="@Model.Filter.Status"
                           title="Trang sau"
                           style="min-width: 32px; height: 32px; padding: 0 8px; border: 1px solid #cbd5e1; border-radius: 6px; background: #fff; color: #334155; text-decoration: none; font-size: 12.5px; font-weight: 500; display: inline-flex; align-items: center; justify-content: center; transition: all 0.15s;">
                            &rsaquo;
                        </a>
                        <a asp-page="./Index"
                           asp-route-Filter.PageIndex="@totalPages"
                           asp-route-Filter.PageSize="@pageSize"
                           asp-route-Filter.Keyword="@Model.Filter.Keyword"
                           asp-route-Filter.Status="@Model.Filter.Status"
                           title="Trang cuối"
                           style="min-width: 32px; height: 32px; padding: 0 8px; border: 1px solid #cbd5e1; border-radius: 6px; background: #fff; color: #334155; text-decoration: none; font-size: 12.5px; font-weight: 500; display: inline-flex; align-items: center; justify-content: center; transition: all 0.15s;">
                            &raquo;
                        </a>
                    }
                    else
                    {
                        <span style="min-width: 32px; height: 32px; padding: 0 8px; border: 1px solid #e2e8f0; border-radius: 6px; background: #f8fafc; color: #cbd5e1; display: inline-flex; align-items: center; justify-content: center; font-size: 12.5px; cursor: not-allowed;">&rsaquo;</span>
                        <span style="min-width: 32px; height: 32px; padding: 0 8px; border: 1px solid #e2e8f0; border-radius: 6px; background: #f8fafc; color: #cbd5e1; display: inline-flex; align-items: center; justify-content: center; font-size: 12.5px; cursor: not-allowed;">&raquo;</span>
                    }
                </div>
            }
        </div>
    </div>
</div>

<script>
    function changeSupplierPageSize(size) {
        document.getElementById('supplierPageSizeInput').value = size;
        document.getElementById('supplierFilterForm').submit();
    }
</script>
