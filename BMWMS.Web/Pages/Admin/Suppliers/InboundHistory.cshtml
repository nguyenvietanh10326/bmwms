@page "/Admin/Suppliers/{supplierCode}/InboundHistory"
@model BMWMS.Web.Pages.Admin.Suppliers.InboundHistoryModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Xem lịch sử nhập theo nhà cung cấp";
    ViewData["ActiveMenu"] = "Suppliers";
}

<style>
    .premium-header {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        border-radius: 12px;
        padding: 32px;
        color: white;
        margin-bottom: 24px;
        box-shadow: 0 10px 15px -3px rgba(15, 23, 42, 0.3);
        position: relative;
        overflow: hidden;
    }
    .premium-header::after {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 300px;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.05));
        transform: skewX(-20deg) translateX(100px);
    }
    .premium-breadcrumb a { color: #94a3b8; text-decoration: none; transition: color 0.2s; }
    .premium-breadcrumb a:hover { color: white; }
    .premium-breadcrumb .active { color: #cbd5e1; }
    
    .premium-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        border: 1px solid #f1f5f9;
        padding: 24px;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .premium-card:hover {
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -2px rgba(0, 0, 0, 0.04);
    }
    
    .premium-input {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        height: 44px;
        transition: all 0.2s;
        box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.02);
    }
    .premium-input:focus {
        background-color: white;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }
    
    .premium-btn-primary {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        border: none;
        border-radius: 8px;
        color: white;
        font-weight: 500;
        height: 44px;
        padding: 0 24px;
        transition: all 0.2s;
        box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.2);
    }
    .premium-btn-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 8px -1px rgba(37, 99, 235, 0.3);
    }
    
    .premium-btn-outline {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        color: #475569;
        font-weight: 500;
        height: 44px;
        padding: 0 24px;
        transition: all 0.2s;
        text-decoration: none;
    }
    .premium-btn-outline:hover {
        background: #f8fafc;
        border-color: #cbd5e1;
        color: #1e293b;
    }
    
    .premium-table { border-collapse: separate; border-spacing: 0; width: 100%; min-width: 1000px; }
    .premium-table th {
        background: #f8fafc;
        color: #475569;
        font-weight: 600;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 16px;
        border-bottom: 2px solid #e2e8f0;
    }
    .premium-table td {
        padding: 16px;
        color: #334155;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
        transition: background-color 0.2s;
    }
    .premium-table tbody tr:hover td { background-color: #f8fafc; }
    
    .badge-premium { padding: 6px 12px; border-radius: 20px; font-weight: 600; font-size: 12px; display: inline-flex; align-items: center; gap: 6px; }
    .badge-success-premium { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
    .badge-warning-premium { background: #fef9c3; color: #854d0e; border: 1px solid #fef08a; }
    .badge-secondary-premium { background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }
    .badge-danger-premium { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
    
    .status-dot { width: 6px; height: 6px; border-radius: 50%; }
    .bg-green-500 { background-color: #22c55e; }
    .bg-yellow-500 { background-color: #eab308; }
    .bg-gray-500 { background-color: #64748b; }
    .bg-red-500 { background-color: #ef4444; }
    
    .action-link {
        color: #3b82f6;
        font-weight: 500;
        text-decoration: none;
        padding: 6px 12px;
        border-radius: 6px;
        transition: all 0.2s;
    }
    .action-link:hover { background: #eff6ff; color: #1d4ed8; }

    /* Modal styling */
    .modal-content.premium { border: none; border-radius: 16px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); overflow: hidden; }
    .modal-header.premium { background: #f8fafc; border-bottom: 1px solid #e2e8f0; padding: 20px 24px; }
    .modal-title.premium { font-weight: 600; color: #0f172a; margin: 0; }
    .modal-body.premium { padding: 24px; }
    .modal-footer.premium { border-top: 1px solid #e2e8f0; padding: 16px 24px; background: #f8fafc; }
</style>

<div class="premium-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb premium-breadcrumb mb-2" style="font-size: 14px;">
                    <li class="breadcrumb-item"><a href="/Admin/Suppliers">Nhà cung cấp</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Lịch sử nhập hàng</li>
                </ol>
            </nav>
            <h2 class="mb-1" style="font-weight: 700; font-size: 28px;">Lịch sử nhập hàng</h2>
            <p class="mb-0" style="color: #94a3b8; font-size: 15px;">
                <i class="ri-user-3-line align-bottom me-1"></i> Actor chính: @(HttpContext.Session.GetString("RoleName") ?? "Nhân viên mua hàng")
            </p>
        </div>
    </div>
</div>

<div class="premium-card">
    <!-- Filter Form -->
    <form method="get" style="display: flex; gap: 16px; margin-bottom: 24px; flex-wrap: wrap; align-items: flex-end;">
        <div style="flex: 2; min-width: 300px; position: relative;">
            <label class="form-label text-muted mb-2" style="font-size: 13px; font-weight: 500;">Từ khóa tìm kiếm</label>
            <i class="ri-search-line" style="position: absolute; left: 16px; bottom: 13px; color: #94a3b8; font-size: 18px;"></i>
            <input type="text" name="Keyword" value="@Model.Filter.Keyword" class="form-control premium-input" placeholder="Tìm lệnh nhập hoặc PO" style="padding-left: 44px;">
        </div>
        
        <div style="flex: 1; min-width: 200px;">
            <label class="form-label text-muted mb-2" style="font-size: 13px; font-weight: 500;">Trạng thái</label>
            <select name="Status" class="form-select premium-input">
                <option value="">Tất cả trạng thái</option>
                <option value="COMPLETED" selected="@(Model.Filter.Status == "COMPLETED")">Đã nhận</option>
                <option value="IN_PROGRESS" selected="@(Model.Filter.Status == "IN_PROGRESS")">Đang kiểm nhận</option>
                <option value="ASSIGNED" selected="@(Model.Filter.Status == "ASSIGNED")">Đã phân công</option>
                <option value="DRAFT" selected="@(Model.Filter.Status == "DRAFT")">Nháp</option>
                <option value="CANCELLED" selected="@(Model.Filter.Status == "CANCELLED")">Đã hủy</option>
            </select>
        </div>

        <div style="flex: 1; min-width: 200px;">
            <label class="form-label text-muted mb-2" style="font-size: 13px; font-weight: 500;">Kho nhận</label>
            <select name="WarehouseId" class="form-select premium-input" asp-items="Model.WarehouseOptions">
                <option value="">Tất cả kho</option>
            </select>
        </div>

        <div style="display: flex; gap: 12px;">
            <button type="submit" class="premium-btn-primary d-inline-flex align-items-center">
                <i class="ri-filter-3-line me-1"></i> Lọc
            </button>
            <a href="/Admin/Suppliers/@Model.SupplierCode/InboundHistory" class="premium-btn-outline d-inline-flex align-items-center">
                <i class="ri-refresh-line me-1"></i> Đặt lại
            </a>
        </div>
    </form>

    <!-- Data Table -->
    <div style="overflow-x: auto; border: 1px solid #e2e8f0; border-radius: 8px;">
        <table class="premium-table">
            <thead>
                <tr>
                    <th>Mã lệnh</th>
                    <th>Purchase Order</th>
                    <th>Nhà cung cấp</th>
                    <th>Kho nhận</th>
                    <th style="text-align: center;">Trạng thái</th>
                    <th style="text-align: right;">Tổng SL</th>
                    <th style="text-align: center;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Inbounds != null && Model.Inbounds.Any())
                {
                    foreach (var item in Model.Inbounds)
                    {
                        <tr>
                            <td style="font-weight: 600; color: #0f172a;">@item.InboundOrderNumber</td>
                            <td><span style="background: #f1f5f9; padding: 4px 8px; border-radius: 4px; font-family: monospace; font-size: 13px;">@item.PurchaseOrderNumber</span></td>
                            <td style="font-weight: 500;">@item.SupplierName</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div style="width: 28px; height: 28px; border-radius: 6px; background: #eff6ff; color: #3b82f6; display: flex; align-items: center; justify-content: center; margin-right: 8px;">
                                        <i class="ri-store-2-line"></i>
                                    </div>
                                    @item.WarehouseName
                                </div>
                            </td>
                            <td style="text-align: center;">
                                @if (item.Status == "COMPLETED")
                                {
                                    <span class="badge-premium badge-success-premium"><span class="status-dot bg-green-500"></span> Đã nhận</span>
                                }
                                else if (item.Status == "IN_PROGRESS" || item.Status == "ASSIGNED")
                                {
                                    <span class="badge-premium badge-warning-premium"><span class="status-dot bg-yellow-500"></span> Đang kiểm nhận</span>
                                }
                                else if (item.Status == "DRAFT")
                                {
                                    <span class="badge-premium badge-secondary-premium"><span class="status-dot bg-gray-500"></span> Nháp</span>
                                }
                                else if (item.Status == "CANCELLED")
                                {
                                    <span class="badge-premium badge-danger-premium"><span class="status-dot bg-red-500"></span> Đã hủy</span>
                                }
                                else
                                {
                                    <span class="badge-premium badge-secondary-premium">@item.Status</span>
                                }
                            </td>
                            <td style="text-align: right; font-weight: 600; font-variant-numeric: tabular-nums;">
                                @item.TotalQuantity.ToString("N0")
                            </td>
                            <td style="text-align: center;">
                                <a href="javascript:void(0)" onclick="viewInboundDetail('@item.InboundOrderNumber')" class="action-link d-inline-flex align-items-center">
                                    <i class="ri-eye-line me-1"></i>Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center" style="padding: 48px 24px;">
                            <div style="width: 64px; height: 64px; background: #f8fafc; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; color: #cbd5e1;">
                                <i class="ri-inbox-archive-line" style="font-size: 32px;"></i>
                            </div>
                            <h5 style="color: #475569; font-weight: 600;">Không có dữ liệu</h5>
                            <p style="color: #94a3b8; margin-bottom: 0;">Không tìm thấy lịch sử nhập hàng nào khớp với điều kiện lọc.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-4">
            <span class="text-muted" style="font-size: 14px; font-weight: 500;">
                Hiển thị <span class="text-dark">@(((Model.Filter.PageIndex - 1) * Model.Filter.PageSize) + 1)-@(Math.Min(Model.Filter.PageIndex * Model.Filter.PageSize, Model.TotalCount))</span> trong tổng số <span class="text-dark">@Model.TotalCount</span>
            </span>
            <ul class="pagination mb-0" style="gap: 4px;">
                <li class="page-item @(Model.Filter.PageIndex == 1 ? "disabled" : "")">
                    <a class="page-link" style="border-radius: 8px; border: none; background: #f1f5f9; color: #475569; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;" href="?Keyword=@Model.Filter.Keyword&Status=@Model.Filter.Status&WarehouseId=@Model.Filter.WarehouseId&PageIndex=@(Model.Filter.PageIndex - 1)">
                        <i class="ri-arrow-left-s-line"></i>
                    </a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Filter.PageIndex ? "active" : "")">
                        <a class="page-link text-decoration-none" style="@(i == Model.Filter.PageIndex ? "border-radius: 8px; background: #3b82f6; border-color: #3b82f6; color: white; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; font-weight: 600;" : "border-radius: 8px; border: none; background: transparent; color: #475569; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;")" href="?Keyword=@Model.Filter.Keyword&Status=@Model.Filter.Status&WarehouseId=@Model.Filter.WarehouseId&PageIndex=@i">@i</a>
                    </li>
                }
                <li class="page-item @(Model.Filter.PageIndex == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" style="border-radius: 8px; border: none; background: #f1f5f9; color: #475569; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;" href="?Keyword=@Model.Filter.Keyword&Status=@Model.Filter.Status&WarehouseId=@Model.Filter.WarehouseId&PageIndex=@(Model.Filter.PageIndex + 1)">
                        <i class="ri-arrow-right-s-line"></i>
                    </a>
                </li>
            </ul>
        </div>
    }
</div>

<!-- Modal Chi tiết Lệnh nhập -->
<div class="modal fade" id="inboundDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content premium">
            <div class="modal-header premium">
                <h5 class="modal-title premium">
                    <div class="d-flex align-items-center">
                        <div style="width: 32px; height: 32px; border-radius: 8px; background: #eff6ff; color: #3b82f6; display: flex; align-items: center; justify-content: center; margin-right: 12px;">
                            <i class="ri-file-list-3-line"></i>
                        </div>
                        Chi tiết Lệnh nhập kho
                    </div>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body premium" id="inboundDetailContent">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-3 mb-0">Đang tải dữ liệu...</p>
                </div>
            </div>
            <div class="modal-footer premium">
                <button type="button" class="premium-btn-outline" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function viewInboundDetail(orderNumber) {
            var modalEl = document.getElementById('inboundDetailModal');
            var modal = new bootstrap.Modal(modalEl);
            document.getElementById('inboundDetailContent').innerHTML = `
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-3 mb-0">Đang tải dữ liệu...</p>
                </div>
            `;
            modal.show();

            fetch(`?handler=Detail&orderNumber=${orderNumber}`)
                .then(response => {
                    if (!response.ok) throw new Error("Network response was not ok");
                    return response.json();
                })
                .then(data => {
                    renderInboundDetail(data);
                })
                .catch(error => {
                    console.error('Error fetching detail:', error);
                    document.getElementById('inboundDetailContent').innerHTML = `
                        <div class="alert alert-danger d-flex align-items-center" role="alert">
                            <i class="ri-error-warning-line me-2 fs-4"></i>
                            <div>Có lỗi xảy ra khi lấy dữ liệu chi tiết.</div>
                        </div>
                    `;
                });
        }

        function renderInboundDetail(data) {
            const getStatusBadge = (status) => {
                if (status === "COMPLETED") return `<span class="badge-premium badge-success-premium"><span class="status-dot bg-green-500"></span> Đã nhận</span>`;
                if (status === "IN_PROGRESS") return `<span class="badge-premium badge-warning-premium"><span class="status-dot bg-yellow-500"></span> Đang kiểm nhận</span>`;
                if (status === "ASSIGNED") return `<span class="badge-premium badge-warning-premium"><span class="status-dot bg-yellow-500"></span> Sẵn sàng nhận</span>`;
                if (status === "DRAFT") return `<span class="badge-premium badge-secondary-premium"><span class="status-dot bg-gray-500"></span> Nháp</span>`;
                if (status === "CANCELLED") return `<span class="badge-premium badge-danger-premium"><span class="status-dot bg-red-500"></span> Đã hủy</span>`;
                return `<span class="badge-premium badge-secondary-premium">${status}</span>`;
            };

            const formatDate = (dateStr) => {
                if (!dateStr) return '---';
                const d = new Date(dateStr);
                return d.toLocaleDateString('vi-VN', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });
            };

            let itemsHtml = '';
            if (data.items && data.items.length > 0) {
                data.items.forEach(item => {
                    itemsHtml += `
                        <tr>
                            <td style="font-weight: 500;">
                                <span style="background: #f1f5f9; padding: 2px 6px; border-radius: 4px; font-family: monospace; font-size: 12px; margin-right: 8px;">${item.productCode}</span>
                            </td>
                            <td style="font-weight: 500; color: #0f172a;">${item.productName}</td>
                            <td><span class="badge bg-light text-dark border">${item.unitName}</span></td>
                            <td class="text-end font-monospace">${item.expectedQuantity.toLocaleString()}</td>
                            <td class="text-end font-monospace fw-bold text-primary">${item.receivedQuantity.toLocaleString()}</td>
                        </tr>
                    `;
                });
            } else {
                itemsHtml = `<tr><td colspan="5" class="text-center py-4 text-muted"><i class="ri-inbox-line fs-3 d-block mb-2 text-light"></i>Không có mặt hàng nào.</td></tr>`;
            }

            const html = `
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div style="background: #f8fafc; border-radius: 12px; padding: 16px; height: 100%; border: 1px solid #e2e8f0;">
                            <h6 style="color: #64748b; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px;">Thông tin Lệnh nhập</h6>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Mã lệnh:</span>
                                <strong class="text-primary">${data.inboundOrderNumber}</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Trạng thái:</span>
                                <div>${getStatusBadge(data.status)}</div>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Ngày tạo:</span>
                                <strong>${formatDate(data.createdAt)}</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div style="background: #f8fafc; border-radius: 12px; padding: 16px; height: 100%; border: 1px solid #e2e8f0;">
                            <h6 style="color: #64748b; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px;">Thông tin Nguồn</h6>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Purchase Order:</span>
                                <strong style="font-family: monospace; font-size: 14px;">${data.purchaseOrderNumber || '---'}</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Nhà cung cấp:</span>
                                <strong>${data.supplierName}</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Kho nhận:</span>
                                <strong>${data.warehouseName || '---'}</strong>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div style="border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden;">
                    <div style="background: #f8fafc; padding: 12px 16px; border-bottom: 1px solid #e2e8f0;">
                        <h6 class="mb-0" style="color: #334155; font-weight: 600;"><i class="ri-box-3-line me-2 text-primary"></i>Danh sách mặt hàng</h6>
                    </div>
                    <div class="table-responsive mb-0">
                        <table class="table table-hover mb-0 premium-table">
                            <thead>
                                <tr>
                                    <th style="font-size: 12px;">Mã SP</th>
                                    <th style="font-size: 12px;">Tên Sản phẩm</th>
                                    <th style="font-size: 12px;">ĐVT</th>
                                    <th class="text-end" style="font-size: 12px;">SL Dự kiến</th>
                                    <th class="text-end" style="font-size: 12px;">SL Thực nhận</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${itemsHtml}
                            </tbody>
                        </table>
                    </div>
                </div>
            `;
            
            document.getElementById('inboundDetailContent').innerHTML = html;
        }
    </script>
}
