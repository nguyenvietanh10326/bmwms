@page "{supplierCode}"
@model BMWMS.Web.Pages.Admin.Suppliers.EditModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chỉnh sửa nhà cung cấp";
    ViewData["HeaderTitle"] = HttpContext.Session.GetString("RoleName") ?? "Nhân viên mua hàng";
    ViewData["FooterVersion"] = "Full coverage · UC01-UC63";
}

<div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
    <div>
        <div class="page-header-title">Chỉnh sửa nhà cung cấp</div>
        <div class="page-header-sub">Cập nhật thông tin được phép của nhà cung cấp &middot; Actor chính: @(HttpContext.Session.GetString("RoleName") ?? "Nhân viên mua hàng")</div>
    </div>
    <div style="font-size: 16px; color: var(--text-main);">
        @if (Model.Input.Status == "ACTIVE")
        {
            <span>Đang hoạt động</span>
        }
        else
        {
            <span>Tạm ngừng</span>
        }
    </div>
</div>

@if (!ModelState.IsValid)
{
    <div style="background-color: #fef2f2; border: 1px solid #fecaca; color: #ef4444; padding: 16px; border-radius: 6px; margin-bottom: 24px;">
        <div style="font-weight: 600; margin-bottom: 8px;">Đã có lỗi xảy ra:</div>
        <div asp-validation-summary="All" style="margin: 0; padding-left: 20px;"></div>
    </div>
}

<form method="post">
    <div class="form-card" style="padding: 24px; margin-bottom: 24px;">
        <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 16px; color: var(--text-main);">Thông tin nhà cung cấp</h3>
        
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-bottom: 24px;">
            <div>
                <label style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 8px; color: var(--text-main);">Mã nhà cung cấp *</label>
                <input type="text" asp-for="Input.SupplierCode" class="form-control" style="width: 100%; box-sizing: border-box; padding: 10px 12px;" />
            </div>
            <div>
                <label style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 8px; color: var(--text-main);">Tên nhà cung cấp *</label>
                <input type="text" asp-for="Input.SupplierName" class="form-control" style="width: 100%; box-sizing: border-box; padding: 10px 12px;" />
            </div>
            <div>
                <label style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 8px; color: var(--text-main);">Mã số thuế *</label>
                <input type="text" asp-for="Input.TaxCode" class="form-control" style="width: 100%; box-sizing: border-box; padding: 10px 12px;" />
            </div>
            <div>
                <label style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 8px; color: var(--text-main);">Số điện thoại *</label>
                <input type="text" asp-for="Input.PhoneNumber" class="form-control" style="width: 100%; box-sizing: border-box; padding: 10px 12px;" />
            </div>

            <div>
                <label style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 8px; color: var(--text-main);">Email</label>
                <input type="text" asp-for="Input.Email" class="form-control" style="width: 100%; box-sizing: border-box; padding: 10px 12px;" />
            </div>
            <div>
                <label style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 8px; color: var(--text-main);">Địa chỉ *</label>
                <input type="text" asp-for="Input.Address" class="form-control" style="width: 100%; box-sizing: border-box; padding: 10px 12px;" />
            </div>
            <div>
                <label style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 8px; color: var(--text-main);">Người liên hệ *</label>
                <input type="text" asp-for="Input.RepresentativeName" class="form-control" style="width: 100%; box-sizing: border-box; padding: 10px 12px;" />
            </div>
            <div>
                <label style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 8px; color: var(--text-main);">Trạng thái</label>
                <select asp-for="Input.Status" class="form-control" style="width: 100%; box-sizing: border-box; padding: 10px 12px;">
                    <option value="ACTIVE">Đang hoạt động</option>
                    <option value="INACTIVE">Tạm ngừng</option>
                </select>
            </div>
        </div>
    </div>

    <div class="form-card" style="padding: 24px; margin-bottom: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <h3 style="font-size: 16px; font-weight: 600; color: var(--text-main); margin: 0;">Danh mục vật tư cung ứng</h3>
        </div>

        <div style="overflow-x: auto; margin-bottom: 24px; max-height: 400px;">
            <table class="table" style="width: 100%; min-width: 800px; border-collapse: collapse;">
                <thead>
                    <tr style="border-bottom: 1px solid var(--border-color); position: sticky; top: 0; background: white;">
                        <th style="width: 40px; text-align: left; padding: 12px 0;"></th>
                        <th style="text-align: left; padding: 12px 0; color: var(--text-muted); font-size: 13px; font-weight: 500;">Mã SP</th>
                        <th style="text-align: left; padding: 12px 0; color: var(--text-muted); font-size: 13px; font-weight: 500;">Sản phẩm</th>
                        <th style="text-align: left; padding: 12px 0; color: var(--text-muted); font-size: 13px; font-weight: 500;">Nhóm</th>
                        <th style="text-align: left; padding: 12px 0; color: var(--text-muted); font-size: 13px; font-weight: 500;">Đơn vị tính</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.AllProducts != null && Model.AllProducts.Any())
                    {
                        @foreach (var p in Model.AllProducts)
                        {
                            bool isSelected = Model.SelectedProductIds.Contains(p.ProductId);
                            <tr style="border-bottom: 1px solid #f4f4f5;">
                                <td style="padding: 16px 0;">
                                    <input type="checkbox" name="SelectedProductIds" value="@p.ProductId" @(isSelected ? "checked" : "") style="width: 16px; height: 16px; accent-color: #27272a;" />
                                </td>
                                <td style="padding: 16px 0; color: #2563eb; font-size: 14px;">@p.ProductCode</td>
                                <td style="padding: 16px 0; color: var(--text-main); font-size: 14px;">@p.ProductName</td>
                                <td style="padding: 16px 0; color: var(--text-muted); font-size: 14px;">@p.GroupName</td>
                                <td style="padding: 16px 0; color: var(--text-muted); font-size: 14px;">@p.UnitName</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="text-align: center; padding: 24px; color: var(--text-muted);">
                                Hệ thống chưa có vật tư nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div style="background-color: #faf5ff; border: 1px solid #e9d5ff; border-radius: 6px; padding: 16px; margin-bottom: 24px; display: flex; align-items: center; gap: 12px; color: #7e22ce; font-size: 14px;">
        <div style="width: 8px; height: 8px; background-color: #a855f7; border-radius: 50%;"></div>
        Nhà cung cấp là dữ liệu danh mục; lịch sử nhập được liên kết qua đơn mua và lệnh nhập kho. 
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 12px;">
        <a href="/Admin/Suppliers/Detail/@RouteData.Values["supplierCode"]" class="btn" style="padding: 10px 24px; color: var(--text-main); text-decoration: none; font-weight: 500;">Hủy</a>
        <button type="button" class="btn" style="background-color: #e4e4e7; color: #a1a1aa; border: 1px solid #d4d4d8; padding: 10px 24px; border-radius: 6px; font-weight: 500; cursor: not-allowed;" disabled>Lưu nháp</button>
        <button type="submit" class="btn btn-primary" style="background-color: #27272a; color: white; border: none; padding: 10px 24px; border-radius: 6px; font-weight: 500;">Lưu thay đổi</button>
    </div>
</form>
