@page "{id:long}"
@model BMWMS.Web.Pages.Admin.Inbound.DetailsModel
@using BMWMS.Web.Helpers
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Chi tiết phiếu nhập {Model.Order.InboundOrderNumber}";
    var isReturn = Model.Order.SourceType == "SALES_RETURN";
    var isAssignedStaff = User.IsInRole("WAREHOUSE_STAFF") &&
        long.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var currentUserId) &&
        Model.Order.AssignedToUserId == currentUserId;
    var hasPendingPutaway = Model.Order.Items.Any(item => item.Receipts.Any(receipt =>
        receipt.ConditionStatus == "GOOD" && receipt.PutawayQuantity < receipt.ReceivedQuantity));
}

<div class="container-fluid py-4">
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div><div class="text-muted">Chi tiết phiếu nhập kho</div><h3>@Model.Order.InboundOrderNumber</h3></div>
        <div class="d-flex gap-2">
            @if (isReturn && isAssignedStaff && Model.Order.Status == "READY")
            {
                <form method="post" asp-page-handler="StartReturn" asp-route-id="@Model.Order.InboundOrderId"><button class="btn btn-primary">Bắt đầu nhận hàng trả</button></form>
            }
            @if (isReturn && isAssignedStaff && Model.Order.Status == "RECEIVING")
            {
                <a asp-page="./ReturnReceipt" asp-route-id="@Model.Order.InboundOrderId" class="btn btn-primary">Ghi nhận thực nhận</a>
            }
            @if (isAssignedStaff && hasPendingPutaway && Model.Order.Status == "RECEIVED")
            {
                <a asp-page="./Putaway" asp-route-id="@Model.Order.InboundOrderId" class="btn btn-primary">Cất hàng vào vị trí</a>
            }
            <a asp-page="./Index" class="btn btn-outline-secondary">Danh sách phiếu nhập</a>
            @if (Model.Order.ReturnRequestId.HasValue) { <a asp-page="/CustomerReturns/Details" asp-route-id="@Model.Order.ReturnRequestId" class="btn btn-outline-secondary">Yêu cầu trả hàng</a> }
        </div>
    </div>


    @if (isReturn)
    {
        <div class="alert alert-warning">
            Phiếu này chỉ ghi nhận hàng khách trả đủ điều kiện nhập lại kho. Hàng không đạt được xử lý ngoài luồng nhập kho và không được cộng tồn.
        </div>
    }

    <div class="card border-0 shadow-sm mb-3"><div class="card-body row g-3">
        <div class="col-md-3"><div class="text-muted small">Trạng thái</div><strong>@StatusLabel(Model.Order.Status)</strong></div>
        <div class="col-md-3"><div class="text-muted small">Đơn tham chiếu</div><strong>@Model.Order.SourceReference</strong></div>
        <div class="col-md-3"><div class="text-muted small">Đối tác</div><strong>@Model.Order.PartnerName</strong></div>
        <div class="col-md-3"><div class="text-muted small">@(isReturn && Model.Order.Status is "READY" or "RECEIVING" ? "Ngày dự kiến nhận trả" : "Ngày nhận thực tế")</div><span>@Model.Order.ExpectedReceiptDate.ToString("dd/MM/yyyy")</span></div>
        <div class="col-md-3"><div class="text-muted small">Nhân viên thực hiện</div><span>@(string.IsNullOrWhiteSpace(Model.Order.AssignedToUserName) ? "Không xác định" : Model.Order.AssignedToUserName)</span></div>
        @if (isReturn) { <div class="col-md-3"><div class="text-muted small">Người duyệt nhận trả</div><span>@(Model.Order.ApprovedByUserName ?? "Chưa ghi nhận duyệt của Quản lý")</span></div> }
        <div class="col-12"><div class="text-muted small">@(isReturn ? "Lý do và căn cứ nhận hàng trả" : "Ghi chú phiếu")</div><span>@(string.IsNullOrWhiteSpace(Model.Order.Notes) ? "Không có" : Model.Order.Notes)</span></div>
        @if (!string.IsNullOrWhiteSpace(Model.Order.CancellationReason)) { <div class="col-12"><div class="text-muted small">Lý do hủy</div><strong class="text-danger">@Model.Order.CancellationReason</strong></div> }
    </div></div>

    @if (isReturn && (User.IsInRole("WAREHOUSE_MANAGER") || User.IsInRole("SYSTEM_ADMIN")) &&
        Model.Order.Status is "READY" or "RECEIVING" && Model.Order.Items.All(item => item.ReceivedQuantity == 0))
    {
        <form method="post" asp-page-handler="Cancel" asp-route-id="@Model.Order.InboundOrderId" class="d-flex gap-2 mb-3"
              onsubmit="return confirm('Hủy lệnh chưa nhận hàng và giải phóng nhân viên đang phụ trách?');">
            <input name="reason" class="form-control" required maxlength="500" placeholder="Lý do hủy lệnh nhận trả" />
            <button class="btn btn-outline-danger text-nowrap">Hủy lệnh nhận trả</button>
        </form>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h4 class="h6 mb-1">Mặt hàng trong đợt nhập</h4><div class="text-muted small">Đối chiếu số theo đơn, số thực nhận và vị trí cất của từng mặt hàng.</div></div>
    </div>

    @foreach (var item in Model.Order.Items)
    {
        <div class="card border-0 shadow-sm mb-3"><div class="card-header bg-white d-flex justify-content-between"><span><strong>@item.ProductName</strong> <span class="text-muted">(@item.ProductCode)</span></span><span>@item.UnitName</span></div>
        <div class="card-body">
            <div class="row g-3 mb-3">
                <div class="col"><div class="text-muted small">@(isReturn ? "Số lượng được duyệt" : "Còn phải nhận trước đợt")</div><strong>@FormatQuantity(item.ExpectedQuantity, item.QuantityScale) @item.UnitName</strong></div>
                <div class="col"><div class="text-muted small">Thực nhận đợt này</div><strong class="text-success">@FormatQuantity(item.ReceivedQuantity, item.QuantityScale) @item.UnitName</strong></div>
                <div class="col"><div class="text-muted small">Đã cất vào vị trí</div><strong class="text-success">@FormatQuantity(item.PutawayQuantity, item.QuantityScale) @item.UnitName</strong></div>
                <div class="col"><div class="text-muted small">Chưa nhận</div><strong class="text-warning">@FormatQuantity(Math.Max(0, item.ExpectedQuantity - item.ReceivedQuantity), item.QuantityScale) @item.UnitName</strong></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(item.Notes))
            {
                <div class="alert alert-warning py-2"><strong>Ghi chú mặt hàng:</strong><div style="white-space:pre-line">@item.Notes</div></div>
            }

            @if (item.Receipts.Count > 0)
            {
                <div class="table-responsive mb-3"><table class="table table-sm align-middle"><thead><tr><th>Ngày sản xuất</th><th>Hạn sử dụng</th><th>Vị trí cất</th><th>Người ghi nhận</th><th class="text-end">Thực nhận</th><th class="text-end">Đã cất</th></tr></thead><tbody>
                @foreach (var receipt in item.Receipts)
                {
                    var locationPath = LocationPath(receipt);
                    <tr><td>@(receipt.ManufactureDate?.ToString("dd/MM/yyyy") ?? "Không áp dụng")</td><td>@(receipt.ExpiryDate?.ToString("dd/MM/yyyy") ?? "Không áp dụng")</td><td><strong>@(string.IsNullOrWhiteSpace(locationPath) ? "Chưa cất" : locationPath)</strong><div class="text-muted small">@(receipt.PutawayAt.HasValue ? $"Cất bởi {receipt.PutawayByUserName} lúc {receipt.PutawayAt:dd/MM/yyyy HH:mm}" : "Đang chờ xác nhận vị trí")</div></td><td>@receipt.RecordedByUserName<div class="text-muted small">@receipt.RecordedAt.ToString("dd/MM/yyyy HH:mm")</div></td><td class="text-end">@FormatQuantity(receipt.ReceivedQuantity, item.QuantityScale) @item.UnitName</td><td class="text-end">@FormatQuantity(receipt.PutawayQuantity, item.QuantityScale) @item.UnitName</td></tr>
                }
                </tbody></table></div>
            }

        </div></div>
    }

    @if (Model.Order.Timeline.Count > 0)
    {
        <div class="card border-0 shadow-sm mt-3">
            <div class="card-header bg-white"><strong>Lịch sử trạng thái</strong></div>
            <div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Thời gian</th><th>Sự kiện</th><th>Trạng thái sau sự kiện</th><th>Người thực hiện</th></tr></thead><tbody>
            @foreach (var entry in Model.Order.Timeline)
            {
                <tr><td>@entry.EventTime.ToString("dd/MM/yyyy HH:mm")</td><td>@entry.EventName</td><td>@StatusLabel(entry.StatusBadge)</td><td>@entry.PerformedBy</td></tr>
            }
            </tbody></table></div>
        </div>
    }
</div>

@functions {
    string StatusLabel(string status) => status switch { "DRAFT" => "Chưa ghi nhận thực nhận", "READY" => "Chờ nhận hàng", "RECEIVING" => "Đang ghi nhận thực nhận", "RECEIVED" => "Chờ cất hàng", "PUTAWAY_COMPLETED" => "Đã hoàn tất nhập kho", "CANCELLED" => "Đã hủy", _ => status };
    string FormatQuantity(decimal value, byte scale) => FormatHelper.FormatQuantity(value, scale);
    string LocationPath(BMWMS.Web.Models.InboundReceiptDto receipt) => string.Join(" / ",
        new[] { receipt.ZoneCode, receipt.RackCode, receipt.LocationCode }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
