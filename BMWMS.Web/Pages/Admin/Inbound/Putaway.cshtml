@page "{id:long}"
@model BMWMS.Web.Pages.Admin.Inbound.PutawayModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Xếp hàng vào vị trí kho";
    var remaining = Model.Receipt.ReceivedQuantity - Model.Receipt.PutawayQuantity;
}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div><div class="text-muted">Putaway theo vị trí cố định</div><h3>@Model.Order.InboundOrderNumber</h3></div>
        <a asp-page="./Details" asp-route-id="@Model.Order.InboundOrderId" class="btn btn-outline-secondary">Quay lại phiếu nhập</a>
    </div>
    <div class="alert alert-info">Chỉ hiển thị bin cố định đang hoạt động của sản phẩm. Khi lưu, hệ thống ghi bút toán INBOUND và tăng tồn tại từng bin.</div>
    @if (!Model.Locations.Any()) { <div class="alert alert-danger">Sản phẩm chưa có vị trí cố định hợp lệ. Hãy cấu hình ProductFixedLocation trước khi putaway.</div> }
    <div class="card border-0 shadow-sm"><div class="card-header bg-white"><strong>@Model.Item.ProductName</strong> (@Model.Item.ProductCode) · @(Model.Item.TrackLot ? $"Lô {Model.Receipt.LotNumber}" : "Hàng lẻ") · Còn xếp @FormatQuantity(remaining, Model.Item.QuantityScale)</div>
        <form method="post" id="putawayForm"><div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>Vị trí cố định</th><th style="width:220px">Số lượng xếp</th><th style="width:100px"></th></tr></thead><tbody id="rows">
            <tr>
                <td><input type="hidden" name="PutawayDtos[0].InboundOrderItemId" value="@Model.Item.InboundOrderItemId" /><input type="hidden" name="PutawayDtos[0].ProductLotId" value="@Model.Receipt.ProductLotId" /><select name="PutawayDtos[0].StorageLocationId" asp-items="Model.Locations" class="form-select location" required><option value="">-- Chọn bin --</option></select></td>
                <td><input name="PutawayDtos[0].PutawayQuantity" type="number" min="@QuantityStep(Model.Item.QuantityScale)" max="@remaining" step="@QuantityStep(Model.Item.QuantityScale)" value="@remaining" class="form-control quantity" required /></td><td></td>
            </tr>
        </tbody></table></div>
        <div class="card-footer bg-white d-flex justify-content-between align-items-center"><div>Đã phân bổ: <strong id="assigned">@FormatQuantity(remaining, Model.Item.QuantityScale)</strong> / @FormatQuantity(remaining, Model.Item.QuantityScale)</div><div class="d-flex gap-2"><button type="button" class="btn btn-outline-primary" onclick="addRow()">Chia thêm bin</button><button class="btn btn-primary" id="save" @(!Model.Locations.Any() ? "disabled" : null)>Ghi nhận xếp vị trí</button></div></div></form>
    </div>
</div>
<script>
    const maximum = @remaining.ToString(System.Globalization.CultureInfo.InvariantCulture);
    const quantityStep = '@QuantityStep(Model.Item.QuantityScale)';
    const rows = document.getElementById('rows');
    let options = '';
    document.addEventListener('DOMContentLoaded', () => { options = document.querySelector('.location').innerHTML; recalculate(); });
    function addRow() {
        const index = rows.children.length;
        const tr = document.createElement('tr');
        tr.innerHTML = `<td><input type="hidden" name="PutawayDtos[${index}].InboundOrderItemId" value="@Model.Item.InboundOrderItemId"><input type="hidden" name="PutawayDtos[${index}].ProductLotId" value="@Model.Receipt.ProductLotId"><select name="PutawayDtos[${index}].StorageLocationId" class="form-select location" required>${options}</select></td><td><input name="PutawayDtos[${index}].PutawayQuantity" type="number" min="${quantityStep}" max="${maximum}" step="${quantityStep}" value="0" class="form-control quantity" required></td><td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove(); renameRows(); recalculate();">Xóa</button></td>`;
        rows.appendChild(tr); tr.querySelector('.quantity').addEventListener('input', recalculate); recalculate();
    }
    function renameRows() { [...rows.children].forEach((row,i) => row.querySelectorAll('[name]').forEach(x => x.name=x.name.replace(/\[\d+\]/,`[${i}]`))); }
    function recalculate() { const total=[...document.querySelectorAll('.quantity')].reduce((s,x)=>s+(Number(x.value)||0),0); document.getElementById('assigned').textContent=total.toLocaleString('vi-VN'); document.getElementById('save').disabled=total<=0||total>maximum||!document.querySelector('.location option:not([value=""])'); }
    document.addEventListener('input', e => { if(e.target.classList.contains('quantity')) recalculate(); });
</script>
@functions {
    string QuantityStep(byte scale) => scale == 0 ? "1" : "0." + new string('0', scale - 1) + "1";
    string FormatQuantity(decimal value, byte scale) => value.ToString(scale == 0 ? "N0" : $"N{scale}");
}
