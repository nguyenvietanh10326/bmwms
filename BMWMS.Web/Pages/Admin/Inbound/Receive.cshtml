@page "{id:long?}"
@model BMWMS.Web.Pages.Admin.Inbound.ReceiveModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Nhận hàng vào kho";
}
<div class="container-fluid py-4">
    <div class="mb-3"><h3 class="mb-1">Nhận và kiểm đếm hàng</h3><div class="text-muted">Ghi nhận thực giao, hàng hỏng, lô và hạn dùng; bước này chưa tăng tồn kho.</div></div>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row g-3">
        <div class="col-lg-4"><div class="card border-0 shadow-sm"><div class="card-header bg-white fw-semibold">Phiếu đang chờ nhận</div><div class="list-group list-group-flush">
            @if (Model.Data.Items.Count == 0) { <div class="p-4 text-muted text-center">Không có phiếu được phân công.</div> }
            @foreach (var item in Model.Data.Items)
            {
                <a asp-page="./Receive" asp-route-id="@item.InboundOrderId" class="list-group-item list-group-item-action @(Model.Order?.InboundOrderId == item.InboundOrderId ? "active" : "")"><div class="d-flex justify-content-between"><strong>@item.InboundOrderNumber</strong><span>@StatusLabel(item.Status)</span></div><div class="small">@(item.SourceType == "SALES_RETURN" ? "Khách trả theo SO" : "Nhập mua theo PO") · @item.SourceReference</div><div class="small">@item.TotalReceivedQuantity.ToString("N2") / @item.TotalExpectedQuantity.ToString("N2")</div></a>
            }
        </div></div></div>
        <div class="col-lg-8">
        @if (Model.Order?.InboundOrderId > 0)
        {
            <form method="post" asp-page-handler="ReceiveBatch" asp-route-id="@Model.Order.InboundOrderId" class="card border-0 shadow-sm">
                <div class="card-header bg-white"><strong>@Model.Order.InboundOrderNumber</strong><div class="text-muted small">@Model.Order.SourceReference — @Model.Order.PartnerName — @Model.Order.WarehouseName</div></div>
                <div class="card-body"><div class="alert alert-warning">Hàng hỏng sẽ chuyển vào khu cách ly và chưa tính vào tồn khả dụng. Chỉ sản phẩm có cấu hình theo dõi hạn dùng mới bắt buộc nhập hạn dùng trong tương lai.</div>
                    @{ var row = 0; }
                    @foreach (var item in Model.Order.Items.Where(i => i.ReceivedQuantity < i.ExpectedQuantity))
                    {
                        var remaining = item.ExpectedQuantity - item.ReceivedQuantity;
                        <div class="border rounded p-3 mb-3"><div class="d-flex justify-content-between mb-2"><span><strong>@item.ProductName</strong> <span class="text-muted">(@item.ProductCode)</span></span><span>Còn nhận @FormatQuantity(remaining, item.QuantityScale) @item.UnitName</span></div>
                            <input type="hidden" name="ReceiveDto.Items[@row].InboundOrderItemId" value="@item.InboundOrderItemId" />
                            <div class="row g-2"><div class="col-md-3"><label class="form-label">Thực giao</label><input name="ReceiveDto.Items[@row].DeliveredQuantity" type="number" min="0" max="@remaining" step="@QuantityStep(item.QuantityScale)" value="0" class="form-control" /></div><div class="col-md-3"><label class="form-label">Hàng hỏng</label><input name="ReceiveDto.Items[@row].DamagedQuantity" type="number" min="0" step="@QuantityStep(item.QuantityScale)" value="0" class="form-control" /></div>
                                @if (item.TrackLot) { <div class="col-md-3"><label class="form-label">Số lô</label><input name="ReceiveDto.Items[@row].LotNumber" class="form-control" required /></div> }
                                else { <div class="col-md-3"><label class="form-label">Kiểu quản lý</label><input class="form-control" value="Hàng lẻ — không theo dõi lô" readonly /><input type="hidden" name="ReceiveDto.Items[@row].LotNumber" value="" /></div> }
                                @if (item.TrackExpiry) { <div class="col-md-3"><label class="form-label">Hạn dùng</label><input name="ReceiveDto.Items[@row].ExpiryDate" type="date" class="form-control" required /></div> }
                                else { <div class="col-md-3"><label class="form-label">Hạn dùng</label><input class="form-control" value="Không theo dõi" readonly /></div> }
                            </div>
                        </div>
                        row++;
                    }
                </div><div class="card-footer bg-white d-flex justify-content-end"><button class="btn btn-primary">Xác nhận lần nhận hàng</button></div>
            </form>
        }
        else { <div class="card border-0 shadow-sm p-5 text-center text-muted">Chọn một phiếu bên trái để bắt đầu nhận hàng.</div> }
        </div>
    </div>
</div>
@functions {
    string StatusLabel(string status) => status == "READY" ? "Sẵn sàng" : "Đang nhận";
    string QuantityStep(byte scale) => scale == 0 ? "1" : "0." + new string('0', scale - 1) + "1";
    string FormatQuantity(decimal value, byte scale) => value.ToString(scale == 0 ? "N0" : $"N{scale}");
}
