@page "{id:long?}"
@model BMWMS.Web.Pages.Admin.Inbound.ReceiveModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Phiếu nhập được giao";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <div class="text-muted">Công việc của nhân viên kho</div>
            <h3 class="mb-1">Phiếu nhập được giao</h3>
            <div class="text-muted">Mỗi phiếu được xử lý liên tục qua kiểm nhận và xác nhận vị trí cất hàng.</div>
        </div>
        <span class="badge bg-primary fs-6">@Model.Data.TotalCount phiếu đang xử lý</span>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-stretch">
                <div class="col-md-5">
                    <div class="border rounded h-100 p-3">
                        <div class="d-flex gap-3">
                            <span class="badge rounded-pill bg-primary align-self-start">1</span>
                            <div><strong>Kiểm nhận hàng</strong><div class="text-muted small">Ghi số lượng thực giao, đạt, hỏng/cách ly, số lô và hạn dùng.</div></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-2 d-flex align-items-center justify-content-center text-muted">
                    <span>Hoàn tất kiểm nhận →</span>
                </div>
                <div class="col-md-5">
                    <div class="border border-primary rounded h-100 p-3 bg-primary bg-opacity-10">
                        <div class="d-flex gap-3">
                            <span class="badge rounded-pill bg-primary align-self-start">2</span>
                            <div><strong>Cất hàng và xác nhận vị trí</strong><div class="text-muted small">Tìm/chọn theo Khu → Kệ → Bin, có thể chia số lượng vào nhiều bin.</div></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Data.Items.Count == 0)
    {
        <div class="card border-0 shadow-sm p-5 text-center">
            <div class="text-muted">Hiện không có phiếu nhập nào đang chờ bạn xử lý.</div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model.Data.Items)
            {
                var isPutaway = item.Status == "RECEIVED";
                <div class="col-xl-4 col-md-6">
                    <a asp-page="./Details" asp-route-id="@item.InboundOrderId" class="card border-0 shadow-sm h-100 text-decoration-none text-reset">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                                <div><strong class="text-primary">@item.InboundOrderNumber</strong><div class="small text-muted">@SourceLabel(item.SourceType) · @item.SourceReference</div></div>
                                <span class="badge @(isPutaway ? "bg-primary" : "bg-warning text-dark")">@StatusLabel(item.Status)</span>
                            </div>
                            <div class="small mb-2"><span class="text-muted">Tiến độ nhận:</span> @FormatQuantity(item.TotalReceivedQuantity) / @FormatQuantity(item.TotalExpectedQuantity)</div>
                            <div class="progress mb-3" style="height: 6px;"><div class="progress-bar" style="width: @Progress(item.TotalReceivedQuantity, item.TotalExpectedQuantity)%"></div></div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="small text-muted">Dự kiến @item.ExpectedReceiptDate.ToString("dd/MM/yyyy")</span>
                                <strong class="small text-primary">@(isPutaway ? "Chọn vị trí cất hàng →" : "Tiếp tục kiểm nhận →")</strong>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>

@functions {
    string StatusLabel(string status) => status switch
    {
        "READY" => "Sẵn sàng kiểm nhận",
        "RECEIVING" => "Đang kiểm nhận",
        "RECEIVED" => "Chờ xếp vị trí",
        _ => status
    };
    string SourceLabel(string sourceType) => sourceType == "SALES_RETURN" ? "Khách trả theo SO" : "Nhập mua theo PO";
    string FormatQuantity(decimal value) => value.ToString("0.####");
    decimal Progress(decimal received, decimal expected) => expected <= 0 ? 0 : Math.Min(100, Math.Round(received / expected * 100, 0));
}
