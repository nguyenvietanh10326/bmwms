@page
@model BMWMS.Web.Pages.Admin.UnitOfMeasures.IndexModel
@{
    ViewData["Title"] = "Quản lý Đơn vị tính";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 mb-0 text-gray-800 fw-bold">Danh sách Đơn vị tính</h2>
    <a asp-page="./Create" class="btn btn-primary shadow-sm">
        <i class="ri-add-line me-1"></i> Thêm mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="ri-checkbox-circle-line me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="ri-error-warning-line me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm mb-4 border-0">
    <div class="card-header bg-white py-3 d-flex flex-wrap align-items-center justify-content-between border-bottom">
        <form method="get" class="d-flex gap-2">
            <input type="text" name="Keyword" value="@Model.Keyword" class="form-control form-control-sm" placeholder="Tìm theo mã hoặc tên..." style="width: 250px;">
            <button type="submit" class="btn btn-primary btn-sm"><i class="ri-search-line"></i> Lọc</button>
            @if (!string.IsNullOrEmpty(Model.Keyword))
            {
                <a asp-page="./Index" class="btn btn-light btn-sm"><i class="ri-close-line"></i> Xóa lọc</a>
            }
        </form>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Mã ĐVT</th>
                        <th>Tên ĐVT</th>
                        <th class="text-center">Thang tỷ lệ</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.UnitOfMeasures.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">Không tìm thấy đơn vị tính nào.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.UnitOfMeasures)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">@item.UnitCode</td>
                                <td>@item.UnitName</td>
                                <td class="text-center">@item.QuantityScale</td>
                                <td class="text-end pe-4">
                                    <a asp-page="./Edit" asp-route-id="@item.UnitOfMeasureId" class="btn btn-sm btn-outline-primary" title="Sửa">
                                        <i class="ri-pencil-line"></i>
                                    </a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@item.UnitOfMeasureId" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa ĐVT này?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                            <i class="ri-delete-bin-line"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
