@page "/warehouse/my-tasks"
@model BMWMS.Web.Pages.Warehouse.MyTasksModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Nhiệm vụ của tôi";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">Nhiệm vụ của tôi</h3>
            <div class="text-muted">Các phiếu xuất đang chờ bạn bắt đầu hoặc tiếp tục lấy hàng.</div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Phiếu Xuất Kho (Outbound)</h5>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã phiếu</th>
                                <th>Ngày dự kiến</th>
                                <th>Khách / Đối tác</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.OutboundTasks.Any())
                            {
                                <tr><td colspan="5" class="text-center py-4 text-muted">Không có nhiệm vụ xuất kho nào.</td></tr>
                            }
                            else
                            {
                                @foreach (var task in Model.OutboundTasks)
                                {
                                    <tr>
                                        <td><strong>@task.OutboundOrderNumber</strong></td>
                                        <td>@task.ExpectedIssueDate?.ToString("dd/MM/yyyy")</td>
                                        <td>@task.PartnerName</td>
                                        <td>
                                            @if (task.Status == "READY") { <span class="badge bg-primary">Sẵn sàng xuất</span> }
                                            else if (task.Status == "ISSUING") { <span class="badge bg-warning text-dark">Đang lấy hàng</span> }
                                            else { <span class="badge bg-secondary">@task.Status</span> }
                                        </td>
                                        <td class="text-end">
                                            @if (task.Status == "READY") { <a asp-page="/OutboundOrders/Details" asp-route-id="@task.OutboundOrderId" class="btn btn-sm btn-primary">Bắt đầu xử lý</a> }
                                            else if (task.Status == "ISSUING") { <a asp-page="/OutboundOrders/Process" asp-route-id="@task.OutboundOrderId" class="btn btn-sm btn-warning">Tiếp tục lấy hàng</a> }
                                            else { <a asp-page="/OutboundOrders/Details" asp-route-id="@task.OutboundOrderId" class="btn btn-sm btn-outline-secondary">Chi tiết</a> }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
