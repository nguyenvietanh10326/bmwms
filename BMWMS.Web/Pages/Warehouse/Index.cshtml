@page
@model BMWMS.Web.Pages.Warehouse.IndexModel

@{
    Layout = "/Pages/Shared/Warehourse/_Layout.cshtml";
    ViewData["Title"] = "Warehouse List";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Warehouse/index.css" asp-append-version="true" />
}
<!-- TOPBAR -->
<div class="topbar">
    <div class="breadcrumb">
        <span>Warehouse Management</span>
        <span class="sep">›</span>
        <span class="current">Warehouses</span>
    </div>

    <div class="topbar-right">
        <div class="topbar-icon-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9" />
                <path d="M13.73 21a2 2 0 01-3.46 0" />
            </svg>
            <span class="badge">3</span>
        </div>

        <div class="topbar-icon-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3" />
                <line x1="12" y1="17" x2="12.01" y2="17" />
            </svg>
        </div>

        <div class="user-info">
            <div class="avatar">NA</div>

            <div class="user-details">
                <div class="user-name">Nguyen Van A</div>
                <div class="user-role">Warehouse Manager</div>
            </div>

            <div class="user-chevron">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="6 9 12 15 18 9" />
                </svg>
            </div>
        </div>
    </div>
</div>

<!-- CONTENT -->
<div class="content">

    <div class="page-title">Warehouse List</div>
    <div class="page-sub">
        View and manage all warehouses in the system.
    </div>

    <!-- FILTER -->
    <form method="get" class="filter-bar">
        <div class="filter-header">
            <a asp-page="./Create" class="btn-create" style="text-decoration:none;">
                Create Warehouse
            </a>
        </div>

        <input type="hidden" name="Filter.PageIndex" value="1" />

        <div class="search-group" style="flex: 1;">
            <div class="filter-label">Search</div>
            <div class="search-wrap">
                <input class="search-input" asp-for="Filter.Keyword" placeholder="Search code, name, city..." style="width: 100%;" />
            </div>
        </div>

        <div class="filter-group">
            <div class="filter-label">Status</div>
            <select class="filter-select" asp-for="Filter.Status">
                <option value="">All</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
        </div>

        <div class="filter-group">
            <div class="filter-label">Warehouse Type</div>
            <select class="filter-select" asp-for="Filter.IsPrimary">
                <option value="">All Types</option>
                <option value="true">Primary Warehouse</option>
                <option value="false">Sub Warehouse</option>
            </select>
        </div>

        <div style="display: flex; align-items: flex-end; gap: 8px;">
            <button type="submit" class="btn-create" style="background: #475569;">
                Filter
            </button>
        </div>

       
    </form>

    <!-- TABLE -->
    <div class="table-card">


            <table class="data-table" style="width:100%; border-collapse:collapse;">
                <thead>
                    <tr style="background:#F8FAFC; border-bottom:2px solid #E2E8F0; text-align:left;">
                        <th style="width:50px; text-align:center; padding:12px 8px;">#</th>
                        <th style="width:140px; padding:12px;">Mã Kho</th>
                        <th style="width:200px; padding:12px;">Tên Kho</th>
                        <th style="padding:12px;">Địa Chỉ</th>
                        <th style="width:160px; padding:12px;">Quản Lý</th>
                        <th style="width:110px; text-align:center; padding:12px;">Trạng Thái</th>
                        <th style="width:160px; text-align:center; padding:12px;">Thao Tác</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.WarehousesResult.Items != null && Model.WarehousesResult.Items.Any())
                    {
                        int index = (Model.Filter.PageIndex - 1) * Model.Filter.PageSize + 1;

                        foreach (var item in Model.WarehousesResult.Items)
                        {
                            <!-- 1. DÒNG CHÍNH: THÔNG TIN KHO -->
                            <tr style="border-top:1px solid #E2E8F0; background:#FFFFFF; vertical-align:middle;">

                                <!-- STT -->
                                <td style="text-align:center; color:#64748B; font-weight:600; padding:14px 8px;">
                                    @(index++)
                                </td>

                                <!-- Mã Kho -->
                                <td style="font-weight:700; padding:14px 12px;">
                                    <div style="display:flex; align-items:center; gap:6px;">
                                        <span style="color:#0F172A; font-size:14px; font-family:monospace;">@item.WarehouseCode</span>
                                        @if (item.IsPrimary)
                                        {
                                            <span style="padding:2px 6px; background:#EFF6FF; color:#2563EB; border:1px solid #BFDBFE; border-radius:4px; font-size:9px; font-weight:700;">
                                                PRIMARY
                                            </span>
                                        }
                                    </div>
                                </td>

                                <!-- Tên Kho -->
                                <td style="font-weight:600; color:#1E293B; padding:14px 12px;">
                                    @item.WarehouseName
                                </td>

                                <!-- Địa Chỉ & Diện Tích Kho -->
                            <td style="padding:12px 12px; max-width:260px;">
                                <div style="color:#334155; font-size:13px; line-height:1.4;">
                                    @item.Address
                                </div>

                               
                            </td>


                                <!-- Quản Lý & SĐT -->
                                <td style="padding:14px 12px;">
                                    <div style="font-weight:600; color:#1E293B; font-size:13px;">
                                        👤 @(string.IsNullOrEmpty(item.ManagerName) ? "—" : item.ManagerName)
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.PhoneNumber))
                                    {
                                        <div style="font-size:12px; color:#64748B; margin-top:2px;">
                                            📞 @item.PhoneNumber
                                        </div>
                                    }
                                </td>

                                <!-- Trạng Thái -->
                                <td style="text-align:center; padding:14px 8px;">
                                    @if (string.Equals(item.Status, "Active", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span style="padding:3px 10px; background:#ECFDF5; color:#059669; border:1px solid #A7F3D0; border-radius:999px; font-size:11px; font-weight:600;">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="padding:3px 10px; background:#F1F5F9; color:#64748B; border:1px solid #E2E8F0; border-radius:999px; font-size:11px; font-weight:600;">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <!-- Thao Tác -->
                                <td style="padding:14px 12px; text-align:center;">
                                    <div style="display:flex; justify-content:center; align-items:center; gap:6px;">
                                        <a asp-page="/StorageLocations/Index"
                                           asp-route-WarehouseId="@item.WarehouseID"
                                           title="Xem chi tiết vị trí"
                                           style="display:inline-flex; align-items:center; gap:4px; padding:5px 10px; background:#EFF6FF; color:#2563EB; border:1px solid #BFDBFE; border-radius:6px; text-decoration:none; font-size:12px; font-weight:600;">
                                            View
                                        </a>

                                        <a asp-page="./Edit"
                                           asp-route-id="@item.WarehouseID"
                                           title="Sửa nhà kho"
                                           style="display:inline-flex; align-items:center; gap:4px; padding:5px 10px; background:#F8FAFC; color:#334155; border:1px solid #CBD5E1; border-radius:6px; text-decoration:none; font-size:12px; font-weight:500;">
                                            Edit
                                        </a>
                                    </div>
                                </td>
                            </tr>

                            <!-- 2. DÒNG PHỤ NẰM BÊN DƯỚI: HIỂN THỊ DANH SÁCH STORAGELOCATIONS (RACK / BINS) -->
                            <tr style="border-bottom:2px solid #E2E8F0; background:#F8FAFC;">
                                <td></td> <!-- Trống cột STT -->
                                <td colspan="6" style="padding:10px 16px 16px 16px;">

                                    @if (item.StorageLocations != null && item.StorageLocations.Any())
                                    {
                                        var groupedRacks = item.StorageLocations.GroupBy(x => string.IsNullOrWhiteSpace(x.LocationType) ? "Khu vực chung" : x.LocationType);

                                        <div style="display:flex; flex-direction:column; gap:10px;">
                                            <div style="font-size:11px; font-weight:700; color:#64748B; text-transform:uppercase; letter-spacing:0.5px; display:flex; align-items:center; gap:6px;">
                                                <span>↳ Danh sách vị trí lưu trữ trong kho (Tổng: @item.TotalLocations)</span>
                                            </div>

                                            <!-- Lưới các Kệ (Racks) -->
                                            <div style="display:flex; flex-wrap:wrap; gap:12px;">
                                                @foreach (var rack in groupedRacks)
                                                {
                                                    <!-- KHUNG DÃY KỆ (RACK) -->
                                                    <div style="background:#FFFFFF; border:1px solid #E2E8F0; border-radius:8px; padding:10px 12px; min-width:260px; flex:1 1 calc(33.33% - 12px); box-shadow:0 1px 2px rgba(0,0,0,0.03);">

                                                        <!-- Header Kệ -->
                                                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; border-bottom:1px solid #F1F5F9; padding-bottom:6px;">
                                                            <span style="font-size:12px; font-weight:700; color:#0284C7; display:flex; align-items:center; gap:4px;">
                                                                🗄️ @rack.Key
                                                            </span>
                                                            <span style="font-size:10px; background:#E0F2FE; color:#0369A1; padding:1px 6px; border-radius:10px; font-weight:600;">
                                                                @rack.Count() ô
                                                            </span>
                                                        </div>

                                                        <!-- Các Ô vị trí cụ thể (Bins) -->
                                                        <div style="display:flex; flex-wrap:wrap; gap:6px;">
                                                            @foreach (var loc in rack.Take(6))
                                                            {
                                                                <div style="background:#F8FAFC; border:1px solid #CBD5E1; border-radius:5px; padding:4px 8px; min-width:70px;">
                                                                    <div style="font-weight:700; font-size:11px; color:#0F172A; font-family:monospace;">
                                                                        @loc.LocationCode
                                                                    </div>
                                                                    @if (loc.AreaSquareMeter.HasValue)
                                                                    {
                                                                        <div style="font-size:9px; color:#64748B; margin-top:2px;">
                                                                            @loc.AreaSquareMeter.Value.ToString("N0") m²
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }

                                                            @if (rack.Count() > 6)
                                                            {
                                                                <div style="display:flex; align-items:center; justify-content:center; background:#E2E8F0; color:#475569; font-size:10px; font-weight:700; padding:0 8px; border-radius:5px;">
                                                                    +@(rack.Count() - 6)
                                                                </div>
                                                            }
                                                        </div>

                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="color:#94A3B8; font-size:12px; font-style:italic; padding:4px 0;">
                                            ↳ Chưa chia vị trí lưu trữ cho nhà kho này.
                                        </div>
                                    }

                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" style="text-align:center; padding:40px; color:#94A3B8; font-size:14px;">
                                Không tìm thấy nhà kho nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        

        <!-- PAGINATION FOOTER -->
        @{
            var totalCount = Model.WarehousesResult.TotalCount;
            var pageSize = Model.Filter.PageSize;
            var currentPage = Model.Filter.PageIndex;
            var totalPages = Model.WarehousesResult.TotalPages;

            var startEntry = totalCount == 0 ? 0 : (currentPage - 1) * pageSize + 1;
            var endEntry = Math.Min(currentPage * pageSize, totalCount);
        }

        <div class="table-footer">
            <span>
                Showing @startEntry to @endEntry of @totalCount entries
            </span>

            <div class="pagination">
                <!-- Nút Previous -->
                @if (currentPage > 1)
                {
                    <a asp-page="./Index"
                       asp-route-Filter.PageIndex="@(currentPage - 1)"
                       asp-route-Filter.PageSize="@pageSize"
                       asp-route-Filter.Keyword="@Model.Filter.Keyword"
                       asp-route-Filter.Status="@Model.Filter.Status"
                       asp-route-Filter.IsPrimary="@Model.Filter.IsPrimary"
                       class="pg-btn" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">
                        &lt;
                    </a>
                }
                else
                {
                    <button class="pg-btn" disabled style="opacity: 0.5; cursor: not-allowed;">&lt;</button>
                }

                <!-- Trang hiện tại -->
                <div class="pg-current">
                    @currentPage
                </div>

                <!-- Nút Next -->
                @if (currentPage < totalPages)
                {
                    <a asp-page="./Index"
                       asp-route-Filter.PageIndex="@(currentPage + 1)"
                       asp-route-Filter.PageSize="@pageSize"
                       asp-route-Filter.Keyword="@Model.Filter.Keyword"
                       asp-route-Filter.Status="@Model.Filter.Status"
                       asp-route-Filter.IsPrimary="@Model.Filter.IsPrimary"
                       class="pg-btn" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">
                        &gt;
                    </a>
                }
                else
                {
                    <button class="pg-btn" disabled style="opacity: 0.5; cursor: not-allowed;">&gt;</button>
                }
            </div>
        </div>

    </div>

</div>

<!-- FOOTER -->
<div class="page-footer">
    <span>© 2024 BMWMS. All rights reserved.</span>
    <span>Version 1.0.0</span>
</div>