@page
@model BMWMS.Web.Pages.Warehouse.IndexModel

@{
    Layout = "/Pages/Shared/Warehourse/_Layout.cshtml";
    ViewData["Title"] = "Warehouse List";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Warehouse/index.css" asp-append-version="true" />
}
<!-- TOPBAR -->
<div class="topbar">
    <div class="breadcrumb">
        <span>Warehouse Management</span>
        <span class="sep">›</span>
        <span class="current">Warehouses</span>
    </div>

    <div class="topbar-right">
        <div class="topbar-icon-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9" />
                <path d="M13.73 21a2 2 0 01-3.46 0" />
            </svg>
            <span class="badge">3</span>
        </div>

        <div class="topbar-icon-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3" />
                <line x1="12" y1="17" x2="12.01" y2="17" />
            </svg>
        </div>

        <div class="user-info">
            <div class="avatar">NA</div>

            <div class="user-details">
                <div class="user-name">Nguyen Van A</div>
                <div class="user-role">Warehouse Manager</div>
            </div>

            <div class="user-chevron">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="6 9 12 15 18 9" />
                </svg>
            </div>
        </div>
    </div>
</div>

<!-- CONTENT -->
<div class="content">

    <div class="page-title">Warehouse List</div>
    <div class="page-sub">
        View and manage all warehouses in the system.
    </div>

    <!-- FILTER -->
    <form method="get" class="filter-bar">
        <div class="filter-header">
            <a asp-page="./Create" class="btn-create" style="text-decoration:none;">
                Create Warehouse
            </a>
        </div>

        <input type="hidden" name="Filter.PageIndex" value="1" />

        <div class="search-group" style="flex: 1;">
            <div class="filter-label">Search</div>
            <div class="search-wrap">
                <input class="search-input" asp-for="Filter.Keyword" placeholder="Search code, name, city..." style="width: 100%;" />
            </div>
        </div>

        <div class="filter-group">
            <div class="filter-label">Status</div>
            <select class="filter-select" asp-for="Filter.Status">
                <option value="">All</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
        </div>

        <div class="filter-group">
            <div class="filter-label">Warehouse Type</div>
            <select class="filter-select" asp-for="Filter.IsPrimary">
                <option value="">All Types</option>
                <option value="true">Primary Warehouse</option>
                <option value="false">Sub Warehouse</option>
            </select>
        </div>

        <div style="display: flex; align-items: flex-end; gap: 8px;">
            <button type="submit" class="btn-create" style="background: #475569;">
                Filter
            </button>
        </div>

       
    </form>

    <!-- TABLE -->
    <div class="table-card">

        <table class="data-table">
            <thead>
                <tr>
                    <th style="width:60px; text-align:center;">#</th>
                    <th style="width:160px;">Warehouse Code</th>
                    <th style="width:220px;">Warehouse Name</th>
                    <th>Address</th>
                    <th style="width:180px;">Manager</th>
                    <th style="width:120px; text-align:center;">Status</th>
                    <th style="width:120px; text-align:center;">Locations</th>
                    <th style="width:190px; text-align:center;">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.WarehousesResult.Items != null && Model.WarehousesResult.Items.Any())
                {
                    int index = (Model.Filter.PageIndex - 1) * Model.Filter.PageSize + 1;

                    foreach (var item in Model.WarehousesResult.Items)
                    {
                        <tr>
                            <!-- STT -->
                            <td style="text-align:center;">
                                @(index++)
                            </td>

                            <!-- Warehouse Code -->
                            <td style="font-weight:600; white-space:nowrap;">
                                @item.WarehouseCode

                                @if (item.IsPrimary)
                                {
                                    <span style="margin-left:6px;
                                                     padding:2px 8px;
                                                     background:#DBEAFE;
                                                     color:#1D4ED8;
                                                     border-radius:999px;
                                                     font-size:11px;
                                                     font-weight:600;">
                                        ★ Primary
                                    </span>
                                }
                            </td>

                            <!-- Warehouse Name -->
                            <td>
                                @item.WarehouseName
                            </td>

                            <!-- Address -->
                            <td>
                                @item.Address
                            </td>

                            <!-- Manager -->
                            <td>
                                <div style="font-weight:600;">
                                    @item.ManagerName
                                </div>

                                <div style="font-size:12px;color:#64748b;margin-top:2px;">
                                    📞 @item.PhoneNumber
                                </div>
                            </td>

                            <!-- Status -->
                            <td style="text-align:center;">
                                @if (string.Equals(item.Status, "Active", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge-status badge-active">
                                         Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status badge-inactive">
                                         Inactive
                                    </span>
                                }
                            </td>

                            <!-- Total Locations -->
                            <td style="text-align:center;font-weight:600;">
                                @item.TotalLocations
                            </td>

                            <!-- Actions -->
                            <td>
                                <div style="display:flex;
                                            justify-content:center;
                                            align-items:center;
                                            gap:8px;">

                                    <!-- View -->
                                    <a asp-page="/StorageLocations/Index"
                                       asp-route-WarehouseId="@item.WarehouseID"
                                       title="View Storage Locations"
                                       style="display:inline-flex;
                                              align-items:center;
                                              gap:6px;
                                              padding:6px 12px;
                                              background:#EFF6FF;
                                              color:#2563EB;
                                              border:1px solid #BFDBFE;
                                              border-radius:6px;
                                              text-decoration:none;
                                              font-size:13px;
                                              font-weight:500;">

                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             width="16"
                                             height="16"
                                             fill="none"
                                             viewBox="0 0 24 24"
                                             stroke="currentColor"
                                             stroke-width="2">
                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  d="M2.458 12C3.732 7.943 7.523 5 12 5s8.268 2.943 9.542 7c-1.274 4.057-5.065 7-9.542 7S3.732 16.057 2.458 12z" />
                                            <circle cx="12" cy="12" r="3" />
                                        </svg>

                                        View
                                    </a>

                                    <!-- Edit -->
                                    <a asp-page="./Edit"
                                       asp-route-id="@item.WarehouseID"
                                       title="Edit Warehouse"
                                       style="display:inline-flex;
                                              align-items:center;
                                              gap:6px;
                                              padding:6px 12px;
                                              background:#F8FAFC;
                                              color:#334155;
                                              border:1px solid #CBD5E1;
                                              border-radius:6px;
                                              text-decoration:none;
                                              font-size:13px;
                                              font-weight:500;">

                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             width="16"
                                             height="16"
                                             fill="none"
                                             viewBox="0 0 24 24"
                                             stroke="currentColor"
                                             stroke-width="2">
                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                                        </svg>

                                        Edit
                                    </a>

                                </div>
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9"
                            style="text-align:center;
                               padding:32px;
                               color:#94A3B8;">
                            No warehouses found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- PAGINATION FOOTER -->
        @{
            var totalCount = Model.WarehousesResult.TotalCount;
            var pageSize = Model.Filter.PageSize;
            var currentPage = Model.Filter.PageIndex;
            var totalPages = Model.WarehousesResult.TotalPages;

            var startEntry = totalCount == 0 ? 0 : (currentPage - 1) * pageSize + 1;
            var endEntry = Math.Min(currentPage * pageSize, totalCount);
        }

        <div class="table-footer">
            <span>
                Showing @startEntry to @endEntry of @totalCount entries
            </span>

            <div class="pagination">
                <!-- Nút Previous -->
                @if (currentPage > 1)
                {
                    <a asp-page="./Index"
                       asp-route-Filter.PageIndex="@(currentPage - 1)"
                       asp-route-Filter.PageSize="@pageSize"
                       asp-route-Filter.Keyword="@Model.Filter.Keyword"
                       asp-route-Filter.Status="@Model.Filter.Status"
                       asp-route-Filter.IsPrimary="@Model.Filter.IsPrimary"
                       class="pg-btn" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">
                        &lt;
                    </a>
                }
                else
                {
                    <button class="pg-btn" disabled style="opacity: 0.5; cursor: not-allowed;">&lt;</button>
                }

                <!-- Trang hiện tại -->
                <div class="pg-current">
                    @currentPage
                </div>

                <!-- Nút Next -->
                @if (currentPage < totalPages)
                {
                    <a asp-page="./Index"
                       asp-route-Filter.PageIndex="@(currentPage + 1)"
                       asp-route-Filter.PageSize="@pageSize"
                       asp-route-Filter.Keyword="@Model.Filter.Keyword"
                       asp-route-Filter.Status="@Model.Filter.Status"
                       asp-route-Filter.IsPrimary="@Model.Filter.IsPrimary"
                       class="pg-btn" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">
                        &gt;
                    </a>
                }
                else
                {
                    <button class="pg-btn" disabled style="opacity: 0.5; cursor: not-allowed;">&gt;</button>
                }
            </div>
        </div>

    </div>

</div>

<!-- FOOTER -->
<div class="page-footer">
    <span>© 2024 BMWMS. All rights reserved.</span>
    <span>Version 1.0.0</span>
</div>