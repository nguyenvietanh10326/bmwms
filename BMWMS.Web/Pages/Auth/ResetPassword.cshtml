@page
@model BMWMS.Web.Pages.Auth.ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = "~/Pages/Shared/_AuthLayout.cshtml";
}

<div class="auth-card">
    <!-- Logo -->
    <div class="auth-logo">
        <div class="auth-logo-icon">🏭</div>
        <div class="auth-logo-text">
            <span class="auth-logo-name">BMWMS</span>
            <span class="auth-logo-sub">Building Materials Warehouse Management</span>
        </div>
    </div>

    <!-- Header -->
    <div class="auth-header">
        <h1 class="auth-title">Đặt lại mật khẩu</h1>
        <p class="auth-subtitle">Nhập mã OTP đã được gửi đến email và mật khẩu mới của bạn.</p>
    </div>

    <!-- Alert Messages -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error">
            <i class="ri-error-warning-fill alert-icon"></i>
            <div class="alert-content">
                @Model.ErrorMessage
            </div>
        </div>
    }

    <!-- Form -->
    <form method="post" class="auth-form" id="resetForm">
        <input type="hidden" asp-for="Email" />
        
        <div class="form-group">
            <label class="form-label" style="color: #6b7280;">Tài khoản email</label>
            <div class="input-group">
                <input type="text" class="form-control" value="@Model.Email" disabled style="background: #f3f4f6; color: #6b7280;" />
            </div>
        </div>

        <div class="form-group">
            <label class="form-label" for="token">Mã xác thực (OTP) <span class="text-error">*</span></label>
            <div class="input-group">
                <i class="ri-shield-keyhole-line input-icon"></i>
                <input type="text" class="form-control" id="token" asp-for="Token" placeholder="Nhập mã 6 số" required />
            </div>
            <span asp-validation-for="Token" class="text-error" style="font-size: 13px; margin-top: 4px; display: block;"></span>
        </div>

        <div class="form-group">
            <label class="form-label" for="newPassword">Mật khẩu mới <span class="text-error">*</span></label>
            <div class="input-group" style="position: relative;">
                <i class="ri-lock-password-line input-icon"></i>
                <input type="password" class="form-control" id="newPassword" asp-for="NewPassword" placeholder="Nhập mật khẩu mới" required />
                <i class="ri-eye-off-line toggle-password" onclick="togglePassword(this)" style="position: absolute; right: 12px; top: 12px; color: #9ca3af; cursor: pointer;"></i>
            </div>
            <span asp-validation-for="NewPassword" class="text-error" style="font-size: 13px; margin-top: 4px; display: block;"></span>
        </div>

        <div class="form-group">
            <label class="form-label" for="confirmNewPassword">Xác nhận mật khẩu mới <span class="text-error">*</span></label>
            <div class="input-group" style="position: relative;">
                <i class="ri-lock-password-line input-icon"></i>
                <input type="password" class="form-control" id="confirmNewPassword" asp-for="ConfirmNewPassword" placeholder="Nhập lại mật khẩu mới" required />
                <i class="ri-eye-off-line toggle-password" onclick="togglePassword(this)" style="position: absolute; right: 12px; top: 12px; color: #9ca3af; cursor: pointer;"></i>
            </div>
            <span asp-validation-for="ConfirmNewPassword" class="text-error" style="font-size: 13px; margin-top: 4px; display: block;"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Độ mạnh mật khẩu</label>
            <select class="form-control" disabled id="passwordStrength" style="background: #f3f4f6;">
                <option selected>Chưa có</option>
                <option>Yếu</option>
                <option>Trung bình</option>
                <option>Mạnh</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Đặt lại mật khẩu</button>
    </form>
    
    <!-- Links -->
    <div class="auth-links" style="margin-top: 24px; text-align: center;">
        <a href="/Auth/Login" style="color: #4b5563; text-decoration: none; font-size: 14px; font-weight: 500; display: inline-flex; align-items: center; gap: 6px;">
            <i class="ri-arrow-left-line"></i> Hủy
        </a>
    </div>
</div>

@section Scripts {
    <script>
        function togglePassword(icon) {
            var input = icon.previousElementSibling;
            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("ri-eye-off-line");
                icon.classList.add("ri-eye-line");
            } else {
                input.type = "password";
                icon.classList.remove("ri-eye-line");
                icon.classList.add("ri-eye-off-line");
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            var newPassInput = document.getElementById("newPassword");
            var strengthSelect = document.getElementById("passwordStrength");

            if (newPassInput && strengthSelect) {
                newPassInput.addEventListener("input", function() {
                    var val = this.value;
                    if (!val) {
                        strengthSelect.value = "Chưa có";
                        return;
                    }
                    var score = 0;
                    if (val.length >= 12) score++;
                    if (/[a-z]/.test(val)) score++;
                    if (/[A-Z]/.test(val)) score++;
                    if (/[0-9]/.test(val)) score++;
                    if (/[^a-zA-Z0-9]/.test(val)) score++;

                    if (score <= 2) strengthSelect.value = "Yếu";
                    else if (score <= 4) strengthSelect.value = "Trung bình";
                    else strengthSelect.value = "Mạnh";
                });
            }
        });
    </script>
}
