@page
@model BMWMS.Web.Pages.Auth.ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "~/Pages/Shared/_AuthLayout.cshtml";
}

<div class="auth-card">
    <!-- Logo -->
    <div class="auth-logo">
        <div class="auth-logo-icon">🏭</div>
        <div class="auth-logo-text">
            <span class="auth-logo-name">BMWMS</span>
            <span class="auth-logo-sub">Building Materials Warehouse Management</span>
        </div>
    </div>

    <!-- Header -->
    <div class="auth-header">
        <h1 class="auth-title">Khôi phục mật khẩu</h1>
        <p class="auth-subtitle">Vui lòng nhập địa chỉ email của bạn để nhận mã xác thực.</p>
    </div>

    <!-- Alert Messages -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error">
            <i class="ri-error-warning-fill alert-icon"></i>
            <div class="alert-content">
                @Model.ErrorMessage
            </div>
        </div>
    }

    <!-- Form -->
    <form method="post" class="auth-form" id="forgotForm">
        <div class="form-group">
            <label class="form-label" for="email">Địa chỉ Email <span class="text-error">*</span></label>
            <div class="input-group">
                <i class="ri-mail-line input-icon"></i>
                <input type="email" class="form-control" id="email" asp-for="Email" placeholder="Nhập địa chỉ email của bạn" required />
            </div>
            <span asp-validation-for="Email" class="text-error" style="font-size: 13px; margin-top: 4px; display: block;"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Gửi mã xác thực</button>
    </form>

    <!-- Links -->
    <div class="auth-links" style="margin-top: 24px; text-align: center;">
        <a href="/Auth/Login" style="color: #4b5563; text-decoration: none; font-size: 14px; font-weight: 500; display: inline-flex; align-items: center; gap: 6px;">
            <i class="ri-arrow-left-line"></i> Quay lại Đăng nhập
        </a>
    </div>
</div>
