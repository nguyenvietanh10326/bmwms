@page
@model BMWMS.Web.Pages.StorageLocations.IndexModel
@using BMWMS.Web.Helpers
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Sơ đồ vị trí kho";
    var roleCode = HttpContext.Session.GetString("RoleCode") ?? string.Empty;
    var canManage = roleCode.Equals("SYSTEM_ADMIN", StringComparison.OrdinalIgnoreCase);
    var structure = Model.StructureData;
    var totalBins = structure.WarehouseInfo.TotalLocations;
    var jsonOptions = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
    var zoneCatalogJson = System.Text.Json.JsonSerializer.Serialize(Model.Zones, jsonOptions);
    var rackCatalogJson = System.Text.Json.JsonSerializer.Serialize(Model.Racks, jsonOptions);
}

<style>
    .warehouse-map{max-width:1500px;margin:0 auto;padding:24px;color:#172033}.warehouse-hero{display:flex;justify-content:space-between;gap:20px;align-items:center;padding:22px;border:1px solid #dfe6ef;border-radius:16px;background:linear-gradient(135deg,#fff 0%,#f4f8ff 100%);box-shadow:0 8px 28px rgba(15,23,42,.06)}.warehouse-title{margin:0 0 6px;font-size:24px;font-weight:750}.warehouse-meta{color:#607089;font-size:13px}.action-row{display:flex;gap:8px;flex-wrap:wrap}.map-btn{border:1px solid #cbd6e4;border-radius:9px;padding:9px 13px;background:#fff;color:#334155;font-size:13px;font-weight:650;cursor:pointer}.map-btn:hover{border-color:#2563eb;color:#1d4ed8}.map-btn.primary{background:#2563eb;color:#fff;border-color:#2563eb}.map-btn.danger{color:#b42318;border-color:#fecaca}.map-btn.success{color:#087443;border-color:#a7f3d0}.summary-grid{display:grid;grid-template-columns:repeat(6,minmax(130px,1fr));gap:12px;margin:16px 0}.summary-card{padding:14px 16px;border:1px solid #e2e8f0;border-radius:12px;background:#fff}.summary-label{color:#64748b;font-size:12px}.summary-value{margin-top:3px;font-size:21px;font-weight:750}.view-toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px}.view-switch{display:inline-flex;gap:4px;padding:4px;border:1px solid #dbe4ef;border-radius:10px;background:#f1f5f9}.view-switch .map-btn{padding:7px 12px;border-color:transparent;background:transparent}.view-switch .map-btn.active{border-color:#2563eb;background:#2563eb;color:#fff;box-shadow:0 2px 5px rgba(37,99,235,.2)}.filter-bar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:13px;margin-bottom:16px;border:1px solid #e2e8f0;border-radius:12px;background:#fff}.filter-bar input,.filter-bar select{min-height:38px;border:1px solid #cbd5e1;border-radius:8px;padding:7px 10px;font-size:13px;background:#fff}.filter-bar input{flex:1;min-width:220px}.legend{margin-left:auto;display:flex;gap:11px;flex-wrap:wrap;font-size:12px;color:#475569}.legend span{display:inline-flex;gap:5px;align-items:center}.legend i{width:10px;height:10px;border-radius:3px;display:inline-block}.zone-panel{margin-bottom:18px;border:1px solid #dce4ee;border-radius:15px;overflow:hidden;background:#fff;box-shadow:0 4px 18px rgba(15,23,42,.04)}.zone-head{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:15px 18px;background:#f7f9fc;border-bottom:1px solid #e2e8f0}.node-title{margin:0;font-size:16px;font-weight:750}.node-subtitle{margin-top:3px;font-size:12px;color:#64748b}.node-actions{display:flex;gap:6px}.icon-btn{width:32px;height:32px;border:1px solid #d7e0eb;border-radius:8px;background:#fff;color:#475569;cursor:pointer}.icon-btn:hover{color:#1d4ed8;border-color:#93b4fa}.rack-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:14px;padding:14px}.rack-card{border:1px solid #e1e8f0;border-radius:12px;background:#fbfcfe;overflow:hidden}.rack-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;padding:12px 13px;border-bottom:1px solid #e7edf4}.capacity-note{font-size:11px;color:#64748b;margin-top:4px}.bin-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(145px,1fr));gap:9px;padding:12px}.bin-card{min-height:132px;padding:11px;border:1px solid;border-radius:10px;cursor:pointer;position:relative;transition:.18s ease}.bin-card:hover{transform:translateY(-2px);box-shadow:0 7px 16px rgba(15,23,42,.09)}.bin-card.available{background:#f0fdf4;border-color:#86efac}.bin-card.occupied{background:#eff6ff;border-color:#93c5fd}.bin-card.full{background:#fff7ed;border-color:#fdba74}.bin-card.unknown{background:#fffbeb;border-color:#fcd34d}.bin-card.blocked{background:#f8fafc;border-color:#cbd5e1;color:#64748b}.bin-code{font-size:14px;font-weight:800;padding-right:24px;overflow-wrap:anywhere}.bin-name{font-size:11px;color:#64748b;min-height:30px;margin-top:2px}.bin-state{display:inline-flex;padding:2px 7px;margin:6px 0;border-radius:999px;background:rgba(255,255,255,.75);font-size:10px;font-weight:750}.capacity-line{font-size:11px;color:#475569;line-height:1.55}.bin-edit{position:absolute;right:7px;top:7px;border:0;background:rgba(255,255,255,.85);border-radius:6px;color:#475569}.location-list{display:none;border:1px solid #dce4ee;border-radius:14px;background:#fff;overflow:hidden;box-shadow:0 4px 18px rgba(15,23,42,.04)}.list-scroll{overflow:auto}.location-table{width:100%;min-width:980px;border-collapse:collapse;font-size:12px}.location-table th{padding:11px 12px;background:#f7f9fc;color:#475569;text-align:left;white-space:nowrap;border-bottom:1px solid #dce4ee}.location-table td{padding:11px 12px;border-bottom:1px solid #edf1f5;vertical-align:middle}.location-table tbody tr:hover{background:#f8fbff}.list-path{font-weight:700;color:#334155}.list-secondary{margin-top:2px;color:#64748b;font-size:11px}.list-state{display:inline-flex;padding:3px 8px;border-radius:999px;font-size:11px;font-weight:700}.list-state.available{background:#dcfce7;color:#166534}.list-state.occupied{background:#dbeafe;color:#1d4ed8}.list-state.full{background:#ffedd5;color:#c2410c}.list-state.unknown{background:#fef3c7;color:#92400e}.list-state.blocked{background:#e2e8f0;color:#475569}.list-footer{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 14px;background:#fbfcfe}.list-page-controls{display:flex;align-items:center;gap:8px}.list-page-controls select{min-height:34px;border:1px solid #cbd5e1;border-radius:7px;background:#fff;padding:5px 8px}.empty-rack{padding:24px;text-align:center;color:#64748b;font-size:13px}.empty-page{padding:52px 20px;text-align:center;background:#fff;border:1px dashed #b9c7d8;border-radius:14px;color:#64748b}.modal-mask{display:none;position:fixed;inset:0;z-index:9999;align-items:center;justify-content:center;padding:20px;background:rgba(15,23,42,.58);backdrop-filter:blur(2px)}.modal-card{width:100%;max-width:560px;max-height:90vh;overflow:auto;border-radius:14px;background:#fff;box-shadow:0 24px 70px rgba(15,23,42,.26)}.modal-head,.modal-foot{display:flex;justify-content:space-between;align-items:center;padding:16px 19px;border-bottom:1px solid #e5eaf1}.modal-foot{border-top:1px solid #e5eaf1;border-bottom:0;justify-content:flex-end;gap:8px}.modal-body{padding:18px 19px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field{margin-bottom:12px}.field.full{grid-column:1/-1}.field label{display:block;margin-bottom:5px;font-size:12px;font-weight:650;color:#475569}.field input,.field select,.field textarea{width:100%;box-sizing:border-box;border:1px solid #cbd5e1;border-radius:8px;padding:9px 10px;font-size:13px}.hint{font-size:11px;color:#718096;margin-top:5px}.inventory-table{width:100%;border-collapse:collapse;font-size:12px}.inventory-table th,.inventory-table td{padding:9px;border-bottom:1px solid #edf1f5;text-align:left}
    @@media(max-width:900px){.summary-grid{grid-template-columns:repeat(3,1fr)}.warehouse-hero{align-items:flex-start;flex-direction:column}.legend{margin-left:0}.rack-list{grid-template-columns:1fr}}@@media(max-width:560px){.summary-grid{grid-template-columns:repeat(2,1fr)}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.warehouse-map{padding:14px}.bin-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>

<div class="warehouse-map">
    @if (!string.IsNullOrWhiteSpace(Model.LoadError))
    {
        <div style="margin-bottom:16px;padding:12px 14px;border:1px solid #fecaca;border-radius:10px;background:#fff1f2;color:#9f1239;font-size:13px">
            <i class="ri-error-warning-line"></i> @Model.LoadError
        </div>
    }
    <section class="warehouse-hero">
        <div>
            <div class="warehouse-meta">Danh mục cơ sở / Kho hiện tại / Sơ đồ vị trí</div>
            <h1 class="warehouse-title"><i class="ri-layout-grid-line" style="color:#2563eb"></i> @structure.WarehouseInfo.WarehouseName</h1>
            <div class="warehouse-meta"><strong>@structure.WarehouseInfo.WarehouseCode</strong> · @structure.WarehouseInfo.Address</div>
            <div class="warehouse-meta" style="margin-top:5px">Mô hình một kho: Zone → Rack → Bin. Vị trí nhận hàng, tập kết và xuất hàng được hệ thống quản lý riêng.</div>
        </div>
        @if (canManage)
        {
            <div class="action-row">
                <button class="map-btn" type="button" onclick="openZoneModal()"><i class="ri-add-line"></i> Thêm Zone</button>
                <button class="map-btn" type="button" onclick="openRackModal()"><i class="ri-add-line"></i> Thêm Rack</button>
                <button class="map-btn primary" type="button" onclick="openBinModal()"><i class="ri-add-line"></i> Thêm Bin</button>
            </div>
        }
    </section>

    <section class="summary-grid" aria-label="Tổng quan sơ đồ kho">
        <div class="summary-card"><div class="summary-label">Zone</div><div class="summary-value">@structure.WarehouseInfo.TotalZones</div></div>
        <div class="summary-card"><div class="summary-label">Rack</div><div class="summary-value">@structure.WarehouseInfo.TotalRacks</div></div>
        <div class="summary-card"><div class="summary-label">Bin trên sơ đồ</div><div class="summary-value">@totalBins</div></div>
        <div class="summary-card"><div class="summary-label">Trống</div><div class="summary-value" style="color:#15803d">@structure.TotalAvailableBins</div></div>
        <div class="summary-card"><div class="summary-label">Có hàng / Đầy</div><div class="summary-value" style="color:#1d4ed8">@structure.TotalOccupiedBins / @structure.TotalFullBins</div></div>
        <div class="summary-card"><div class="summary-label">Thiếu dữ liệu / Ngừng</div><div class="summary-value" style="color:#a16207">@structure.TotalUnknownBins / @structure.TotalBlockedBins</div></div>
    </section>

    @if (structure.HierarchyIssueCount > 0)
    {
        <div style="margin-bottom:16px;padding:11px 14px;border:1px solid #f5c26b;border-radius:10px;background:#fff8e8;color:#7c4a03;font-size:13px">
            <i class="ri-alert-line"></i> Có <strong>@structure.HierarchyIssueCount Bin dữ liệu cũ chưa thuộc Rack</strong> nên chưa được đưa lên sơ đồ. Quản trị viên cần chạy script chuẩn hóa dữ liệu đi kèm trước khi vận hành.
        </div>
    }

    <section class="view-toolbar" aria-label="Chọn cách xem vị trí kho">
        <div class="view-switch" role="tablist" aria-label="Chế độ hiển thị">
            <button id="mapViewButton" class="map-btn active" type="button" role="tab" aria-selected="true" onclick="switchLocationView('map')"><i class="ri-layout-grid-line"></i> Sơ đồ</button>
            <button id="listViewButton" class="map-btn" type="button" role="tab" aria-selected="false" onclick="switchLocationView('list')"><i class="ri-table-line"></i> Danh sách</button>
        </div>
        <div id="matchingLocationCount" class="warehouse-meta" aria-live="polite">@totalBins Bin</div>
    </section>

    <section class="filter-bar">
        <input id="mapKeyword" type="search" placeholder="Tìm theo mã hoặc tên Zone, Rack, Bin..." oninput="applyLocationFilters()" />
        <select id="mapZone" aria-label="Lọc theo Zone" onchange="applyLocationFilters()"><option value="">Tất cả Zone</option>@foreach (var zone in structure.Zones){<option value="@zone.ZoneId">@zone.ZoneCode — @zone.ZoneName</option>}</select>
        <select id="mapRack" aria-label="Lọc theo Rack" onchange="applyLocationFilters()"><option value="">Tất cả Rack</option>@foreach (var rack in Model.Racks){<option value="@rack.RackId">@rack.ZoneCode / @rack.RackCode — @rack.RackName</option>}</select>
        <select id="mapStatus" aria-label="Lọc theo tình trạng Bin" onchange="applyLocationFilters()"><option value="">Tất cả tình trạng</option><option value="available">Trống</option><option value="occupied">Có hàng</option><option value="full">Đầy</option><option value="unknown">Thiếu dữ liệu</option><option value="inactive">Ngừng hoạt động</option><option value="blocked">Tạm khóa</option></select>
        <div class="legend"><span><i style="background:#86efac"></i>Trống</span><span><i style="background:#93c5fd"></i>Có hàng</span><span><i style="background:#fdba74"></i>Đầy</span><span><i style="background:#fcd34d"></i>Thiếu dữ liệu</span><span><i style="background:#cbd5e1"></i>Ngừng hoạt động</span></div>
    </section>

    <main id="warehouseStructure">
        @if (!structure.Zones.Any())
        {
            <div class="empty-page"><i class="ri-node-tree" style="font-size:40px"></i><h3>Chưa có cấu trúc vị trí kho</h3><p>Quản trị viên cần tạo Zone, sau đó Rack và cuối cùng là các Bin.</p></div>
        }
        @foreach (var zone in structure.Zones)
        {
            var zoneInactive = zone.Status.Equals("INACTIVE", StringComparison.OrdinalIgnoreCase);
            var zoneBlocked = zone.Status.Equals("BLOCKED", StringComparison.OrdinalIgnoreCase);
            <section class="zone-panel" data-zone-id="@zone.ZoneId" data-search="@zone.ZoneCode @zone.ZoneName">
                <header class="zone-head">
                    <div><h2 class="node-title">Zone @zone.ZoneCode — @zone.ZoneName @if(zoneInactive){<span class="bin-state">Ngừng hoạt động</span>}else if(zoneBlocked){<span class="bin-state">Tạm khóa</span>} @if(zone.CapacityStatus.Equals("EXCEEDED", StringComparison.OrdinalIgnoreCase)){<span class="bin-state" style="color:#b42318">Vượt sức chứa</span>}else if(zone.HasMissingCapacityData){<span class="bin-state" style="color:#9a6700">Thiếu dữ liệu quy đổi</span>}</h2><div class="node-subtitle">@zone.Racks.Count Rack · Đang dùng: @FormatHelper.FormatOptionalNumber(zone.CurrentWeightKg) / @FormatHelper.FormatOptionalNumber(zone.MaxWeightKg) kg · @FormatHelper.FormatOptionalNumber(zone.CurrentVolumeM3) / @FormatHelper.FormatOptionalNumber(zone.MaxVolumeM3) m³</div><div class="capacity-note">Tổng sức chứa đã cấu hình cho Rack: @FormatHelper.FormatQuantity(zone.AllocatedRackWeightKg, (byte)4) kg · @FormatHelper.FormatQuantity(zone.AllocatedRackVolumeM3, (byte)4) m³</div></div>
                    @if (canManage){<div class="node-actions"><button class="icon-btn" title="Sửa Zone" onclick="editZone(@zone.ZoneId)"><i class="ri-edit-line"></i></button>@if(!zoneBlocked){<button class="icon-btn" title="@(zoneInactive ? "Kích hoạt Zone" : "Ngừng sử dụng Zone")" onclick="changeNodeStatus('zone',@zone.ZoneId,@(zoneInactive ? "true" : "false"))"><i class="@(zoneInactive ? "ri-play-circle-line" : "ri-stop-circle-line")"></i></button>}</div>}
                </header>
                <div class="rack-list">
                    @if (!zone.Racks.Any()){<div class="empty-rack">Zone chưa có Rack. Bin không được tạo trực tiếp ngoài Rack.</div>}
                    @foreach (var rack in zone.Racks)
                    {
                        var rackInactive = rack.Status.Equals("INACTIVE", StringComparison.OrdinalIgnoreCase);
                        var rackBlocked = rack.Status.Equals("BLOCKED", StringComparison.OrdinalIgnoreCase);
                        <article class="rack-card" data-zone-id="@zone.ZoneId" data-rack-id="@rack.RackId" data-search="@zone.ZoneCode @zone.ZoneName @rack.RackCode @rack.RackName">
                            <header class="rack-head"><div><div class="node-title">Rack @rack.RackCode — @rack.RackName @if(rackInactive){<span class="bin-state">Ngừng hoạt động</span>}else if(rackBlocked){<span class="bin-state">Tạm khóa</span>} @if(rack.CapacityStatus.Equals("EXCEEDED", StringComparison.OrdinalIgnoreCase)){<span class="bin-state" style="color:#b42318">Vượt sức chứa</span>}else if(rack.HasMissingCapacityData){<span class="bin-state" style="color:#9a6700">Thiếu dữ liệu quy đổi</span>}</div><div class="capacity-note">@rack.Locations.Count Bin · Đang dùng: @FormatHelper.FormatOptionalNumber(rack.CurrentWeightKg) / @FormatHelper.FormatOptionalNumber(rack.MaxWeightKg) kg · @FormatHelper.FormatOptionalNumber(rack.CurrentVolumeM3) / @FormatHelper.FormatOptionalNumber(rack.MaxVolumeM3) m³</div><div class="capacity-note">Tổng sức chứa đã cấu hình cho Bin: @FormatHelper.FormatQuantity(rack.AllocatedLocationWeightKg, (byte)4) kg · @FormatHelper.FormatQuantity(rack.AllocatedLocationVolumeM3, (byte)4) m³</div></div>@if (canManage){<div class="node-actions"><button class="icon-btn" title="Sửa Rack" onclick="editRack(@rack.RackId)"><i class="ri-edit-line"></i></button>@if(!rackBlocked){<button class="icon-btn" title="@(rackInactive ? "Kích hoạt Rack" : "Ngừng sử dụng Rack")" onclick="changeNodeStatus('rack',@rack.RackId,@(rackInactive ? "true" : "false"))"><i class="@(rackInactive ? "ri-play-circle-line" : "ri-stop-circle-line")"></i></button>}</div>}</header>
                            <div class="bin-grid">
                                @if (!rack.Locations.Any()){<div class="empty-rack">Rack đang trống</div>}
                                @foreach (var bin in rack.Locations)
                                {
                                    var state = bin.OccupancyStatus.ToLowerInvariant();
                                    var stateLabel = state switch { "available" => "Trống", "occupied" => "Có hàng", "full" => "Đầy", "unknown" => "Thiếu dữ liệu", _ => "Ngừng hoạt động" };
                                    var binInactive = bin.Status.Equals("INACTIVE", StringComparison.OrdinalIgnoreCase);
                                    var binBlocked = bin.Status.Equals("BLOCKED", StringComparison.OrdinalIgnoreCase);
                                    if (binBlocked) stateLabel = "Tạm khóa";
                                    <div class="bin-card @state" data-zone-id="@zone.ZoneId" data-rack-id="@rack.RackId" data-operational-status="@bin.Status.ToLowerInvariant()" data-occupancy="@state" data-search="@zone.ZoneCode @zone.ZoneName @rack.RackCode @rack.RackName @bin.LocationCode @bin.LocationName" onclick="showBinDetail(@bin.StorageLocationId)">
                                        @if (canManage){<button class="bin-edit" title="Sửa Bin" onclick="event.stopPropagation();editBin(@bin.StorageLocationId)"><i class="ri-edit-line"></i></button>}
                                        <div class="bin-code">@bin.LocationCode</div><div class="bin-name">@(string.IsNullOrWhiteSpace(bin.LocationName) ? "Ô lưu trữ" : bin.LocationName)</div><span class="bin-state">@stateLabel</span>
                                        <div class="capacity-line">KL: @FormatHelper.FormatOptionalNumber(bin.CurrentWeightKg) / @FormatHelper.FormatOptionalNumber(bin.MaxWeightKg) kg</div><div class="capacity-line">TT: @FormatHelper.FormatOptionalNumber(bin.CurrentVolumeM3) / @FormatHelper.FormatOptionalNumber(bin.MaxVolumeM3) m³</div><div class="capacity-line">@bin.StoredProductCount mặt hàng</div>
                                    </div>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    </main>

    <section id="locationList" class="location-list" aria-label="Danh sách Bin">
        <div class="list-scroll">
            <table class="location-table">
                <thead><tr><th>Bin</th><th>Zone</th><th>Rack</th><th>Tình trạng</th><th>Mặt hàng</th><th>Tải trọng</th><th>Thể tích</th><th></th></tr></thead>
                <tbody id="locationListBody">
                @foreach (var zone in structure.Zones)
                {
                    foreach (var rack in zone.Racks)
                    {
                        foreach (var bin in rack.Locations)
                        {
                            var state = bin.OccupancyStatus.ToLowerInvariant();
                            var binInactive = bin.Status.Equals("INACTIVE", StringComparison.OrdinalIgnoreCase);
                            var binBlocked = bin.Status.Equals("BLOCKED", StringComparison.OrdinalIgnoreCase);
                            var stateLabel = binBlocked ? "Tạm khóa" : binInactive ? "Ngừng hoạt động" : state switch
                            {
                                "available" => "Trống",
                                "occupied" => "Có hàng",
                                "full" => "Đầy",
                                "unknown" => "Thiếu dữ liệu",
                                _ => "Không xác định"
                            };
                            <tr class="location-list-row" data-zone-id="@zone.ZoneId" data-rack-id="@rack.RackId" data-operational-status="@bin.Status.ToLowerInvariant()" data-occupancy="@state" data-search="@zone.ZoneCode @zone.ZoneName @rack.RackCode @rack.RackName @bin.LocationCode @bin.LocationName">
                                <td><div class="list-path">@bin.LocationCode</div><div class="list-secondary">@(string.IsNullOrWhiteSpace(bin.LocationName) ? "Ô lưu trữ" : bin.LocationName)</div></td>
                                <td><div class="list-path">@zone.ZoneCode</div><div class="list-secondary">@zone.ZoneName</div></td>
                                <td><div class="list-path">@rack.RackCode</div><div class="list-secondary">@rack.RackName</div></td>
                                <td><span class="list-state @state">@stateLabel</span></td>
                                <td>@bin.StoredProductCount</td>
                                <td>@FormatHelper.FormatOptionalNumber(bin.CurrentWeightKg) / @FormatHelper.FormatOptionalNumber(bin.MaxWeightKg) kg</td>
                                <td>@FormatHelper.FormatOptionalNumber(bin.CurrentVolumeM3) / @FormatHelper.FormatOptionalNumber(bin.MaxVolumeM3) m³</td>
                                <td><button class="map-btn" type="button" onclick="showBinDetail(@bin.StorageLocationId)"><i class="ri-eye-line"></i> Chi tiết</button></td>
                            </tr>
                        }
                    }
                }
                <tr id="emptyLocationListRow" style="display:none"><td colspan="8"><div class="empty-page" style="margin:10px;padding:28px">Không có Bin phù hợp với bộ lọc.</div></td></tr>
                </tbody>
            </table>
        </div>
        <div class="list-footer">
            <div id="listRangeText" class="warehouse-meta"></div>
            <div class="list-page-controls">
                <label class="warehouse-meta" for="listPageSize">Số dòng</label>
                <select id="listPageSize" onchange="changeListPageSize()"><option value="10">10</option><option value="25">25</option><option value="50">50</option></select>
                <button id="previousListPage" class="map-btn" type="button" onclick="changeListPage(-1)"><i class="ri-arrow-left-s-line"></i></button>
                <span id="listPageText" class="warehouse-meta"></span>
                <button id="nextListPage" class="map-btn" type="button" onclick="changeListPage(1)"><i class="ri-arrow-right-s-line"></i></button>
            </div>
        </div>
    </section>
</div>

<div id="nodeModal" class="modal-mask"><div class="modal-card"><div class="modal-head"><strong id="nodeModalTitle">Cấu hình vị trí</strong><button class="icon-btn" onclick="closeNodeModal()">×</button></div><div class="modal-body">
    <input type="hidden" id="nodeType"/><input type="hidden" id="nodeId" value="0"/>
    <div id="zoneParentField" class="field" style="display:none"><label>Zone cha *</label><select id="nodeZoneId"></select></div>
    <div id="rackParentField" class="field" style="display:none"><label>Rack cha *</label><select id="nodeRackId"></select><div class="hint">Zone được xác định theo Rack đã chọn.</div></div>
    <div class="form-grid"><div class="field"><label id="nodeCodeLabel">Mã *</label><input id="nodeCode" maxlength="50"/></div><div class="field"><label id="nodeNameLabel">Tên *</label><input id="nodeName" maxlength="150"/></div><div id="descriptionField" class="field full"><label>Mô tả</label><textarea id="nodeDescription" rows="2" maxlength="500"></textarea></div><div class="field"><label>Tải trọng tối đa (kg)</label><input id="nodeWeight" type="number" min="0.0001" step="0.0001" placeholder="—"/><div class="hint">Để trống nếu chưa có dữ liệu đáng tin cậy.</div></div><div class="field"><label>Thể tích tối đa (m³)</label><input id="nodeVolume" type="number" min="0.0001" step="0.0001" placeholder="—"/><div class="hint">Không nhập 0 để biểu diễn chưa cấu hình.</div></div></div>
    <div id="editCapacityWarning" class="hint" style="display:none;color:#9a6700;background:#fff8c5;padding:9px;border-radius:7px">Không được giảm sức chứa thấp hơn mức đang dùng. Nếu sản phẩm chưa có hệ số quy đổi, hệ thống sẽ từ chối giảm để tránh mất an toàn.</div>
</div><div class="modal-foot"><button class="map-btn" onclick="closeNodeModal()">Hủy</button><button class="map-btn primary" onclick="saveNode()">Lưu</button></div></div></div>

<div id="detailModal" class="modal-mask"><div class="modal-card" style="max-width:760px"><div class="modal-head"><strong id="detailTitle">Chi tiết Bin</strong><button class="icon-btn" onclick="closeDetailModal()">×</button></div><div class="modal-body" id="detailBody"></div><div class="modal-foot"><div id="detailActions" style="margin-right:auto"></div><button class="map-btn" onclick="closeDetailModal()">Đóng</button></div></div></div>

<span class="d-none">@Html.AntiForgeryToken()</span>
<script>
const pageUrl=window.location.pathname,csrfToken=document.querySelector('input[name="__RequestVerificationToken"]').value,warehouseId=@Model.Filter.WarehouseId,zones=@Html.Raw(zoneCatalogJson),racks=@Html.Raw(rackCatalogJson);let listPage=1,currentLocationView='map';
function valueOrNull(id){const v=document.getElementById(id).value.trim();return v===''?null:Number(v)}function formatNumber(v){if(v===null||v===undefined)return'—';return Number(v).toLocaleString('en-US',{maximumFractionDigits:4,useGrouping:false})}function formatQuantity(v,scale){const safeScale=Math.max(0,Math.min(6,Number(scale)||0));return Number(v||0).toLocaleString('en-US',{minimumFractionDigits:0,maximumFractionDigits:safeScale,useGrouping:false})}function isUsable(v){const s=String(v||'').toUpperCase();return s!==''&&s!=='INACTIVE'&&s!=='BLOCKED'}function notify(m,ok=true){if(window.Toastify)Toastify({text:m,duration:3500,gravity:'top',position:'right',style:{background:ok?'#087443':'#b42318'}}).showToast();else alert(m)}async function readJson(r){const t=await r.text();try{return JSON.parse(t)}catch{return{message:t||'Có lỗi xảy ra.'}}}async function postJson(u,m,b){return fetch(u,{method:m,headers:{'Content-Type':'application/json','RequestVerificationToken':csrfToken},body:JSON.stringify(b)})}
function locationFilter(){return{keyword:document.getElementById('mapKeyword').value.trim().toLocaleLowerCase('vi'),zoneId:document.getElementById('mapZone').value,rackId:document.getElementById('mapRack').value,status:document.getElementById('mapStatus').value}}
function matchesLocation(element,filter){const text=(element.dataset.search||'').toLocaleLowerCase('vi'),occupancy=(element.dataset.occupancy||'').toLowerCase(),operational=(element.dataset.operationalStatus||'').toLowerCase(),statusMatch=!filter.status||(filter.status==='inactive'||filter.status==='blocked'?operational===filter.status:occupancy===filter.status);return(!filter.keyword||text.includes(filter.keyword))&&(!filter.zoneId||element.dataset.zoneId===filter.zoneId)&&(!filter.rackId||element.dataset.rackId===filter.rackId)&&statusMatch}
function applyLocationFilters(resetPage=true){if(resetPage)listPage=1;const filter=locationFilter();document.querySelectorAll('.zone-panel').forEach(zone=>{let visibleRacks=0;zone.querySelectorAll('.rack-card').forEach(rack=>{const bins=[...rack.querySelectorAll('.bin-card')];let visibleBins=0;bins.forEach(bin=>{const visible=matchesLocation(bin,filter);bin.style.display=visible?'block':'none';if(visible)visibleBins++});const emptyRackMatch=bins.length===0&&!filter.status&&(!filter.keyword||(rack.dataset.search||'').toLocaleLowerCase('vi').includes(filter.keyword))&&(!filter.zoneId||rack.dataset.zoneId===filter.zoneId)&&(!filter.rackId||rack.dataset.rackId===filter.rackId);const visible=visibleBins>0||emptyRackMatch;rack.style.display=visible?'block':'none';if(visible)visibleRacks++});zone.style.display=visibleRacks>0?'block':'none'});renderLocationList()}
function filteredLocationRows(){const filter=locationFilter();return[...document.querySelectorAll('.location-list-row')].filter(row=>matchesLocation(row,filter))}
function renderLocationList(){const rows=[...document.querySelectorAll('.location-list-row')],matches=filteredLocationRows(),pageSize=Number(document.getElementById('listPageSize').value)||10,totalPages=Math.max(1,Math.ceil(matches.length/pageSize));listPage=Math.min(Math.max(1,listPage),totalPages);rows.forEach(row=>row.style.display='none');const start=(listPage-1)*pageSize,end=Math.min(start+pageSize,matches.length);matches.slice(start,end).forEach(row=>row.style.display='table-row');document.getElementById('emptyLocationListRow').style.display=matches.length?'none':'table-row';document.getElementById('matchingLocationCount').textContent=`${matches.length} Bin phù hợp`;document.getElementById('listRangeText').textContent=matches.length?`Hiển thị ${start+1}–${end} trên ${matches.length} Bin`:'Không có Bin phù hợp';document.getElementById('listPageText').textContent=`Trang ${listPage}/${totalPages}`;document.getElementById('previousListPage').disabled=listPage<=1;document.getElementById('nextListPage').disabled=listPage>=totalPages}
function changeListPage(offset){listPage+=offset;renderLocationList()}function changeListPageSize(){listPage=1;renderLocationList()}
function switchLocationView(view){currentLocationView=view==='list'?'list':'map';document.getElementById('warehouseStructure').style.display=currentLocationView==='map'?'block':'none';document.getElementById('locationList').style.display=currentLocationView==='list'?'block':'none';const mapButton=document.getElementById('mapViewButton'),listButton=document.getElementById('listViewButton');mapButton.classList.toggle('active',currentLocationView==='map');listButton.classList.toggle('active',currentLocationView==='list');mapButton.setAttribute('aria-selected',currentLocationView==='map'?'true':'false');listButton.setAttribute('aria-selected',currentLocationView==='list'?'true':'false');try{localStorage.setItem('bmwms.storageLocations.view',currentLocationView)}catch{}renderLocationList()}
function resetModal(t,id=0){document.getElementById('nodeType').value=t;document.getElementById('nodeId').value=id;['nodeCode','nodeName','nodeDescription','nodeWeight','nodeVolume'].forEach(x=>document.getElementById(x).value='');document.getElementById('zoneParentField').style.display=t==='rack'?'block':'none';document.getElementById('rackParentField').style.display=t==='bin'?'block':'none';document.getElementById('descriptionField').style.display=t==='zone'?'block':'none';document.getElementById('nodeCodeLabel').textContent=`Mã ${t==='zone'?'Zone':t==='rack'?'Rack':'Bin'} *`;document.getElementById('nodeNameLabel').textContent=`Tên ${t==='zone'?'Zone':t==='rack'?'Rack':'Bin'}${t==='bin'?'':' *'}`;document.getElementById('nodeModalTitle').textContent=`${id?'Sửa':'Thêm'} ${t==='zone'?'Zone':t==='rack'?'Rack':'Bin'}`;document.getElementById('editCapacityWarning').style.display=id?'block':'none';document.getElementById('nodeZoneId').innerHTML=zones.filter(x=>isUsable(x.status)).map(x=>`<option value="${x.zoneId}">${x.zoneCode} — ${x.zoneName}</option>`).join('');document.getElementById('nodeRackId').innerHTML=racks.filter(x=>isUsable(x.status)).map(x=>`<option value="${x.rackId}">${x.zoneCode} / ${x.rackCode} — ${x.rackName}</option>`).join('');document.getElementById('nodeModal').style.display='flex'}function openZoneModal(){resetModal('zone')}function openRackModal(){resetModal('rack')}function openBinModal(){resetModal('bin')}function closeNodeModal(){document.getElementById('nodeModal').style.display='none'}
function editZone(id){const x=zones.find(x=>x.zoneId===id);if(!x)return;resetModal('zone',id);document.getElementById('nodeCode').value=x.zoneCode;document.getElementById('nodeName').value=x.zoneName;document.getElementById('nodeDescription').value=x.description||'';document.getElementById('nodeWeight').value=x.maxWeightKg??'';document.getElementById('nodeVolume').value=x.maxVolumeM3??''}function editRack(id){const x=racks.find(x=>x.rackId===id);if(!x)return;resetModal('rack',id);document.getElementById('nodeZoneId').value=x.zoneId;document.getElementById('nodeCode').value=x.rackCode;document.getElementById('nodeName').value=x.rackName;document.getElementById('nodeWeight').value=x.maxWeightKg??'';document.getElementById('nodeVolume').value=x.maxVolumeM3??''}async function editBin(id){const r=await fetch(`${pageUrl}?handler=Location&id=${id}`),x=await readJson(r);if(!r.ok){notify(x.message||'Không tải được Bin.',false);return}resetModal('bin',id);document.getElementById('nodeRackId').value=x.rackId;document.getElementById('nodeCode').value=x.locationCode;document.getElementById('nodeName').value=x.locationName||'';document.getElementById('nodeWeight').value=x.maxWeightKg??'';document.getElementById('nodeVolume').value=x.maxVolumeM3??''}
async function saveNode(){const t=document.getElementById('nodeType').value,id=Number(document.getElementById('nodeId').value),code=document.getElementById('nodeCode').value.trim(),name=document.getElementById('nodeName').value.trim();if(!code||(t!=='bin'&&!name)){notify('Vui lòng nhập đủ mã và tên.',false);return}let h,b;if(t==='zone'){h='SaveZone';b={zoneId:id,warehouseId,zoneCode:code,zoneName:name,description:document.getElementById('nodeDescription').value.trim()||null,maxWeightKg:valueOrNull('nodeWeight'),maxVolumeM3:valueOrNull('nodeVolume')}}else if(t==='rack'){const zoneId=Number(document.getElementById('nodeZoneId').value);if(!zoneId){notify('Vui lòng chọn Zone.',false);return}h='SaveRack';b={rackId:id,warehouseId,zoneId,rackCode:code,rackName:name,maxWeightKg:valueOrNull('nodeWeight'),maxVolumeM3:valueOrNull('nodeVolume')}}else{const rackId=Number(document.getElementById('nodeRackId').value);if(!rackId){notify('Vui lòng chọn Rack.',false);return}h='SaveLocation';b={storageLocationId:id,warehouseId,rackId,locationCode:code,locationName:name||null,maxWeightKg:valueOrNull('nodeWeight'),maxVolumeM3:valueOrNull('nodeVolume')}}const r=await postJson(`${pageUrl}?handler=${h}`,'POST',b),x=await readJson(r);if(!r.ok){notify(x.message||'Không thể lưu dữ liệu.',false);return}notify(x.message||'Đã lưu.');setTimeout(()=>location.reload(),500)}
async function changeNodeStatus(t,id,active){const verb=active?'kích hoạt':'ngừng sử dụng';if(!confirm(`Bạn có chắc muốn ${verb} ${t.toUpperCase()} này? Dữ liệu lịch sử sẽ được giữ nguyên.`))return;const r=await postJson(`${pageUrl}?handler=ChangeStatus&nodeType=${t}&id=${id}`,'POST',{active}),x=await readJson(r);if(!r.ok){notify(x.message||`Không thể ${verb}.`,false);return}notify(x.message);setTimeout(()=>location.reload(),500)}
async function showBinDetail(id){const r=await fetch(`${pageUrl}?handler=LocationInventory&id=${id}`),d=await readJson(r);if(!r.ok){notify(d.message||'Không tải được chi tiết Bin.',false);return}document.getElementById('detailTitle').textContent=`${d.location.locationCode} — ${d.location.locationName||'Bin lưu trữ'}`;const rows=(d.inventories||[]).map(x=>`<tr><td><strong>${x.productCode}</strong><br>${x.productName}</td><td>${formatQuantity(x.onHandQuantity,x.quantityScale)} ${x.unitOfMeasure}</td><td>${formatQuantity(x.reservedQuantity,x.quantityScale)} ${x.unitOfMeasure}</td><td>${x.expiryDate||'—'}</td></tr>`).join('');document.getElementById('detailBody').innerHTML=`<div class="warehouse-meta" style="margin-bottom:12px">${d.location.zoneCode} / ${d.location.rackCode} / ${d.location.locationCode}<br>Khối lượng: ${formatNumber(d.location.currentWeightKg)} / ${formatNumber(d.location.maxWeightKg)} kg · Thể tích: ${formatNumber(d.location.currentVolumeM3)} / ${formatNumber(d.location.maxVolumeM3)} m³</div>${rows?`<table class="inventory-table"><thead><tr><th>Sản phẩm</th><th>Tồn thực tế</th><th>Đã giữ chỗ</th><th>HSD</th></tr></thead><tbody>${rows}</tbody></table>`:'<div class="empty-page" style="padding:25px">Bin hiện không có hàng.</div>'}`;const status=String(d.location.status||'').toUpperCase(),actions=document.getElementById('detailActions');actions.innerHTML='';if(@(canManage ? "true" : "false")&&status!=='BLOCKED'){const active=status==='INACTIVE';actions.innerHTML=`<button class="map-btn ${active?'success':'danger'}" type="button" onclick="changeNodeStatus('bin',${id},${active})"><i class="${active?'ri-play-circle-line':'ri-stop-circle-line'}"></i> ${active?'Kích hoạt lại Bin':'Ngừng sử dụng Bin'}</button>`}document.getElementById('detailModal').style.display='flex'}function closeDetailModal(){document.getElementById('detailModal').style.display='none'}document.querySelectorAll('.modal-mask').forEach(m=>m.addEventListener('click',e=>{if(e.target===m)m.style.display='none'}));
let savedLocationView='map';try{savedLocationView=localStorage.getItem('bmwms.storageLocations.view')||'map'}catch{}applyLocationFilters();switchLocationView(savedLocationView);
</script>
