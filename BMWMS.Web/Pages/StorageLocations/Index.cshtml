@page
@model BMWMS.Web.Pages.StorageLocations.IndexModel
@using BMWMS.Web.Helpers
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Sơ đồ vị trí kho";
    var roleCode = HttpContext.Session.GetString("RoleCode") ?? string.Empty;
    var canManage = roleCode.Equals("SYSTEM_ADMIN", StringComparison.OrdinalIgnoreCase);
    var structure = Model.StructureData;
    var totalBins = structure.WarehouseInfo.TotalLocations;
    var jsonOptions = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
    var zoneCatalogJson = System.Text.Json.JsonSerializer.Serialize(Model.Zones, jsonOptions);
    var rackCatalogJson = System.Text.Json.JsonSerializer.Serialize(Model.Racks, jsonOptions);
}

<style>
    .warehouse-map{max-width:1500px;margin:0 auto;padding:24px;color:#172033}.warehouse-hero{display:flex;justify-content:space-between;gap:20px;align-items:center;padding:22px;border:1px solid #dfe6ef;border-radius:16px;background:linear-gradient(135deg,#fff 0%,#f4f8ff 100%);box-shadow:0 8px 28px rgba(15,23,42,.06)}.warehouse-title{margin:0 0 6px;font-size:24px;font-weight:750}.warehouse-meta{color:#607089;font-size:13px}.action-row{display:flex;gap:8px;flex-wrap:wrap}.map-btn{border:1px solid #cbd6e4;border-radius:9px;padding:9px 13px;background:#fff;color:#334155;font-size:13px;font-weight:650;cursor:pointer}.map-btn:hover{border-color:#2563eb;color:#1d4ed8}.map-btn.primary{background:#2563eb;color:#fff;border-color:#2563eb}.map-btn.danger{color:#b42318;border-color:#fecaca}.map-btn.success{color:#087443;border-color:#a7f3d0}.summary-grid{display:grid;grid-template-columns:repeat(6,minmax(130px,1fr));gap:12px;margin:16px 0}.summary-card{padding:14px 16px;border:1px solid #e2e8f0;border-radius:12px;background:#fff}.summary-label{color:#64748b;font-size:12px}.summary-value{margin-top:3px;font-size:21px;font-weight:750}.filter-bar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:13px;margin-bottom:16px;border:1px solid #e2e8f0;border-radius:12px;background:#fff}.filter-bar input,.filter-bar select{min-height:38px;border:1px solid #cbd5e1;border-radius:8px;padding:7px 10px;font-size:13px;background:#fff}.filter-bar input{flex:1;min-width:220px}.legend{margin-left:auto;display:flex;gap:11px;flex-wrap:wrap;font-size:12px;color:#475569}.legend span{display:inline-flex;gap:5px;align-items:center}.legend i{width:10px;height:10px;border-radius:3px;display:inline-block}.zone-panel{margin-bottom:18px;border:1px solid #dce4ee;border-radius:15px;overflow:hidden;background:#fff;box-shadow:0 4px 18px rgba(15,23,42,.04)}.zone-head{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:15px 18px;background:#f7f9fc;border-bottom:1px solid #e2e8f0}.node-title{margin:0;font-size:16px;font-weight:750}.node-subtitle{margin-top:3px;font-size:12px;color:#64748b}.node-actions{display:flex;gap:6px}.icon-btn{width:32px;height:32px;border:1px solid #d7e0eb;border-radius:8px;background:#fff;color:#475569;cursor:pointer}.icon-btn:hover{color:#1d4ed8;border-color:#93b4fa}.rack-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:14px;padding:14px}.rack-card{border:1px solid #e1e8f0;border-radius:12px;background:#fbfcfe;overflow:hidden}.rack-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;padding:12px 13px;border-bottom:1px solid #e7edf4}.capacity-note{font-size:11px;color:#64748b;margin-top:4px}.bin-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(145px,1fr));gap:9px;padding:12px}.bin-card{min-height:132px;padding:11px;border:1px solid;border-radius:10px;cursor:pointer;position:relative;transition:.18s ease}.bin-card:hover{transform:translateY(-2px);box-shadow:0 7px 16px rgba(15,23,42,.09)}.bin-card.available{background:#f0fdf4;border-color:#86efac}.bin-card.occupied{background:#eff6ff;border-color:#93c5fd}.bin-card.full{background:#fff7ed;border-color:#fdba74}.bin-card.unknown{background:#fffbeb;border-color:#fcd34d}.bin-card.blocked{background:#f8fafc;border-color:#cbd5e1;color:#64748b}.bin-code{font-size:14px;font-weight:800;padding-right:24px;overflow-wrap:anywhere}.bin-name{font-size:11px;color:#64748b;min-height:30px;margin-top:2px}.bin-state{display:inline-flex;padding:2px 7px;margin:6px 0;border-radius:999px;background:rgba(255,255,255,.75);font-size:10px;font-weight:750}.capacity-line{font-size:11px;color:#475569;line-height:1.55}.bin-edit{position:absolute;right:7px;top:7px;border:0;background:rgba(255,255,255,.85);border-radius:6px;color:#475569}.empty-rack{padding:24px;text-align:center;color:#64748b;font-size:13px}.empty-page{padding:52px 20px;text-align:center;background:#fff;border:1px dashed #b9c7d8;border-radius:14px;color:#64748b}.modal-mask{display:none;position:fixed;inset:0;z-index:9999;align-items:center;justify-content:center;padding:20px;background:rgba(15,23,42,.58);backdrop-filter:blur(2px)}.modal-card{width:100%;max-width:560px;max-height:90vh;overflow:auto;border-radius:14px;background:#fff;box-shadow:0 24px 70px rgba(15,23,42,.26)}.modal-head,.modal-foot{display:flex;justify-content:space-between;align-items:center;padding:16px 19px;border-bottom:1px solid #e5eaf1}.modal-foot{border-top:1px solid #e5eaf1;border-bottom:0;justify-content:flex-end;gap:8px}.modal-body{padding:18px 19px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field{margin-bottom:12px}.field.full{grid-column:1/-1}.field label{display:block;margin-bottom:5px;font-size:12px;font-weight:650;color:#475569}.field input,.field select,.field textarea{width:100%;box-sizing:border-box;border:1px solid #cbd5e1;border-radius:8px;padding:9px 10px;font-size:13px}.hint{font-size:11px;color:#718096;margin-top:5px}.inventory-table{width:100%;border-collapse:collapse;font-size:12px}.inventory-table th,.inventory-table td{padding:9px;border-bottom:1px solid #edf1f5;text-align:left}
    @@media(max-width:900px){.summary-grid{grid-template-columns:repeat(3,1fr)}.warehouse-hero{align-items:flex-start;flex-direction:column}.legend{margin-left:0}.rack-list{grid-template-columns:1fr}}@@media(max-width:560px){.summary-grid{grid-template-columns:repeat(2,1fr)}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.warehouse-map{padding:14px}.bin-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>

<div class="warehouse-map">
    <section class="warehouse-hero">
        <div>
            <div class="warehouse-meta">Danh mục cơ sở / Kho hiện tại / Sơ đồ vị trí</div>
            <h1 class="warehouse-title"><i class="ri-layout-grid-line" style="color:#2563eb"></i> @structure.WarehouseInfo.WarehouseName</h1>
            <div class="warehouse-meta"><strong>@structure.WarehouseInfo.WarehouseCode</strong> · @structure.WarehouseInfo.Address</div>
            <div class="warehouse-meta" style="margin-top:5px">Mô hình một kho: Zone → Rack → Bin. Vị trí nhận hàng, tập kết và xuất hàng được hệ thống quản lý riêng.</div>
        </div>
        @if (canManage)
        {
            <div class="action-row">
                <button class="map-btn" type="button" onclick="openZoneModal()"><i class="ri-add-line"></i> Thêm Zone</button>
                <button class="map-btn" type="button" onclick="openRackModal()"><i class="ri-add-line"></i> Thêm Rack</button>
                <button class="map-btn primary" type="button" onclick="openBinModal()"><i class="ri-add-line"></i> Thêm Bin</button>
            </div>
        }
    </section>

    <section class="summary-grid" aria-label="Tổng quan sơ đồ kho">
        <div class="summary-card"><div class="summary-label">Zone</div><div class="summary-value">@structure.WarehouseInfo.TotalZones</div></div>
        <div class="summary-card"><div class="summary-label">Rack</div><div class="summary-value">@structure.WarehouseInfo.TotalRacks</div></div>
        <div class="summary-card"><div class="summary-label">Bin</div><div class="summary-value">@totalBins</div></div>
        <div class="summary-card"><div class="summary-label">Trống</div><div class="summary-value" style="color:#15803d">@structure.TotalAvailableBins</div></div>
        <div class="summary-card"><div class="summary-label">Có hàng / Đầy</div><div class="summary-value" style="color:#1d4ed8">@structure.TotalOccupiedBins / @structure.TotalFullBins</div></div>
        <div class="summary-card"><div class="summary-label">Thiếu dữ liệu / Ngừng</div><div class="summary-value" style="color:#a16207">@structure.TotalUnknownBins / @structure.TotalBlockedBins</div></div>
    </section>

    <section class="filter-bar">
        <input id="mapKeyword" type="search" placeholder="Tìm theo mã hoặc tên Zone, Rack, Bin..." oninput="applyMapFilter()" />
        <select id="mapZone" onchange="applyMapFilter()"><option value="">Tất cả Zone</option>@foreach (var zone in structure.Zones){<option value="@zone.ZoneId">@zone.ZoneCode — @zone.ZoneName</option>}</select>
        <div class="legend"><span><i style="background:#86efac"></i>Trống</span><span><i style="background:#93c5fd"></i>Có hàng</span><span><i style="background:#fdba74"></i>Đầy</span><span><i style="background:#fcd34d"></i>Thiếu dữ liệu</span><span><i style="background:#cbd5e1"></i>Ngừng hoạt động</span></div>
    </section>

    <main id="warehouseStructure">
        @if (!structure.Zones.Any())
        {
            <div class="empty-page"><i class="ri-node-tree" style="font-size:40px"></i><h3>Chưa có cấu trúc vị trí kho</h3><p>Quản trị viên cần tạo Zone, sau đó Rack và cuối cùng là các Bin.</p></div>
        }
        @foreach (var zone in structure.Zones)
        {
            var zoneInactive = zone.Status.Equals("INACTIVE", StringComparison.OrdinalIgnoreCase);
            <section class="zone-panel" data-zone-id="@zone.ZoneId" data-search="@zone.ZoneCode @zone.ZoneName">
                <header class="zone-head">
                    <div><h2 class="node-title">Zone @zone.ZoneCode — @zone.ZoneName</h2><div class="node-subtitle">@zone.Racks.Count Rack · Ngân sách con: @FormatHelper.FormatQuantity(zone.AllocatedRackWeightKg, (byte)4) / @FormatHelper.FormatOptionalNumber(zone.MaxWeightKg) kg · @FormatHelper.FormatQuantity(zone.AllocatedRackVolumeM3, (byte)4) / @FormatHelper.FormatOptionalNumber(zone.MaxVolumeM3) m³</div></div>
                    @if (canManage){<div class="node-actions"><button class="icon-btn" title="Sửa Zone" onclick="editZone(@zone.ZoneId)"><i class="ri-edit-line"></i></button><button class="icon-btn" title="@(zoneInactive ? "Kích hoạt Zone" : "Ngừng sử dụng Zone")" onclick="changeNodeStatus('zone',@zone.ZoneId,@(zoneInactive ? "true" : "false"))"><i class="@(zoneInactive ? "ri-play-circle-line" : "ri-stop-circle-line")"></i></button></div>}
                </header>
                <div class="rack-list">
                    @if (!zone.Racks.Any()){<div class="empty-rack">Zone chưa có Rack. Bin không được tạo trực tiếp ngoài Rack.</div>}
                    @foreach (var rack in zone.Racks)
                    {
                        var rackInactive = rack.Status.Equals("INACTIVE", StringComparison.OrdinalIgnoreCase);
                        <article class="rack-card" data-search="@rack.RackCode @rack.RackName">
                            <header class="rack-head"><div><div class="node-title">Rack @rack.RackCode — @rack.RackName</div><div class="capacity-note">@rack.Locations.Count Bin · Ngân sách Bin: @FormatHelper.FormatQuantity(rack.AllocatedLocationWeightKg, (byte)4) / @FormatHelper.FormatOptionalNumber(rack.MaxWeightKg) kg · @FormatHelper.FormatQuantity(rack.AllocatedLocationVolumeM3, (byte)4) / @FormatHelper.FormatOptionalNumber(rack.MaxVolumeM3) m³</div></div>@if (canManage){<div class="node-actions"><button class="icon-btn" title="Sửa Rack" onclick="editRack(@rack.RackId)"><i class="ri-edit-line"></i></button><button class="icon-btn" title="@(rackInactive ? "Kích hoạt Rack" : "Ngừng sử dụng Rack")" onclick="changeNodeStatus('rack',@rack.RackId,@(rackInactive ? "true" : "false"))"><i class="@(rackInactive ? "ri-play-circle-line" : "ri-stop-circle-line")"></i></button></div>}</header>
                            <div class="bin-grid">
                                @if (!rack.Locations.Any()){<div class="empty-rack">Rack đang trống</div>}
                                @foreach (var bin in rack.Locations)
                                {
                                    var state = bin.OccupancyStatus.ToLowerInvariant();
                                    var stateLabel = state switch { "available" => "Trống", "occupied" => "Có hàng", "full" => "Đầy", "unknown" => "Thiếu dữ liệu", _ => "Ngừng hoạt động" };
                                    var binInactive = state == "blocked";
                                    <div class="bin-card @state" data-search="@bin.LocationCode @bin.LocationName" onclick="showBinDetail(@bin.StorageLocationId)">
                                        @if (canManage){<button class="bin-edit" title="Sửa Bin" onclick="event.stopPropagation();editBin(@bin.StorageLocationId)"><i class="ri-edit-line"></i></button>}
                                        <div class="bin-code">@bin.LocationCode</div><div class="bin-name">@(string.IsNullOrWhiteSpace(bin.LocationName) ? "Ô lưu trữ" : bin.LocationName)</div><span class="bin-state">@stateLabel</span>
                                        <div class="capacity-line">KL: @FormatHelper.FormatOptionalNumber(bin.CurrentWeightKg) / @FormatHelper.FormatOptionalNumber(bin.MaxWeightKg) kg</div><div class="capacity-line">TT: @FormatHelper.FormatOptionalNumber(bin.CurrentVolumeM3) / @FormatHelper.FormatOptionalNumber(bin.MaxVolumeM3) m³</div><div class="capacity-line">@bin.StoredProductCount mặt hàng</div>
                                        @if (canManage){<button class="map-btn @(binInactive ? "success" : "danger")" style="margin-top:7px;padding:4px 7px;font-size:10px" onclick="event.stopPropagation();changeNodeStatus('bin',@bin.StorageLocationId,@(binInactive ? "true" : "false"))">@(binInactive ? "Kích hoạt" : "Ngừng sử dụng")</button>}
                                    </div>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    </main>
</div>

<div id="nodeModal" class="modal-mask"><div class="modal-card"><div class="modal-head"><strong id="nodeModalTitle">Cấu hình vị trí</strong><button class="icon-btn" onclick="closeNodeModal()">×</button></div><div class="modal-body">
    <input type="hidden" id="nodeType"/><input type="hidden" id="nodeId" value="0"/>
    <div id="zoneParentField" class="field" style="display:none"><label>Zone cha *</label><select id="nodeZoneId"></select></div>
    <div id="rackParentField" class="field" style="display:none"><label>Rack cha *</label><select id="nodeRackId"></select><div class="hint">Zone được xác định theo Rack đã chọn.</div></div>
    <div class="form-grid"><div class="field"><label id="nodeCodeLabel">Mã *</label><input id="nodeCode" maxlength="50"/></div><div class="field"><label id="nodeNameLabel">Tên *</label><input id="nodeName" maxlength="150"/></div><div id="descriptionField" class="field full"><label>Mô tả</label><textarea id="nodeDescription" rows="2" maxlength="500"></textarea></div><div class="field"><label>Tải trọng tối đa (kg)</label><input id="nodeWeight" type="number" min="0.0001" step="0.0001" placeholder="—"/><div class="hint">Để trống nếu chưa có dữ liệu đáng tin cậy.</div></div><div class="field"><label>Thể tích tối đa (m³)</label><input id="nodeVolume" type="number" min="0.0001" step="0.0001" placeholder="—"/><div class="hint">Không nhập 0 để biểu diễn chưa cấu hình.</div></div></div>
    <div id="editCapacityWarning" class="hint" style="display:none;color:#9a6700;background:#fff8c5;padding:9px;border-radius:7px">Không được giảm sức chứa thấp hơn mức đang dùng. Nếu sản phẩm chưa có hệ số quy đổi, hệ thống sẽ từ chối giảm để tránh mất an toàn.</div>
</div><div class="modal-foot"><button class="map-btn" onclick="closeNodeModal()">Hủy</button><button class="map-btn primary" onclick="saveNode()">Lưu</button></div></div></div>

<div id="detailModal" class="modal-mask"><div class="modal-card" style="max-width:760px"><div class="modal-head"><strong id="detailTitle">Chi tiết Bin</strong><button class="icon-btn" onclick="closeDetailModal()">×</button></div><div class="modal-body" id="detailBody"></div><div class="modal-foot"><button class="map-btn" onclick="closeDetailModal()">Đóng</button></div></div></div>

<span class="d-none">@Html.AntiForgeryToken()</span>
<script>
const pageUrl=window.location.pathname,csrfToken=document.querySelector('input[name="__RequestVerificationToken"]').value,warehouseId=@Model.Filter.WarehouseId,zones=@Html.Raw(zoneCatalogJson),racks=@Html.Raw(rackCatalogJson);
function valueOrNull(id){const v=document.getElementById(id).value.trim();return v===''?null:Number(v)}function formatNumber(v){if(v===null||v===undefined)return'—';return Number(v).toLocaleString('en-US',{maximumFractionDigits:4,useGrouping:false})}function isInactive(v){return String(v||'').toUpperCase()==='INACTIVE'}function notify(m,ok=true){if(window.Toastify)Toastify({text:m,duration:3500,gravity:'top',position:'right',style:{background:ok?'#087443':'#b42318'}}).showToast();else alert(m)}async function readJson(r){const t=await r.text();try{return JSON.parse(t)}catch{return{message:t||'Có lỗi xảy ra.'}}}async function postJson(u,m,b){return fetch(u,{method:m,headers:{'Content-Type':'application/json','RequestVerificationToken':csrfToken},body:JSON.stringify(b)})}
function applyMapFilter(){const k=document.getElementById('mapKeyword').value.trim().toLocaleLowerCase('vi'),z=document.getElementById('mapZone').value;document.querySelectorAll('.zone-panel').forEach(p=>{const zm=!z||p.dataset.zoneId===z;let rc=0;p.querySelectorAll('.rack-card').forEach(r=>{let bc=0;r.querySelectorAll('.bin-card').forEach(b=>{const v=!k||b.dataset.search.toLocaleLowerCase('vi').includes(k)||r.dataset.search.toLocaleLowerCase('vi').includes(k)||p.dataset.search.toLocaleLowerCase('vi').includes(k);b.style.display=v?'block':'none';if(v)bc++});const v=!k||bc>0||r.dataset.search.toLocaleLowerCase('vi').includes(k)||p.dataset.search.toLocaleLowerCase('vi').includes(k);r.style.display=v?'block':'none';if(v)rc++});p.style.display=zm&&(!k||rc>0||p.dataset.search.toLocaleLowerCase('vi').includes(k))?'block':'none'})}
function resetModal(t,id=0){document.getElementById('nodeType').value=t;document.getElementById('nodeId').value=id;['nodeCode','nodeName','nodeDescription','nodeWeight','nodeVolume'].forEach(x=>document.getElementById(x).value='');document.getElementById('zoneParentField').style.display=t==='rack'?'block':'none';document.getElementById('rackParentField').style.display=t==='bin'?'block':'none';document.getElementById('descriptionField').style.display=t==='zone'?'block':'none';document.getElementById('nodeCodeLabel').textContent=`Mã ${t==='zone'?'Zone':t==='rack'?'Rack':'Bin'} *`;document.getElementById('nodeNameLabel').textContent=`Tên ${t==='zone'?'Zone':t==='rack'?'Rack':'Bin'}${t==='bin'?'':' *'}`;document.getElementById('nodeModalTitle').textContent=`${id?'Sửa':'Thêm'} ${t==='zone'?'Zone':t==='rack'?'Rack':'Bin'}`;document.getElementById('editCapacityWarning').style.display=id?'block':'none';document.getElementById('nodeZoneId').innerHTML=zones.filter(x=>!isInactive(x.status)).map(x=>`<option value="${x.zoneId}">${x.zoneCode} — ${x.zoneName}</option>`).join('');document.getElementById('nodeRackId').innerHTML=racks.filter(x=>!isInactive(x.status)).map(x=>`<option value="${x.rackId}">${x.zoneCode} / ${x.rackCode} — ${x.rackName}</option>`).join('');document.getElementById('nodeModal').style.display='flex'}function openZoneModal(){resetModal('zone')}function openRackModal(){resetModal('rack')}function openBinModal(){resetModal('bin')}function closeNodeModal(){document.getElementById('nodeModal').style.display='none'}
function editZone(id){const x=zones.find(x=>x.zoneId===id);if(!x)return;resetModal('zone',id);document.getElementById('nodeCode').value=x.zoneCode;document.getElementById('nodeName').value=x.zoneName;document.getElementById('nodeDescription').value=x.description||'';document.getElementById('nodeWeight').value=x.maxWeightKg??'';document.getElementById('nodeVolume').value=x.maxVolumeM3??''}function editRack(id){const x=racks.find(x=>x.rackId===id);if(!x)return;resetModal('rack',id);document.getElementById('nodeZoneId').value=x.zoneId;document.getElementById('nodeCode').value=x.rackCode;document.getElementById('nodeName').value=x.rackName;document.getElementById('nodeWeight').value=x.maxWeightKg??'';document.getElementById('nodeVolume').value=x.maxVolumeM3??''}async function editBin(id){const r=await fetch(`${pageUrl}?handler=Location&id=${id}`),x=await readJson(r);if(!r.ok){notify(x.message||'Không tải được Bin.',false);return}resetModal('bin',id);document.getElementById('nodeRackId').value=x.rackId;document.getElementById('nodeCode').value=x.locationCode;document.getElementById('nodeName').value=x.locationName||'';document.getElementById('nodeWeight').value=x.maxWeightKg??'';document.getElementById('nodeVolume').value=x.maxVolumeM3??''}
async function saveNode(){const t=document.getElementById('nodeType').value,id=Number(document.getElementById('nodeId').value),code=document.getElementById('nodeCode').value.trim(),name=document.getElementById('nodeName').value.trim();if(!code||(t!=='bin'&&!name)){notify('Vui lòng nhập đủ mã và tên.',false);return}let h,b;if(t==='zone'){h='SaveZone';b={zoneId:id,warehouseId,zoneCode:code,zoneName:name,description:document.getElementById('nodeDescription').value.trim()||null,areaSquareMeter:null,maxWeightKg:valueOrNull('nodeWeight'),maxVolumeM3:valueOrNull('nodeVolume'),status:'ACTIVE'}}else if(t==='rack'){const zoneId=Number(document.getElementById('nodeZoneId').value);if(!zoneId){notify('Vui lòng chọn Zone.',false);return}h='SaveRack';b={rackId:id,warehouseId,zoneId,rackCode:code,rackName:name,areaSquareMeter:null,maxWeightKg:valueOrNull('nodeWeight'),maxVolumeM3:valueOrNull('nodeVolume'),status:'ACTIVE'}}else{const rackId=Number(document.getElementById('nodeRackId').value);if(!rackId){notify('Vui lòng chọn Rack.',false);return}h='SaveLocation';b={storageLocationId:id,warehouseId,rackId,locationCode:code,locationName:name||null,locationType:'BIN',areaSquareMeter:null,maxWeightKg:valueOrNull('nodeWeight'),maxVolumeM3:valueOrNull('nodeVolume'),isPutawayAllowed:true,isPickable:true,status:'ACTIVE'}}const r=await postJson(`${pageUrl}?handler=${h}`,'POST',b),x=await readJson(r);if(!r.ok){notify(x.message||'Không thể lưu dữ liệu.',false);return}notify(x.message||'Đã lưu.');setTimeout(()=>location.reload(),500)}
async function changeNodeStatus(t,id,active){const verb=active?'kích hoạt':'ngừng sử dụng';if(!confirm(`Bạn có chắc muốn ${verb} ${t.toUpperCase()} này? Dữ liệu lịch sử sẽ được giữ nguyên.`))return;const r=await postJson(`${pageUrl}?handler=ChangeStatus&nodeType=${t}&id=${id}`,'POST',{active}),x=await readJson(r);if(!r.ok){notify(x.message||`Không thể ${verb}.`,false);return}notify(x.message);setTimeout(()=>location.reload(),500)}
async function showBinDetail(id){const r=await fetch(`${pageUrl}?handler=LocationInventory&id=${id}`),d=await readJson(r);if(!r.ok){notify(d.message||'Không tải được chi tiết Bin.',false);return}document.getElementById('detailTitle').textContent=`${d.location.locationCode} — ${d.location.locationName||'Bin lưu trữ'}`;const rows=(d.inventories||[]).map(x=>`<tr><td><strong>${x.productCode}</strong><br>${x.productName}</td><td>${formatNumber(x.onHandQuantity)} ${x.unitOfMeasure}</td><td>${formatNumber(x.reservedQuantity)} ${x.unitOfMeasure}</td><td>${x.expiryDate||'—'}</td></tr>`).join('');document.getElementById('detailBody').innerHTML=`<div class="warehouse-meta" style="margin-bottom:12px">${d.location.zoneCode} / ${d.location.rackCode} / ${d.location.locationCode}<br>Khối lượng: ${formatNumber(d.location.currentWeightKg)} / ${formatNumber(d.location.maxWeightKg)} kg · Thể tích: ${formatNumber(d.location.currentVolumeM3)} / ${formatNumber(d.location.maxVolumeM3)} m³</div>${rows?`<table class="inventory-table"><thead><tr><th>Sản phẩm</th><th>Tồn thực tế</th><th>Đã giữ chỗ</th><th>HSD</th></tr></thead><tbody>${rows}</tbody></table>`:'<div class="empty-page" style="padding:25px">Bin hiện không có hàng.</div>'}`;document.getElementById('detailModal').style.display='flex'}function closeDetailModal(){document.getElementById('detailModal').style.display='none'}document.querySelectorAll('.modal-mask').forEach(m=>m.addEventListener('click',e=>{if(e.target===m)m.style.display='none'}));
</script>
