@page
@model BMWMS.Web.Pages.OutboundOrders.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Phiếu xuất kho";
    var totalPages = Math.Max(1, (int)Math.Ceiling(Model.PagedResult.TotalCount / (double)Math.Max(1, Model.PagedResult.PageSize)));
}

<div class="container-fluid py-4">
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) { <div class="alert alert-success">@Model.SuccessMessage</div> }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h3 class="mb-1">Phiếu xuất kho</h3></div>
        @if (User.IsInRole("WAREHOUSE_STAFF") || User.IsInRole("WAREHOUSE_MANAGER") || User.IsInRole("SYSTEM_ADMIN"))
        {
            <a asp-page="./Create" class="btn btn-primary">@(User.IsInRole("WAREHOUSE_STAFF") ? "Nhận đợt xuất từ SO" : "Tạo lệnh trả NCC")</a>
        }
    </div>

    <form method="get" class="card border-0 shadow-sm mb-3"><div class="card-body row g-3 align-items-end">
        <div class="col-md-5"><label class="form-label">Tìm kiếm</label><input asp-for="Filter.Search" class="form-control" placeholder="Mã phiếu, SO hoặc PO" /></div>
        <div class="col-md-5"><label class="form-label">Trạng thái</label><select asp-for="Filter.Status" asp-items="Model.StatusOptions" class="form-select"></select></div>
        <div class="col-md-3"><label class="form-label">Phiếu tham chiếu</label><select asp-for="Filter.SourceType" class="form-select"><option value="">Tất cả</option><option value="PURCHASE_RETURN">PO</option><option value="SALES_ORDER">SO</option></select></div>
        <div class="col-md-3"><label class="form-label">Sắp xếp</label><select asp-for="Filter.SortOrder" class="form-select"><option value="newest">Mới nhất</option><option value="oldest">Cũ nhất</option></select></div>
        <div class="col-md-2 d-flex gap-2"><button class="btn btn-primary flex-fill">Lọc</button><a asp-page="./Index" class="btn btn-outline-secondary">Đặt lại</a></div>
    </div></form>

    <div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0">
        <thead class="table-light"><tr><th>Mã phiếu</th><th>Nguồn xuất</th><th>Đơn tham chiếu</th><th>Đối tác</th><th>Ngày xuất dự kiến</th><th>Trạng thái</th><th class="text-end">Số mặt hàng</th><th class="text-end">Thao tác</th></tr></thead>
        <tbody>
        @if (Model.PagedResult.Items.Count == 0)
        { <tr><td colspan="8" class="text-center text-muted py-5">Không có phiếu xuất phù hợp.</td></tr> }
        @foreach (var item in Model.PagedResult.Items)
        {
            <tr>
                <td><a asp-page="./Details" asp-route-id="@item.OutboundOrderId" class="fw-semibold text-decoration-none">@item.OutboundOrderNumber</a><div class="text-muted small">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div></td>
                <td>@(item.SourceType == "PURCHASE_RETURN" ? "Trả nhà cung cấp" : "Bán hàng")</td>
                <td>@item.SourceReference</td><td>@item.PartnerName</td><td>@item.ExpectedIssueDate.ToString("dd/MM/yyyy")</td>
                <td><span class="badge @StatusClass(item.Status)">@StatusLabel(item.Status)</span></td>
                <td class="text-end">@item.LineCount dòng</td>
                <td class="text-end">
                    @if ((User.IsInRole("WAREHOUSE_MANAGER") || User.IsInRole("SYSTEM_ADMIN")) && item.Status == "DRAFT")
                    { <a asp-page="./Details" asp-route-id="@item.OutboundOrderId" class="btn btn-sm btn-primary">Duyệt &amp; phân công</a> }
                    else if ((User.IsInRole("WAREHOUSE_MANAGER") || User.IsInRole("SYSTEM_ADMIN")) && item.Status == "PENDING_APPROVAL")
                    { <a asp-page="./Details" asp-route-id="@item.OutboundOrderId" class="btn btn-sm btn-primary">Duyệt chốt đợt</a> }
                    else if (User.IsInRole("WAREHOUSE_STAFF") && item.Status == "READY")
                    { <a asp-page="./Details" asp-route-id="@item.OutboundOrderId" class="btn btn-sm btn-primary">Bắt đầu xử lý</a> }
                    else if (User.IsInRole("WAREHOUSE_STAFF") && item.Status == "ISSUING")
                    { <a asp-page="./Process" asp-route-id="@item.OutboundOrderId" class="btn btn-sm btn-warning">Tiếp tục lấy hàng</a> }
                    else
                    { <a asp-page="./Details" asp-route-id="@item.OutboundOrderId" class="btn btn-sm btn-outline-primary">@(item.Status == "ISSUED" ? "Xem kết quả" : "Chi tiết")</a> }
                </td>
            </tr>
        }
        </tbody>
    </table></div>
    <div class="card-footer bg-white d-flex justify-content-between align-items-center"><span class="text-muted">Tổng cộng @Model.PagedResult.TotalCount phiếu</span><div class="btn-group"><a class="btn btn-outline-secondary @(Model.Filter.PageIndex <= 1 ? "disabled" : "")" asp-route-Filter.PageIndex="@(Model.Filter.PageIndex-1)" asp-route-Filter.Search="@Model.Filter.Search" asp-route-Filter.Status="@Model.Filter.Status" asp-route-Filter.SourceType="@Model.Filter.SourceType" asp-route-Filter.SortOrder="@Model.Filter.SortOrder">Trước</a><span class="btn btn-light disabled">@Model.Filter.PageIndex / @totalPages</span><a class="btn btn-outline-secondary @(Model.Filter.PageIndex >= totalPages ? "disabled" : "")" asp-route-Filter.PageIndex="@(Model.Filter.PageIndex+1)" asp-route-Filter.Search="@Model.Filter.Search" asp-route-Filter.Status="@Model.Filter.Status" asp-route-Filter.SourceType="@Model.Filter.SourceType" asp-route-Filter.SortOrder="@Model.Filter.SortOrder">Sau</a></div></div>
    </div>
</div>

@functions {
    string StatusLabel(string status) => status switch { "DRAFT" => "Nháp", "READY" => "Sẵn sàng xuất", "ISSUING" => "Đang xuất hàng", "PENDING_APPROVAL" => "Chờ duyệt chốt đợt", "ISSUED" => "Đã xuất", "CANCELLED" => "Đã hủy", _ => status };
    string StatusClass(string status) => status switch { "ISSUED" => "bg-success", "ISSUING" => "bg-warning text-dark", "READY" => "bg-primary", "CANCELLED" => "bg-danger", _ => "bg-secondary" };
}
