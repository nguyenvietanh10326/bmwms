@model string
@{
    var state = (Model ?? "").ToUpperInvariant();
    var current = state switch { "CREATE" or "DRAFT" => 0, "READY" or "ASSIGNED" => 1, "ISSUING" or "IN_PROGRESS" => 2, "PENDING_APPROVAL" => 3, "ISSUED" or "COMPLETED" => 4, _ => -1 };
    var steps = new[] { "Tạo phiếu", "Sẵn sàng", "Lấy · đóng gói · giao hàng", "Quản lý duyệt chốt đợt", "Đã xuất" };
}
@if (current >= 0)
{
    <nav class="d-flex flex-wrap gap-2 mb-3" aria-label="Tiến trình xuất kho">
        @for (var i = 0; i < steps.Length; i++)
        {
            <span class="badge rounded-pill p-2 @(i == current ? "bg-primary" : i < current ? "bg-success" : "bg-light text-secondary border")">@(i + 1). @steps[i]</span>
        }
    </nav>
}
