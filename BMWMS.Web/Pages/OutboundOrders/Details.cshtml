@page "{id:long}"
@model BMWMS.Web.Pages.OutboundOrders.DetailsModel
@using BMWMS.Web.Helpers
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Chi tiết phiếu xuất {Model.Order.OutboundOrderNumber}";
    var isManager = User.IsInRole("SYSTEM_ADMIN") || User.IsInRole("WAREHOUSE_MANAGER");
    var isSales = User.IsInRole("SALES_STAFF");
    var isPurchasing = User.IsInRole("PURCHASING_STAFF");
    var currentUserId = long.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var parsedUserId)
        ? parsedUserId : 0;
    var isAssignedStaff = User.IsInRole("WAREHOUSE_STAFF") && currentUserId > 0 &&
        Model.Order.AssignedToUserId == currentUserId;
    var hasIssuedQuantity = Model.Order.Items.Any(item => item.IssuedQuantity > 0);
    var canCancel = Model.Order.Status is "READY" or "ISSUING" && !hasIssuedQuantity && isAssignedStaff;
    var canStart = isAssignedStaff && Model.Order.Status == "READY";
    var canProcess = isAssignedStaff && Model.Order.Status == "ISSUING";
    var canReview = isManager && Model.Order.Status == "PENDING_APPROVAL" && Model.Order.SourceType == "PURCHASE_RETURN";
    var sourceLabel = Model.Order.SourceType == "PURCHASE_RETURN" ? "Trả nhà cung cấp theo PO" : "Bán hàng theo SO";
    ViewData["OutboundSourceType"] = Model.Order.SourceType;
}

<div class="container-fluid py-4">
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) { <div class="alert alert-success">@Model.SuccessMessage</div> }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div><div class="text-muted">Chi tiết phiếu xuất kho</div><h3>@Model.Order.OutboundOrderNumber</h3></div>
        <div class="d-flex gap-2">
            @if (canStart) { <form method="post" asp-page-handler="Start" asp-route-id="@Model.Order.OutboundOrderId"><button class="btn btn-primary">Bắt đầu xử lý</button></form> }
            @if (canProcess) { <a asp-page="./Process" asp-route-id="@Model.Order.OutboundOrderId" class="btn btn-primary">Tiếp tục lấy hàng</a> }
            @if (isManager) { <a href="/Admin/AuditLogs?Filter.EntityName=OutboundOrder&amp;Filter.EntityId=@Model.Order.OutboundOrderNumber" class="btn btn-outline-secondary">Nhật ký phiếu</a> }
            <a asp-page="./Index" class="btn btn-outline-secondary">Danh sách phiếu xuất</a>
        </div>
    </div>

    <partial name="_Workflow" model="Model.Order.Status" />

    <div class="card shadow-sm border-0 mb-3"><div class="card-body">
        <div class="row g-3">
            <div class="col-md-3"><div class="text-muted small">Trạng thái</div><strong>@StatusLabel(Model.Order.Status)</strong></div>
            <div class="col-md-3"><div class="text-muted small">Luồng nghiệp vụ</div><strong>@sourceLabel</strong></div>
            <div class="col-md-3"><div class="text-muted small">Đơn tham chiếu</div><strong>@Model.Order.SourceReference</strong></div>
            <div class="col-md-3"><div class="text-muted small">Đối tác</div><strong>@Model.Order.PartnerName</strong></div>
            <div class="col-md-3"><div class="text-muted small">Ngày xuất dự kiến</div><span>@Model.Order.ExpectedIssueDate?.ToString("dd/MM/yyyy")</span></div>
            <div class="col-md-3"><div class="text-muted small">Nhân viên phụ trách</div><span>@(Model.Order.AssignedToUserName ?? "Chưa phân công")</span></div>
            <div class="col-md-3"><div class="text-muted small">Người tạo phiếu</div><span>@(Model.Order.CreatedByUserName ?? "Không xác định")</span></div>
            <div class="col-md-3"><div class="text-muted small">Ngày tạo phiếu</div><span>@Model.Order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span></div>
            @if (Model.Order.Status == "ISSUED")
            {
                <div class="col-md-3"><div class="text-muted small">Kết quả đợt xuất</div><span>@(Model.Order.CompletionType == "PARTIAL" ? "Giao một phần" : "Giao đủ")</span></div>
                <div class="col-md-3"><div class="text-muted small">Hoàn tất lúc</div><span>@(Model.Order.CompletedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</span></div>
                <div class="col-md-3"><div class="text-muted small">Người xác nhận xuất</div><span>@(Model.Order.CompletionReviewedByUserName ?? "—")</span></div>
            }
            <div class="col-12"><div class="text-muted small">Ghi chú</div><span>@(string.IsNullOrWhiteSpace(Model.Order.Notes) ? "Không có" : Model.Order.Notes)</span></div>
            @if (!string.IsNullOrWhiteSpace(Model.Order.CompletionReason)) { <div class="col-12"><div class="text-muted small">Lý do hoàn tất khi còn thiếu</div><span>@Model.Order.CompletionReason</span></div> }
            @if (!string.IsNullOrWhiteSpace(Model.Order.CancellationReason)) { <div class="col-12"><div class="text-muted small">Lý do hủy</div><span>@Model.Order.CancellationReason</span></div> }
        </div>
    </div></div>

    @if (Model.Order.Status == "PENDING_APPROVAL")
    {
        <div class="card border-warning shadow-sm mb-3"><div class="card-header bg-warning-subtle fw-semibold">Chờ Manager quyết định phần còn lại</div><div class="card-body">
            <p class="text-muted">Nhân viên kho đã chốt số thực xuất của đợt này. Manager xác nhận trả tiếp ở đợt sau hoặc đóng phần còn lại theo thỏa thuận với nhà cung cấp.</p>
            @if (canReview)
            {
                <form method="post" asp-page-handler="ReviewCompletion" asp-route-id="@Model.Order.OutboundOrderId" class="row g-3" onsubmit="return confirm('Duyệt số thực xuất và chốt đợt này?');">
                    @if (Model.Order.HasReferenceRemainder)
                    {
                        <div class="col-12"><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Vật tư</th><th>Đơn vị</th><th class="text-end">@(Model.Order.SourceType == "SALES_ORDER" ? "Khách đặt" : "Dự kiến trả đợt này")</th><th class="text-end">Đã giao</th><th class="text-end">Còn thiếu</th></tr></thead><tbody>
                        @foreach (var line in Model.Order.Remainders)
                        { <tr><td>@line.ProductName</td><td>@line.UnitName</td><td class="text-end">@FormatQuantity(line.PlannedQuantity, line.QuantityScale)</td><td class="text-end">@FormatQuantity(line.DeliveredQuantity, line.QuantityScale)</td><td class="text-end">@FormatQuantity(line.RemainingQuantity, line.QuantityScale)</td></tr> }
                        </tbody></table></div></div>
                        <div class="col-md-4"><label class="form-label">Quyết định phần còn lại</label><select name="remainderAction" class="form-select" required><option value="">Chọn quyết định</option><option value="CONTINUE">Tiếp tục đợt sau</option><option value="CLOSE">Kết thúc phần còn lại</option></select></div>
                        <div class="col-md-8"><label class="form-label">Căn cứ đã thống nhất với @(Model.Order.SourceType == "SALES_ORDER" ? "khách hàng" : "nhà cung cấp")</label><textarea name="reason" class="form-control" minlength="10" maxlength="500" rows="2" required></textarea></div>
                    }
                    <div class="col-12 text-end"><button class="btn btn-primary">Duyệt chốt đợt xuất</button></div>
                </form>
            }
            else if (Model.Order.SourceType == "SALES_ORDER") { <span>Quyết định phần còn lại được thực hiện tại chi tiết SO tham chiếu.</span> }
            else { <span>Đang chờ Quản lý kho xử lý.</span> }
        </div></div>
    }

    @if (canCancel)
    {
        <div class="card border-danger shadow-sm mb-3"><div class="card-body">
            <form method="post" asp-page-handler="CancelOrder" asp-route-id="@Model.Order.OutboundOrderId" class="row g-2 align-items-end" onsubmit="return confirm('Xác nhận hủy phiếu xuất này?');">
                <div class="col-md-9"><label class="form-label">Lý do hủy</label><input name="reason" class="form-control" minlength="5" maxlength="500" required /></div>
                <div class="col-md-3"><button class="btn btn-outline-danger w-100">Hủy phiếu</button></div>
            </form>
        </div></div>
    }


    <div class="card shadow-sm border-0"><div class="card-header bg-white"><div class="fw-semibold">Tác nghiệp lấy và xuất hàng</div><div class="text-muted small">Theo dõi số lượng yêu cầu, thực xuất và phần còn phải xử lý ngay trên phiếu xuất.</div></div>
        <div class="table-responsive"><table class="table align-middle mb-0">
            <thead class="table-light"><tr><th>Mã hàng</th><th>Tên sản phẩm</th><th>Đơn vị</th><th class="text-end">Cần xuất</th><th class="text-end">Đã xuất</th><th class="text-end">Còn lại</th><th>Ghi chú</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Order.Items)
            {
                <tr><td>@item.ProductCode</td><td>@item.ProductName</td><td>@item.UnitOfMeasure</td><td class="text-end">@FormatQuantity(item.RequestedQuantity, item.QuantityScale)</td><td class="text-end">@FormatQuantity(item.IssuedQuantity, item.QuantityScale)</td><td class="text-end">@FormatQuantity(item.RequestedQuantity-item.IssuedQuantity, item.QuantityScale)</td><td>@(item.Notes ?? "—")</td></tr>
            }
            </tbody>
        </table></div>
    </div>

    @if (Model.Order.Items.Any(item => item.PickedDetails.Count > 0))
    {
        <div class="card shadow-sm border-0 mt-3">
            <div class="card-header bg-white"><div class="fw-semibold">Vị trí đã lấy hàng</div><div class="text-muted small">Lịch sử số lượng thực xuất theo đúng Khu / Kệ / Bin.</div></div>
            <div class="table-responsive"><table class="table align-middle mb-0">
                <thead class="table-light"><tr><th>Vật tư</th><th>Vị trí lấy</th><th>Ngày nhập / Hạn sử dụng</th><th>Người thực hiện</th><th>Thời gian</th><th class="text-end">Thực xuất</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Order.Items)
                {
                    @foreach (var picked in item.PickedDetails)
                    {
                        <tr><td><strong>@item.ProductName</strong><div class="text-muted small">@item.ProductCode</div></td><td>@picked.LocationCode</td><td><div>@(picked.FirstReceivedDate == default ? "Không xác định" : picked.FirstReceivedDate.ToString("dd/MM/yyyy"))</div><div class="text-muted small">HSD: @(picked.ExpiryDate?.ToString("dd/MM/yyyy") ?? "Không áp dụng")</div></td><td>@picked.RecordedByUserName</td><td>@picked.RecordedAt.ToString("dd/MM/yyyy HH:mm")</td><td class="text-end">@FormatQuantity(picked.IssuedQuantity, item.QuantityScale) @item.UnitOfMeasure</td></tr>
                    }
                }
                </tbody>
            </table></div>
        </div>
    }
</div>

@functions {
    string StatusLabel(string status) => status switch { "DRAFT" => "Dữ liệu nháp cũ", "READY" => "Sẵn sàng xuất", "ISSUING" => "Đang xuất hàng", "PENDING_APPROVAL" => "Chờ Manager duyệt phần còn lại", "ISSUED" => "Đã xuất", "CANCELLED" => "Đã hủy", _ => status };
    string FormatQuantity(decimal value, byte scale) => FormatHelper.FormatQuantity(value, scale);
}
