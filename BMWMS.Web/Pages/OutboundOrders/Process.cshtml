@page "{id:long}"
@using System.Text.Json
@model BMWMS.Web.Pages.OutboundOrders.ProcessModel
@using BMWMS.Web.Helpers
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Thực hiện xuất kho - {Model.Order.OutboundOrderNumber}";
    var isSale = Model.Order.SourceType == "SALES_ORDER";
    ViewData["OutboundSourceType"] = Model.Order.SourceType;
}

<div class="container-fluid py-4">
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) { <div class="alert alert-success">@Model.SuccessMessage</div> }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <div class="text-muted mb-1">Thực hiện lấy hàng và xác nhận xuất kho</div>
            <h3 class="mb-0">@Model.Order.OutboundOrderNumber</h3>
        </div>
        <a asp-page="./Details" asp-route-id="@Model.Order.OutboundOrderId" class="btn btn-outline-secondary">Chi tiết phiếu xuất</a>
    </div>

    <partial name="_Workflow" model="Model.Order.Status" />



    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body row g-3">
            <div class="col-md-3"><div class="text-muted small">Trạng thái</div><strong>@StatusLabel(Model.Order.Status)</strong></div>
            <div class="col-md-3"><div class="text-muted small">Ngày xuất dự kiến</div><strong>@Model.Order.ExpectedIssueDate?.ToString("dd/MM/yyyy")</strong></div>
            <div class="col-md-6"><div class="text-muted small">Ghi chú</div><span>@(string.IsNullOrWhiteSpace(Model.Order.Notes) ? "Không có" : Model.Order.Notes)</span></div>
        </div>
    </div>

    @foreach (var item in Model.Order.Items)
    {
        var progress = item.RequestedQuantity > 0 ? Math.Min(100, (int)(item.IssuedQuantity * 100 / item.RequestedQuantity)) : 0;
        var suggestedRemaining = item.RemainingQuantity;
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="badge bg-secondary">@item.ProductCode</span>
                        <span class="badge bg-light text-dark border">Gợi ý @item.RotationMethod</span>
                        <h5 class="mt-2 mb-1">@item.ProductName</h5>
                        <span class="text-muted">Đơn vị: @item.UnitName · @(item.RotationMethod == "FEFO" ? "ưu tiên HSD gần nhất, sau đó ngày nhập" : "ưu tiên ngày nhập cũ nhất")</span>
                    </div>
                    <div class="text-end"><strong>@FormatQuantity(item.IssuedQuantity, item.QuantityScale) / @FormatQuantity(item.RequestedQuantity, item.QuantityScale)</strong><div class="text-muted">Còn @FormatQuantity(item.RemainingQuantity, item.QuantityScale)</div></div>
                </div>
                <div class="progress mb-3" style="height:8px"><div class="progress-bar" style="width:@progress%"></div></div>

                @if (item.PickedDetails.Count > 0)
                {
                    <div class="mb-3"><div class="fw-semibold mb-2">Đã xuất</div>
                    @foreach (var picked in item.PickedDetails)
                    { <span class="badge bg-success-subtle text-success border me-2">@picked.LocationCode · @FormatQuantity(picked.IssuedQuantity, item.QuantityScale) @item.UnitName</span> }
                    </div>
                }

                <div class="d-flex align-items-center gap-3 mb-2"><div class="fw-semibold">Phân bổ lấy hàng</div>
                    @if (Model.Order.SourceType == "SALES_ORDER") { <select class="form-select form-select-sm picking-method" data-item-id="@item.OutboundOrderItemId" style="max-width:260px" aria-label="Phương pháp lấy @item.ProductCode">
                        <option value="FIFO" selected="@(item.RotationMethod == "FIFO")">FIFO — ngày nhập cũ nhất</option>
                        <option value="FEFO" selected="@(item.RotationMethod == "FEFO")">FEFO — HSD gần nhất</option>
                        <option value="CUSTOM">Tự chọn vị trí</option>
                    </select> }
                </div>
                @if (item.AvailableLocations.Count == 0)
                { <div class="alert alert-warning mb-0">Không còn hàng đủ điều kiện tại vị trí kho. Báo quản lý trước khi tiếp tục hoặc kết thúc đợt.</div> }
                else
                {
                    <div class="table-responsive"><table class="table table-sm align-middle">
                        <thead><tr><th style="width:55px">Chọn</th><th>Vị trí lấy</th><th>Ngày nhập</th><th>HSD</th><th class="text-end">Khả dụng</th><th style="width:190px">Thực xuất</th></tr></thead>
                        <tbody>
                        @foreach (var location in item.AvailableLocations)
                        {
                            var suggested = Model.Order.SourceType == "SALES_ORDER" ? Math.Min(suggestedRemaining, location.AvailableQuantity) : 0;
                            suggestedRemaining -= suggested;
                            <tr class="pick-row" data-item-id="@item.OutboundOrderItemId" data-received="@(location.FirstReceivedDate?.ToString("yyyy-MM-dd"))" data-expiry="@(location.ExpiryDate?.ToString("yyyy-MM-dd"))" data-item-remaining="@item.RemainingQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-suggested="@suggested.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                <td><input type="checkbox" class="form-check-input pick-check" aria-label="Chọn vị trí @location.LocationCode" @(suggested > 0 ? "checked" : null) /></td>
                                <td>@(string.IsNullOrWhiteSpace(location.LocationPath) ? location.LocationCode : location.LocationPath) <span class="badge bg-info-subtle text-info-emphasis suggestion-badge" hidden="@(suggested <= 0)">Đề xuất</span></td>
                                <td>@(location.FirstReceivedDate?.ToString("dd/MM/yyyy") ?? "—")</td><td>@(location.ExpiryDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td class="text-end">@FormatQuantity(location.AvailableQuantity, item.QuantityScale) @item.UnitName<div class="text-muted small">Cất: @FormatQuantity(location.StoredQuantity, item.QuantityScale) · Giữ: @FormatQuantity(location.HeldQuantity, item.QuantityScale)</div></td>
                                <td>
                                    <input type="number" class="form-control form-control-sm pick-quantity"
                                           min="@QuantityStep(item.QuantityScale)" max="@location.AvailableQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                           step="@QuantityStep(item.QuantityScale)"
                                           value="@suggested.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                           data-order-id="@Model.Order.OutboundOrderId"
                                           data-location-id="@location.StorageLocationId"
                                           data-lot-id="@location.ProductLotId"
                                           data-reservation-id="@location.InventoryReservationId" disabled="@(suggested <= 0)" />
                                    <span class="text-muted small">@item.UnitName</span>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>
    }

    @if (Model.Order.Status == "ISSUING")
    {
        <div class="sticky-bottom bg-body border-top py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <div id="batchError" class="text-danger small"></div>
                @if (Model.Order.SourceType == "SALES_ORDER") { <div class="mt-2"><label for="deviationReason" class="form-label small mb-1">Lý do chọn vị trí khác đề xuất</label><input id="deviationReason" class="form-control" minlength="10" maxlength="500" placeholder="Bắt buộc khi đổi thứ tự vị trí so với gợi ý" /></div> }
                @if (Model.Order.Items.Any(item => item.IssuedQuantity > 0) &&
                     Model.Order.Items.Any(item => item.RemainingQuantity > 0))
                {
                    <form method="post" asp-page-handler="Complete" asp-route-id="@Model.Order.OutboundOrderId" class="mt-2" onsubmit="return confirm('Gửi số thực xuất để Quản lý kho duyệt chốt đợt?');">
                        <div class="input-group"><input name="reason" class="form-control" minlength="10" maxlength="500" placeholder="Lý do đợt này giao thiếu" required /><button class="btn btn-outline-primary">Gửi chốt đợt giao thiếu</button></div>
                    </form>
                }
            </div>
            <button type="button" id="reviewBatch" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#confirmPickModal" disabled>Xem lại và xác nhận xuất</button>
        </div>
    }
</div>

<div class="modal fade" id="confirmPickModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Xác nhận trừ tồn kho</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <p class="mb-2">Kiểm tra số thực giao trước khi xác nhận trừ tồn.</p>
            <div id="batchSummary" class="small mb-3"></div>
            <div class="form-check mb-2"><input class="form-check-input shipment-check" type="checkbox" id="physicalCheck"><label class="form-check-label" for="physicalCheck">Đã đối chiếu đúng sản phẩm, số lượng và hàng vật lý đủ điều kiện xuất</label></div>
            <div class="form-check"><input class="form-check-input shipment-check" type="checkbox" id="packingCheck"><label class="form-check-label" for="packingCheck">Đã hoàn tất đóng gói/chằng buộc và sẵn sàng bàn giao</label></div>
            <div id="shipmentError" class="text-danger small mt-2"></div>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Kiểm tra lại</button><button type="button" id="submitBatch" class="btn btn-primary">Xác nhận xuất và trừ tồn</button></div>
    </div></div>
</div>

@functions {
    string StatusLabel(string status) => status switch { "READY" => "Sẵn sàng xuất", "ISSUING" => "Đang xuất hàng", "ISSUED" => "Đã xuất", "CANCELLED" => "Đã hủy", _ => "Nháp" };
    string QuantityStep(byte scale) => scale == 0 ? "1" : "0." + new string('0', scale - 1) + "1";
    string FormatQuantity(decimal value, byte scale) => FormatHelper.FormatQuantity(value, scale);
}

@section Scripts {
@Html.AntiForgeryToken()
<script>
    const requiresPickingPolicy = @(Model.Order.SourceType == "SALES_ORDER" ? "true" : "false");
    let checks = [...document.querySelectorAll('.pick-check')];
    const reviewButton = document.getElementById('reviewBatch');
    const submitButton = document.getElementById('submitBatch');
    const batchError = document.getElementById('batchError');

    checks.forEach(check => {
        check.closest('.pick-row').querySelector('.pick-quantity').disabled = !check.checked;
        check.addEventListener('change', () => {
            check.closest('.pick-row').querySelector('.pick-quantity').disabled = !check.checked;
            validateBatch();
        });
    });
    document.querySelectorAll('.pick-quantity').forEach(input => input.addEventListener('input', validateBatch));
    document.getElementById('deviationReason')?.addEventListener('input', validateBatch);
    document.querySelectorAll('.shipment-check').forEach(input => input.addEventListener('change', validateBatch));
    reviewButton?.addEventListener('click', renderBatchSummary);
    submitButton?.addEventListener('click', submitBatch);
    document.querySelectorAll('.picking-method').forEach(select => {
        select.addEventListener('change', () => applyMethod(select));
        applyMethod(select);
    });

    function applyMethod(select) {
        const rows = [...document.querySelectorAll('.pick-row')].filter(r => r.dataset.itemId === select.dataset.itemId);
        rows.sort((a,b) => {
            const expiry = select.value === 'FEFO' ? (a.dataset.expiry || '9999').localeCompare(b.dataset.expiry || '9999') : 0;
            return expiry || (a.dataset.received || '9999').localeCompare(b.dataset.received || '9999') ||
                a.querySelector('td:nth-child(2)').textContent.localeCompare(b.querySelector('td:nth-child(2)').textContent, 'vi', {numeric:true});
        });
        let remaining = Number(rows[0]?.dataset.itemRemaining || 0);
        rows.forEach(row => {
            row.parentElement.appendChild(row);
            const input = row.querySelector('.pick-quantity'), check = row.querySelector('.pick-check');
            const suggestion = select.value === 'FEFO' && !row.dataset.expiry ? 0 : Math.min(remaining, Number(input.max));
            remaining -= suggestion;
            row.dataset.suggested = String(suggestion);
            row.dataset.method = select.value;
            check.checked = select.value !== 'CUSTOM' && suggestion > 0;
            input.value = check.checked ? suggestion : '';
            input.disabled = !check.checked;
            row.hidden = select.value !== 'CUSTOM' && suggestion <= 0;
            row.querySelector('.suggestion-badge').hidden = select.value === 'CUSTOM' || suggestion <= 0;
        });
        checks = [...document.querySelectorAll('.pick-check')];
        validateBatch();
    }

    function validateBatch() {
        const selectedRows = checks.filter(check => check.checked).map(check => check.closest('.pick-row'));
        let message = selectedRows.length ? '' : 'Chọn ít nhất một vị trí cần lấy.';
        const totals = new Map();
        let deviatesFromSuggestion = false;
        if (selectedRows.some(row => row.dataset.method === 'CUSTOM')) deviatesFromSuggestion = true;
        selectedRows.forEach(row => {
            const input = row.querySelector('.pick-quantity');
            const quantity = Number(input.value);
            const maximum = Number(input.max);
            if (!input.checkValidity() || !Number.isFinite(quantity) || !(quantity > 0) || quantity > maximum) message = 'Số lượng thực xuất phải đúng đơn vị tính, lớn hơn 0 và không vượt tồn khả dụng tại vị trí.';
            totals.set(row.dataset.itemId, (totals.get(row.dataset.itemId) || 0) + quantity);
            if (totals.get(row.dataset.itemId) > Number(row.dataset.itemRemaining))
                message = 'Tổng số lượng chọn của một mặt hàng vượt số lượng còn phải giao trong phiếu.';
        });
        // Compare the proposed route for THIS batch quantity, not the full shipment.
        const suggestionRemaining = new Map(totals);
        checks.forEach(check => {
            const row = check.closest('.pick-row');
            const input = row.querySelector('.pick-quantity');
            const remaining = suggestionRemaining.get(row.dataset.itemId) || 0;
            const expected = row.dataset.method === 'FEFO' && !row.dataset.expiry ? 0 : Math.min(remaining, Number(input.max));
            suggestionRemaining.set(row.dataset.itemId, remaining - expected);
            const actual = check.checked ? Number(input.value) : 0;
            if (Math.abs(actual - expected) > 0.000001) deviatesFromSuggestion = true;
        });
        const deviationReason = document.getElementById('deviationReason')?.value?.trim() || '';
        if (!message && requiresPickingPolicy && deviatesFromSuggestion && (deviationReason.length < 10 || deviationReason.length > 500))
            message = 'Lấy khác gợi ý FIFO/FEFO: vui lòng nhập lý do từ 10 đến 500 ký tự.';
        if (batchError) batchError.textContent = message;
        if (reviewButton) reviewButton.disabled = !!message;
        return !message;
    }

    function renderBatchSummary() {
        const rows = checks.filter(check => check.checked).map(check => check.closest('.pick-row'));
        const summary = document.getElementById('batchSummary');
        summary.replaceChildren();
        rows.forEach(row => {
            const input = row.querySelector('.pick-quantity');
            const line = document.createElement('div');
            line.className = 'd-flex justify-content-between border-bottom py-2';
            const label = document.createElement('span');
            label.textContent = row.children[1].innerText.trim();
            const quantity = document.createElement('strong');
            quantity.textContent = input.value;
            line.append(label, quantity);
            summary.append(line);
        });
    }

    async function submitBatch() {
        if (!validateBatch()) return;
        if (!document.getElementById('physicalCheck').checked || !document.getElementById('packingCheck').checked) {
            document.getElementById('shipmentError').textContent = 'Phải xác nhận đủ hai bước kiểm tra trước khi bàn giao.';
            return;
        }
        document.getElementById('shipmentError').textContent = '';
        const payload = checks.filter(check => check.checked).map(check => {
            const row = check.closest('.pick-row');
            const input = row.querySelector('.pick-quantity');
            return {
                outboundOrderId: Number(input.dataset.orderId),
                outboundOrderItemId: Number(row.dataset.itemId),
                pickingMethod: row.dataset.method || 'DEFAULT',
                storageLocationId: Number(input.dataset.locationId),
                productLotId: Number(input.dataset.lotId),
                inventoryReservationId: input.dataset.reservationId ? Number(input.dataset.reservationId) : null,
                pickQuantity: Number(input.value), notes: 'Ghi nhận theo đợt xuất hàng.',
                deviationReason: document.getElementById('deviationReason')?.value?.trim() || null,
                physicalCheckConfirmed: document.getElementById('physicalCheck').checked,
                packingConfirmed: document.getElementById('packingCheck').checked
            };
        });
        submitButton.disabled = true;
        try {
            const response = await fetch('?handler=PickBatch', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
                body: JSON.stringify(payload)
            });
            const contentType = response.headers.get('content-type') || '';
            const result = contentType.includes('application/json') ? await response.json() : { success: false, message: 'Máy chủ trả về phản hồi không hợp lệ.' };
            if (result.success) {
                if (result.completed) window.location.href = '@Url.Page("./Details", new { id = Model.Order.OutboundOrderId })';
                else location.reload();
            }
            else { batchError.textContent = result.message || 'Không thể ghi nhận đợt xuất hàng.'; submitButton.disabled = false; }
        } catch {
            batchError.textContent = 'Mất kết nối khi ghi nhận. Hãy tải lại phiếu để kiểm tra trước khi thử lại.';
            submitButton.disabled = false;
        }
    }

    validateBatch();
</script>
}
