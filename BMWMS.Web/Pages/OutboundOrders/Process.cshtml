@page "{id:int}"
@using System.Text.Json
@model BMWMS.Web.Pages.OutboundOrders.ProcessModel
@using BMWMS.Web.Helpers
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Thực hiện xuất kho - {Model.Order.OutboundOrderNumber}";
    var isSale = Model.Order.SourceType == "SALES_ORDER";
}

<div class="container-fluid py-4">
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) { <div class="alert alert-success">@Model.SuccessMessage</div> }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <div class="text-muted mb-1">Thực hiện lấy hàng và xác nhận xuất kho</div>
            <h3 class="mb-0">@Model.Order.OutboundOrderNumber</h3>
        </div>
        <a asp-page="./Details" asp-route-id="@Model.Order.OutboundOrderId" class="btn btn-outline-secondary">Chi tiết phiếu xuất</a>
    </div>

    <div class="alert alert-info">
        <strong>@(isSale ? "Xuất bán theo SO" : "Trả hàng nhà cung cấp theo PO"):</strong>
        @Model.Order.SourceReference — @Model.Order.PartnerName.
        Chọn một hoặc nhiều vị trí của nhiều mặt hàng trong cùng lần giao. Hệ thống chỉ ghi nhận khi toàn bộ lựa chọn hợp lệ.
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body row g-3">
            <div class="col-md-3"><div class="text-muted small">Trạng thái</div><strong>@StatusLabel(Model.Order.Status)</strong></div>
            <div class="col-md-3"><div class="text-muted small">Ngày xuất dự kiến</div><strong>@Model.Order.ExpectedIssueDate?.ToString("dd/MM/yyyy")</strong></div>
            <div class="col-md-6"><div class="text-muted small">Ghi chú</div><span>@(string.IsNullOrWhiteSpace(Model.Order.Notes) ? "Không có" : Model.Order.Notes)</span></div>
        </div>
    </div>

    @foreach (var item in Model.Order.Items)
    {
        var progress = item.RequestedQuantity > 0 ? Math.Min(100, (int)(item.IssuedQuantity * 100 / item.RequestedQuantity)) : 0;
        var suggestedRemaining = item.RemainingQuantity;
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div><span class="badge bg-secondary">@item.ProductCode</span><h5 class="mt-2 mb-1">@item.ProductName</h5><span class="text-muted">Đơn vị: @item.UnitName</span></div>
                    <div class="text-end"><strong>@FormatQuantity(item.IssuedQuantity, item.QuantityScale) / @FormatQuantity(item.RequestedQuantity, item.QuantityScale)</strong><div class="text-muted">Còn @FormatQuantity(item.RemainingQuantity, item.QuantityScale)</div></div>
                </div>
                <div class="progress mb-3" style="height:8px"><div class="progress-bar" style="width:@progress%"></div></div>

                @if (item.PickedDetails.Count > 0)
                {
                    <div class="mb-3"><div class="fw-semibold mb-2">Đã xuất</div>
                    @foreach (var picked in item.PickedDetails)
                    { <span class="badge bg-success-subtle text-success border me-2">@picked.LocationCode · @FormatQuantity(picked.IssuedQuantity, item.QuantityScale) @item.UnitName</span> }
                    </div>
                }

                <div class="fw-semibold mb-2">Phân bổ lấy hàng</div>
                @if (item.AvailableLocations.Count == 0)
                { <div class="text-muted">Không còn phân bổ khả dụng.</div> }
                else
                {
                    <div class="table-responsive"><table class="table table-sm align-middle">
                        <thead><tr><th style="width:55px">Chọn</th><th>Vị trí lấy</th><th>Ngày nhập / Hạn sử dụng</th><th class="text-end">Khả dụng</th><th style="width:190px">Thực xuất</th></tr></thead>
                        <tbody>
                        @foreach (var location in item.AvailableLocations)
                        {
                            var suggested = Math.Min(suggestedRemaining, location.AvailableQuantity);
                            suggestedRemaining -= suggested;
                            <tr class="pick-row" data-item-id="@item.OutboundOrderItemId" data-item-remaining="@item.RemainingQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                <td><input type="checkbox" class="form-check-input pick-check" aria-label="Chọn vị trí @location.LocationCode" @(suggested > 0 ? "checked" : null) /></td>
                                <td>@(string.IsNullOrWhiteSpace(location.LocationPath) ? location.LocationCode : location.LocationPath) @if (suggested > 0) { <span class="badge bg-info-subtle text-info-emphasis">Đề xuất</span> }</td>
                                <td><div>@(location.FirstReceivedDate?.ToString("dd/MM/yyyy") ?? "Không xác định")</div><div class="text-muted small">HSD: @(location.ExpiryDate?.ToString("dd/MM/yyyy") ?? "Không áp dụng")</div></td>
                                <td class="text-end">@FormatQuantity(location.AvailableQuantity, item.QuantityScale) @item.UnitName</td>
                                <td>
                                    <input type="number" class="form-control form-control-sm pick-quantity"
                                           min="@QuantityStep(item.QuantityScale)" max="@location.AvailableQuantity"
                                           step="@QuantityStep(item.QuantityScale)"
                                           value="@suggested.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                           data-order-id="@Model.Order.OutboundOrderId"
                                           data-location-id="@location.StorageLocationId"
                                           data-lot-id="@location.ProductLotId"
                                           data-reservation-id="@location.InventoryReservationId" disabled="@(suggested <= 0)" />
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>
    }

    @if (Model.Order.Status == "ISSUING")
    {
        <div class="sticky-bottom bg-body border-top py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <div id="batchError" class="text-danger small"></div>
                <div class="mt-2"><label for="deviationReason" class="form-label small mb-1">Lý do lấy khác đề xuất (chỉ nhập khi có)</label><input id="deviationReason" class="form-control form-control-sm" minlength="10" maxlength="500" placeholder="Ví dụ: vị trí đề xuất tạm thời khó tiếp cận" /></div>
                @if (Model.Order.Items.Any(item => item.IssuedQuantity > 0 && item.RemainingQuantity > 0))
                {
                    <form method="post" asp-page-handler="Complete" asp-route-id="@Model.Order.OutboundOrderId" class="mt-2" onsubmit="return confirm('Hoàn tất đợt xuất theo số lượng thực tế đã ghi nhận? Phần còn lại của đơn tham chiếu vẫn được giữ để xử lý sau.');">
                        <div class="input-group"><input name="reason" class="form-control" minlength="10" maxlength="500" placeholder="Lý do kết thúc đợt khi còn thiếu" required /><button class="btn btn-outline-warning">Hoàn tất đợt giao một phần</button></div>
                    </form>
                }
            </div>
            <button type="button" id="reviewBatch" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#confirmPickModal" disabled>Xem lại và xác nhận xuất</button>
        </div>
    }
</div>

<div class="modal fade" id="confirmPickModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Xác nhận trừ tồn kho</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body"><p class="mb-2">Hệ thống sẽ ghi nhận đồng thời tất cả các dòng đã chọn. Nếu một dòng không còn hợp lệ, toàn bộ lần ghi nhận sẽ bị hủy.</p><div id="batchSummary" class="small"></div></div>
        <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Kiểm tra lại</button><button type="button" id="submitBatch" class="btn btn-primary">Xác nhận xuất và trừ tồn</button></div>
    </div></div>
</div>

@functions {
    string StatusLabel(string status) => status switch { "READY" => "Sẵn sàng xuất", "ISSUING" => "Đang xuất hàng", "ISSUED" => "Đã xuất", "CANCELLED" => "Đã hủy", _ => "Nháp" };
    string QuantityStep(byte scale) => scale == 0 ? "1" : "0." + new string('0', scale - 1) + "1";
    string FormatQuantity(decimal value, byte scale) => FormatHelper.FormatQuantity(value, scale);
}

@section Scripts {
@Html.AntiForgeryToken()
<script>
    const checks = [...document.querySelectorAll('.pick-check')];
    const reviewButton = document.getElementById('reviewBatch');
    const submitButton = document.getElementById('submitBatch');
    const batchError = document.getElementById('batchError');

    checks.forEach(check => {
        check.closest('.pick-row').querySelector('.pick-quantity').disabled = !check.checked;
        check.addEventListener('change', () => {
            check.closest('.pick-row').querySelector('.pick-quantity').disabled = !check.checked;
            validateBatch();
        });
    });
    document.querySelectorAll('.pick-quantity').forEach(input => input.addEventListener('input', validateBatch));
    reviewButton?.addEventListener('click', renderBatchSummary);
    submitButton?.addEventListener('click', submitBatch);

    function validateBatch() {
        const selectedRows = checks.filter(check => check.checked).map(check => check.closest('.pick-row'));
        let message = selectedRows.length ? '' : 'Chọn ít nhất một vị trí cần lấy.';
        const totals = new Map();
        selectedRows.forEach(row => {
            const input = row.querySelector('.pick-quantity');
            const quantity = Number(input.value);
            const maximum = Number(input.max);
            if (!(quantity > 0) || quantity > maximum) message = 'Số lượng thực xuất phải lớn hơn 0 và không vượt tồn khả dụng tại vị trí.';
            totals.set(row.dataset.itemId, (totals.get(row.dataset.itemId) || 0) + quantity);
            if (totals.get(row.dataset.itemId) > Number(row.dataset.itemRemaining))
                message = 'Tổng số lượng chọn của một mặt hàng vượt số lượng còn phải giao trong phiếu.';
        });
        if (batchError) batchError.textContent = message;
        if (reviewButton) reviewButton.disabled = !!message;
        return !message;
    }

    function renderBatchSummary() {
        const rows = checks.filter(check => check.checked).map(check => check.closest('.pick-row'));
        document.getElementById('batchSummary').innerHTML = rows.map(row => {
            const input = row.querySelector('.pick-quantity');
            const location = row.children[1].innerText.trim();
            return `<div class="d-flex justify-content-between border-bottom py-2"><span>${location}</span><strong>${input.value}</strong></div>`;
        }).join('');
    }

    async function submitBatch() {
        if (!validateBatch()) return;
        const payload = checks.filter(check => check.checked).map(check => {
            const row = check.closest('.pick-row');
            const input = row.querySelector('.pick-quantity');
            return {
                outboundOrderId: Number(input.dataset.orderId),
                outboundOrderItemId: Number(row.dataset.itemId),
                storageLocationId: Number(input.dataset.locationId),
                productLotId: Number(input.dataset.lotId),
                inventoryReservationId: input.dataset.reservationId ? Number(input.dataset.reservationId) : null,
                pickQuantity: Number(input.value), notes: 'Ghi nhận theo đợt xuất hàng.',
                deviationReason: document.getElementById('deviationReason')?.value?.trim() || null
            };
        });
        submitButton.disabled = true;
        try {
            const response = await fetch('?handler=PickBatch', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
                body: JSON.stringify(payload)
            });
            const contentType = response.headers.get('content-type') || '';
            const result = contentType.includes('application/json') ? await response.json() : { success: false, message: 'Máy chủ trả về phản hồi không hợp lệ.' };
            if (result.success) location.reload();
            else { batchError.textContent = result.message || 'Không thể ghi nhận đợt xuất hàng.'; submitButton.disabled = false; }
        } catch {
            batchError.textContent = 'Mất kết nối khi ghi nhận. Hãy tải lại phiếu để kiểm tra trước khi thử lại.';
            submitButton.disabled = false;
        }
    }

    validateBatch();
</script>
}
