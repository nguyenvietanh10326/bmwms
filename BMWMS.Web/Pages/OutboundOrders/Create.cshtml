@page
@model BMWMS.Web.Pages.OutboundOrders.CreateModel
@using BMWMS.Web.Helpers
@{
    Layout = "_AdminLayout";
    var isPurchaseReturn = User.IsInRole("WAREHOUSE_MANAGER") || User.IsInRole("SYSTEM_ADMIN");
    ViewData["Title"] = isPurchaseReturn ? "Duyệt lệnh trả NCC" : "Tạo phiếu xuất bán";
    ViewData["OutboundSourceType"] = isPurchaseReturn ? "PURCHASE_RETURN" : "SALES_ORDER";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-1">@ViewData["Title"]</h3>

        </div>
        <a asp-page="./Index" class="btn btn-outline-secondary">Danh sách phiếu xuất</a>
    </div>

    <form method="post" id="outboundForm" data-return="@(isPurchaseReturn ? "true" : "false")">
        <div asp-validation-summary="All" class="alert alert-danger"></div>
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-white fw-semibold">Thông tin nguồn xuất</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Nghiệp vụ xuất</label>
                        <input type="hidden" asp-for="Input.SourceType" id="sourceType" />
                        <input class="form-control" value="@(isPurchaseReturn ? "Trả hàng nhà cung cấp theo PO" : "Giao hàng bán theo SO")" readonly />
                    </div>
                    @if (isPurchaseReturn)
                    {
                        <div class="col-md-4">
                            <label class="form-label">Nhân viên kho thực hiện</label>
                            <select asp-for="Input.AssignedToUserId" asp-items="Model.AssigneeOptions" class="form-select" required></select>
                            <span asp-validation-for="Input.AssignedToUserId" class="text-danger"></span>
                        </div>
                    }
                    <div class="col-12 order-first source-sales @(isPurchaseReturn ? "d-none" : "")">
                        <label class="form-label">Đơn bán hàng đủ điều kiện xuất</label>
                        <div class="row g-2"><div class="col-md-4"><input type="search" id="referenceSearch" class="form-control" placeholder="Tìm mã đơn hoặc đối tác" aria-label="Tìm đơn tham chiếu" /></div><div class="col-md-8"><select asp-for="Input.SalesOrderId" asp-items="Model.SalesOrderOptions" class="form-select" id="salesOrder"></select></div></div>
                    </div>
                    <div class="col-12 order-first source-purchase @(!isPurchaseReturn ? "d-none" : "")">
                        <label class="form-label">Đơn mua hàng đã nhập</label>
                        <div class="row g-2"><div class="col-md-4"><input type="search" id="purchaseReferenceSearch" class="form-control" placeholder="Tìm mã đơn hoặc đối tác" aria-label="Tìm đơn tham chiếu" /></div><div class="col-md-8"><select asp-for="Input.PurchaseOrderId" asp-items="Model.PurchaseOrderOptions" class="form-select" id="purchaseOrder"></select></div></div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Đối tác</label>
                        <input asp-for="Input.PartnerName" class="form-control" id="partnerName" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Mã đơn tham chiếu</label>
                        <input asp-for="Input.SourceReference" class="form-control" id="sourceReference" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Ngày dự kiến xuất</label>
                        <input asp-for="Input.ExpectedIssueDate" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">@(isPurchaseReturn ? "Lý do trả nhà cung cấp" : "Ghi chú nghiệp vụ")</label>
                        <textarea asp-for="Input.Notes" class="form-control" rows="2" required="@isPurchaseReturn" minlength="@(isPurchaseReturn ? "10" : null)" maxlength="500" placeholder="Lý do trả NCC hoặc yêu cầu giao hàng"></textarea>
                        <span asp-validation-for="Input.Notes" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white d-flex justify-content-between">
                <span class="fw-semibold">Mặt hàng cần xuất</span>
                <span class="text-muted" id="itemCount">@Model.Input.Items.Count mặt hàng</span>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0" style="min-width:900px">
                    <thead class="table-light">
                        @if (isPurchaseReturn)
                        { <tr><th>STT</th><th>Vị trí</th><th>Ngày nhập / HSD</th><th class="text-end">Đang cất</th><th class="text-end">Đang giữ</th><th class="text-end">Có thể trả</th><th style="width:160px">Số lượng đợt này</th></tr> }
                        else
                        { <tr><th>Mã hàng</th><th>Tên sản phẩm</th><th>Đơn vị</th><th class="text-end">Khách đặt</th><th class="text-end">Còn có thể giao</th><th style="width:180px">Số lượng đợt này</th></tr> }
                    </thead>
                    <tbody id="itemsBody">
                    @for (var i = 0; !isPurchaseReturn && i < Model.Input.Items.Count; i++)
                    {
                        <tr>
                            <td><input type="hidden" asp-for="Input.Items[i].ProductId" /><input type="hidden" asp-for="Input.Items[i].ProductCode" />@Model.Input.Items[i].ProductCode</td>
                            <td><input type="hidden" asp-for="Input.Items[i].ProductName" />@Model.Input.Items[i].ProductName</td>
                            <td><input type="hidden" asp-for="Input.Items[i].UnitName" />@Model.Input.Items[i].UnitName</td>
                            <td class="text-end"><input type="hidden" name="Input.Items[@i].ReferenceQuantity" value="@(Model.Input.Items[i].ReferenceQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture))" />@FormatQuantity(Model.Input.Items[i].ReferenceQuantity, Model.Input.Items[i].QuantityScale)</td>
                            <td class="text-end"><input type="hidden" name="Input.Items[@i].AvailableQuantity" value="@(Model.Input.Items[i].AvailableQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture))" />@FormatQuantity(Model.Input.Items[i].AvailableQuantity, Model.Input.Items[i].QuantityScale)</td>
                            <td><input type="hidden" asp-for="Input.Items[i].QuantityScale" /><input type="hidden" asp-for="Input.Items[i].TrackLot" /><input asp-for="Input.Items[i].RequestedQuantity" type="number" min="0" max="@(Model.Input.Items[i].AvailableQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture))" step="@QuantityStep(Model.Input.Items[i].QuantityScale)" class="form-control text-end" /></td>
                        </tr>
                        @if (isPurchaseReturn && Model.Input.Items[i].SourceLocations.Count > 0)
                        {
                            <tr><td colspan="6">@* Quantities are reloaded from the server after rendering below. *@
                            <div class="return-source-placeholder" data-item="@i"></div>
                            </td></tr>
                        }
                    }
                    @if (Model.Input.Items.Count == 0 || isPurchaseReturn)
                    {
                        <tr><td colspan="@(isPurchaseReturn ? 7 : 6)" class="text-center text-muted py-4">Chọn đơn tham chiếu để tải mặt hàng có thể xuất.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-white d-flex justify-content-end gap-2">
                <span class="text-muted small me-auto align-self-center" id="createHint">Chọn đơn tham chiếu để tải các mặt hàng còn có thể xuất.</span>
                <button type="submit" id="createOutboundButton" class="btn btn-primary" @(Model.Input.Items.Count == 0 ? "disabled" : null)>@(isPurchaseReturn ? "Duyệt và giao lệnh trả NCC" : "Tạo phiếu xuất")</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
    const sourceType = document.getElementById('sourceType');
    const salesOrder = document.getElementById('salesOrder');
    const purchaseOrder = document.getElementById('purchaseOrder');
    const body = document.getElementById('itemsBody');
    const createOutboundButton = document.getElementById('createOutboundButton');
    const createHint = document.getElementById('createHint');
    let referenceVersion = 0;

    function toggleSource() {
        const isSales = sourceType.value === 'SALES_ORDER';
        document.querySelector('.source-sales').classList.toggle('d-none', !isSales);
        document.querySelector('.source-purchase').classList.toggle('d-none', isSales);
    }

    async function loadReference(kind, id, restorePosted = false) {
        const version = ++referenceVersion;
        document.getElementById('partnerName').value = '';
        document.getElementById('sourceReference').value = '';
        if (!id) { renderItems([]); return; }
        const handler = kind === 'sales' ? 'SalesOrderDetail' : 'PurchaseOrderDetail';
        createOutboundButton.disabled = true;
        createHint.textContent = 'Đang tải dữ liệu đơn tham chiếu...';
        let response;
        try {
            response = await fetch(`?handler=${handler}&id=${id}`, { headers: { 'Accept': 'application/json' } });
            if (version !== referenceVersion) return;
        } catch {
            if (version !== referenceVersion) return;
            renderItems([]);
            createHint.textContent = 'Mất kết nối khi tải đơn tham chiếu. Vui lòng thử lại.';
            return;
        }
        if (!response.ok) {
            renderItems([]);
            let message = 'Không tải được dữ liệu đơn tham chiếu.';
            try { message = (await response.json()).message || message; } catch { }
            createHint.textContent = message;
            return;
        }
        let data;
        try { data = await response.json(); }
        catch { renderItems([]); createHint.textContent = 'Dữ liệu đơn tham chiếu không hợp lệ. Vui lòng tải lại.'; return; }
        if (version !== referenceVersion) return;
        document.getElementById('partnerName').value = kind === 'sales' ? data.customerName : data.supplierName;
        document.getElementById('sourceReference').value = kind === 'sales' ? data.salesOrderNumber : data.purchaseOrderNumber;
        const items = (data.items || []).map(x => ({
            productId: x.productId, productCode: x.productCode, productName: x.productName,
            unitName: x.unitOfMeasure || x.unitName || '',
            quantityScale: x.quantityScale || 0, trackLot: x.trackLot || false,
            referenceQuantity: kind === 'sales' ? x.quantity : x.receivedQuantity,
            availableQuantity: kind === 'sales' ? x.reservedQuantity : x.remainingQuantity,
            sourceLocations: x.sourceLocations || []
        }));
        renderItems(items);
        if (restorePosted) {
            const posted = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Input.Items));
            items.forEach((item,i) => {
                const previous = posted.find(p => p.ProductId === item.productId);
                if (!previous) return;
                const method = document.querySelector(`.return-source-method[data-item="${i}"]`);
                if (method) method.value = 'CUSTOM';
                item.sourceLocations.forEach((source,j) => {
                    const old = (previous.SourceLocations || []).find(s => s.StorageLocationId === source.storageLocationId && s.ProductLotId === source.productLotId);
                    const input = document.querySelector(`.return-source-quantity[data-item="${i}"][data-source="${j}"]`);
                    if (input) input.value = old?.Quantity ?? 0;
                });
                document.querySelector(`[name="Input.Items[${i}].RequestedQuantity"]`).value =
                    [...document.querySelectorAll(`.return-source-quantity[data-item="${i}"]`)].reduce((sum,el) => sum + Number(el.value || 0),0).toFixed(item.quantityScale);
            });
        }
    }

    function escapeHtml(value) { const d = document.createElement('div'); d.textContent = value ?? ''; return d.innerHTML.replaceAll('"', '&quot;').replaceAll("'", '&#39;'); }
    function quantityStep(scale) { return scale === 0 ? '1' : `0.${'0'.repeat(scale - 1)}1`; }
    function formatQuantity(value, scale) {
        return Number(value).toLocaleString('en-US', {
            useGrouping: false,
            maximumFractionDigits: scale
        });
    }
    function renderItems(items) {
        document.getElementById('itemCount').textContent = `${items.length} mặt hàng`;
        createOutboundButton.disabled = items.length === 0;
        createHint.textContent = items.length
            ? 'Nhập số lượng đợt này; nhập 0 nếu chưa xuất mặt hàng.'
            : 'Đơn không còn mặt hàng có thể xuất.';
        if (!items.length) { body.innerHTML = `<tr><td colspan="${sourceType.value === 'PURCHASE_RETURN' ? 7 : 6}" class="text-center text-muted py-4">Chọn đơn còn hàng có thể xuất để tải thông tin.</td></tr>`; return; }
        body.innerHTML = sourceType.value === 'PURCHASE_RETURN' ? items.map((x,i) => returnSources(x,i)).join('') : items.map((x, i) => `<tr>
            <td><input type="hidden" name="Input.Items[${i}].ProductId" value="${x.productId}"><input type="hidden" name="Input.Items[${i}].ProductCode" value="${escapeHtml(x.productCode)}">${escapeHtml(x.productCode)}</td>
            <td><input type="hidden" name="Input.Items[${i}].ProductName" value="${escapeHtml(x.productName)}">${escapeHtml(x.productName)}</td>
            <td><input type="hidden" name="Input.Items[${i}].UnitName" value="${escapeHtml(x.unitName)}">${escapeHtml(x.unitName)}</td>
            <td class="text-end"><input type="hidden" name="Input.Items[${i}].ReferenceQuantity" value="${x.referenceQuantity}">${formatQuantity(x.referenceQuantity, x.quantityScale)}</td>
            <td class="text-end"><input type="hidden" name="Input.Items[${i}].AvailableQuantity" value="${x.availableQuantity}">${formatQuantity(x.availableQuantity, x.quantityScale)}</td>
            <td><input type="hidden" name="Input.Items[${i}].QuantityScale" value="${x.quantityScale}"><input type="hidden" name="Input.Items[${i}].TrackLot" value="${x.trackLot}"><input type="number" name="Input.Items[${i}].RequestedQuantity" value="${x.availableQuantity}" min="0" max="${x.availableQuantity}" step="${quantityStep(x.quantityScale)}" class="form-control text-end" required></td></tr>
            ${(x.sourceLocations || []).length ? returnSources(x, i) : ''}`).join('');
        document.querySelectorAll('.return-source-method').forEach(select => {
            select.addEventListener('change', () => suggestReturn(Number(select.dataset.item), items[Number(select.dataset.item)]));
            suggestReturn(Number(select.dataset.item), items[Number(select.dataset.item)]);
        });
        document.querySelectorAll('.return-source-quantity').forEach(input => input.addEventListener('input', () => {
            const i = input.dataset.item;
            document.querySelector(`[name="Input.Items[${i}].RequestedQuantity"]`).value =
                [...document.querySelectorAll(`.return-source-quantity[data-item="${i}"]`)].reduce((s, el) => s + Number(el.value || 0), 0).toFixed(items[Number(i)].quantityScale);
        }));
    }
    function returnSources(x, i) {
        return `<tr class="table-light"><td colspan="7"><div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div><strong>${escapeHtml(x.productCode)} — ${escapeHtml(x.productName)}</strong><span class="ms-2 text-muted">ĐVT: ${escapeHtml(x.unitName)}</span></div>
        <div class="d-flex align-items-center gap-2"><label class="mb-0" for="method${i}">Gợi ý lấy hàng</label><select id="method${i}" class="form-select form-select-sm return-source-method" data-item="${i}" style="width:190px"><option value="FIFO">FIFO — ngày nhập</option><option value="FEFO">FEFO — HSD</option><option value="CUSTOM">Tự chọn</option></select></div></div>
        <input type="hidden" name="Input.Items[${i}].ProductId" value="${x.productId}"><input type="hidden" name="Input.Items[${i}].ProductCode" value="${escapeHtml(x.productCode)}"><input type="hidden" name="Input.Items[${i}].ProductName" value="${escapeHtml(x.productName)}"><input type="hidden" name="Input.Items[${i}].UnitName" value="${escapeHtml(x.unitName)}"><input type="hidden" name="Input.Items[${i}].ReferenceQuantity" value="${x.referenceQuantity}"><input type="hidden" name="Input.Items[${i}].AvailableQuantity" value="${x.availableQuantity}"><input type="hidden" name="Input.Items[${i}].QuantityScale" value="${x.quantityScale}"><input type="hidden" name="Input.Items[${i}].RequestedQuantity" value="0"></td></tr>
        ${x.sourceLocations.map((s,j) => `<tr><td>${j+1}</td><td>${escapeHtml(s.locationPath)}</td><td>${escapeHtml(s.firstReceivedDate)}<div class="text-muted">HSD: ${escapeHtml(s.expiryDate || '—')}</div></td><td class="text-end">${formatQuantity(s.storedQuantity,x.quantityScale)}</td><td class="text-end">${formatQuantity(s.heldQuantity,x.quantityScale)}</td><td class="text-end">${formatQuantity(s.returnableQuantity,x.quantityScale)}</td><td>
        <input type="hidden" name="Input.Items[${i}].SourceLocations[${j}].StorageLocationId" value="${s.storageLocationId}"><input type="hidden" name="Input.Items[${i}].SourceLocations[${j}].ProductLotId" value="${s.productLotId}">
        <input type="number" aria-label="Số muốn trả ${escapeHtml(x.productName)} tại ${escapeHtml(s.locationPath)}" name="Input.Items[${i}].SourceLocations[${j}].Quantity" class="form-control text-end return-source-quantity" data-item="${i}" data-source="${j}" min="0" max="${s.returnableQuantity}" step="${quantityStep(x.quantityScale)}" value="0"></td></tr>`).join('')}`;
    }
    function suggestReturn(i,x) {
        const method = document.querySelector(`.return-source-method[data-item="${i}"]`).value;
        const total = document.querySelector(`[name="Input.Items[${i}].RequestedQuantity"]`);
        total.readOnly = true;
        let remainder = x.availableQuantity;
        const ordered = x.sourceLocations.map((s,j) => ({...s,j})).sort((a,b) =>
            (method === 'FEFO' ? (a.expiryDate || '9999').localeCompare(b.expiryDate || '9999') : 0) ||
            a.firstReceivedDate.localeCompare(b.firstReceivedDate) || a.locationPath.localeCompare(b.locationPath,undefined,{numeric:true}));
        ordered.forEach(s => {
            const input = document.querySelector(`.return-source-quantity[data-item="${i}"][data-source="${s.j}"]`);
            const q = method === 'CUSTOM' || (method === 'FEFO' && !s.expiryDate) ? 0 : Math.min(remainder,s.returnableQuantity);
            input.value = Number(q.toFixed(x.quantityScale)); remainder = Number((remainder - q).toFixed(x.quantityScale));
        });
        total.value = method === 'CUSTOM' ? 0 : (x.availableQuantity-remainder).toFixed(x.quantityScale);
    }

    salesOrder.addEventListener('change', e => loadReference('sales', e.target.value));
    purchaseOrder.addEventListener('change', e => loadReference('purchase', e.target.value));
    ['referenceSearch', 'purchaseReferenceSearch'].forEach((id, index) => {
        const search = document.getElementById(id);
        const select = index === 0 ? salesOrder : purchaseOrder;
        if (search) search.addEventListener('input', () => {
            const keyword = search.value.trim().toLocaleLowerCase('vi');
            Array.from(select.options).forEach(option => { option.hidden = !!option.value && !option.selected && !option.text.toLocaleLowerCase('vi').includes(keyword); });
        });
    });
    document.getElementById('outboundForm').addEventListener('submit', event => {
        if (!event.target.checkValidity()) return;
        if (event.target.dataset.return === 'true' && !confirm('Duyệt trả hàng cho NCC và giao lệnh cho nhân viên đã chọn?')) event.preventDefault();
    });
    toggleSource();
    // Reload source locations on initial/server-error rendering; never trust posted stock figures.
    if (sourceType.value === 'PURCHASE_RETURN' && purchaseOrder.value) loadReference('purchase', purchaseOrder.value, @(ViewData.ModelState.ErrorCount > 0 ? "true" : "false"));
</script>
}
@functions {
    string QuantityStep(byte scale) => scale == 0 ? "1" : "0." + new string('0', scale - 1) + "1";
    string FormatQuantity(decimal value, byte scale) => FormatHelper.FormatQuantity(value, scale);
}
