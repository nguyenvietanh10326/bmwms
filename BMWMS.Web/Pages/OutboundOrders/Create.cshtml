@page
@model BMWMS.Web.Pages.OutboundOrders.CreateModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tạo phiếu xuất kho";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-1">Tạo phiếu xuất kho</h3>
            <div class="text-muted">Chọn đúng luồng nghiệp vụ; hệ thống tự tạo phiếu điều chuyển tác nghiệp vị trí.</div>
        </div>
        <a asp-page="./Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
    </div>

    <form method="post" id="outboundForm">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-white fw-semibold">Thông tin nguồn xuất</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Loại xuất hàng</label>
                        <select asp-for="Input.SourceType" class="form-select" id="sourceType">
                            <option value="SALES_ORDER">Bán hàng theo đơn bán (SO)</option>
                            <option value="PURCHASE_RETURN">Trả hàng nhà cung cấp theo đơn mua (PO)</option>
                        </select>
                    </div>
                    <div class="col-md-4 source-sales">
                        <label class="form-label">Đơn bán hàng đủ điều kiện xuất</label>
                        <select asp-for="Input.SalesOrderId" asp-items="Model.SalesOrderOptions" class="form-select" id="salesOrder"></select>
                        <div class="form-text">Chỉ hiển thị SO đã xác nhận, còn số lượng chưa xuất và chưa có phiếu xuất đang hoạt động.</div>
                    </div>
                    <div class="col-md-4 source-purchase d-none">
                        <label class="form-label">Đơn mua hàng đã nhập</label>
                        <select asp-for="Input.PurchaseOrderId" asp-items="Model.PurchaseOrderOptions" class="form-select" id="purchaseOrder"></select>
                        <div class="form-text">Chỉ hiển thị PO có hàng đã nhận và đã xếp vào vị trí kho, còn số lượng khả dụng để trả nhà cung cấp.</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Đối tác</label>
                        <input asp-for="Input.PartnerName" class="form-control" id="partnerName" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Mã đơn tham chiếu</label>
                        <input asp-for="Input.SourceReference" class="form-control" id="sourceReference" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Ngày dự kiến xuất</label>
                        <input asp-for="Input.ExpectedIssueDate" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nhân viên phụ trách</label>
                        <select asp-for="Input.AssignedToUserId" asp-items="Model.AssigneeOptions" class="form-select"></select>
                        <span asp-validation-for="Input.AssignedToUserId" class="text-danger"></span>
                        <div class="form-text">Chỉ hiển thị nhân viên kho đang hoạt động và chưa giữ phiếu nhập/xuất khác.</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Ghi chú nghiệp vụ</label>
                        <textarea asp-for="Input.Notes" class="form-control" rows="2" placeholder="Ví dụ: lý do trả NCC, yêu cầu giao hàng..."></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white d-flex justify-content-between">
                <span class="fw-semibold">Mặt hàng cần xuất</span>
                <span class="text-muted" id="itemCount">@Model.Input.Items.Count mặt hàng</span>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Mã hàng</th><th>Tên sản phẩm</th><th>ĐVT</th><th class="text-end">Theo đơn/đã nhận</th><th class="text-end">Có thể xuất</th><th style="width:180px">Số lượng xuất</th><th>Ghi chú</th></tr>
                    </thead>
                    <tbody id="itemsBody">
                    @for (var i = 0; i < Model.Input.Items.Count; i++)
                    {
                        <tr>
                            <td><input type="hidden" asp-for="Input.Items[i].ProductId" /><input type="hidden" asp-for="Input.Items[i].ProductCode" />@Model.Input.Items[i].ProductCode</td>
                            <td><input type="hidden" asp-for="Input.Items[i].ProductName" />@Model.Input.Items[i].ProductName</td>
                            <td><input type="hidden" asp-for="Input.Items[i].UnitName" />@Model.Input.Items[i].UnitName</td>
                            <td class="text-end"><input type="hidden" asp-for="Input.Items[i].ReferenceQuantity" />@FormatQuantity(Model.Input.Items[i].ReferenceQuantity, Model.Input.Items[i].QuantityScale)</td>
                            <td class="text-end"><input type="hidden" asp-for="Input.Items[i].AvailableQuantity" />@FormatQuantity(Model.Input.Items[i].AvailableQuantity, Model.Input.Items[i].QuantityScale)</td>
                            <td><input type="hidden" asp-for="Input.Items[i].QuantityScale" /><input type="hidden" asp-for="Input.Items[i].TrackLot" /><input asp-for="Input.Items[i].RequestedQuantity" type="number" min="@QuantityStep(Model.Input.Items[i].QuantityScale)" max="@Model.Input.Items[i].AvailableQuantity" step="@QuantityStep(Model.Input.Items[i].QuantityScale)" class="form-control text-end" /></td>
                            <td><input asp-for="Input.Items[i].Notes" class="form-control" /></td>
                        </tr>
                    }
                    @if (Model.Input.Items.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Chọn đơn tham chiếu để tải mặt hàng có thể xuất.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-white d-flex justify-content-end gap-2">
                <button type="submit" name="actionType" value="draft" class="btn btn-outline-secondary">Lưu nháp</button>
                <button type="submit" name="actionType" value="submit" class="btn btn-primary" @(Model.Input.Items.Count == 0 ? "disabled" : null)>Tạo phiếu và sẵn sàng xuất</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
    const sourceType = document.getElementById('sourceType');
    const salesOrder = document.getElementById('salesOrder');
    const purchaseOrder = document.getElementById('purchaseOrder');
    const body = document.getElementById('itemsBody');

    function toggleSource() {
        const isSales = sourceType.value === 'SALES_ORDER';
        document.querySelector('.source-sales').classList.toggle('d-none', !isSales);
        document.querySelector('.source-purchase').classList.toggle('d-none', isSales);
    }

    async function loadReference(kind, id) {
        if (!id) { renderItems([]); return; }
        const handler = kind === 'sales' ? 'SalesOrderDetail' : 'PurchaseOrderDetail';
        const response = await fetch(`?handler=${handler}&id=${id}`);
        if (!response.ok) { alert('Không tải được dữ liệu đơn tham chiếu.'); return; }
        const data = await response.json();
        document.getElementById('partnerName').value = kind === 'sales' ? data.customerName : data.supplierName;
        document.getElementById('sourceReference').value = kind === 'sales' ? data.salesOrderNumber : data.purchaseOrderNumber;
        const items = (data.items || []).map(x => ({
            productId: x.productId, productCode: x.productCode, productName: x.productName,
            unitName: x.unitOfMeasure || x.unitName || '',
            quantityScale: x.quantityScale || 0, trackLot: x.trackLot || false,
            referenceQuantity: kind === 'sales' ? x.quantity : x.receivedQuantity,
            availableQuantity: kind === 'sales' ? x.reservedQuantity : x.remainingQuantity
        }));
        renderItems(items);
    }

    function escapeHtml(value) { const d = document.createElement('div'); d.textContent = value ?? ''; return d.innerHTML; }
    function quantityStep(scale) { return scale === 0 ? '1' : `0.${'0'.repeat(scale - 1)}1`; }
    function formatQuantity(value, scale) { return Number(value).toLocaleString('vi-VN', { minimumFractionDigits: scale, maximumFractionDigits: scale }); }
    function renderItems(items) {
        document.getElementById('itemCount').textContent = `${items.length} mặt hàng`;
        if (!items.length) { body.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">Đơn không còn mặt hàng có thể xuất.</td></tr>'; return; }
        body.innerHTML = items.map((x, i) => `<tr>
            <td><input type="hidden" name="Input.Items[${i}].ProductId" value="${x.productId}"><input type="hidden" name="Input.Items[${i}].ProductCode" value="${escapeHtml(x.productCode)}">${escapeHtml(x.productCode)}</td>
            <td><input type="hidden" name="Input.Items[${i}].ProductName" value="${escapeHtml(x.productName)}">${escapeHtml(x.productName)}</td>
            <td><input type="hidden" name="Input.Items[${i}].UnitName" value="${escapeHtml(x.unitName)}">${escapeHtml(x.unitName)}</td>
            <td class="text-end"><input type="hidden" name="Input.Items[${i}].ReferenceQuantity" value="${x.referenceQuantity}">${formatQuantity(x.referenceQuantity, x.quantityScale)}</td>
            <td class="text-end"><input type="hidden" name="Input.Items[${i}].AvailableQuantity" value="${x.availableQuantity}">${formatQuantity(x.availableQuantity, x.quantityScale)}</td>
            <td><input type="hidden" name="Input.Items[${i}].QuantityScale" value="${x.quantityScale}"><input type="hidden" name="Input.Items[${i}].TrackLot" value="${x.trackLot}"><input type="number" name="Input.Items[${i}].RequestedQuantity" value="${x.availableQuantity}" min="${quantityStep(x.quantityScale)}" max="${x.availableQuantity}" step="${quantityStep(x.quantityScale)}" class="form-control text-end" required></td>
            <td><input name="Input.Items[${i}].Notes" class="form-control"></td></tr>`).join('');
    }

    sourceType.addEventListener('change', () => { toggleSource(); renderItems([]); });
    salesOrder.addEventListener('change', e => loadReference('sales', e.target.value));
    purchaseOrder.addEventListener('change', e => loadReference('purchase', e.target.value));
    toggleSource();
</script>
}
@functions {
    string QuantityStep(byte scale) => scale == 0 ? "1" : "0." + new string('0', scale - 1) + "1";
    string FormatQuantity(decimal value, byte scale) => value.ToString(scale == 0 ? "N0" : $"N{scale}");
}
