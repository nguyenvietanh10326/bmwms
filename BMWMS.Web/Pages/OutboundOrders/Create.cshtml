@page
@model BMWMS.Web.Pages.OutboundOrders.CreateModel
@using BMWMS.Web.Helpers
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tạo phiếu xuất kho";
    var isAdmin = User.IsInRole("SYSTEM_ADMIN");
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
        <div><h1 class="h3 mb-1">Tạo phiếu xuất kho</h1><p class="text-muted mb-0">Chọn đơn nguồn; số lượng thực xuất được ghi nhận khi nhân viên kiểm tra và lấy hàng.</p></div>
        <a asp-page="./Index" class="btn btn-outline-secondary">Danh sách phiếu xuất</a>
    </div>

    <form method="post" id="outboundForm">
        <div asp-validation-summary="All" class="alert alert-danger"></div>
        <section class="card border-0 shadow-sm mb-4"><div class="card-header bg-white fw-semibold">Thông tin phiếu xuất</div><div class="card-body">
            <div class="row g-3">
                <div class="col-lg-4"><label asp-for="Input.SourceType" class="form-label">Nghiệp vụ xuất <span class="text-danger">*</span></label>
                    <select asp-for="Input.SourceType" class="form-select" id="sourceType"><option value="SALES_ORDER">Giao hàng theo đơn bán</option><option value="PURCHASE_RETURN">Trả hàng nhà cung cấp theo đơn mua</option></select></div>
                @if (isAdmin)
                {
                    <div class="col-lg-4"><label asp-for="Input.AssignedToUserId" class="form-label">Nhân viên kho thực hiện <span class="text-danger">*</span></label><select asp-for="Input.AssignedToUserId" asp-items="Model.AssigneeOptions" class="form-select"></select></div>
                }
                <div class="col-lg-4"><label asp-for="Input.ExpectedIssueDate" class="form-label">Ngày dự kiến xuất <span class="text-danger">*</span></label><input asp-for="Input.ExpectedIssueDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" /></div>

                <div class="col-12 source-sales"><label class="form-label">Đơn bán hàng đã duyệt còn hàng cần giao</label><div class="row g-2"><div class="col-md-4"><input type="search" id="salesSearch" class="form-control" placeholder="Tìm mã SO hoặc khách hàng" /></div><div class="col-md-8"><select asp-for="Input.SalesOrderId" asp-items="Model.SalesOrderOptions" id="salesOrder" class="form-select"></select></div></div></div>
                <div class="col-12 source-purchase"><label class="form-label">Đơn mua hàng đã nhập còn hàng có thể trả</label><div class="row g-2"><div class="col-md-4"><input type="search" id="purchaseSearch" class="form-control" placeholder="Tìm mã PO hoặc nhà cung cấp" /></div><div class="col-md-8"><select asp-for="Input.PurchaseOrderId" asp-items="Model.PurchaseOrderOptions" id="purchaseOrder" class="form-select"></select></div></div></div>

                <div class="col-md-6"><label class="form-label">Đối tác</label><input asp-for="Input.PartnerName" id="partnerName" class="form-control" readonly /></div>
                <div class="col-md-6"><label class="form-label">Mã đơn tham chiếu</label><input asp-for="Input.SourceReference" id="sourceReference" class="form-control" readonly /></div>
                <div class="col-12"><label asp-for="Input.Notes" class="form-label" id="notesLabel">Ghi chú nghiệp vụ</label><textarea asp-for="Input.Notes" id="notes" class="form-control" rows="2" maxlength="500" placeholder="Ghi chú giao hàng hoặc lý do trả nhà cung cấp"></textarea><span asp-validation-for="Input.Notes" class="text-danger"></span></div>
            </div>
        </div></section>

        <section class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center"><span class="fw-semibold">Các mặt hàng thuộc đợt xuất</span><span class="text-muted small" id="itemCount">@Model.Input.Items.Count mặt hàng</span></div>
            <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Mã hàng</th><th>Tên sản phẩm</th><th>Đơn vị</th><th class="text-end">Theo đơn</th><th class="text-end">Tối đa có thể xử lý</th></tr></thead><tbody id="itemsBody">
            @for (var i = 0; i < Model.Input.Items.Count; i++)
            {
                <tr><td><input type="hidden" asp-for="Input.Items[i].ProductId" /><input type="hidden" asp-for="Input.Items[i].ProductCode" />@Model.Input.Items[i].ProductCode</td>
                    <td><input type="hidden" asp-for="Input.Items[i].ProductName" />@Model.Input.Items[i].ProductName</td><td><input type="hidden" asp-for="Input.Items[i].UnitName" />@Model.Input.Items[i].UnitName</td>
                    <td class="text-end"><input type="hidden" name="Input.Items[@i].ReferenceQuantity" value="@Model.Input.Items[i].ReferenceQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" />@FormatQuantity(Model.Input.Items[i].ReferenceQuantity, Model.Input.Items[i].QuantityScale) @Model.Input.Items[i].UnitName</td>
                    <td class="text-end"><input type="hidden" name="Input.Items[@i].AvailableQuantity" value="@Model.Input.Items[i].AvailableQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" /><input type="hidden" asp-for="Input.Items[i].QuantityScale" />@FormatQuantity(Model.Input.Items[i].AvailableQuantity, Model.Input.Items[i].QuantityScale) @Model.Input.Items[i].UnitName</td></tr>
            }
            @if (Model.Input.Items.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-5">Chọn đơn tham chiếu để tải mặt hàng có thể xuất.</td></tr> }
            </tbody></table></div>
            <div class="card-footer bg-white d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2"><span class="text-muted small" id="createHint">Hệ thống chỉ lập kế hoạch; nhân viên nhập số lượng thực tại màn lấy hàng.</span><button type="submit" id="createButton" class="btn btn-primary" @(Model.Input.Items.Count == 0 ? "disabled" : null)>Tạo phiếu xuất kho</button></div>
        </section>
    </form>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
    const sourceType = document.getElementById('sourceType');
    const salesOrder = document.getElementById('salesOrder');
    const purchaseOrder = document.getElementById('purchaseOrder');
    const body = document.getElementById('itemsBody');
    const createButton = document.getElementById('createButton');
    const hint = document.getElementById('createHint');
    let requestVersion = 0;

    function escapeHtml(value) { const node = document.createElement('div'); node.textContent = value ?? ''; return node.innerHTML; }
    function formatQuantity(value, scale) { return Number(value).toLocaleString('en-US', { useGrouping: false, maximumFractionDigits: scale }); }
    function toggleSource() {
        const sales = sourceType.value === 'SALES_ORDER';
        document.querySelector('.source-sales').classList.toggle('d-none', !sales);
        document.querySelector('.source-purchase').classList.toggle('d-none', sales);
        document.getElementById('notesLabel').textContent = sales ? 'Ghi chú nghiệp vụ' : 'Lý do trả nhà cung cấp *';
        const notes = document.getElementById('notes'); notes.required = !sales; notes.minLength = sales ? 0 : 10;
        if (sales) purchaseOrder.value = ''; else salesOrder.value = '';
        renderItems([]);
    }
    function renderItems(items) {
        document.getElementById('itemCount').textContent = `${items.length} mặt hàng`;
        createButton.disabled = items.length === 0;
        hint.textContent = items.length ? 'Số lượng thực xuất được nhập sau khi bắt đầu lấy hàng.' : 'Chọn đơn còn hàng có thể xuất.';
        if (!items.length) { body.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-5">Chọn đơn tham chiếu để tải mặt hàng có thể xuất.</td></tr>'; return; }
        body.innerHTML = items.map((item, index) => `<tr>
            <td><input type="hidden" name="Input.Items[${index}].ProductId" value="${item.productId}"><input type="hidden" name="Input.Items[${index}].ProductCode" value="${escapeHtml(item.productCode)}">${escapeHtml(item.productCode)}</td>
            <td><input type="hidden" name="Input.Items[${index}].ProductName" value="${escapeHtml(item.productName)}">${escapeHtml(item.productName)}</td>
            <td><input type="hidden" name="Input.Items[${index}].UnitName" value="${escapeHtml(item.unitName)}">${escapeHtml(item.unitName)}</td>
            <td class="text-end"><input type="hidden" name="Input.Items[${index}].ReferenceQuantity" value="${item.referenceQuantity}">${formatQuantity(item.referenceQuantity,item.quantityScale)} ${escapeHtml(item.unitName)}</td>
            <td class="text-end"><input type="hidden" name="Input.Items[${index}].AvailableQuantity" value="${item.availableQuantity}"><input type="hidden" name="Input.Items[${index}].QuantityScale" value="${item.quantityScale}">${formatQuantity(item.availableQuantity,item.quantityScale)} ${escapeHtml(item.unitName)}</td></tr>`).join('');
    }
    async function loadReference(kind, id) {
        const version = ++requestVersion;
        document.getElementById('partnerName').value = '';
        document.getElementById('sourceReference').value = '';
        if (!id) { renderItems([]); return; }
        createButton.disabled = true; hint.textContent = 'Đang tải dữ liệu đơn tham chiếu...';
        try {
            const response = await fetch(`?handler=${kind === 'sales' ? 'SalesOrderDetail' : 'PurchaseOrderDetail'}&id=${id}`, { headers: { Accept: 'application/json' } });
            if (version !== requestVersion) return;
            if (!response.ok) { const error = await response.json().catch(() => ({})); renderItems([]); hint.textContent = error.message || 'Không tải được đơn tham chiếu.'; return; }
            const data = await response.json();
            document.getElementById('partnerName').value = kind === 'sales' ? data.customerName : data.supplierName;
            document.getElementById('sourceReference').value = kind === 'sales' ? data.salesOrderNumber : data.purchaseOrderNumber;
            renderItems((data.items || []).map(item => ({ productId:item.productId, productCode:item.productCode, productName:item.productName,
                unitName:item.unitOfMeasure || item.unitName || '', quantityScale:item.quantityScale || 0,
                referenceQuantity:kind === 'sales' ? item.quantity : item.receivedQuantity,
                availableQuantity:kind === 'sales' ? item.reservedQuantity : item.remainingQuantity })));
        } catch { if (version === requestVersion) { renderItems([]); hint.textContent = 'Không thể kết nối để tải đơn tham chiếu.'; } }
    }
    function bindSearch(inputId, select) { document.getElementById(inputId)?.addEventListener('input', event => { const keyword=event.target.value.trim().toLocaleLowerCase('vi'); [...select.options].forEach(option => option.hidden=!!option.value && !option.selected && !option.text.toLocaleLowerCase('vi').includes(keyword)); }); }
    sourceType.addEventListener('change', toggleSource);
    salesOrder.addEventListener('change', event => loadReference('sales', event.target.value));
    purchaseOrder.addEventListener('change', event => loadReference('purchase', event.target.value));
    bindSearch('salesSearch', salesOrder); bindSearch('purchaseSearch', purchaseOrder);
    const initialType = sourceType.value; toggleSource(); sourceType.value = initialType;
    document.querySelector('.source-sales').classList.toggle('d-none', initialType !== 'SALES_ORDER');
    document.querySelector('.source-purchase').classList.toggle('d-none', initialType === 'SALES_ORDER');
    if (initialType === 'SALES_ORDER' && salesOrder.value) loadReference('sales', salesOrder.value);
    if (initialType === 'PURCHASE_RETURN' && purchaseOrder.value) loadReference('purchase', purchaseOrder.value);
</script>
}

@functions { string FormatQuantity(decimal value, byte scale) => FormatHelper.FormatQuantity(value, scale); }
