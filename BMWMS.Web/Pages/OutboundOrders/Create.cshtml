@page
@model BMWMS.Web.Pages.OutboundOrders.CreateModel
@{
    Layout = "_AdminLayout";

    ViewData["Title"] = "T?o L?nh Xu?t Kho";
}
@section Styles {
    <link rel="stylesheet"
          href="~/css/Inventory/outbound-create.css"
          asp-append-version="true" />
}
<div class="container-fluid py-4">
    <!-- KHU V?C THÔNG BÁO L?I VÀ THÀNH CÔNG -->
    <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert">
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>

    <form method="post" id="formCreateOutbound">
        <div class="card shadow border-0 rounded-3">
            <!-- HEADER -->
            <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="m-0 font-weight-bold">
                    <i class="bi bi-box-arrow-up-right me-2"></i>T?o L?nh Xu?t Kho T? Ðon Bán Hàng (SO)
                </h5>
                <a asp-page="./Index" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-arrow-left me-1"></i>Quay l?i danh sách
                </a>
            </div>

            <div class="card-body p-4">
                <!-- THÔNG TIN ÐON HÀNG CHÍNH -->
                <div class="row g-3 mb-4 bg-light p-3 rounded border">
                    <!-- 1. Ch?n Sales Order -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold">1. Ch?n Ðon Bán Hàng (SO) <span class="text-danger">*</span></label>
                        <select asp-for="Input.SalesOrderId" asp-items="Model.SalesOrderOptions" class="form-select border-primary" id="ddlSalesOrder" onchange="onSalesOrderChanged(this.value)">
                        </select>
                        <span asp-validation-for="Input.SalesOrderId" class="text-danger small"></span>
                    </div>

                    <!-- 2. Khách hàng (Readonly, t? di?n khi ch?n SO) -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Khách hàng</label>
                        <input asp-for="Input.CustomerName" class="form-control" id="txtCustomerName" readonly placeholder="Tên khách hàng s? t? hi?n th?..." />
                    </div>

                    <!-- 3. Mã tham chi?u / Ghi chú SO -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Mã Tham Chi?u / Mã Ðon SO</label>
                        <input asp-for="Input.ReferenceCode" class="form-control" id="txtReferenceCode" placeholder="S? don tham chi?u..." />
                    </div>

                    <!-- 4. Kho xu?t -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold">2. Ch?n Kho Xu?t <span class="text-danger">*</span></label>
                        <select asp-for="Input.WarehouseId" asp-items="Model.WarehouseOptions" class="form-select border-primary" id="ddlWarehouse">
                        </select>
                        <span asp-validation-for="Input.WarehouseId" class="text-danger small"></span>
                    </div>

                    <!-- 5. Ngày xu?t d? ki?n -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold">3. Ngày xu?t d? ki?n <span class="text-danger">*</span></label>
                        <input asp-for="Input.ExpectedIssueDate" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" />
                        <span asp-validation-for="Input.ExpectedIssueDate" class="text-danger small"></span>
                    </div>

                    <!-- 6. Ngu?i ph? trách -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Ngu?i ph? trách xu?t kho</label>
                        <select asp-for="Input.AssignedToUserId" asp-items="Model.AssigneeOptions" class="form-select">
                        </select>
                    </div>
                </div>

                <!-- DANH SÁCH S?N PH?M KHU V?C CHI TI?T -->
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold text-secondary m-0">
                        <i class="bi bi-list-check me-1"></i>Danh Sách M?t Hàng C?n Xu?t Kho
                    </h6>
                    <span class="text-muted small fw-bold" id="lblItemCount">
                        S? lu?ng m?t hàng: @(Model.Input.Items?.Count ?? 0)
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle" id="tblItems">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 50px;" class="text-center">#</th>
                                <th>Mã SKU</th>
                                <th>Tên S?n Ph?m</th>
                                <th class="text-center" style="width: 90px;">ÐVT</th>
                                <th class="text-end" style="width: 140px;">SL Khách Ð?t</th>
                                <th class="text-end" style="width: 140px;">SL Ðã Gi? T?n</th>
                                <th class="text-end" style="width: 170px;">SL Yêu C?u Xu?t <span class="text-danger">*</span></th>
                                <th>Ghi Chú</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyItems">
                            @if (Model.Input.Items != null && Model.Input.Items.Any())
                            {
                                @for (int i = 0; i < Model.Input.Items.Count; i++)
                                {
                                    <tr>
                                        <td class="text-center fw-bold">@(i + 1)</td>
                                        <td>
                                            <input type="hidden" name="Input.Items[@i].ProductId" value="@Model.Input.Items[i].ProductId" />
                                            <span class="badge bg-light text-dark font-monospace border">@Model.Input.Items[i].ProductCode</span>
                                        </td>
                                        <td class="fw-bold">@Model.Input.Items[i].ProductName</td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary">@Model.Input.Items[i].UnitName</span>
                                        </td>
                                        <td class="text-end fw-bold text-primary">@Model.Input.Items[i].RequestedQuantity.ToString("N0")</td>
                                        <td class="text-end text-success fw-bold">@Model.Input.Items[i].ReservedQuantity.ToString("N0")</td>
                                        <td>
                                            <input type="number" step="0.01" name="Input.Items[@i].RequestedQuantity"
                                                   class="form-control text-end fw-bold border-primary"
                                                   value="@Model.Input.Items[i].RequestedQuantity"
                                                   max="@Model.Input.Items[i].RequestedQuantity" min="0.01" required />
                                        </td>
                                        <td>
                                            <input type="text" name="Input.Items[@i].Notes" value="@Model.Input.Items[i].Notes" class="form-control form-control-sm" placeholder="Ghi chú thêm..." />
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-4">
                                        <i class="bi bi-info-circle me-1"></i>Vui lòng ch?n Sales Order ? trên d? h? th?ng t?i danh sách s?n ph?m.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- BUTTONS HÀNH Ð?NG -->
                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <button type="submit" name="actionType" value="draft" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-save me-1"></i>Luu Nháp (Draft)
                    </button>
                    <button type="submit" name="actionType" value="submit" class="btn btn-success px-4" id="btnSubmit" @(Model.Input.Items != null && Model.Input.Items.Any() ? "" : "disabled")>
                        <i class="bi bi-check-circle me-1"></i>T?o L?nh Xu?t Kho
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <!-- Load Validation Scripts qua CDN tr?c ti?p d? tránh l?i thi?u Partial View -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <script>
        // G?i AJAX khi thay d?i Dropdown Sales Order
        function onSalesOrderChanged(salesOrderId) {
            const tbody = $('#tbodyItems');
            const btnSubmit = $('#btnSubmit');
            const txtCustomer = $('#txtCustomerName');
            const txtRefCode = $('#txtReferenceCode');
            const ddlWarehouse = $('#ddlWarehouse');

            if (!salesOrderId || salesOrderId <= 0) {
                tbody.html('<tr><td colspan="8" class="text-center text-muted py-4"><i class="bi bi-info-circle me-1"></i>Vui lòng ch?n Sales Order ? trên d? h? th?ng t?i danh sách s?n ph?m.</td></tr>');
                $('#lblItemCount').text('S? lu?ng m?t hàng: 0');
                txtCustomer.val('');
                txtRefCode.val('');
                btnSubmit.prop('disabled', true);
                return;
            }

            // Hi?n th? tr?ng thái dang t?i
            tbody.html('<tr><td colspan="8" class="text-center py-4"><div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>Ðang t?i danh sách chi ti?t s?n ph?m...</td></tr>');

            // G?i Handler AJAX trong PageModel (Create.cshtml.cs)
            $.get(`?handler=SalesOrderDetail&id=${salesOrderId}`)
                .done(function (response) {
                    const detail = response.data || response;

                    if (!detail || !detail.salesOrderId) {
                        tbody.html('<tr><td colspan="8" class="text-center text-danger py-3">Không tìm th?y d? li?u chi ti?t Sales Order!</td></tr>');
                        btnSubmit.prop('disabled', true);
                        return;
                    }

                    // 1. T? d?ng fill thông tin chung (Kh?p chính xác v?i JSON API)
                    txtCustomer.val(detail.customerName || '');
                    txtRefCode.val(detail.salesOrderNumber || '');
                    if (detail.warehouseId && detail.warehouseId > 0) {
                        ddlWarehouse.val(detail.warehouseId);
                    }

                    // 2. Render b?ng danh sách s?n ph?m
                    if (!detail.items || detail.items.length === 0) {
                        tbody.html('<tr><td colspan="8" class="text-center text-warning py-3">Sales Order này không có m?t hàng nào c?n xu?t!</td></tr>');
                        btnSubmit.prop('disabled', true);
                        $('#lblItemCount').text('S? lu?ng m?t hàng: 0');
                        return;
                    }

                    let html = '';
                    detail.items.forEach((item, index) => {
                        const unitName = item.unitName ? item.unitName : 'N/A';

                        html += `
                            <tr>
                                <td class="text-center fw-bold">${index + 1}</td>
                                <td>
                                    <input type="hidden" name="Input.Items[${index}].ProductId" value="${item.productId}" />
                                    <span class="badge bg-light text-dark font-monospace border">${item.productCode}</span>
                                </td>
                                <td class="fw-bold">${item.productName}</td>
                                <td class="text-center"><span class="badge bg-secondary">${unitName}</span></td>
                                <td class="text-end fw-bold text-primary">${Number(item.quantity).toLocaleString()}</td>
                                <td class="text-end text-success fw-bold">${Number(item.reservedQuantity || 0).toLocaleString()}</td>
                                <td>
                                    <input type="number" step="0.01" name="Input.Items[${index}].RequestedQuantity"
                                           class="form-control text-end fw-bold border-primary"
                                           value="${item.quantity}" max="${item.quantity}" min="0.01" required />
                                </td>
                                <td>
                                    <input type="text" name="Input.Items[${index}].Notes" class="form-control form-control-sm" placeholder="Ghi chú thêm..." />
                                </td>
                            </tr>
                        `;
                    });

                    tbody.html(html);
                    $('#lblItemCount').text(`S? lu?ng m?t hàng: ${detail.items.length}`);
                    btnSubmit.prop('disabled', false);
                })
                .fail(function () {
                    tbody.html('<tr><td colspan="8" class="text-center text-danger py-3">L?i k?t n?i máy ch? khi l?y d? li?u Sales Order!</td></tr>');
                    btnSubmit.prop('disabled', true);
                });
        }
    </script>
}
