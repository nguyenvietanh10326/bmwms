@page
@model BMWMS.Web.Pages.CustomerReturns.IndexModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Khách trả hàng theo SO"; }
<div class="d-flex justify-content-between align-items-center mb-4"><h2>Khách trả hàng theo SO</h2>
@if (User.IsInRole("SALES_STAFF") || User.IsInRole("SYSTEM_ADMIN")) { <a asp-page="./Create" class="btn btn-primary">Tạo phiếu khách trả theo SO</a> }</div>
<div asp-validation-summary="All" class="text-danger"></div>
@if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
@if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Phiếu đề nghị</th><th>SO tham chiếu</th><th>Khách hàng</th><th>Ngày tạo</th><th>Trạng thái</th></tr></thead><tbody>
@foreach (var r in Model.Requests) { <tr><td><a asp-page="./Details" asp-route-id="@r.Id">@r.RequestNumber</a></td><td>@(r.SalesOrderNumber ?? "Lịch sử nhiều SO")</td><td>@r.CustomerName</td><td>@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@BMWMS.Web.Pages.CustomerReturns.IndexModel.Label(r.Status)</td></tr> }
@if (!Model.Requests.Any()) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có phiếu khách trả.</td></tr> }
</tbody></table></div></div>
