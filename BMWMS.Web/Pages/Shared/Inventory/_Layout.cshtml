<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - BMWMS
    </title>


    <!-- =====================================================
         BOOTSTRAP CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css"
          asp-append-version="true" />
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- =====================================================
         BOOTSTRAP ICONS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css"
          asp-append-version="true" />


    <!-- =====================================================
         INVENTORY LAYOUT
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/Inventory/layout.css"
          asp-append-version="true" />


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/Inventory/sidebar.css"
          asp-append-version="true" />


    <!-- =====================================================
         PAGE CSS
         ===================================================== -->
    @RenderSection("Styles", required: false)

</head>


<body>


    <!-- SIDEBAR -->
    @await Html.PartialAsync(
    "~/Pages/Shared/Inventory/sidebar.cshtml"
        )



    <!-- MAIN -->

    <main class="main-content">

        @RenderBody()

    </main>



    <!-- =====================================================
         JQUERY
         ===================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"
            asp-append-version="true">
    </script>


    <!-- =====================================================
         BOOTSTRAP JS
         QUAN TRỌNG: PHẢI LÀ bundle
         ===================================================== -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"
            asp-append-version="true">
    </script>


    <!-- =====================================================
         PAGE SCRIPTS
         ===================================================== -->
    @await RenderSectionAsync("Scripts", required: false)


</body>

</html>
