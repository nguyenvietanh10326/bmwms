@page
@model BMWMS.Web.Pages.Transfer.DetailsModel
@using BMWMS.Web.Helpers
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Chi ti·∫øt phi·∫øu ƒëi·ªÅu chuy·ªÉn {Model.Order?.TransferOrderNumber}";
    ViewData["ActivePage"] = "Transfer";

    var status = Model.Order?.Status ?? "";
    var isDraft    = status == "DRAFT";
    var isApproved = status == "APPROVED" || status == "ASSIGNED";
    var isInProgress = status == "IN_PROGRESS";
    var inventoryPosted = Model.Order?.InventoryPosted == true;
    var isDone     = status == "COMPLETED";
    var isCancelled = status == "CANCELLED";

    var tempSuccess = TempData["SuccessMessage"] as string;
    var tempError   = TempData["ErrorMessage"] as string;
}

<style>
  :root{
    --font-ui:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    --font-mono:"IBM Plex Mono",ui-monospace,monospace;

    --navy-950:#233a6b; --navy-900:#1b2d56; --navy-800:#152d57;
    --accent:#3e5cf6; --accent-600:#3149d4; --accent-100:#e8ecff;

    --bg:#f2f3f7; --card:#ffffff; --line:#e7e9f0; --line-strong:#d7dae5;
    --ink:#161b2e; --ink-2:#525a72; --ink-3:#8890a6; --ink-4:#aeb4c6;

    --g-bg:#e2f8ea; --g-tx:#0f7a3e; --g-dot:#1fa855;
    --y-bg:#fef3d6; --y-tx:#93650a; --y-dot:#e2a336;
    --gy-bg:#eceef3; --gy-tx:#565f78; --gy-dot:#9aa1b5;
    --r-bg:#fce3e4; --r-tx:#c1222f; --r-dot:#e2454f;
    --b-bg:#e3eaff; --b-tx:#2c48d8; --b-dot:#5876f2;

    --sh-xs:0 1px 2px rgba(16,23,42,.05);
    --sh-sm:0 1px 2px rgba(16,23,42,.04),0 4px 10px -4px rgba(16,23,42,.07);
    --r-sm:8px; --r-lg:16px;
    --ease:cubic-bezier(.4,0,.2,1);
  }
  
  .transfer-page {
    font-family: var(--font-ui);
    color: var(--ink);
    font-size: 14px;
    line-height: 1.45;
    padding: 26px 30px 64px;
  }
  .transfer-page * { box-sizing: border-box; }
  .transfer-page button{font-family:inherit;}

  .transfer-page .breadcrumb{font-size:11.5px;color:var(--ink-3);margin-bottom:8px;font-weight:600;letter-spacing:.02em;text-transform:uppercase; display:block; padding:0; background:transparent;}
  .transfer-page .pagehead{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px;gap:20px;}
  .transfer-page .pagehead h1{font-size:20px;margin:0 0 5px;letter-spacing:-.01em;font-weight:700;}
  .transfer-page .pagehead p{margin:0;color:var(--ink-2);font-size:13px;max-width:560px;}

  .transfer-page .card{background:var(--card);border:1px solid var(--line);border-radius:var(--r-lg);padding:22px 24px;margin-bottom:16px;box-shadow:var(--sh-xs);}
  .transfer-page .card h3{margin:0 0 14px;font-size:14px;font-weight:700;letter-spacing:-.005em;display:flex;align-items:center;gap:8px;}
  .transfer-page .row{display:flex;justify-content:space-between;align-items:center;}

  .transfer-page .badge{display:inline-flex;align-items:center;gap:6px;padding:3.5px 10px 3.5px 8px;border-radius:999px;font-size:11.5px;font-weight:600;}
  .transfer-page .badge .dot{width:6px;height:6px;border-radius:50%;flex-shrink:0;}
  .transfer-page .b-g{background:var(--g-bg);color:var(--g-tx);} .transfer-page .b-g .dot{background:var(--g-dot);}
  .transfer-page .b-y{background:var(--y-bg);color:var(--y-tx);} .transfer-page .b-y .dot{background:var(--y-dot);}
  .transfer-page .b-gy{background:var(--gy-bg);color:var(--gy-tx);} .transfer-page .b-gy .dot{background:var(--gy-dot);}
  .transfer-page .b-r{background:var(--r-bg);color:var(--r-tx);} .transfer-page .b-r .dot{background:var(--r-dot);}
  .transfer-page .b-b{background:var(--b-bg);color:var(--b-tx);} .transfer-page .b-b .dot{background:var(--b-dot);}

  .transfer-page table{width:100%;border-collapse:collapse;font-size:13px;}
  .transfer-page th{text-align:left;color:var(--ink-3);font-weight:600;font-size:11px;letter-spacing:.03em;padding:0 10px 10px;border-bottom:1px solid var(--line);}
  .transfer-page th.num, .transfer-page td.num{text-align:right;}
  .transfer-page td{padding:13px 10px;border-bottom:1px solid var(--line);vertical-align:middle;color:var(--ink);}
  .transfer-page td.num{font-family:var(--font-mono);font-variant-numeric:tabular-nums;font-size:12.5px;}
  .transfer-page tbody tr:hover{background:#f8f9fc;}
  .transfer-page tr:last-child td{border-bottom:none;}
  .transfer-page .prod-code{font-family:var(--font-mono);font-size:11px;background:var(--gy-bg);color:var(--ink-2);padding:1.5px 6px;border-radius:5px;margin-right:6px;font-weight:600;}
  .transfer-page .muted{color:var(--ink-3);}
  .transfer-page .small{font-size:12px;}
  .transfer-page .stat-strip{display:flex;justify-content:space-between;align-items:center;margin-top:12px;padding-top:12px;border-top:1px solid var(--line);}

  .transfer-page .grid2{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
  .transfer-page .grid2 label{display:block;font-size:11.5px;color:var(--ink-3);margin-bottom:6px;font-weight:600;text-transform:uppercase;letter-spacing:.02em;}
  .transfer-page .grid2 .field input{width:100%;padding:9px 11px;border:1px solid var(--line-strong);border-radius:var(--r-sm);font-size:13px;background:#fff;color:var(--ink);}
  .transfer-page .grid2 .field input[disabled]{background:#f7f8fb;color:var(--ink-3);border-color:var(--line);}
  
  .transfer-page .btn{display:inline-flex;align-items:center;gap:7px;border:none;border-radius:var(--r-sm);padding:9px 15px;font-size:13px;font-weight:600;cursor:pointer;transition:all .15s var(--ease); text-decoration:none;}
  .transfer-page .btn svg{width:15px;height:15px;}
  .transfer-page .btn-dark{background:var(--navy-950);color:#fff;box-shadow:var(--sh-xs);}
  .transfer-page .btn-dark:hover{background:#1c2340;transform:translateY(-1px);box-shadow:var(--sh-sm); color:#fff;}
  .transfer-page .btn-primary{background:var(--accent-600);color:#fff;box-shadow:var(--sh-xs);}
  .transfer-page .btn-primary:hover{background:#1d4ed8;color:#fff;}
  .transfer-page .btn-success{background:#16a34a;color:#fff;}
  .transfer-page .btn-success:hover{background:#15803d;color:#fff;}
  .transfer-page .btn-danger{background:#dc2626;color:#fff;}
  .transfer-page .btn-danger:hover{background:#b91c1c;color:#fff;}
  .transfer-page .btn-light{background:#fff;border:1px solid var(--line-strong);color:var(--ink);}
  .transfer-page .btn-light:hover{border-color:var(--ink-4);background:#fafafd; color:var(--ink);}
</style>

<svg width="0" height="0" style="position:absolute; display:none;">
    <symbol id="i-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></symbol>
</svg>

<div class="transfer-page">
    <div class="breadcrumb">
        <a href="/Transfer/Index" style="color:var(--ink-3); text-decoration:none;">ƒêi·ªÅu chuy·ªÉn kho</a>
        <svg style="width:12px; height:12px; display:inline-block; vertical-align:middle; margin:0 4px;"><use href="#i-chev"/></svg>
        <span>Chi ti·∫øt phi·∫øu</span>
    </div>
    <div class="pagehead">
        <div>
            <h1>Chi ti·∫øt l·ªánh ƒëi·ªÅu chuy·ªÉn ‚Äî @Model.Order?.TransferOrderNumber</h1>
            <p>Th√¥ng tin phi·∫øu, h√†ng h√≥a, v·ªã tr√≠ l∆∞u tr·ªØ v√† k·∫øt qu·∫£ th·ª±c hi·ªán.</p>
        </div>
        @{
            var statusClass = "b-gy";
            var statusName = status;
            if (isDraft) { statusClass = "b-y"; statusName = "Ch·ªù ph√™ duy·ªát"; }
            else if (isApproved) { statusClass = "b-b"; statusName = "ƒê√£ duy·ªát"; }
            else if (isInProgress) { statusClass = "b-b"; statusName = inventoryPosted ? "ƒê√£ nh·∫≠p" : "ƒê√£ xu·∫•t"; }
            else if (isDone) { statusClass = "b-g"; statusName = "Ho√†n th√†nh"; }
            else if (isCancelled) { statusClass = "b-r"; statusName = "ƒê√£ h·ªßy"; }
        }
        <div style="display:flex; align-items:flex-end; flex-direction:column; gap:10px;">
            <span class="badge @statusClass"><span class="dot"></span>@statusName</span>
            <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:flex-start;">
                @if (Model.Order?.CanEdit == true && Model.IsManager)
                {
                    <a href="/Transfer/Create?id=@Model.Order.TransferOrderId" class="btn btn-light" style="padding: 6px 12px; color: var(--accent-600);">
                        <i class="ri-edit-line"></i> S·ª≠a phi·∫øu
                    </a>
                }

                @if (Model.Order?.CanApprove == true && Model.IsManager) { <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#approveModal" style="padding: 6px 12px;"><i class="ri-check-line"></i> PhÍ duy?t</button> } @if (Model.Order?.CanCancel == true) { <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#cancelModal" style="padding: 6px 12px;"><i class="ri-close-line"></i> H?y phi?u</button> }

                @if (Model.Order?.CanConfirm == true && Model.IsStaff)
{
    <div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" style="border-radius:12px;">
                <form method="post" asp-page-handler="Confirm" asp-route-id="@Model.Order?.TransferOrderId">
                    @Html.AntiForgeryToken()
                    <div class="modal-header" style="border-bottom:1px solid #f1f5f9; background:#eff6ff;">
                        <h5 class="modal-title" style="font-size:16px; font-weight:700; color:#1d4ed8;">
                            <i class="ri-check-double-line"></i> X·c Nh?n Chuy?n Kho (1 bu?c)
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body" style="font-size:13px; color:#334155;">
                        @if (Model.Order?.Details.Any() == true)
                        {
                            <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:10px; margin-bottom:12px;">
                                @foreach (var d in Model.Order.Details)
                                {
                                    <div style="padding:10px 0; border-bottom:1px solid #f1f5f9;">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <span style="font-weight:700; color:#1e293b;">@d.ProductCode</span>
                                            <span style="color:#64748b;">@d.LotNumber</span>
                                            <span style="margin-left:auto; font-weight:700; color:#2563eb;">YÍu c?u: @FormatHelper.FormatQuantity(d.RequestedQuantity, d.QuantityScale) @d.UnitName</span>
                                        </div>
                                        <input type="hidden" name="detailIds" value="@d.TransferOrderDetailId" />
                                        
                                        <div class="row gx-2 mb-2">
                                            <div class="col-md-6">
                                                <label class="form-label mb-1">S? lu?ng th?c chuy?n</label>
                                                <div class="input-group input-group-sm">
                                                    <input type="number" name="actualMovedQuantities" class="form-control text-end"
                                                           value="@d.RequestedQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                           min="0.0001" max="@d.RequestedQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                           step="0.0001" required />
                                                    <span class="input-group-text">@d.UnitName</span>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label mb-1">V? trÌ dÌch th?c t?</label>
                                                <select name="destinationLocationIds" class="form-select form-select-sm" required>
                                                    @foreach (var location in Model.DestinationLocations)
                                                    {
                                                        if (location.LocationId == d.DestLocationId)
                                                        {
                                                            <option value="@location.LocationId" selected>@location.DisplayLabel</option>
                                                        }
                                                        else if (location.LocationId != d.SourceLocationId)
                                                        {
                                                            <option value="@location.LocationId">@location.DisplayLabel</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <div class="row gx-2 mb-2">
                            <div class="col-md-6">
                                <label class="form-label" style="font-weight:600; font-size:12px; color:#475569;">Ghi ch˙ (t˘y ch?n)</label>
                                <textarea name="notes" class="form-control form-control-sm" rows="2" placeholder="Ghi ch˙ qu· trÏnh chuy?n..."></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" style="font-weight:600; font-size:12px; color:#475569;">L˝ do d?i dÌch (n?u cÛ)</label>
                                <textarea name="destinationChangeReason" class="form-control form-control-sm" rows="2" placeholder="L˝ do d?i v? trÌ dÌch..."></textarea>
                            </div>
                        </div>

                        <div class="row gx-2 mb-2">
                            <div class="col-md-6">
                                <label class="form-label" style="font-weight:600; font-size:12px; color:#475569;">L˝ do thi?u h?t (n?u cÛ)</label>
                                <textarea name="shortfallReason" class="form-control form-control-sm" rows="2" placeholder="L˝ do chuy?n Ìt hon yÍu c?u..."></textarea>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mt-3 mb-1">
                                    <input class="form-check-input" type="checkbox" name="acknowledgeCapacityWarning" value="true" id="confirmCapacityAck">
                                    <label class="form-check-label" for="confirmCapacityAck">TÙi d„ ki?m tra th?c t? khi d?y.</label>
                                </div>
                                <input type="text" name="capacityWarningReason" class="form-control form-control-sm" placeholder="L˝ do ti?p t?c khi d?y..." />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top:1px solid #f1f5f9;">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="font-size: 13px; padding: 7px 14px;">H?y</button>
                        <button type="submit" class="btn btn-primary" style="font-size: 13px; font-weight:700; padding:7px 20px;">
                            <i class="ri-check-double-line"></i> X·c Nh?n
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}


