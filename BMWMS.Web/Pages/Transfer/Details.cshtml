                                        <span style="color:#64748b;">@d.LotNumber</span>
                                        <span>|</span>
                                        <span style="background:#fef3c7; color:#92400e; padding:2px 6px; border-radius:4px;">@d.SourceLocationCode</span>
                                        <span>→</span>
                                        <span style="background:#dbeafe; color:#1e40af; padding:2px 6px; border-radius:4px;">@d.DestLocationCode</span>
                                        <span style="font-weight:700; color:#0e7490; margin-left:auto;">@d.MovedQuantity.ToString("N2") @d.UnitName</span>
                                    </div>
