@page
@model BMWMS.Web.Pages.Transfer.DetailsModel
@using BMWMS.Web.Helpers
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Chi tiết phiếu {Model.Order?.TransferOrderNumber}";
    ViewData["ActivePage"] = "Transfer";
}

<style>
    .transfer-page .badge { padding: 5px 10px; border-radius: 6px; font-weight: 600; font-size: 12px; }
    .transfer-page .b-y { background: #fef08a; color: #854d0e; }
    .transfer-page .b-b { background: #bfdbfe; color: #1e40af; }
    .transfer-page .b-g { background: #bbf7d0; color: #166534; }
    .transfer-page .b-r { background: #fecaca; color: #991b1b; }
    .transfer-page .b-gy { background: #e2e8f0; color: #475569; }
    .transfer-page select, .transfer-page .form-select {
        padding-right: 2.5rem !important;
        text-overflow: ellipsis;
        white-space: nowrap;
        overflow: hidden;
        background-position: right .75rem center;
    }
</style>

<div class="transfer-page">
    <div class="breadcrumb">
        <a href="/Transfer/Index" style="color:var(--ink-3); text-decoration:none;">Điều chuyển kho</a>
        <span style="margin:0 4px;">/</span>
        <span>Chi tiết</span>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage)) { <div class="alert alert-success">@Model.SuccessMessage</div> }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }

    <div class="card" style="padding: 20px; background: #fff; border-radius: 12px; border: 1px solid #e2e8f0; margin-bottom: 20px;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start;">
            <div>
                <h2 style="font-size:20px; font-weight:700;">Phiếu Điều Chuyển: @Model.Order?.TransferOrderNumber</h2>
                <p style="color:#64748b; font-size:13px;">Ngày tạo: @Model.Order?.CreatedAt.ToString("dd/MM/yyyy HH:mm") bởi @Model.Order?.CreatedByName</p>
            </div>
            <div style="display:flex; flex-direction:column; align-items:flex-end; gap:10px;">
                @{
                    var statusClass = Model.Order?.Status switch {
                        "DRAFT" => "b-y",
                        "APPROVED" => "b-b",
                        "COMPLETED" => "b-g",
                        "CANCELLED" => "b-r",
                        _ => "b-gy"
                    };
                }
                <span class="badge @statusClass">@Model.Order?.StatusLabel</span>
                <div class="d-flex gap-2">
                    @if(Model.Order?.CanEdit == true) { <a href="/Transfer/Create?id=@Model.Order.TransferOrderId" class="btn btn-sm btn-light">Sửa</a> }
                    @if(Model.Order?.CanApprove == true) { <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#approveModal">Duyệt</button> }
                    @if(Model.Order?.CanCancel == true) { <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#cancelModal">Hủy</button> }
                    @if(Model.Order?.CanConfirm == true) { <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#confirmModal">Thực Hiện</button> }
                </div>
            </div>
        </div>
    </div>

    <div class="card" style="background:#fff; border:1px solid #e2e8f0; border-radius:12px; overflow:hidden;">
        <table class="table table-hover mb-0" style="font-size:13px;">
            <thead style="background:#f8fafc;">
                <tr>
                    <th>Sản phẩm</th>
                    <th>Lot/Batch</th>
                    <th>Từ vị trí</th>
                    <th>Đến vị trí</th>
                    <th class="text-end">SL Yêu cầu</th>
                </tr>
            </thead>
            <tbody>
                @if(Model.Order?.Details.Any() == true)
                {
                    foreach(var d in Model.Order.Details)
                    {
                        <tr>
                            <td>
                                <strong>@d.ProductCode</strong><br />
                                <span style="color:#64748b;">@d.ProductName</span>
                            </td>
                            <td>@d.LotNumber</td>
                            <td><span class="badge b-gy">@d.SourceLocationCode</span></td>
                            <td><span class="badge b-gy">@d.DestLocationCode</span></td>
                            <td class="text-end fw-bold text-primary">@FormatHelper.FormatQuantity(d.RequestedQuantity, d.QuantityScale) @d.UnitName</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Duyệt -->
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Approve" asp-route-id="@Model.Order?.TransferOrderId">
                <div class="modal-header">
                    <h5 class="modal-title">Phê duyệt lệnh</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label>Ghi chú (Tùy chọn)</label>
                    <textarea name="notes" class="form-control" rows="3"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-success">Phê duyệt</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Hủy -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Cancel" asp-route-id="@Model.Order?.TransferOrderId">
                <div class="modal-header">
                    <h5 class="modal-title text-danger">Hủy lệnh chuyển kho</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label>Lý do hủy</label>
                    <textarea name="notes" class="form-control" rows="3" required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger">Hủy Lệnh</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Thực Hiện (Confirm) -->
@if (Model.Order?.CanConfirm == true)
{
    <div class="modal fade" id="confirmModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form method="post" asp-page-handler="Confirm" asp-route-id="@Model.Order.TransferOrderId">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title">Thực hiện chuyển kho</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-0">
                        <div class="p-3" style="background:#f8fafc; border-bottom:1px solid #e2e8f0;">
                            <p class="mb-0 text-muted">Kiểm tra số lượng và vị trí thực tế. Bạn có thể đổi vị trí cất hàng nếu cần.</p>
                        </div>
                        <div class="p-3">
                            @foreach(var d in Model.Order.Details)
                            {
                                <div class="card mb-3 shadow-sm border-0" style="background:#f1f5f9;">
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between mb-2">
                                            <strong>@d.ProductCode - @d.ProductName (Lot: @d.LotNumber)</strong>
                                            <span class="text-primary fw-bold">Yêu cầu: @FormatHelper.FormatQuantity(d.RequestedQuantity, d.QuantityScale) @d.UnitName</span>
                                        </div>
                                        <input type="hidden" name="detailIds" value="@d.TransferOrderDetailId" />
                                        <div class="row g-2">
                                            <div class="col-md-12">
                                                <label class="form-label small mb-1">Vị trí cất (Thực tế)</label>
                                                <select name="destinationLocationIds" class="form-select form-select-sm" required>
                                                    @foreach (var loc in Model.DestinationLocations)
                                                    {
                                                        if (loc.LocationId == d.DestLocationId)
                                                        {
                                                            <option value="@loc.LocationId" selected>@loc.DisplayLabel (Chỉ định)</option>
                                                        }
                                                        else if (loc.LocationId != d.SourceLocationId)
                                                        {
                                                            <option value="@loc.LocationId">@loc.DisplayLabel</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            <div class="mt-3">
                                <label class="form-label small">Ghi chú</label>
                                <textarea name="notes" class="form-control" rows="2"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-primary"><i class="ri-check-double-line"></i> Xác nhận</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
