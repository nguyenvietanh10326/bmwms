@page
@model BMWMS.Web.Pages.Transfer.DetailsModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Chi tiết phiếu điều chuyển {Model.Order?.TransferOrderNumber}";
    ViewData["ActivePage"] = "Transfer";

    var status = Model.Order?.Status ?? "";
    var isDraft    = status == "DRAFT";
    var isApproved = status == "APPROVED" || status == "ASSIGNED";
    var isInProgress = status == "IN_PROGRESS";
    var inventoryPosted = Model.Order?.InventoryPosted == true;
    var isDone     = status == "COMPLETED";
    var isCancelled = status == "CANCELLED";

    var tempSuccess = TempData["SuccessMessage"] as string;
    var tempError   = TempData["ErrorMessage"] as string;
}

<style>
  :root{
    --font-ui:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    --font-mono:"IBM Plex Mono",ui-monospace,monospace;

    --navy-950:#233a6b; --navy-900:#1b2d56; --navy-800:#152d57;
    --accent:#3e5cf6; --accent-600:#3149d4; --accent-100:#e8ecff;

    --bg:#f2f3f7; --card:#ffffff; --line:#e7e9f0; --line-strong:#d7dae5;
    --ink:#161b2e; --ink-2:#525a72; --ink-3:#8890a6; --ink-4:#aeb4c6;

    --g-bg:#e2f8ea; --g-tx:#0f7a3e; --g-dot:#1fa855;
    --y-bg:#fef3d6; --y-tx:#93650a; --y-dot:#e2a336;
    --gy-bg:#eceef3; --gy-tx:#565f78; --gy-dot:#9aa1b5;
    --r-bg:#fce3e4; --r-tx:#c1222f; --r-dot:#e2454f;
    --b-bg:#e3eaff; --b-tx:#2c48d8; --b-dot:#5876f2;

    --sh-xs:0 1px 2px rgba(16,23,42,.05);
    --sh-sm:0 1px 2px rgba(16,23,42,.04),0 4px 10px -4px rgba(16,23,42,.07);
    --r-sm:8px; --r-lg:16px;
    --ease:cubic-bezier(.4,0,.2,1);
  }
  
  .transfer-page {
    font-family: var(--font-ui);
    color: var(--ink);
    font-size: 14px;
    line-height: 1.45;
    padding: 26px 30px 64px;
  }
  .transfer-page * { box-sizing: border-box; }
  .transfer-page button{font-family:inherit;}

  .transfer-page .breadcrumb{font-size:11.5px;color:var(--ink-3);margin-bottom:8px;font-weight:600;letter-spacing:.02em;text-transform:uppercase; display:block; padding:0; background:transparent;}
  .transfer-page .pagehead{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px;gap:20px;}
  .transfer-page .pagehead h1{font-size:20px;margin:0 0 5px;letter-spacing:-.01em;font-weight:700;}
  .transfer-page .pagehead p{margin:0;color:var(--ink-2);font-size:13px;max-width:560px;}

  .transfer-page .card{background:var(--card);border:1px solid var(--line);border-radius:var(--r-lg);padding:22px 24px;margin-bottom:16px;box-shadow:var(--sh-xs);}
  .transfer-page .card h3{margin:0 0 14px;font-size:14px;font-weight:700;letter-spacing:-.005em;display:flex;align-items:center;gap:8px;}
  .transfer-page .row{display:flex;justify-content:space-between;align-items:center;}

  .transfer-page .badge{display:inline-flex;align-items:center;gap:6px;padding:3.5px 10px 3.5px 8px;border-radius:999px;font-size:11.5px;font-weight:600;}
  .transfer-page .badge .dot{width:6px;height:6px;border-radius:50%;flex-shrink:0;}
  .transfer-page .b-g{background:var(--g-bg);color:var(--g-tx);} .transfer-page .b-g .dot{background:var(--g-dot);}
  .transfer-page .b-y{background:var(--y-bg);color:var(--y-tx);} .transfer-page .b-y .dot{background:var(--y-dot);}
  .transfer-page .b-gy{background:var(--gy-bg);color:var(--gy-tx);} .transfer-page .b-gy .dot{background:var(--gy-dot);}
  .transfer-page .b-r{background:var(--r-bg);color:var(--r-tx);} .transfer-page .b-r .dot{background:var(--r-dot);}
  .transfer-page .b-b{background:var(--b-bg);color:var(--b-tx);} .transfer-page .b-b .dot{background:var(--b-dot);}

  .transfer-page table{width:100%;border-collapse:collapse;font-size:13px;}
  .transfer-page th{text-align:left;color:var(--ink-3);font-weight:600;font-size:11px;letter-spacing:.03em;padding:0 10px 10px;border-bottom:1px solid var(--line);}
  .transfer-page th.num, .transfer-page td.num{text-align:right;}
  .transfer-page td{padding:13px 10px;border-bottom:1px solid var(--line);vertical-align:middle;color:var(--ink);}
  .transfer-page td.num{font-family:var(--font-mono);font-variant-numeric:tabular-nums;font-size:12.5px;}
  .transfer-page tbody tr:hover{background:#f8f9fc;}
  .transfer-page tr:last-child td{border-bottom:none;}
  .transfer-page .prod-code{font-family:var(--font-mono);font-size:11px;background:var(--gy-bg);color:var(--ink-2);padding:1.5px 6px;border-radius:5px;margin-right:6px;font-weight:600;}
  .transfer-page .muted{color:var(--ink-3);}
  .transfer-page .small{font-size:12px;}
  .transfer-page .stat-strip{display:flex;justify-content:space-between;align-items:center;margin-top:12px;padding-top:12px;border-top:1px solid var(--line);}

  .transfer-page .grid2{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
  .transfer-page .grid2 label{display:block;font-size:11.5px;color:var(--ink-3);margin-bottom:6px;font-weight:600;text-transform:uppercase;letter-spacing:.02em;}
  .transfer-page .grid2 .field input{width:100%;padding:9px 11px;border:1px solid var(--line-strong);border-radius:var(--r-sm);font-size:13px;background:#fff;color:var(--ink);}
  .transfer-page .grid2 .field input[disabled]{background:#f7f8fb;color:var(--ink-3);border-color:var(--line);}
  
  .transfer-page .btn{display:inline-flex;align-items:center;gap:7px;border:none;border-radius:var(--r-sm);padding:9px 15px;font-size:13px;font-weight:600;cursor:pointer;transition:all .15s var(--ease); text-decoration:none;}
  .transfer-page .btn svg{width:15px;height:15px;}
  .transfer-page .btn-dark{background:var(--navy-950);color:#fff;box-shadow:var(--sh-xs);}
  .transfer-page .btn-dark:hover{background:#1c2340;transform:translateY(-1px);box-shadow:var(--sh-sm); color:#fff;}
  .transfer-page .btn-primary{background:var(--accent-600);color:#fff;box-shadow:var(--sh-xs);}
  .transfer-page .btn-primary:hover{background:#1d4ed8;color:#fff;}
  .transfer-page .btn-success{background:#16a34a;color:#fff;}
  .transfer-page .btn-success:hover{background:#15803d;color:#fff;}
  .transfer-page .btn-danger{background:#dc2626;color:#fff;}
  .transfer-page .btn-danger:hover{background:#b91c1c;color:#fff;}
  .transfer-page .btn-light{background:#fff;border:1px solid var(--line-strong);color:var(--ink);}
  .transfer-page .btn-light:hover{border-color:var(--ink-4);background:#fafafd; color:var(--ink);}
</style>

<svg width="0" height="0" style="position:absolute; display:none;">
    <symbol id="i-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></symbol>
</svg>

<div class="transfer-page">
    <div class="breadcrumb">
        <a href="/Transfer/Index" style="color:var(--ink-3); text-decoration:none;">Điều chuyển kho</a>
        <svg style="width:12px; height:12px; display:inline-block; vertical-align:middle; margin:0 4px;"><use href="#i-chev"/></svg>
        <span>Chi tiết phiếu</span>
    </div>
    <div class="pagehead">
        <div>
            <h1>Chi tiết lệnh điều chuyển — @Model.Order?.TransferOrderNumber</h1>
            <p>Thông tin phiếu, hàng hóa, vị trí lưu trữ và kết quả thực hiện.</p>
        </div>
        @{
            var statusClass = "b-gy";
            var statusName = status;
            if (isDraft) { statusClass = "b-y"; statusName = "Chờ phê duyệt"; }
            else if (isApproved) { statusClass = "b-b"; statusName = "Đã duyệt"; }
            else if (isInProgress) { statusClass = "b-b"; statusName = inventoryPosted ? "Đã nhập" : "Đã xuất"; }
            else if (isDone) { statusClass = "b-g"; statusName = "Hoàn thành"; }
            else if (isCancelled) { statusClass = "b-r"; statusName = "Đã hủy"; }
        }
        <div style="display:flex; align-items:flex-end; flex-direction:column; gap:10px;">
            <span class="badge @statusClass"><span class="dot"></span>@statusName</span>
            <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:flex-start;">
                @if (Model.Order?.CanEdit == true && Model.IsManager)
                {
                    <a href="/Transfer/Create?id=@Model.Order.TransferOrderId" class="btn btn-light" style="padding: 6px 12px; color: var(--accent-600);">
                        <i class="ri-edit-line"></i> Sửa phiếu
                    </a>
                }

                @if (Model.Order?.CanApprove == true && Model.IsManager)
                {
                    <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#approveModal" style="padding: 6px 12px;">
                        <i class="ri-check-line"></i> Phê duyệt
                    </button>
                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal" style="padding: 6px 12px;">
                        <i class="ri-close-line"></i> Từ chối
                    </button>
                }

                @if (Model.Order?.CanIssue == true && Model.IsStaff)
                {
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#issueModal" style="padding: 6px 12px;">
                        <i class="ri-logout-box-r-line"></i> Xác nhận xuất
                    </button>
                }

                @if (Model.Order?.CanReceive == true && Model.IsStaff)
                {
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#receiveModal" style="padding: 6px 12px; background: #0e7490;">
                        <i class="ri-login-box-line"></i> Xác nhận nhập
                    </button>
                }
            </div>
        </div>
    </div>

    @if (Model.Order != null)
    {
        <div class="card">
            <h3>Thông tin chung</h3>
            <div class="grid2">
                <div class="field"><label>Mã phiếu</label><input disabled value="@Model.Order.TransferOrderNumber"></div>
                <div class="field"><label>Kho hàng</label><input disabled value="@Model.Order.WarehouseName"></div>
                <div class="field"><label>Ngày tạo</label><input disabled value="@Model.Order.RequestedDate.ToString("dd/MM/yyyy")"></div>
                <div class="field"><label>Ngày dự kiến hoàn thành</label><input disabled value="@(Model.Order.DueDate.HasValue ? Model.Order.DueDate.Value.ToString("dd/MM/yyyy") : "—")"></div>
                
                <div class="field"><label>Người lập lệnh</label><input disabled value="@Model.Order.CreatedByName"></div>
                <div class="field"><label>Nhân viên phụ trách</label><input disabled value="@(string.IsNullOrEmpty(Model.Order.AssignedToName) ? "—" : Model.Order.AssignedToName)"></div>
                
                @if (!string.IsNullOrEmpty(Model.Order.ConfirmedByName))
                {
                    <div class="field"><label>@(isDone ? "Người xác nhận" : "Người duyệt")</label><input disabled value="@Model.Order.ConfirmedByName"></div>
                }
                @if (!string.IsNullOrEmpty(Model.Order.Notes))
                {
                    <div class="field" style="grid-column: span 4;"><label>Ghi chú</label><input disabled value="@Model.Order.Notes"></div>
                }
            </div>
        </div>

        <div class="card">
            <h3>Dòng hàng & số lượng (@Model.Order.Details.Count dòng)</h3>
            <div style="overflow-x:auto;">
                <table>
                    <thead>
                        <tr>
                            <th style="width: 5%">#</th>
                            <th style="width: 25%">Sản phẩm</th>
                            <th style="width: 15%">Lô hàng</th>
                            <th style="width: 15%; padding-left: 10px;">Ô nguồn</th>
                            <th style="width: 15%; padding-left: 10px;">Ô đích</th>
                            <th class="num" style="width: 15%;">SL Yêu cầu</th>
                            <th style="width: 10%; text-align:center;">Kết quả</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Order.Details.Count; i++)
                        {
                            var d = Model.Order.Details[i];
                            bool fullMoved = (isInProgress || isDone) && d.MovedQuantity >= d.RequestedQuantity;
                            <tr>
                                <td style="color:var(--ink-3); font-weight:700;">@(i + 1)</td>
                                <td>
                                    <span class="prod-code">@d.ProductCode</span>
                                    <span style="font-weight:600;">@d.ProductName</span>
                                </td>
                                <td>
                                    <span style="background:var(--bg); border: 1px solid var(--line-strong); padding:3px 8px; border-radius:6px; font-size:12px; font-weight: 600;">@d.LotNumber</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(d.SourceZoneCode))
                                    {
                                        <div style="font-size:11px; color:var(--ink-3); margin-bottom: 2px;">@d.SourceZoneCode / @d.SourceRackCode</div>
                                    }
                                    <span style="background:#fef3c7; color:#92400e; padding:3px 8px; border-radius:6px; font-weight:700; font-size:12px;">@d.SourceLocationCode</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(d.DestZoneCode))
                                    {
                                        <div style="font-size:11px; color:var(--ink-3); margin-bottom: 2px;">@d.DestZoneCode / @d.DestRackCode</div>
                                    }
                                    <span style="background:#dbeafe; color:#1e40af; padding:3px 8px; border-radius:6px; font-weight:700; font-size:12px;">@d.DestLocationCode</span>
                                </td>
                                <td class="num">
                                    <div style="font-weight:700;">@d.RequestedQuantity.ToString("N2") @d.UnitName</div>
                                    @if (isInProgress || isDone)
                                    {
                                        <div style="font-size: 11px; color: var(--ink-3); margin-top: 3px;">Đã chuyển: <span style="color: @(fullMoved ? "#16a34a" : "#64748b"); font-family:var(--font-mono);">@d.MovedQuantity.ToString("N2")</span></div>
                                    }
                                </td>
                                <td style="text-align:center;">
                                    @if (isInProgress || isDone)
                                    {
                                        if (fullMoved)
                                        {
                                            <span class="badge b-g">✓ Đủ</span>
                                        }
                                        else
                                        {
                                            <span class="badge b-r">⚠ Thiếu</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="muted" style="font-size:11px;">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (isInProgress || isDone)
            {
                var sumRequested = Model.Order.Details.Sum(d => d.RequestedQuantity);
                var sumMoved = Model.Order.Details.Sum(d => d.MovedQuantity);
                <div class="stat-strip">
                    <span class="small muted">Tổng yêu cầu @sumRequested.ToString("N2") · đã thực hiện @sumMoved.ToString("N2")</span>
                    @if (sumMoved >= sumRequested)
                    {
                        <b style="color:var(--g-tx)">Đủ số lượng</b>
                    }
                    else
                    {
                        <b style="color:var(--y-tx)">Thiếu: @((sumRequested - sumMoved).ToString("N2"))</b>
                    }
                </div>
            }
        </div>
    }
</div>

<!-- MODAL PHÊ DUYỆT -->
@if (Model.IsManager && isDraft)
{
    <div class="modal fade" id="approveModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" style="border-radius:12px;">
                <form method="post" asp-page-handler="Approve" asp-route-id="@Model.Order?.TransferOrderId">
                    @Html.AntiForgeryToken()
                    <div class="modal-header" style="border-bottom:1px solid #f1f5f9;">
                        <h5 class="modal-title" style="font-size:16px; font-weight:700; color:#16a34a;">
                            <i class="ri-checkbox-circle-line"></i> Phê Duyệt Lệnh Điều Chuyển
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body" style="font-size:13px; color:#334155;">
                        <p>Bạn xác nhận phê duyệt lệnh <strong>@Model.Order?.TransferOrderNumber</strong>?</p>

                        <div class="mb-3">
                            <label class="form-label" style="font-weight:600; font-size:12px; color:#475569;">Ghi chú phê duyệt (tùy chọn)</label>
                            <textarea name="notes" class="form-control form-control-sm" rows="2" placeholder="Nhập ghi chú nếu có..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top:1px solid #f1f5f9;">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="font-size: 13px; padding: 7px 14px;">Hủy</button>
                        <button type="submit" class="btn btn-success" style="font-size: 13px; font-weight:600; padding:7px 18px;">
                            <i class="ri-check-line"></i> Phê Duyệt
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" style="border-radius:12px;">
                <form method="post" asp-page-handler="Reject" asp-route-id="@Model.Order?.TransferOrderId">
                    @Html.AntiForgeryToken()
                    <div class="modal-header" style="border-bottom:1px solid #f1f5f9;">
                        <h5 class="modal-title" style="font-size:16px; font-weight:700; color:#dc2626;">
                            <i class="ri-close-circle-line"></i> Từ Chối Lệnh Điều Chuyển
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body" style="font-size:13px; color:#334155;">
                        <p>Từ chối lệnh điều chuyển <strong>@Model.Order?.TransferOrderNumber</strong>?</p>
                        <div class="mb-3">
                            <label class="form-label" style="font-weight:600; font-size:12px; color:#475569;">Lý do từ chối <span style="color:#ef4444;">*</span></label>
                            <textarea name="notes" class="form-control form-control-sm" rows="2" placeholder="Nhập lý do từ chối..." required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top:1px solid #f1f5f9;">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="font-size: 13px; padding: 7px 14px;">Hủy</button>
                        <button type="submit" class="btn btn-danger" style="font-size: 13px; font-weight:600; padding:7px 18px;">
                            <i class="ri-close-line"></i> Xác Nhận Từ Chối
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- MODAL XÁC NHẬN DI CHUYỂN -->
@if (Model.Order?.CanIssue == true && Model.IsStaff)
{
    <div class="modal fade" id="issueModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" style="border-radius:12px;">
                <form method="post" asp-page-handler="Issue" asp-route-id="@Model.Order?.TransferOrderId">
                    @Html.AntiForgeryToken()
                    <div class="modal-header" style="border-bottom:1px solid #f1f5f9; background:#eff6ff;">
                        <h5 class="modal-title" style="font-size:16px; font-weight:700; color:#1d4ed8;">
                            <i class="ri-logout-box-r-line"></i> Xác Nhận Xuất Hàng
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body" style="font-size:13px; color:#334155;">
                        <p>Bạn xác nhận đã xuất hàng khỏi ô nguồn theo lệnh <strong>@Model.Order?.TransferOrderNumber</strong>?</p>


                        @if (Model.Order?.Details.Any() == true)
                        {
                            <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:10px; margin-bottom:12px; font-size:12px;">
                                @foreach (var d in Model.Order.Details)
                                {
                                    <div style="display:flex; align-items:center; gap:8px; padding:4px 0; border-bottom:1px solid #f1f5f9;">
                                        <span style="font-weight:700; color:#1e293b;">@d.ProductCode</span>
                                        <span style="color:#64748b;">@d.LotNumber</span>
                                        <span>|</span>
                                        <span style="background:#fef3c7; color:#92400e; padding:2px 6px; border-radius:4px;">@d.SourceLocationCode</span>
                                        <span>→</span>
                                        <span style="background:#dbeafe; color:#1e40af; padding:2px 6px; border-radius:4px;">@d.DestLocationCode</span>
                                        <span style="font-weight:700; color:#2563eb; margin-left:auto;">@d.RequestedQuantity.ToString("N2") @d.UnitName</span>
                                    </div>
                                }
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label" style="font-weight:600; font-size:12px; color:#475569;">Ghi chú xuất hàng (tùy chọn)</label>
                            <textarea name="notes" class="form-control form-control-sm" rows="2" placeholder="Ghi chú quá trình xuất hàng..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top:1px solid #f1f5f9;">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="font-size: 13px; padding: 7px 14px;">Hủy</button>
                        <button type="submit" class="btn btn-primary" style="font-size: 13px; font-weight:700; padding:7px 20px;">
                            <i class="ri-logout-box-r-line"></i> Xác Nhận Xuất
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (Model.Order?.CanReceive == true && Model.IsStaff)
{
    <div class="modal fade" id="receiveModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" style="border-radius:12px;">
                <form method="post" asp-page-handler="Receive" asp-route-id="@Model.Order?.TransferOrderId">
                    @Html.AntiForgeryToken()
                    <div class="modal-header" style="border-bottom:1px solid #f1f5f9; background:#ecfeff;">
                        <h5 class="modal-title" style="font-size:16px; font-weight:700; color:#0e7490;">
                            <i class="ri-login-box-line"></i> Xác Nhận Nhập Hàng
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body" style="font-size:13px; color:#334155;">
                        <p>Xác nhận hàng đã đến ô đích theo phiếu <strong>@Model.Order?.TransferOrderNumber</strong>?</p>


                        @if (Model.Order?.Details.Any() == true)
                        {
                            <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:10px; margin-bottom:12px; font-size:12px;">
                                @foreach (var d in Model.Order.Details)
                                {
                                    <div style="display:flex; align-items:center; gap:8px; padding:4px 0; border-bottom:1px solid #f1f5f9;">
                                        <span style="font-weight:700; color:#1e293b;">@d.ProductCode</span>
                                        <span style="color:#64748b;">@d.LotNumber</span>
                                        <span>|</span>
                                        <span style="background:#fef3c7; color:#92400e; padding:2px 6px; border-radius:4px;">@d.SourceLocationCode</span>
                                        <span>→</span>
                                        <span style="background:#dbeafe; color:#1e40af; padding:2px 6px; border-radius:4px;">@d.DestLocationCode</span>
                                        <span style="font-weight:700; color:#0e7490; margin-left:auto;">@d.RequestedQuantity.ToString("N2") @d.UnitName</span>
                                    </div>
                                }
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label" style="font-weight:600; font-size:12px; color:#475569;">Ghi chú nhập hàng (tùy chọn)</label>
                            <textarea name="notes" class="form-control form-control-sm" rows="2" placeholder="Ghi chú quá trình nhập hàng..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top:1px solid #f1f5f9;">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="font-size: 13px; padding: 7px 14px;">Hủy</button>
                        <button type="submit" class="btn btn-primary" style="font-size: 13px; font-weight:700; padding:7px 20px; background:#0e7490; border:none;">
                            <i class="ri-login-box-line"></i> Xác Nhận Nhập
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
