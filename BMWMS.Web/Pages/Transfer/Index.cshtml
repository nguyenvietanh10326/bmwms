@page
@model BMWMS.Web.Pages.Transfer.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Điều chuyển kho";
    ViewData["ActivePage"] = "Transfer";
}

<style>
    .transfer-page select, .transfer-page .form-select {
        padding-right: 2.5rem !important;
        text-overflow: ellipsis;
        white-space: nowrap;
        overflow: hidden;
        background-position: right .75rem center;
    }
</style>

<div class="transfer-page">
    <div class="pagehead" style="display:flex; justify-content:space-between; align-items:flex-end;">
        <div>
            <h3 class="mb-1">Phiếu chuyển kho</h3>
            <p>Quản lý các lệnh điều chuyển nội bộ.</p>
        </div>
        @if (Model.IsStaff)
        {
            <div>
                <a href="/Transfer/Create" class="btn btn-primary"><i class="ri-add-line"></i> Tạo phiếu mới</a>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage)) { <div class="alert alert-success">@Model.SuccessMessage</div> }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }

    <div class="card" style="padding: 20px; background: #fff; border-radius: 12px; border: 1px solid #e2e8f0; margin-bottom: 20px;">
        <form method="get" class="d-flex gap-2">
            <input type="text" name="Keyword" value="@Model.Keyword" placeholder="Nhập mã phiếu..." class="form-control" style="max-width:300px;" />
            <select name="Status" class="form-select" style="max-width:200px;">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="DRAFT" selected="@(Model.Status == "DRAFT" ? "selected" : null)">Nháp</option>
                <option value="APPROVED" selected="@(Model.Status == "APPROVED" ? "selected" : null)">Đã duyệt</option>
                <option value="ASSIGNED" selected="@(Model.Status == "ASSIGNED" ? "selected" : null)">Phiếu cũ - chỉ xem</option>
                <option value="COMPLETED" selected="@(Model.Status == "COMPLETED" ? "selected" : null)">Hoàn thành</option>
                <option value="CANCELLED" selected="@(Model.Status == "CANCELLED" ? "selected" : null)">Đã hủy</option>
            </select>
            <button type="submit" class="btn btn-dark">Lọc</button>
            <a href="/Transfer/Index" class="btn btn-light">Xóa lọc</a>
        </form>
    </div>

    <div class="card" style="background:#fff; border:1px solid #e2e8f0; border-radius:12px; overflow:hidden;">
        <table class="table table-hover mb-0" style="font-size:13px;">
            <thead style="background:#f8fafc;">
                <tr>
                    <th>Mã Phiếu</th>
                    <th>Ngày yêu cầu</th>
                    <th>Người tạo</th>
                    <th>Người thực hiện</th>
                    <th>Số mặt hàng</th>
                    <th>Trạng Thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if(Model.PagedResult.Items.Any())
                {
                    @foreach(var item in Model.PagedResult.Items)
                    {
                        <tr>
                            <td style="font-weight:600;"><a href="/Transfer/Details?id=@item.TransferOrderId">@item.TransferOrderNumber</a></td>
                            <td>@item.RequestedDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.CreatedByName</td>
                            <td>@item.AssignedToName</td>
                            <td>@item.TotalItems dòng</td>
                            <td><span class="badge bg-@item.StatusCss">@item.StatusLabel</span></td>
                            <td class="text-end">
                                <a href="/Transfer/Details?id=@item.TransferOrderId" class="btn btn-sm btn-light">Chi tiết</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center py-4">Không tìm thấy dữ liệu.</td></tr>
                }
            </tbody>
        </table>
        
        @if(Model.PagedResult.TotalCount > 0)
        {
            <div class="p-3" style="background:#f8fafc; border-top:1px solid #e2e8f0; display:flex; justify-content:space-between;">
                <span>Hiển thị @(((Model.PagedResult.PageIndex - 1) * Model.PagedResult.PageSize) + 1) - @(Math.Min(Model.PagedResult.PageIndex * Model.PagedResult.PageSize, Model.PagedResult.TotalCount)) / @Model.PagedResult.TotalCount</span>
                <div class="d-flex gap-2">
                    <a href="/Transfer/Index?PageIndex=@(Model.PagedResult.PageIndex - 1)&Status=@Model.Status&Keyword=@Model.Keyword" class="btn btn-sm btn-light @(Model.PagedResult.PageIndex <= 1 ? "disabled" : "")">Trước</a>
                    <a href="/Transfer/Index?PageIndex=@(Model.PagedResult.PageIndex + 1)&Status=@Model.Status&Keyword=@Model.Keyword" class="btn btn-sm btn-light @(Model.PagedResult.PageIndex >= Model.PagedResult.TotalPages ? "disabled" : "")">Sau</a>
                </div>
            </div>
        }
    </div>
</div>
