@page
@model BMWMS.Web.Pages.Products.DetailsModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Chi tiết {Model.Product.ProductCode}";
    ViewData["ActivePage"] = "Products";
}

<div class="container-fluid px-4 py-4">

    <!-- BREADCRUMB & HEADER -->
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
        <div>
            <div class="text-muted small mb-1 d-flex align-items-center gap-2">
                <a href="/Products/Index" class="text-decoration-none text-muted">Danh mục hàng hóa</a>
                <i class="ri-arrow-right-s-line"></i>
                <span class="text-primary fw-medium">Chi tiết vật tư: @Model.Product.ProductCode</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <h1 class="h3 mb-0 fw-bold text-dark">@Model.Product.ProductName</h1>
                @if (Model.Product.Status == "ACTIVE")
                {
                    <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-1">
                        <i class="ri-checkbox-circle-fill me-1"></i> Đang kinh doanh
                    </span>
                }
                else
                {
                    <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-3 py-1">
                        <i class="ri-close-circle-fill me-1"></i> Ngừng kinh doanh
                    </span>
                }
            </div>
            <div class="text-muted small mt-1">
                Mã SKU: <span class="font-monospace fw-bold text-primary">@Model.Product.ProductCode</span>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a href="/Products/Index" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1 shadow-sm">
                <i class="ri-arrow-left-line"></i> Quay lại
            </a>
            <a href="/Products/Edit?id=@Model.Product.ProductId" class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm">
                <i class="ri-edit-line"></i> Chỉnh sửa
            </a>
        </div>
    </div>

    <!-- METRICS STRIP -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small fw-medium text-uppercase mb-1">Tổng Tồn Thực Tế (On-Hand)</div>
                    <div class="h4 mb-0 fw-bold text-success">
                        @Model.Product.TotalStockOnHand.ToString("N0") <span class="fs-6 text-muted fw-normal">@Model.Product.UnitName</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small fw-medium text-uppercase mb-1">Nhóm Danh Mục</div>
                    <div class="h5 mb-0 fw-bold text-dark mt-2">@Model.Product.GroupName</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small fw-medium text-uppercase mb-1">Quy Tắc Xuất Kho</div>
                    <div class="h5 mb-0 fw-bold text-primary mt-2">
                        @Model.Product.RotationMethod
                        <small class="text-muted fw-normal">(@(Model.Product.RotationMethod == "FIFO" ? "Nhập trước Xuất trước" : "Hạn trước Xuất trước"))</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small fw-medium text-uppercase mb-1">Theo Dõi Hạn Sử Dụng</div>
                    <div class="mt-2">
                        <span class="badge @(Model.Product.TrackExpiry ? "bg-purple-subtle text-purple border-purple" : "bg-light text-secondary border") px-2 py-1">
                            HSD khi nhập: @(Model.Product.TrackExpiry ? "Bắt buộc theo nhãn hàng" : "Không bắt buộc")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TABS NAVIGATION -->
    <ul class="nav nav-tabs nav-tabs-custom mb-4" id="productDetailTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold" id="info-tab" data-bs-toggle="tab" data-bs-target="#info-tab-pane" type="button" role="tab">
                <i class="ri-information-line me-1"></i> Thông Tin & Quy Cách
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="attr-tab" data-bs-toggle="tab" data-bs-target="#attr-tab-pane" type="button" role="tab">
                <i class="bi bi-sliders me-1"></i> Thông Số Kỹ Thuật
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="stock-tab" data-bs-toggle="tab" data-bs-target="#stock-tab-pane" type="button" role="tab">
                <i class="ri-archive-2-line me-1"></i> Phân Bổ Tồn Kho
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="supplier-tab" data-bs-toggle="tab" data-bs-target="#supplier-tab-pane" type="button" role="tab">
                <i class="ri-truck-line me-1"></i> Nhà Cung Cấp
            </button>
        </li>
    </ul>

    <!-- TABS CONTENT -->
    <div class="tab-content bg-white border border-top-0 rounded-bottom shadow-sm p-4" id="productDetailTabsContent">
        
        <!-- TAB: INFO -->
        <div class="tab-pane fade show active" id="info-tab-pane" role="tabpanel" tabindex="0">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <tbody>
                        <tr>
                            <td class="text-muted" style="width: 35%;">Mô tả / Quy cách</td>
                            <td class="fw-medium text-dark">@(Model.Product.Description ?? "Chưa có mô tả")</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Đơn vị tính cơ sở</td>
                            <td class="fw-bold text-dark">@Model.Product.UnitName</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Người khởi tạo</td>
                            <td class="fw-medium text-dark">@Model.Product.CreatedByName</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Thời gian tạo</td>
                            <td class="text-dark">@Model.Product.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                        @if (Model.Product.UpdatedAt.HasValue)
                        {
                            <tr>
                                <td class="text-muted">Cập nhật lần cuối</td>
                                <td class="text-dark">
                                    @Model.Product.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                    @(Model.Product.UpdatedByName != null ? $" (bởi {Model.Product.UpdatedByName})" : "")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB: ATTRIBUTES -->
        <div class="tab-pane fade" id="attr-tab-pane" role="tabpanel" tabindex="0">
            @if (Model.Product.AttributeValues != null && Model.Product.AttributeValues.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 35%;">Tên Thông Số</th>
                                <th>Mã</th>
                                <th class="text-end">Giá Trị</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var av in Model.Product.AttributeValues)
                            {
                                <tr>
                                    <td class="fw-medium text-muted">@av.AttributeName</td>
                                    <td><code class="small text-secondary">@av.AttributeCode</code></td>
                                    <td class="text-end">
                                        <span class="fw-bold text-dark">@av.AttributeValue</span>
                                        @if (!string.IsNullOrEmpty(av.UnitLabel))
                                        {
                                            <span class="small text-muted ms-1">@av.UnitLabel</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-sliders text-muted fs-1 mb-3"></i>
                    <p class="text-muted">Chưa có giá trị thông số kỹ thuật đặc trưng nào được thiết lập.</p>
                </div>
            }
        </div>

        <!-- TAB: STOCK -->
        <div class="tab-pane fade" id="stock-tab-pane" role="tabpanel" tabindex="0">
            @if (Model.Product.StockLocations != null && Model.Product.StockLocations.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Kho Hàng</th>
                                <th>Vị Trí (Location)</th>
                                <th class="text-end">Tồn Thực Tế</th>
                                <th class="text-end">Đang Giữ</th>
                                <th class="text-end">Khả Dụng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var loc in Model.Product.StockLocations)
                            {
                                <tr>
                                    <td class="fw-medium">@loc.WarehouseName</td>
                                    <td class="font-monospace text-primary">@loc.StorageLocationCode</td>
                                    <td class="text-end fw-bold">@loc.QuantityOnHand.ToString("N0")</td>
                                    <td class="text-end text-danger">@loc.QuantityReserved.ToString("N0")</td>
                                    <td class="text-end fw-bold text-success">@loc.QuantityAvailable.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="ri-inbox-line text-muted fs-1 mb-3"></i>
                    <p class="text-muted">Chưa có số dư tồn kho tại bất kỳ vị trí nào.</p>
                </div>
            }
        </div>

        <!-- TAB: SUPPLIERS -->
        <div class="tab-pane fade" id="supplier-tab-pane" role="tabpanel" tabindex="0">
            @if (Model.Product.Suppliers != null && Model.Product.Suppliers.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Mã NCC</th>
                                <th>Tên Nhà Cung Cấp</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sup in Model.Product.Suppliers)
                            {
                                <tr>
                                    <td class="font-monospace text-primary fw-bold">@sup.SupplierCode</td>
                                    <td class="fw-medium text-dark">@sup.SupplierName</td>
                                    <td class="text-center">
                                        <a href="/Admin/Suppliers/Detail/@sup.SupplierCode"
                                           class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1"
                                           title="Xem chi tiết nhà cung cấp">
                                            <i class="ri-external-link-line"></i> Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="ri-truck-line text-muted fs-1 mb-3"></i>
                    <p class="text-muted">Chưa liên kết nhà cung cấp cho mặt hàng này.</p>
                </div>
            }
        </div>

    </div>
</div>

<style>
    .border-dashed { border-style: dashed !important; border-color: #e2e8f0 !important; }
    .nav-tabs-custom .nav-link { color: #64748b; border: none; border-bottom: 2px solid transparent; padding: 12px 20px; }
    .nav-tabs-custom .nav-link:hover { color: #2563b8; border-bottom-color: #cbd5e1; }
    .nav-tabs-custom .nav-link.active { color: #2563b8; border-bottom-color: #2563b8; background: transparent; }
    .text-purple { color: #6b21a8; }
    .bg-purple-subtle { background-color: #f3e8ff; }
    .border-purple { border-color: #e9d5ff; }
</style>


