@page
@model BMWMS.Web.Pages.PurchaseOrders.IndexModel
@using BMWMS.Web.Helpers
@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Danh sách đơn mua hàng";
    ViewData["ActivePage"] = "PurchaseOrders";
}

<style>
  :root {
    --font-ui:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    --navy-950:#233a6b; --navy-900:#1b2d56;
    --bg:#f2f3f7; --card:#ffffff; --line:#e7e9f0;
    --ink:#161b2e; --ink-2:#525a72;
    --accent:#3e5cf6; --accent-600:#3149d4;
    
    --g-bg:#e2f8ea; --g-tx:#0f7a3e; --g-dot:#1fa855;
    --y-bg:#fef3d6; --y-tx:#93650a; --y-dot:#e2a336;
    --r-bg:#fce3e4; --r-tx:#c1222f; --r-dot:#e2454f;
    --b-bg:#e3eaff; --b-tx:#2c48d8; --b-dot:#5876f2;
    --gy-bg:#eceef3; --gy-tx:#565f78; --gy-dot:#9aa1b5;

    --sh-sm:0 1px 2px rgba(16,23,42,.04),0 4px 10px -4px rgba(16,23,42,.07);
    --r-md:12px;
  }
  
  .inbound-page { font-family: var(--font-ui); background: var(--bg); min-height: 100vh; padding: 24px; color: var(--ink); }
  .ib-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
  .ib-title { font-size: 20px; font-weight: 600; color: var(--navy-950); margin: 0; }
  .ib-actions .btn-primary { background: var(--accent); color: #fff; text-decoration: none; padding: 8px 16px; border-radius: 6px; font-weight: 500; font-size: 14px; box-shadow: var(--sh-sm); transition: 0.2s; }
  .ib-actions .btn-primary:hover { background: var(--accent-600); }
  
  .ib-filters { background: var(--card); padding: 16px; border-radius: var(--r-md); box-shadow: var(--sh-sm); margin-bottom: 24px; display: flex; gap: 16px; align-items: flex-end; }
  .filter-group { display: flex; flex-direction: column; gap: 6px; }
  .filter-group label { font-size: 13px; font-weight: 500; color: var(--ink-2); }
  .filter-group input, .filter-group select { padding: 8px 12px; border: 1px solid var(--line); border-radius: 6px; font-size: 14px; outline: none; }
  
  .table-card { background: var(--card); border-radius: var(--r-md); box-shadow: var(--sh-sm); overflow: hidden; }
  .items-table { width: 100%; border-collapse: collapse; text-align: left; }
  .items-table th { background: #fafbfc; padding: 12px 16px; font-size: 13px; font-weight: 600; color: var(--ink-2); border-bottom: 1px solid var(--line); }
  .items-table td { padding: 12px 16px; font-size: 14px; border-bottom: 1px solid var(--line); vertical-align: middle; }
  .items-table tr:hover { background: #fdfdfe; }
  
  .status-badge { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 100px; font-size: 13px; font-weight: 500; }
  .status-badge::before { content: ""; width: 6px; height: 6px; border-radius: 50%; }
  .status-draft { background: var(--gy-bg); color: var(--gy-tx); } .status-draft::before { background: var(--gy-dot); }
  .status-confirmed { background: var(--b-bg); color: var(--b-tx); } .status-confirmed::before { background: var(--b-dot); }
  .status-pending_confirmation, .status-pending_receipt_review { background: var(--y-bg); color: var(--y-tx); }
  .status-pending_confirmation::before, .status-pending_receipt_review::before { background: var(--y-dot); }
  .status-partially_received { background: var(--y-bg); color: var(--y-tx); } .status-partially_received::before { background: var(--y-dot); }
  .status-received, .status-completed { background: var(--g-bg); color: var(--g-tx); }
  .status-received::before, .status-completed::before { background: var(--g-dot); }
  .status-closed { background: var(--g-bg); color: var(--g-tx); } .status-closed::before { background: var(--g-dot); }
  .status-cancelled { background: var(--r-bg); color: var(--r-tx); } .status-cancelled::before { background: var(--r-dot); }
</style>

<div class="inbound-page">
    <div class="ib-header">
        <h1 class="ib-title">Đơn mua hàng</h1>
        <div class="ib-actions">
            <a href="/PurchaseOrders/Create" class="btn-primary">+ Tạo đơn mua hàng</a>
        </div>
    </div>

    <form method="get" class="filters ib-filters" style="display:flex;gap:9px;margin-bottom:16px;flex-wrap:wrap;align-items:flex-end;background:var(--card);padding:16px;border-radius:var(--r-md);box-shadow:var(--sh-sm);">
        <div class="search-wrap" style="position:relative;flex:1;min-width:220px;">
            <label style="font-size: 13px; font-weight: 500; color: var(--ink-2); display:block; margin-bottom:6px;">Tìm kiếm</label>
            <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Mã PO, NCC..." style="width:100%; padding:9px 12px; border:1px solid var(--line); border-radius:6px; font-size:13px;" />
        </div>
        <div class="filter-group">
            <label style="font-size: 13px; font-weight: 500; color: var(--ink-2); display:block; margin-bottom:6px;">Trạng thái</label>
            <select name="status" style="padding:9px 12px; border:1px solid var(--line); border-radius:6px; font-size:13px; background:#fff; min-width:180px;">
                <option value="">Tất cả</option>
                <option value="DRAFT" selected="@(Model.Status == "DRAFT")">Nháp</option>
                <option value="PENDING_CONFIRMATION" selected="@(Model.Status == "PENDING_CONFIRMATION")">Chờ NCC phản hồi</option>
                <option value="CONFIRMED" selected="@(Model.Status == "CONFIRMED")">Đã xác nhận</option>
                <option value="PENDING_RECEIPT_REVIEW" selected="@(Model.Status == "PENDING_RECEIPT_REVIEW")">Chờ duyệt nhận tiếp</option>
                <option value="PENDING_REMAINDER_CONFIRMATION" selected="@(Model.Status == "PENDING_REMAINDER_CONFIRMATION")">Chờ NCC xác nhận giao tiếp</option>
                <option value="PARTIALLY_RECEIVED" selected="@(Model.Status == "PARTIALLY_RECEIVED")">Đã nhận một phần</option>
                <option value="COMPLETED" selected="@(Model.Status == "COMPLETED")">Hoàn tất nhận đủ</option>
                <option value="CLOSED" selected="@(Model.Status == "CLOSED")">Đã kết thúc nhận</option>
                <option value="REJECTED" selected="@(Model.Status == "REJECTED")">NCC từ chối</option>
                <option value="CANCELLED" selected="@(Model.Status == "CANCELLED")">Đã hủy</option>
            </select>
        </div>
        <div class="filter-group" style="display:flex; gap:8px;">
            <button type="submit" class="btn btn-dark" style="background:#233a6b; color:#fff; border:none; padding:9px 16px; border-radius:6px; font-weight:500;">Tìm kiếm</button>
            <a href="/PurchaseOrders/Index" class="btn btn-sub" style="padding: 9px 16px; border: 1px solid var(--line); border-radius: 6px; font-weight: 500; font-size: 14px; text-decoration: none; color: var(--ink-2); background: #fff;">Đặt lại</a>
        </div>
    </form>



    <div class="table-card">
        <table class="items-table">
            <thead>
                <tr>
                    <th>Mã PO</th>
                    <th>Nhà cung cấp</th>
                    <th>Ngày đặt</th>
                    <th>Ngày giao dự kiến</th>
                    <th>Số loại mặt hàng</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Orders != null && Model.Orders.Any())
                {
                    foreach (var po in Model.Orders)
                    {
                        <tr>
                            <td><a href="/PurchaseOrders/Detail?id=@po.PurchaseOrderId" style="color:var(--accent); font-weight:500;">@po.PurchaseOrderNumber</a></td>
                            <td>@po.SupplierName</td>
                            <td>@po.OrderDate.ToString("dd/MM/yyyy")</td>
                            <td>@(po.ExpectedDeliveryDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td>@po.ItemCount mặt hàng</td>
                            <td>
                                <span class="status-badge status-@po.Status.ToLower()">@StatusLabel(po.Status)</span>
                            </td>
                            <td>
                                <a href="/PurchaseOrders/Detail?id=@po.PurchaseOrderId" style="color:var(--ink-2); text-decoration:underline;">Chi tiết</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="text-align:center; padding:24px; color:var(--ink-3);">Không có dữ liệu</td>
                    </tr>
                }
            </tbody>
        </table>
        
        @if (Model.TotalPages > 1)
        {
            <div style="display:flex; justify-content:center; gap:8px; padding:16px; border-top:1px solid var(--line);">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <a href="?searchTerm=@Model.SearchTerm&status=@Model.Status&pageIndex=@i" 
                       class="btn-outline" 
                       style="padding:6px 12px; border-radius:4px; text-decoration:none; @(i == Model.PageIndex ? "background:var(--accent); color:#fff; border-color:var(--accent);" : "color:var(--ink); border:1px solid var(--line);")">
                        @i
                    </a>
                }
            </div>
        }
    </div>
</div>

@functions {
    string StatusLabel(string status) => status switch
    {
        "DRAFT" => "Nháp",
        "PENDING_CONFIRMATION" => "Chờ NCC phản hồi",
        "CONFIRMED" => "Đã xác nhận",
        "PENDING_RECEIPT_REVIEW" => "Chờ duyệt nhận tiếp",
        "PENDING_REMAINDER_CONFIRMATION" => "Chờ NCC xác nhận giao tiếp",
        "PARTIALLY_RECEIVED" => "Đã nhận một phần",
        "RECEIVED" or "COMPLETED" => "Hoàn tất nhận đủ",
        "CLOSED" => "Đã kết thúc nhận",
        "REJECTED" => "NCC từ chối",
        "CANCELLED" => "Đã hủy",
        _ => status
    };
}
