@page
@model BMWMS.Web.Pages.Stocktake.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Stocktake Sessions";
    ViewData["HeaderTitle"] = "Stocktake";

    var historyActive = string.Equals(Model.Status, "HISTORY", StringComparison.OrdinalIgnoreCase);
    var activeStatus = string.IsNullOrWhiteSpace(Model.Status) || historyActive ? "" : Model.Status;
}

<div class="container-fluid" style="padding:24px; max-width:1440px; margin:0 auto;">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
        <div>
            <div class="small text-muted mb-1">Warehouse operations / Stocktake</div>
            <h1 class="h4 mb-1 fw-bold">Stocktake sessions</h1>
            <div class="text-muted small">Danh sach dot kiem kho, trang thai va lich su.</div>
        </div>
        @if (Model.IsManager)
        {
            <a href="/Stocktake/Create" class="btn btn-primary">
                <i class="ri-add-line me-1"></i> New session
            </a>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <div class="row g-3 mb-3">
        <div class="col-md-2"><div class="border rounded p-3 bg-white"><div class="text-muted small">Scheduled</div><div class="fs-4 fw-bold">@Model.PagedResult.ScheduledCount</div></div></div>
        <div class="col-md-2"><div class="border rounded p-3 bg-white"><div class="text-muted small">In progress</div><div class="fs-4 fw-bold">@Model.PagedResult.InProgressCount</div></div></div>
        <div class="col-md-2"><div class="border rounded p-3 bg-white"><div class="text-muted small">Counted</div><div class="fs-4 fw-bold">@Model.PagedResult.CountedCount</div></div></div>
        <div class="col-md-2"><div class="border rounded p-3 bg-white"><div class="text-muted small">Pending approval</div><div class="fs-4 fw-bold">@Model.PagedResult.PendingApprovalCount</div></div></div>
        <div class="col-md-2"><div class="border rounded p-3 bg-white"><div class="text-muted small">Completed</div><div class="fs-4 fw-bold">@Model.PagedResult.CompletedCount</div></div></div>
        <div class="col-md-2"><div class="border rounded p-3 bg-white"><div class="text-muted small">Cancelled</div><div class="fs-4 fw-bold">@Model.PagedResult.CancelledCount</div></div></div>
    </div>

    <div class="border rounded bg-white p-3 mb-3">
        <ul class="nav nav-pills mb-3">
            <li class="nav-item">
                <a class="nav-link @(historyActive ? "" : "active")" href="/Stocktake/Index">Open sessions</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(historyActive ? "active" : "")" href="/Stocktake/Index?Status=HISTORY">History</a>
            </li>
        </ul>

        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted">Keyword</label>
                <input type="text" name="Keyword" value="@Model.Keyword" class="form-control" placeholder="Stocktake number, notes..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Status</label>
                <select name="Status" class="form-select">
                    <option value="">All</option>
                    <option value="SCHEDULED" selected="@(activeStatus == "SCHEDULED" ? "selected" : null)">Scheduled</option>
                    <option value="IN_PROGRESS" selected="@(activeStatus == "IN_PROGRESS" ? "selected" : null)">In progress</option>
                    <option value="COUNTED" selected="@(activeStatus == "COUNTED" ? "selected" : null)">Counted</option>
                    <option value="PENDING_APPROVAL" selected="@(activeStatus == "PENDING_APPROVAL" ? "selected" : null)">Pending approval</option>
                    <option value="COMPLETED" selected="@(activeStatus == "COMPLETED" ? "selected" : null)">Completed</option>
                    <option value="CANCELLED" selected="@(activeStatus == "CANCELLED" ? "selected" : null)">Cancelled</option>
                    <option value="HISTORY" selected="@(historyActive ? "selected" : null)">History</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Warehouse</label>
                <select name="WarehouseId" class="form-select">
                    <option value="">All</option>
                    @foreach (var wh in Model.Warehouses)
                    {
                        <option value="@wh.WarehouseId" selected="@(Model.WarehouseId == wh.WarehouseId ? "selected" : null)">@wh.WarehouseCode - @wh.WarehouseName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">From</label>
                <input type="date" name="FromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">To</label>
                <input type="date" name="ToDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-md-1 d-grid">
                <button class="btn btn-primary" type="submit"><i class="ri-filter-3-line"></i></button>
            </div>
        </form>
    </div>

    <div class="border rounded bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Session</th>
                        <th>Warehouse</th>
                        <th>Planned</th>
                        <th>Assigned</th>
                        <th>Progress</th>
                        <th class="text-end">Variance</th>
                        <th class="text-center">Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PagedResult.Items.Any())
                    {
                        foreach (var item in Model.PagedResult.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@item.StocktakeNumber</div>
                                    <div class="small text-muted">@item.CreatedByName</div>
                                </td>
                                <td>
                                    <div>@item.WarehouseCode</div>
                                    <div class="small text-muted">@item.WarehouseName</div>
                                </td>
                                <td>
                                    <div>@item.PlannedDate.ToString("dd/MM/yyyy")</div>
                                    <div class="small text-muted">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(item.AssignedToName) ? "-" : item.AssignedToName)</td>
                                <td>
                                    <div class="small text-muted">Locations: @item.CountedLocations / @item.TotalLocations</div>
                                    <div class="small text-muted">Items: @item.CountedItems / @item.TotalItems</div>
                                </td>
                                <td class="text-end fw-semibold @(item.TotalDifferenceQuantity == 0 ? "text-muted" : "text-danger")">
                                    @item.TotalDifferenceQuantity.ToString("N2")
                                    <div class="small text-muted">@item.VarianceItems variance lines</div>
                                </td>
                                <td class="text-center">
                                    <span class="badge @item.StatusCss">@item.StatusLabel</span>
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary" href="/Stocktake/Details?id=@item.StocktakeSessionId">
                                        <i class="ri-eye-line"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">No stocktake sessions found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.PagedResult.TotalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center border-top p-3 small text-muted">
                <div>
                    Showing @(((Model.PagedResult.PageIndex - 1) * Model.PagedResult.PageSize) + 1) -
                    @(Math.Min(Model.PagedResult.PageIndex * Model.PagedResult.PageSize, Model.PagedResult.TotalCount))
                    of @Model.PagedResult.TotalCount
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.PagedResult.PageIndex == 1 ? "disabled" : "")">
                            <a class="page-link" href="/Stocktake/Index?PageIndex=@(Model.PagedResult.PageIndex - 1)&PageSize=@Model.PageSize&Keyword=@Model.Keyword&Status=@Model.Status&WarehouseId=@Model.WarehouseId&FromDate=@(Model.FromDate?.ToString("yyyy-MM-dd"))&ToDate=@(Model.ToDate?.ToString("yyyy-MM-dd"))">Prev</a>
                        </li>
                        <li class="page-item @(Model.PagedResult.PageIndex == Model.PagedResult.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="/Stocktake/Index?PageIndex=@(Model.PagedResult.PageIndex + 1)&PageSize=@Model.PageSize&Keyword=@Model.Keyword&Status=@Model.Status&WarehouseId=@Model.WarehouseId&FromDate=@(Model.FromDate?.ToString("yyyy-MM-dd"))&ToDate=@(Model.ToDate?.ToString("yyyy-MM-dd"))">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
