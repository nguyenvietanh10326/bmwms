@page
@model BMWMS.Web.Pages.Stocktake.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kiểm kho";
    ViewData["ActivePage"] = "Stocktake";
}
<div class="transfer-page">
    <div class="pagehead" style="display:flex;justify-content:space-between;align-items:flex-end;gap:16px;">
        <div><h3 class="mb-1">Phiếu kiểm kho</h3><p>Theo dõi nhiệm vụ kiểm kho và kết quả chênh lệch tồn.</p></div>
        @if (Model.IsManager) { <a href="/Stocktake/Create" class="btn btn-primary"><i class="ri-add-line"></i>Tạo phiếu mới</a> }
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6 col-xl-3"><div class="card h-100 p-3"><span class="text-muted small">Chờ bắt đầu</span><strong class="fs-4 mt-1">@Model.PagedResult.ScheduledCount</strong></div></div>
        <div class="col-6 col-xl-3"><div class="card h-100 p-3"><span class="text-muted small">Đang kiểm</span><strong class="fs-4 mt-1 text-primary">@Model.PagedResult.InProgressCount</strong></div></div>
        <div class="col-6 col-xl-3"><div class="card h-100 p-3"><span class="text-muted small">Chờ phê duyệt</span><strong class="fs-4 mt-1 text-warning">@Model.PagedResult.PendingApprovalCount</strong></div></div>
        <div class="col-6 col-xl-3"><div class="card h-100 p-3"><span class="text-muted small">Hoàn tất</span><strong class="fs-4 mt-1 text-success">@Model.PagedResult.CompletedCount</strong></div></div>
    </div>

    <div class="card" style="padding:20px;background:#fff;border-radius:12px;border:1px solid #e2e8f0;margin-bottom:20px;">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4"><label class="form-label small">Từ khóa</label><input class="form-control" name="Keyword" value="@Model.Keyword" placeholder="Nhập mã phiếu..." /></div>
            <div class="col-md-3"><label class="form-label small">Kho</label><select class="form-select" name="WarehouseId"><option value="">Tất cả kho</option>@foreach (var warehouse in Model.Warehouses) { <option value="@warehouse.WarehouseId" selected="@(Model.WarehouseId == warehouse.WarehouseId ? "selected" : null)">@warehouse.WarehouseCode - @warehouse.WarehouseName</option> }</select></div>
            <div class="col-md-3"><label class="form-label small">Trạng thái</label><select class="form-select" name="Status"><option value="">Tất cả trạng thái</option><option value="SCHEDULED" selected="@(Model.Status == "SCHEDULED" ? "selected" : null)">Đã lên lịch</option><option value="IN_PROGRESS" selected="@(Model.Status == "IN_PROGRESS" ? "selected" : null)">Đang kiểm</option><option value="PENDING_APPROVAL" selected="@(Model.Status == "PENDING_APPROVAL" ? "selected" : null)">Chờ phê duyệt</option><option value="COMPLETED" selected="@(Model.Status == "COMPLETED" ? "selected" : null)">Hoàn tất</option><option value="REJECTED" selected="@(Model.Status == "REJECTED" ? "selected" : null)">Đã từ chối</option><option value="CANCELLED" selected="@(Model.Status == "CANCELLED" ? "selected" : null)">Đã hủy</option></select></div>
            <div class="col-md-2 d-flex gap-2"><button class="btn btn-dark flex-fill" type="submit">Lọc</button><a href="/Stocktake/Index" class="btn btn-light" title="Xóa lọc"><i class="ri-refresh-line"></i></a></div>
        </form>
    </div>

    <div class="card" style="background:#fff;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;">
        <div class="table-responsive"><table class="table table-hover align-middle mb-0" style="font-size:13px;"><thead style="background:#f8fafc;"><tr><th>Mã phiếu</th><th>Kho</th><th>Người phụ trách</th><th>Ngày dự kiến</th><th>Tiến độ</th><th>Chênh lệch</th><th>Trạng thái</th><th></th></tr></thead><tbody>
        @if (Model.PagedResult.Items.Any())
        {
            @foreach (var item in Model.PagedResult.Items)
            {
                var statusClass = item.Status switch { "SCHEDULED" => "bg-secondary", "IN_PROGRESS" => "bg-primary", "PENDING_APPROVAL" => "bg-warning text-dark", "COMPLETED" => "bg-success", "REJECTED" => "bg-danger", "CANCELLED" => "bg-danger", _ => "bg-secondary" };
                <tr><td><a class="fw-semibold" href="/Stocktake/Details?id=@item.StocktakeSessionId">@item.StocktakeNumber</a></td><td>@item.WarehouseName</td><td>@(item.AssignedToName ?? "Chưa giao")</td><td>@item.PlannedDate.ToString("dd/MM/yyyy")</td><td>@item.CountedLocations/@item.TotalLocations vị trí</td><td>@if (item.VarianceItems > 0) { <span class="text-danger fw-semibold">@item.VarianceItems dòng</span> } else { <span class="text-muted">-</span> }</td><td><span class="badge @statusClass">@item.StatusLabel</span></td><td class="text-end"><a class="btn btn-sm btn-light" href="/Stocktake/Details?id=@item.StocktakeSessionId">Chi tiết</a></td></tr>
            }
        }
        else { <tr><td colspan="8" class="text-center py-4 text-muted">Không tìm thấy dữ liệu.</td></tr> }
        </tbody></table></div>
        @if (Model.PagedResult.TotalCount > 0)
        {
            <div class="p-3" style="background:#f8fafc;border-top:1px solid #e2e8f0;display:flex;justify-content:space-between;align-items:center;"><span>Hiển thị @(((Model.PagedResult.PageIndex - 1) * Model.PagedResult.PageSize) + 1) - @(Math.Min(Model.PagedResult.PageIndex * Model.PagedResult.PageSize, Model.PagedResult.TotalCount)) / @Model.PagedResult.TotalCount</span><div class="d-flex gap-2"><a class="btn btn-sm btn-light @(Model.PagedResult.PageIndex <= 1 ? "disabled" : "")" href="?PageIndex=@(Model.PagedResult.PageIndex - 1)&Status=@Model.Status&Keyword=@Model.Keyword&WarehouseId=@Model.WarehouseId">Trước</a><a class="btn btn-sm btn-light @(Model.PagedResult.PageIndex >= Model.PagedResult.TotalPages ? "disabled" : "")" href="?PageIndex=@(Model.PagedResult.PageIndex + 1)&Status=@Model.Status&Keyword=@Model.Keyword&WarehouseId=@Model.WarehouseId">Sau</a></div></div>
        }
    </div>
</div>
