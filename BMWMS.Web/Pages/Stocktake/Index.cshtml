@page
@model BMWMS.Web.Pages.Stocktake.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Danh sach phien kiem kho";
    ViewData["HeaderTitle"] = "Kiem kho";

    var historyActive = string.Equals(Model.Status, "HISTORY", StringComparison.OrdinalIgnoreCase);
    var activeStatus = string.IsNullOrWhiteSpace(Model.Status) || historyActive ? "" : Model.Status;
}

<div class="container-fluid" style="padding:24px; max-width:1440px; margin:0 auto;">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
        <div>
            <div class="small text-muted mb-1">Warehouse operations / Stocktake</div>
            <h1 class="h4 mb-1 fw-bold">Xem danh sach phien kiem kho</h1>
            <div class="text-muted small">Xem va theo doi cac phien kiem kho toan bo hoac theo: tinh trang • Actor chinh: Quan ly kho</div>
        </div>
        @if (Model.IsManager)
        {
            <a href="/Stocktake/Create" class="btn btn-primary">
                <i class="ri-add-line me-1"></i> Tao phien kiem kho
            </a>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <div class="border rounded bg-white p-3 mb-3">
        <ul class="nav nav-pills mb-3">
            <li class="nav-item">
                <a class="nav-link @(historyActive ? "" : "active")" href="/Stocktake/Index">Phien dang mo</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(historyActive ? "active" : "")" href="/Stocktake/Index?Status=HISTORY">Lich su</a>
            </li>
        </ul>

        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted">Tim ma phien kiem kho</label>
                <input type="text" name="Keyword" value="@Model.Keyword" class="form-control" placeholder="Nhap ma phien..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Trang thai</label>
                <select name="Status" class="form-select">
                    <option value="">Tat ca trang thai</option>
                    <option value="SCHEDULED" selected="@(activeStatus == "SCHEDULED" ? "selected" : null)">Da len ke hoach</option>
                    <option value="IN_PROGRESS" selected="@(activeStatus == "IN_PROGRESS" ? "selected" : null)">Dang kiem</option>
                    <option value="COUNTED" selected="@(activeStatus == "COUNTED" ? "selected" : null)">Da dem xong</option>
                    <option value="PENDING_APPROVAL" selected="@(activeStatus == "PENDING_APPROVAL" ? "selected" : null)">Cho phe duyet</option>
                    <option value="COMPLETED" selected="@(activeStatus == "COMPLETED" ? "selected" : null)">Hoan tat</option>
                    <option value="CANCELLED" selected="@(activeStatus == "CANCELLED" ? "selected" : null)">Da huy</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">Kho</label>
                <select name="WarehouseId" class="form-select">
                    <option value="">Tat ca kho</option>
                    @foreach (var wh in Model.Warehouses)
                    {
                        <option value="@wh.WarehouseId" selected="@(Model.WarehouseId == wh.WarehouseId ? "selected" : null)">@wh.WarehouseCode - @wh.WarehouseName</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button class="btn btn-primary flex-grow-1" type="submit">
                    <i class="ri-search-line me-1"></i> Tim kiem
                </button>
                <a href="/Stocktake/Index" class="btn btn-outline-secondary">
                    <i class="ri-reset-left-line"></i> Dat lai
                </a>
            </div>
        </form>
    </div>

    <div class="border rounded bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Ma phieu</th>
                        <th>Loai kiem</th>
                        <th>Pham vi</th>
                        <th>Nguoi thuc hien</th>
                        <th>Trang thai</th>
                        <th>Chuyen trang</th>
                        <th class="text-end">Thao tac</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PagedResult.Items.Any())
                    {
                        foreach (var item in Model.PagedResult.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@item.StocktakeNumber</div>
                                    <div class="small text-muted">@item.PlannedDate.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>
                                    <div class="small">Toan bo kho</div>
                                    <div class="small text-muted">@item.WarehouseCode</div>
                                </td>
                                <td>
                                    <div>@item.WarehouseName</div>
                                    <div class="small text-muted">@item.TotalLocations bin</div>
                                </td>
                                <td>
                                    <div>@(string.IsNullOrWhiteSpace(item.AssignedToName) ? "-" : item.AssignedToName)</div>
                                    <div class="small text-muted">@item.CreatedByName</div>
                                </td>
                                <td>
                                    <span class="badge @item.StatusCss">@item.StatusLabel</span>
                                </td>
                                <td>
                                    <div class="small">
                                        <span class="text-muted">@item.CountedLocations/@item.TotalLocations bin</span>
                                    </div>
                                    <div class="small">
                                        @if (item.VarianceItems > 0)
                                        {
                                            <span class="text-danger">@item.VarianceItems chenh lech</span>
                                        }
                                        else
                                        {
                                            <span class="text-success">Khong chenh lech</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary" href="/Stocktake/Details?id=@item.StocktakeSessionId">
                                        <i class="ri-eye-line me-1"></i> Xem chi tiet
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">Khong co phien kiem kho nao.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.PagedResult.TotalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center border-top p-3 small text-muted">
                <div>
                    Hien @(Model.PagedResult.PageIndex * Model.PagedResult.PageSize - Model.PagedResult.PageSize + 1) -
                    @(Math.Min(Model.PagedResult.PageIndex * Model.PagedResult.PageSize, Model.PagedResult.TotalCount))
                    cua @Model.PagedResult.TotalCount
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.PagedResult.PageIndex == 1 ? "disabled" : "")">
                            <a class="page-link" href="/Stocktake/Index?PageIndex=@(Model.PagedResult.PageIndex - 1)&PageSize=@Model.PageSize&Keyword=@Model.Keyword&Status=@Model.Status&WarehouseId=@Model.WarehouseId">Truoc</a>
                        </li>
                        @for (var i = 1; i <= Model.PagedResult.TotalPages; i++)
                        {
                            if (i == Model.PagedResult.PageIndex)
                            {
                                <li class="page-item active"><span class="page-link">@i</span></li>
                            }
                            else if (i <= 3 || i >= Model.PagedResult.TotalPages - 1 || Math.Abs(i - Model.PagedResult.PageIndex) <= 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="/Stocktake/Index?PageIndex=@i&PageSize=@Model.PageSize&Keyword=@Model.Keyword&Status=@Model.Status&WarehouseId=@Model.WarehouseId">@i</a>
                                </li>
                            }
                            else if (i == 4 || i == Model.PagedResult.TotalPages - 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }
                        <li class="page-item @(Model.PagedResult.PageIndex == Model.PagedResult.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="/Stocktake/Index?PageIndex=@(Model.PagedResult.PageIndex + 1)&PageSize=@Model.PageSize&Keyword=@Model.Keyword&Status=@Model.Status&WarehouseId=@Model.WarehouseId">Sau</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
