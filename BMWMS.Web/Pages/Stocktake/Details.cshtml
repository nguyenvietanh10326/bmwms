@page
@model BMWMS.Web.Pages.Stocktake.DetailsModel
@{
    Layout = "_AdminLayout";
    var s = Model.SessionDetail;
    ViewData["Title"] = $"Chi tiết phiếu kiểm kho {s?.StocktakeNumber}";
    ViewData["ActivePage"] = "Stocktake";

    var status = s?.Status ?? "";
    var isScheduled = status == "SCHEDULED";
    var isInProgress = status == "IN_PROGRESS";
    var isCounted = status == "COUNTED";
    var isPendingApproval = status == "PENDING_APPROVAL";
    var isCompleted = status == "COMPLETED";
    var isCancelled = status == "CANCELLED";
    var isActive = isInProgress || isCounted || isPendingApproval;
    var isDone = isCompleted || isCancelled;
}

<style>
  :root{
    --font-ui:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    --font-mono:"IBM Plex Mono",ui-monospace,monospace;

    --navy-950:#233a6b; --navy-900:#1b2d56; --navy-800:#152d57;
    --accent:#3e5cf6; --accent-600:#3149d4; --accent-100:#e8ecff;

    --bg:#f2f3f7; --card:#ffffff; --line:#e7e9f0; --line-strong:#d7dae5;
    --ink:#161b2e; --ink-2:#525a72; --ink-3:#8890a6; --ink-4:#aeb4c6;

    --g-bg:#e2f8ea; --g-tx:#0f7a3e; --g-dot:#1fa855;
    --y-bg:#fef3d6; --y-tx:#93650a; --y-dot:#e2a336;
    --gy-bg:#eceef3; --gy-tx:#565f78; --gy-dot:#9aa1b5;
    --r-bg:#fce3e4; --r-tx:#c1222f; --r-dot:#e2454f;
    --b-bg:#e3eaff; --b-tx:#2c48d8; --b-dot:#5876f2;

    --sh-xs:0 1px 2px rgba(16,23,42,.05);
    --sh-sm:0 1px 2px rgba(16,23,42,.04),0 4px 10px -4px rgba(16,23,42,.07);
    --r-sm:8px; --r-lg:16px;
    --ease:cubic-bezier(.4,0,.2,1);
  }
  
  .transfer-page {
    font-family: var(--font-ui);
    color: var(--ink);
    font-size: 14px;
    line-height: 1.45;
    padding: 26px 30px 64px;
  }
  .transfer-page * { box-sizing: border-box; }
  .transfer-page button{font-family:inherit;}

  .transfer-page .breadcrumb{font-size:11.5px;color:var(--ink-3);margin-bottom:8px;font-weight:600;letter-spacing:.02em;text-transform:uppercase; display:block; padding:0; background:transparent;}
  .transfer-page .pagehead{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px;gap:20px;}
  .transfer-page .pagehead h1{font-size:20px;margin:0 0 5px;letter-spacing:-.01em;font-weight:700;}
  .transfer-page .pagehead p{margin:0;color:var(--ink-2);font-size:13px;max-width:560px;}

  .transfer-page .card{background:var(--card);border:1px solid var(--line);border-radius:var(--r-lg);padding:22px 24px;margin-bottom:16px;box-shadow:var(--sh-xs);}
  .transfer-page .card h3{margin:0 0 14px;font-size:14px;font-weight:700;letter-spacing:-.005em;display:flex;align-items:center;gap:8px;}
  .transfer-page .row{display:flex;justify-content:space-between;align-items:center;}

  .transfer-page .badge{display:inline-flex;align-items:center;gap:6px;padding:3.5px 10px 3.5px 8px;border-radius:999px;font-size:11.5px;font-weight:600;}
  .transfer-page .badge .dot{width:6px;height:6px;border-radius:50%;flex-shrink:0;}
  .transfer-page .b-g{background:var(--g-bg);color:var(--g-tx);} .transfer-page .b-g .dot{background:var(--g-dot);}
  .transfer-page .b-y{background:var(--y-bg);color:var(--y-tx);} .transfer-page .b-y .dot{background:var(--y-dot);}
  .transfer-page .b-gy{background:var(--gy-bg);color:var(--gy-tx);} .transfer-page .b-gy .dot{background:var(--gy-dot);}
  .transfer-page .b-r{background:var(--r-bg);color:var(--r-tx);} .transfer-page .b-r .dot{background:var(--r-dot);}
  .transfer-page .b-b{background:var(--b-bg);color:var(--b-tx);} .transfer-page .b-b .dot{background:var(--b-dot);}

  .transfer-page table{width:100%;border-collapse:collapse;font-size:13px;}
  .transfer-page th{text-align:left;color:var(--ink-3);font-weight:600;font-size:11px;letter-spacing:.03em;padding:0 10px 10px;border-bottom:1px solid var(--line);}
  .transfer-page th.num, .transfer-page td.num{text-align:right;}
  .transfer-page td{padding:13px 10px;border-bottom:1px solid var(--line);vertical-align:middle;color:var(--ink);}
  .transfer-page td.num{font-family:var(--font-mono);font-variant-numeric:tabular-nums;font-size:12.5px;}
  .transfer-page tbody tr:hover{background:#f8f9fc;}
  .transfer-page tr:last-child td{border-bottom:none;}
  .transfer-page .prod-code{font-family:var(--font-mono);font-size:11px;background:var(--gy-bg);color:var(--ink-2);padding:1.5px 6px;border-radius:5px;margin-right:6px;font-weight:600;}
  .transfer-page .muted{color:var(--ink-3);}
  .transfer-page .small{font-size:12px;}
  .transfer-page .stat-strip{display:flex;justify-content:space-between;align-items:center;margin-top:12px;padding-top:12px;border-top:1px solid var(--line);}

  .transfer-page .grid2{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
  .transfer-page .grid2 label{display:block;font-size:11.5px;color:var(--ink-3);margin-bottom:6px;font-weight:600;text-transform:uppercase;letter-spacing:.02em;}
  .transfer-page .grid2 .field input{width:100%;padding:9px 11px;border:1px solid var(--line-strong);border-radius:var(--r-sm);font-size:13px;background:#fff;color:var(--ink);}
  .transfer-page .grid2 .field input[disabled]{background:#f7f8fb;color:var(--ink-3);border-color:var(--line);}
  
  .transfer-page .btn{display:inline-flex;align-items:center;gap:7px;border:none;border-radius:var(--r-sm);padding:9px 15px;font-size:13px;font-weight:600;cursor:pointer;transition:all .15s var(--ease); text-decoration:none;}
  .transfer-page .btn svg{width:15px;height:15px;}
  .transfer-page .btn-dark{background:var(--navy-950);color:#fff;box-shadow:var(--sh-xs);}
  .transfer-page .btn-dark:hover{background:#1c2340;transform:translateY(-1px);box-shadow:var(--sh-sm); color:#fff;}
  .transfer-page .btn-primary{background:var(--accent-600);color:#fff;box-shadow:var(--sh-xs);}
  .transfer-page .btn-primary:hover{background:#1d4ed8;color:#fff;}
  .transfer-page .btn-success{background:#16a34a;color:#fff;}
  .transfer-page .btn-success:hover{background:#15803d;color:#fff;}
  .transfer-page .btn-danger{background:#dc2626;color:#fff;}
  .transfer-page .btn-danger:hover{background:#b91c1c;color:#fff;}
  .transfer-page .btn-warning{background:#f59e0b;color:#fff;}
  .transfer-page .btn-warning:hover{background:#d97706;color:#fff;}
  .transfer-page .btn-light{background:#fff;border:1px solid var(--line-strong);color:var(--ink);}
  .transfer-page .btn-light:hover{border-color:var(--ink-4);background:#fafafd; color:var(--ink);}
</style>

<svg width="0" height="0" style="position:absolute; display:none;">
    <symbol id="i-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></symbol>
</svg>

<div class="transfer-page">
    <div class="breadcrumb">
        <a href="/Stocktake/Index" style="color:var(--ink-3); text-decoration:none;">Kiểm kho</a>
        <svg style="width:12px; height:12px; display:inline-block; vertical-align:middle; margin:0 4px;"><use href="#i-chev"/></svg>
        <span>Chi tiết phiếu</span>
    </div>
    <div class="pagehead">
        <div>
            <h1>Chi tiết phiên kiểm kho — @s?.StocktakeNumber</h1>
            <p>Thông tin phiếu, kết quả đếm, vị trí và xử lý chênh lệch.</p>
        </div>
        @{
            var statusClass = "b-gy";
            var statusName = status;
            if (isScheduled) { statusClass = "b-y"; statusName = "Đã lên kế hoạch"; }
            else if (isInProgress) { statusClass = "b-b"; statusName = "Đang kiểm"; }
            else if (isCounted) { statusClass = "b-b"; statusName = "Đã đếm xong"; }
            else if (isPendingApproval) { statusClass = "b-y"; statusName = "Chờ duyệt"; }
            else if (isCompleted) { statusClass = "b-g"; statusName = "Hoàn thành"; }
            else if (isCancelled) { statusClass = "b-r"; statusName = "Đã hủy"; }
        }
        <div style="display:flex; align-items:flex-end; flex-direction:column; gap:10px;">
            <span class="badge @statusClass"><span class="dot"></span>@statusName</span>
            <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:flex-start;">
                
                @if (Model.IsManager && s?.CanStart == true)
                {
                    <button type="button" class="btn btn-primary" style="padding: 6px 12px;" data-bs-toggle="modal" data-bs-target="#startModal">
                        <i class="ri-play-circle-line"></i> Bắt đầu
                    </button>
                }

                @if (Model.IsManager && s?.CanCancel == true)
                {
                    <button type="button" class="btn btn-light" style="padding: 6px 12px; color: #dc2626;" data-bs-toggle="modal" data-bs-target="#cancelModal">
                        <i class="ri-close-circle-line"></i> Hủy phiếu
                    </button>
                }

                @if (Model.IsManager && s?.CanApprove == true)
                {
                    <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#approveModal" style="padding: 6px 12px;">
                        <i class="ri-check-double-line"></i> Phê duyệt
                    </button>
                }

                @if (Model.IsManager && s?.CanReview == true && !isPendingApproval)
                {
                    <form method="post" asp-page-handler="SubmitForReview" asp-route-id="@s.StocktakeSessionId" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-warning" style="padding: 6px 12px;" onclick="return confirm('Gửi phiên này để xử lý chênh lệch?')">
                            <i class="ri-send-plane-line"></i> Gửi xử lý
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>


    @if (s != null)
    {
        <div class="card">
            <h3>Thông tin chung</h3>
            <div class="grid2">
                <div class="field"><label>Mã phiếu</label><input disabled value="@s.StocktakeNumber"></div>
                <div class="field"><label>Kho hàng</label><input disabled value="@s.WarehouseName"></div>
                <div class="field"><label>Ngày dự kiến</label><input disabled value="@s.PlannedDate.ToString("dd/MM/yyyy")"></div>
                <div class="field"><label>Tiến độ đếm</label><input disabled value="@s.CountedLocations / @s.TotalLocations bin (@(s.TotalLocations > 0 ? (s.CountedLocations*100/s.TotalLocations) : 0)%)"></div>
                
                <div class="field"><label>Người tạo</label><input disabled value="@s.CreatedByName"></div>
                <div class="field"><label>Người phụ trách</label><input disabled value="@(string.IsNullOrEmpty(s.AssignedToName) ? "—" : s.AssignedToName)"></div>
                
                @if (s.StartedAt.HasValue)
                {
                    <div class="field"><label>Bắt đầu lúc</label><input disabled value="@s.StartedAt.Value.ToString("dd/MM/yyyy HH:mm")"></div>
                }
                @if (s.ApprovedAt.HasValue)
                {
                    <div class="field"><label>Người phê duyệt</label><input disabled value="@s.ApprovedByName"></div>
                }
                @if (!string.IsNullOrEmpty(s.Notes))
                {
                    <div class="field" style="grid-column: span 4;"><label>Ghi chú</label><input disabled value="@s.Notes"></div>
                }
            </div>
        </div>

        <div class="card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
                <h3 style="margin:0;">Danh sách vị trí (Bin) (@(s.Locations?.Count ?? 0) ô)</h3>
                @if (s.RecountLocations > 0)
                {
                    <span class="badge b-y"><span class="dot"></span>@s.RecountLocations chờ đếm lại</span>
                }
            </div>
            
            <div style="overflow-x:auto;">
                <table>
                    <thead>
                        <tr>
                            <th style="width: 20%">Vị trí</th>
                            <th style="width: 15%; text-align:center;">Mặt hàng đếm</th>
                            <th style="width: 15%;" class="num">Chênh lệch</th>
                            <th style="width: 15%; text-align:center;">Trạng thái đếm</th>
                            <th style="width: 15%;">Người đếm</th>
                            <th style="width: 20%; text-align:right;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (s.Locations?.Any() == true)
                        {
                            foreach (var loc in s.Locations)
                            {
                                <tr>
                                    <td>
                                        <div style="font-weight:600; color:#1e293b;">@loc.LocationCode</div>
                                        <div class="muted small">@loc.LocationPath</div>
                                    </td>
                                    <td style="text-align:center;">@loc.CountedItems / @loc.TotalItems</td>
                                    <td class="num @(loc.TotalDifferenceQuantity != 0 ? "text-danger" : "muted")" style="@(loc.TotalDifferenceQuantity != 0 ? "color:#dc2626; font-weight:700;" : "")">
                                        @loc.TotalDifferenceQuantity.ToString("N2")
                                    </td>
                                    <td style="text-align:center;">
                                        @if (loc.CountStatus == "COUNTED")
                                        {
                                            <span class="badge b-g"><span class="dot"></span>Đã đếm</span>
                                        }
                                        else if (loc.CountStatus == "RECOUNT")
                                        {
                                            <span class="badge b-y"><span class="dot"></span>Đếm lại</span>
                                        }
                                        else if (loc.CountStatus == "SUBMITTED")
                                        {
                                            <span class="badge b-b"><span class="dot"></span>Đã nộp</span>
                                        }
                                        else
                                        {
                                            <span class="badge b-gy"><span class="dot"></span>Chưa đếm</span>
                                        }
                                    </td>
                                    <td>
                                        <div style="font-weight:500;">@(string.IsNullOrWhiteSpace(loc.CountedByName) ? "—" : loc.CountedByName)</div>
                                        @if (loc.CountedAt.HasValue)
                                        {
                                            <div class="muted small" style="font-size:11px;">@loc.CountedAt.Value.ToString("dd/MM HH:mm")</div>
                                        }
                                    </td>
                                    <td style="text-align:right;">
                                        <div style="display:flex; gap:6px; justify-content:flex-end;">
                                            @if (Model.IsStaff && loc.CanCount && isInProgress)
                                            {
                                                <a href="/Stocktake/Count?id=@s.StocktakeSessionId&locationId=@loc.StorageLocationId" class="btn btn-primary" style="padding:4px 10px; font-size:12px;">
                                                    <i class="ri-calculator-line"></i> Đếm
                                                </a>
                                            }
                                            else if (loc.CountStatus == "COUNTED" || loc.CountStatus == "SUBMITTED")
                                            {
                                                <a href="/Stocktake/Count?id=@s.StocktakeSessionId&locationId=@loc.StorageLocationId" class="btn btn-light" style="padding:4px 10px; font-size:12px;">
                                                    <i class="ri-eye-line"></i> Chi tiết
                                                </a>
                                            }

                                            @if (Model.IsManager && (loc.CountStatus == "SUBMITTED" || loc.CountStatus == "COUNTED") && isInProgress)
                                            {
                                                <form method="post" asp-page-handler="RequestRecount" asp-route-id="@s.StocktakeSessionId" asp-route-locationId="@loc.StorageLocationId" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-light" style="padding:4px 10px; font-size:12px; color:#d97706;" onclick="return confirm('Yêu cầu đếm lại bin @loc.LocationCode?');">
                                                        <i class="ri-refresh-line"></i> Đếm lại
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" style="text-align:center; padding:30px; color:var(--ink-3);">
                                    Không có dữ liệu vị trí.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (s.Items?.Any() == true)
        {
            <div class="card">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
                    <h3 style="margin:0;">Chi tiết mặt hàng & Xử lý chênh lệch</h3>
                    @if (s.VarianceItems > 0)
                    {
                        <span class="badge b-r"><span class="dot"></span>@s.VarianceItems mặt hàng lệch</span>
                    }
                </div>

                @if (Model.IsManager && s.CanReview && isPendingApproval)
                {
                    <form method="post" asp-page-handler="Resolutions" asp-route-id="@s.StocktakeSessionId" id="resolutionForm">
                        @Html.AntiForgeryToken()
                        <div style="overflow-x:auto;">
                            <table>
                                <thead>
                                    <tr>
                                        <th style="width: 15%">Vị trí</th>
                                        <th style="width: 25%">Sản phẩm / Lô</th>
                                        <th class="num" style="width: 10%">Sổ sách</th>
                                        <th class="num" style="width: 10%">Thực đếm</th>
                                        <th class="num" style="width: 10%">Chênh</th>
                                        <th style="width: 15%">Xử lý</th>
                                        <th style="width: 15%">Ghi chú</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < s.Items.Count; i++)
                                    {
                                        var item = s.Items[i];
                                        <tr style="@(item.DifferenceQuantity != 0 ? "background:#fffbeb;" : "")">
                                            <td class="muted small">@item.LocationCode</td>
                                            <td>
                                                <span class="prod-code">@item.ProductCode</span><br/>
                                                <span class="small" style="color:var(--ink-2);">@item.ProductName</span><br/>
                                                <span class="small muted" style="font-size:10px;">Lot: @item.LotNumber</span>
                                                <input type="hidden" name="Resolutions[@i].StocktakeItemId" value="@item.StocktakeItemId" />
                                            </td>
                                            <td class="num small">@item.BookQuantity?.ToString("N2")</td>
                                            <td class="num small">@item.CountedQuantity?.ToString("N2")</td>
                                            <td class="num" style="@(item.DifferenceQuantity != 0 ? "color:#dc2626; font-weight:700;" : "color:var(--ink-3);")">
                                                @(item.DifferenceQuantity.HasValue ? item.DifferenceQuantity.Value.ToString("+0.##;-0.##;0") : "—")
                                            </td>
                                            <td>
                                                @if (item.DifferenceQuantity != 0 || item.IsUnexpected)
                                                {
                                                    <select name="Resolutions[@i].Resolution" style="width:100%; padding:6px; border:1px solid var(--line-strong); border-radius:4px; font-size:12px;">
                                                        <option value="">-- Chọn --</option>
                                                        <option value="ACCEPT_DIFFERENCE" selected="@(item.Resolution == "ACCEPT_DIFFERENCE" ? "selected" : null)">Khớp tồn kho</option>
                                                        <option value="NO_ADJUSTMENT" selected="@(item.Resolution == "NO_ADJUSTMENT" ? "selected" : null)">Bỏ qua</option>
                                                        <option value="RECOUNT" selected="@(item.Resolution == "RECOUNT" ? "selected" : null)">Đếm lại</option>
                                                    </select>
                                                }
                                                else
                                                {
                                                    <span class="muted small">—</span>
                                                    <input type="hidden" name="Resolutions[@i].Resolution" value="NO_ADJUSTMENT" />
                                                }
                                            </td>
                                            <td>
                                                <input type="text" name="Resolutions[@i].Notes" value="@item.Notes" style="width:100%; padding:6px; border:1px solid var(--line-strong); border-radius:4px; font-size:12px;" placeholder="Ghi chú..." />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div style="text-align:right; margin-top:16px;">
                            <button type="submit" class="btn btn-primary">
                                <i class="ri-save-line"></i> Lưu xử lý
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <div style="overflow-x:auto;">
                        <table>
                            <thead>
                                <tr>
                                    <th style="width: 15%">Vị trí</th>
                                    <th style="width: 25%">Sản phẩm / Lô</th>
                                    <th class="num" style="width: 15%">Sổ sách</th>
                                    <th class="num" style="width: 15%">Thực đếm</th>
                                    <th class="num" style="width: 15%">Chênh</th>
                                    <th style="width: 15%">Xử lý</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in s.Items)
                                {
                                    <tr style="@(item.DifferenceQuantity != 0 ? "background:#fffbeb;" : "")">
                                        <td class="muted small">@item.LocationCode</td>
                                        <td>
                                            <span class="prod-code">@item.ProductCode</span><br/>
                                            <span class="small" style="color:var(--ink-2);">@item.ProductName</span><br/>
                                            <span class="small muted" style="font-size:10px;">Lot: @item.LotNumber</span>
                                        </td>
                                        <td class="num small">@item.BookQuantity?.ToString("N2")</td>
                                        <td class="num small">@item.CountedQuantity?.ToString("N2")</td>
                                        <td class="num" style="@(item.DifferenceQuantity != 0 ? "color:#dc2626; font-weight:700;" : "color:var(--ink-3);")">
                                            @(item.DifferenceQuantity.HasValue ? item.DifferenceQuantity.Value.ToString("+0.##;-0.##;0") : "—")
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(item.Resolution))
                                            {
                                                <span class="badge @(item.Resolution == "ACCEPT_DIFFERENCE" ? "b-b" : item.Resolution == "NO_ADJUSTMENT" ? "b-gy" : "b-y")">
                                                    <span class="dot"></span>@item.Resolution
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="muted small">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    }
</div>

@* ── CANCEL MODAL ── *@
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Cancel" asp-route-id="@s?.StocktakeSessionId">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="ri-close-circle-line me-1 text-danger"></i>Hủy phiếu</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">Hủy phiếu <strong>@s?.StocktakeNumber</strong>? Hành động này không thể hoàn tác.</p>
                    <label class="form-label fw-semibold">Lý do hủy</label>
                    <textarea name="notes" class="form-control" rows="3" placeholder="Nhập lý do..."></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger" style="background:#dc2626; color:#fff; border:none; padding:8px 16px; border-radius:6px;">Xác nhận hủy</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── APPROVE MODAL ── *@
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Approve" asp-route-id="@s?.StocktakeSessionId">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="ri-check-double-line me-1 text-success"></i>Phê duyệt và chốt tồn kho</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label fw-semibold">Ghi chú</label>
                    <textarea name="notes" class="form-control" rows="3" placeholder="Nhập ghi chú..."></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Quay lại</button>
                    <button type="submit" class="btn btn-success" style="background:#16a34a; color:#fff; border:none; padding:8px 16px; border-radius:6px;">Phê duyệt</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── START MODAL ── *@
<div class="modal fade" id="startModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Start" asp-route-id="@s?.StocktakeSessionId">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="ri-play-circle-line me-1 text-primary"></i>Bắt đầu kiểm kho</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">Bạn có chắc chắn muốn bắt đầu phiên kiểm kho <strong>@s?.StocktakeNumber</strong>?</p>
                    <div class="alert alert-warning" style="font-size:13px; padding:12px; margin-bottom:0;">
                        <i class="ri-error-warning-fill me-1"></i> Hệ thống sẽ tạo một bản Snapshot (lưu lại số lượng tồn kho hiện tại trên sổ sách) để làm cơ sở đối chiếu khi đếm thực tế.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary" style="background:#2563eb; color:#fff; border:none; padding:8px 16px; border-radius:6px;">Bắt đầu ngay</button>
                </div>
            </form>
        </div>
    </div>
</div>
