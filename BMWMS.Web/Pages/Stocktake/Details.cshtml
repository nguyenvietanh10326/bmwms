@page
@model BMWMS.Web.Pages.Stocktake.DetailsModel
@{
    Layout = "_AdminLayout";
    var s = Model.SessionDetail;
    ViewData["Title"] = $"Stocktake {s?.StocktakeNumber}";
    ViewData["HeaderTitle"] = "Stocktake";

    var status = s?.Status ?? "";
    var isScheduled = status == "SCHEDULED";
    var isInProgress = status == "IN_PROGRESS";
    var isCounted = status == "COUNTED";
    var isPendingApproval = status == "PENDING_APPROVAL";
    var isCompleted = status == "COMPLETED";
    var isCancelled = status == "CANCELLED";
    var isActive = isInProgress || isCounted || isPendingApproval;
    var isDone = isCompleted || isCancelled;
}

<div class="container-fluid" style="padding:24px; max-width:1440px; margin:0 auto;">

    @* ── BREADCRUMB & HEADER ── *@
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
        <div>
            <div class="small text-muted mb-1 d-flex align-items-center gap-1">
                <span>Kho</span>
                <i class="ri-arrow-right-s-line"></i>
                <a href="/Stocktake/Index" class="text-muted text-decoration-none">Kiem kho</a>
                <i class="ri-arrow-right-s-line"></i>
                <span style="color:#2563eb;font-weight:500;">@s?.StocktakeNumber</span>
            </div>
            <h1 class="h4 fw-bold mb-1 d-flex align-items-center gap-2">
                @s?.StocktakeNumber
                <span class="badge @s?.StatusCss fs-6">@s?.StatusLabel</span>
            </h1>
        </div>

        @* ── ACTION BUTTONS ── *@
        <div class="d-flex flex-wrap gap-2 align-items-start">
            <a href="/Stocktake/Index" class="btn btn-outline-secondary btn-sm">
                <i class="ri-arrow-left-line me-1"></i>Quay lai
            </a>

            @if (Model.IsManager && s?.CanStart == true)
            {
                <form method="post" asp-page-handler="Start" asp-route-id="@s.StocktakeSessionId" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary btn-sm"
                            onclick="return confirm('Bat dau phien kiem kho nay? He thong se tao snapshot so luong ton kho.')">
                        <i class="ri-play-circle-line me-1"></i>Bat dau
                    </button>
                </form>
            }

            @if (Model.IsManager && s?.CanCancel == true)
            {
                <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#cancelModal">
                    <i class="ri-close-circle-line me-1"></i>Huy
                </button>
            }

            @if (Model.IsManager && s?.CanApprove == true)
            {
                <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#approveModal">
                    <i class="ri-check-double-line me-1"></i>Phe duyet
                </button>
            }

            @if (Model.IsManager && s?.CanReview == true && !isPendingApproval)
            {
                <form method="post" asp-page-handler="SubmitForReview" asp-route-id="@s!.StocktakeSessionId" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning btn-sm"
                            onclick="return confirm('Gui phien nay de xu ly chenh lech?')">
                        <i class="ri-send-plane-line me-1"></i>Gui xu ly
                    </button>
                </form>
            }
        </div>
    </div>

    @* ── ALERTS ── *@
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="ri-checkbox-circle-line me-1"></i>@Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="ri-error-warning-line me-1"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* ── DEBUG INFO (can be removed in production) ── *@
    <div class="alert alert-info small" style="font-size:11px;">
        <i class="ri-information-line me-1"></i>
        Session ID: @s?.StocktakeSessionId | Trang thai: @s?.Status | Bin da dem: @s?.CountedLocations/@s?.TotalLocations | Mat hang: @s?.CountedItems/@s?.TotalItems
    </div>

    @* ── SWIMLANE PROGRESS INDICATOR ── *@
    <div class="border rounded bg-white p-3 mb-3">
        <div class="d-flex align-items-center gap-0 overflow-auto pb-1" style="min-width:600px;">
            @{
                var steps = new[]
                {
                    ("SCHEDULED",       "ri-calendar-check-line", "Len ke hoach"),
                    ("IN_PROGRESS",     "ri-camera-line",         "Dang kiem"),
                    ("COUNTED",         "ri-calculator-line",     "Da dem xong"),
                    ("PENDING_APPROVAL","ri-user-star-line",      "Cho phe duyet"),
                    ("COMPLETED",       "ri-checkbox-circle-fill","Hoan tat"),
                };
                var statusOrder = new[] { "SCHEDULED","IN_PROGRESS","COUNTED","PENDING_APPROVAL","COMPLETED" };
                var currentIdx = Array.IndexOf(statusOrder, status);
            }
            @for (int si = 0; si < steps.Length; si++)
            {
                var (stepStatus, stepIcon, stepLabel) = steps[si];
                var stepIdx = Array.IndexOf(statusOrder, stepStatus);
                var isPast = stepIdx < currentIdx;
                var isCurr = stepStatus == status;
                var dotColor = isCancelled ? "#94a3b8" : isCurr ? "#2563eb" : isPast ? "#16a34a" : "#cbd5e1";
                var textColor = isCurr ? "#2563eb" : isPast ? "#16a34a" : "#94a3b8";
                <div class="d-flex align-items-center">
                    <div class="text-center" style="min-width:90px;">
                        <div style="width:36px;height:36px;border-radius:50%;background:@dotColor;color:#fff;display:flex;align-items:center;justify-content:center;margin:0 auto 4px;">
                            <i class="@stepIcon" style="font-size:16px;"></i>
                        </div>
                        <div style="font-size:11px;font-weight:600;color:@textColor;white-space:nowrap;">@stepLabel</div>
                    </div>
                    @if (si < steps.Length - 1)
                    {
                        <div style="flex:1;height:2px;background:@(isPast ? "#16a34a" : "#e2e8f0");min-width:20px;"></div>
                    }
                </div>
            }
            @if (isCancelled)
            {
                <div class="ms-3 text-danger small fw-semibold"><i class="ri-close-circle-fill me-1"></i>Da huy</div>
            }
        </div>
    </div>

    <div class="row g-3">
        @* ── LEFT: Session Info ── *@
        <div class="col-lg-4">
            <div class="border rounded bg-white p-3 mb-3">
                <div class="fw-semibold mb-2" style="font-size:13px;color:#64748b;text-transform:uppercase;letter-spacing:.05em;">Thong tin phien</div>
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr><td class="text-muted small">Kho</td><td class="fw-semibold">@s?.WarehouseCode – @s?.WarehouseName</td></tr>
                        <tr><td class="text-muted small">Ngay du kien</td><td>@s?.PlannedDate.ToString("dd/MM/yyyy")</td></tr>
                        <tr><td class="text-muted small">Nguoi tao</td><td>@s?.CreatedByName</td></tr>
                        <tr><td class="text-muted small">Thoi gian tao</td><td>@s?.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td></tr>
                        <tr><td class="text-muted small">Nguoi phu trach</td><td>@(string.IsNullOrWhiteSpace(s?.AssignedToName) ? "—" : s.AssignedToName)</td></tr>
                        @if (s?.StartedAt.HasValue == true)
                        {
                            <tr><td class="text-muted small">Bat dau luc</td><td>@s.StartedAt!.Value.ToString("dd/MM/yyyy HH:mm")</td></tr>
                        }
                        @if (s?.SubmittedAt.HasValue == true)
                        {
                            <tr><td class="text-muted small">Gui luc</td><td>@s.SubmittedAt!.Value.ToString("dd/MM/yyyy HH:mm")</td></tr>
                        }
                        @if (s?.ApprovedAt.HasValue == true)
                        {
                            <tr><td class="text-muted small">Nguoi phe duyet</td><td>@s.ApprovedByName</td></tr>
                            <tr><td class="text-muted small">Phe duyet luc</td><td>@s.ApprovedAt!.Value.ToString("dd/MM/yyyy HH:mm")</td></tr>
                        }
                        @if (!string.IsNullOrWhiteSpace(s?.Notes))
                        {
                            <tr><td class="text-muted small">Ghi chu</td><td>@s.Notes</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Progress Summary *@
            <div class="border rounded bg-white p-3">
                <div class="fw-semibold mb-2" style="font-size:13px;color:#64748b;text-transform:uppercase;letter-spacing:.05em;">Tien do</div>
                <div class="row g-2">
                    <div class="col-6">
                        <div class="border rounded p-2 text-center">
                            <div class="small text-muted">Bin</div>
                            <div class="fw-bold fs-5">@s?.CountedLocations <span class="text-muted small">/ @s?.TotalLocations</span></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border rounded p-2 text-center">
                            <div class="small text-muted">Mat hang</div>
                            <div class="fw-bold fs-5">@s?.CountedItems <span class="text-muted small">/ @s?.TotalItems</span></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border rounded p-2 text-center">
                            <div class="small text-muted">Chenh lech</div>
                            <div class="fw-bold fs-5 @(s?.VarianceItems > 0 ? "text-danger" : "text-success")">@s?.VarianceItems</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border rounded p-2 text-center">
                            <div class="small text-muted">Tong chenh lech</div>
                            <div class="fw-bold fs-5 @(s?.TotalDifferenceQuantity != 0 ? "text-danger" : "text-success")">
                                @s?.TotalDifferenceQuantity.ToString("N2")
                            </div>
                        </div>
                    </div>
                    @if (s?.TotalLocations > 0)
                    {
                        <div class="col-12">
                            @{
                                var pct = s.TotalLocations > 0 ? (int)(s.CountedLocations * 100.0 / s.TotalLocations) : 0;
                            }
                            <div class="progress" style="height:6px;">
                                <div class="progress-bar bg-primary" role="progressbar" style="width:@pct%"></div>
                            </div>
                            <div class="text-muted small mt-1 text-end">@pct% da dem</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── RIGHT: Locations Table ── *@
        <div class="col-lg-8">
            <div class="border rounded bg-white overflow-hidden mb-3">
                <div class="px-3 pt-3 pb-2 border-bottom d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Danh sach bin / Vi tri</span>
                    @if (s?.RecountLocations > 0)
                    {
                        <span class="badge bg-warning text-dark"><i class="ri-refresh-line me-1"></i>@s.RecountLocations cho dem lai</span>
                    }
                </div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Vi tri</th>
                                <th class="text-center">Mat hang</th>
                                <th class="text-end">chenh lech</th>
                                <th class="text-center">Trang thai dem</th>
                                <th class="text-muted small">Nguoi dem</th>
                                <th class="text-end">Thao tac</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (s?.Locations?.Any() == true)
                            {
                                foreach (var loc in s.Locations)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold small">@loc.LocationCode</div>
                                            <div class="text-muted" style="font-size:11px;">@loc.LocationPath</div>
                                        </td>
                                        <td class="text-center small">@loc.CountedItems / @loc.TotalItems</td>
                                        <td class="text-end fw-semibold small @(loc.TotalDifferenceQuantity != 0 ? "text-danger" : "text-muted")">
                                            @loc.TotalDifferenceQuantity.ToString("N2")
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @loc.CountStatusCss">@loc.CountStatusLabel</span>
                                        </td>
                                        <td class="text-muted small">
                                            @(string.IsNullOrWhiteSpace(loc.CountedByName) ? "—" : loc.CountedByName)
                                            @if (loc.CountedAt.HasValue)
                                            {
                                                <div style="font-size:10px;">@loc.CountedAt.Value.ToString("dd/MM HH:mm")</div>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex gap-1 justify-content-end">
                                                @* Staff: count/recount button *@
                                                @if (Model.IsStaff && loc.CanCount && isInProgress)
                                                {
                                                    <a href="/Stocktake/Count?id=@s.StocktakeSessionId&locationId=@loc.StorageLocationId"
                                                       class="btn btn-sm btn-primary">
                                                        <i class="ri-calculator-line me-1"></i>Count
                                                    </a>
                                                }
                                                else if (loc.CountStatus == "COUNTED" || loc.CountStatus == "SUBMITTED")
                                                {
                                                    <a href="/Stocktake/Count?id=@s.StocktakeSessionId&locationId=@loc.StorageLocationId"
                                                       class="btn btn-sm btn-outline-secondary">
                                                        <i class="ri-eye-line"></i>
                                                    </a>
                                                }
                                                @* Manager: request recount *@
                                                @if (Model.IsManager && (loc.CountStatus == "SUBMITTED" || loc.CountStatus == "COUNTED") && isInProgress)
                                                {
                                                    <form method="post" asp-page-handler="RequestRecount"
                                                          asp-route-id="@s.StocktakeSessionId"
                                                          asp-route-locationId="@loc.StorageLocationId"
                                                          style="display:inline;">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-warning"
                                                                title="Request recount"
                                                                onclick="return confirm('Yêu cầu đếm lại bin @loc.LocationCode?')">
                                                            <i class="ri-refresh-line"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">
                                        @if (isScheduled)
                                        {
                                            <div>
                                                <i class="ri-calendar-line fs-3 d-block mb-2"></i>
                                                <span>Phiên chưa bắt đầu. Bấm "Bắt đầu" để tải danh sách bin.</span>
                                            </div>
                                        }
                                        else if (isInProgress)
                                        {
                                            <div>
                                                <i class="ri-loader-line fs-3 d-block mb-2"></i>
                                                <span>Chưa có bin nào được gán. Liên hệ quản lý để thêm bin.</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div>
                                                <i class="ri-inbox-line fs-3 d-block mb-2"></i>
                                                <span>Không tìm thấy vị trí nào.</span>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @* ── Items / Variance table (shown when there are counted items) ── *@
            @if (s?.Items?.Any() == true)
            {
                <div class="border rounded bg-white overflow-hidden">
                    <div class="px-3 pt-3 pb-2 border-bottom d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">Chi tiet mat hang - Chenh lech</span>
                        @if (s.VarianceItems > 0)
                        {
                            <span class="badge bg-danger">@s.VarianceItems chenh lech</span>
                        }
                    </div>

                    @* Manager resolution form (only when PENDING_APPROVAL and CanReview) *@
                    @if (Model.IsManager && s.CanReview && isPendingApproval)
                    {
                        <form method="post" asp-page-handler="Resolutions" asp-route-id="@s.StocktakeSessionId" id="resolutionForm">
                            @Html.AntiForgeryToken()
                            <div class="table-responsive">
                                <table class="table table-sm mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Vi tri</th>
                                            <th>San pham / Lo</th>
                                            <th class="text-end">So sach</th>
                                            <th class="text-end">So dem</th>
                                            <th class="text-end">Chenh</th>
                                            <th style="min-width:150px;">Xu ly</th>
                                            <th style="min-width:150px;">Ghi chu</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < s.Items.Count; i++)
                                        {
                                            var item = s.Items[i];
                                            <tr class="@(item.DifferenceQuantity != 0 ? "table-warning" : "")">
                                                <td class="small text-muted">@item.LocationCode</td>
                                                <td>
                                                    <div class="fw-semibold small">@item.ProductCode</div>
                                                    <div class="text-muted" style="font-size:11px;">@item.ProductName</div>
                                                    <div class="text-muted" style="font-size:10px;">Lot: @item.LotNumber @(item.ExpiryDate.HasValue ? $"– Exp: {item.ExpiryDate.Value:dd/MM/yyyy}" : "")</div>
                                                    @if (item.IsUnexpected)
                                                    {
                                                        <span class="badge bg-info" style="font-size:10px;">Unexpected</span>
                                                    }
                                                    <input type="hidden" name="Resolutions[@i].StocktakeItemId" value="@item.StocktakeItemId" />
                                                </td>
                                                <td class="text-end small">@item.BookQuantity?.ToString("N2")</td>
                                                <td class="text-end small">@item.CountedQuantity?.ToString("N2")</td>
                                                <td class="text-end fw-semibold small @(item.DifferenceQuantity != 0 ? "text-danger" : "text-muted")">
                                                    @(item.DifferenceQuantity.HasValue ? item.DifferenceQuantity.Value.ToString("+0.##;-0.##;0") : "—")
                                                </td>
                                                <td>
                                                    @if (item.DifferenceQuantity != 0 || item.IsUnexpected)
                                                    {
                                                        <select name="Resolutions[@i].Resolution" class="form-select form-select-sm">
                                                            <option value="">-- Chon --</option>
                                                            <option value="ACCEPT_DIFFERENCE" selected="@(item.Resolution == "ACCEPT_DIFFERENCE" ? "selected" : null)">Dieu chinh ton kho</option>
                                                            <option value="NO_ADJUSTMENT" selected="@(item.Resolution == "NO_ADJUSTMENT" ? "selected" : null)">Bo qua</option>
                                                            <option value="RECOUNT" selected="@(item.Resolution == "RECOUNT" ? "selected" : null)">Dem lai</option>
                                                        </select>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">Khong chenh lech</span>
                                                        <input type="hidden" name="Resolutions[@i].Resolution" value="NO_ADJUSTMENT" />
                                                    }
                                                </td>
                                                <td>
                                                    <input type="text" name="Resolutions[@i].Notes" class="form-control form-control-sm"
                                                           value="@item.Notes" placeholder="Notes..." />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="p-3 border-top d-flex justify-content-end">
                                <button type="submit" class="btn btn-primary btn-sm">
                                    <i class="ri-save-line me-1"></i>Luu xu ly
                                </button>
                            </div>
                        </form>
                    }
                    else
                    {
                        @* Read-only view *@
                        <div class="table-responsive">
                            <table class="table table-sm mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Vi tri</th>
                                        <th>San pham / Lo</th>
                                        <th class="text-end">So sach</th>
                                        <th class="text-end">So dem</th>
                                        <th class="text-end">Chenh</th>
                                        <th>Xu ly</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in s.Items)
                                    {
                                        <tr class="@(item.DifferenceQuantity != 0 ? "table-warning" : "")">
                                            <td class="small text-muted">@item.LocationCode</td>
                                            <td>
                                                <div class="fw-semibold small">@item.ProductCode</div>
                                                <div class="text-muted" style="font-size:11px;">@item.ProductName</div>
                                                <div class="text-muted" style="font-size:10px;">Lot: @item.LotNumber @(item.ExpiryDate.HasValue ? $"– Exp: {item.ExpiryDate.Value:dd/MM/yyyy}" : "")</div>
                                                @if (item.IsUnexpected)
                                                {
                                                    <span class="badge bg-info" style="font-size:10px;">Unexpected</span>
                                                }
                                            </td>
                                            <td class="text-end small">@item.BookQuantity?.ToString("N2")</td>
                                            <td class="text-end small">@item.CountedQuantity?.ToString("N2")</td>
                                            <td class="text-end fw-semibold small @(item.DifferenceQuantity != 0 ? "text-danger" : "text-muted")">
                                                @(item.DifferenceQuantity.HasValue ? item.DifferenceQuantity.Value.ToString("+0.##;-0.##;0") : "—")
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(item.Resolution))
                                                {
                                                    <span class="badge @(item.Resolution == "ACCEPT_DIFFERENCE" ? "bg-primary" : item.Resolution == "NO_ADJUSTMENT" ? "bg-secondary" : "bg-warning text-dark")">
                                                        @item.Resolution
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">—</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@* ── CANCEL MODAL ── *@
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Cancel" asp-route-id="@s?.StocktakeSessionId">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="ri-close-circle-line me-1 text-danger"></i>Huy phien kiem kho</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">Huy phien kiem kho <strong>@s?.StocktakeNumber</strong>? Hanh dong nay khong the hoan tac.</p>
                    <label class="form-label fw-semibold">Ly do huy</label>
                    <textarea name="notes" class="form-control" rows="3" placeholder="Nhap ly do huy..."></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Dong</button>
                    <button type="submit" class="btn btn-danger">Huy phien</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── APPROVE MODAL ── *@
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Approve" asp-route-id="@s?.StocktakeSessionId">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="ri-check-double-line me-1 text-success"></i>Phe duyet dieu chinh ton kho</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Phe duyet va dieu chinh ton kho cho phien <strong>@s?.StocktakeNumber</strong>?</p>
                    @if (s?.VarianceItems > 0)
                    {
                        <div class="alert alert-warning small">
                            <i class="ri-error-warning-line me-1"></i>
                            Co <strong>@s.VarianceItems</strong> dong chenh lech. He thong se dieu chinh ton kho theo xu ly da chon.
                        </div>
                    }
                    <label class="form-label fw-semibold">Ghi chu phe duyet</label>
                    <textarea name="notes" class="form-control" rows="3" placeholder="Nhap ghi chu (tuy chon)..."></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Quay lai</button>
                    <button type="submit" class="btn btn-success">
                        <i class="ri-check-double-line me-1"></i>Phe duyet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
