@page
@model BMWMS.Web.Pages.Stocktake.DetailsModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chi tiết kiểm kho";
    var session = Model.SessionDetail;
}
<link rel="stylesheet" href="~/css/stocktake/details.css" asp-append-version="true" />
<main class="stocktake-detail">
    <nav class="stocktake-breadcrumb"><a href="/Stocktake/Index">Kiểm kho</a><i class="ri-arrow-right-s-line"></i><span>@session?.StocktakeNumber</span></nav>
    @if (session == null) { <div class="stocktake-empty">Không tìm thấy phiếu kiểm kho.</div> }
    else
    {
        <header class="stocktake-header">
            <div><div class="stocktake-eyebrow">@session.WarehouseCode · @session.PlannedDate.ToString("dd/MM/yyyy")</div><h1>@session.StocktakeNumber</h1><p>Người phụ trách: <strong>@(session.AssignedToName ?? "Chưa giao")</strong></p></div>
            <partial name="_DetailsActions" model="session" view-data='new ViewDataDictionary(ViewData) { ["IsManager"] = Model.IsManager, ["IsStaff"] = Model.IsStaff }' />
        </header>
        <partial name="_DetailsSummary" model="session" />
        @if (Model.IsStaff && session.Status == "IN_PROGRESS")
        {
            <partial name="_DetailsCountSheet" model="session" />
        }
        else
        {
            <partial name="_DetailsLocations" model="session" view-data='new ViewDataDictionary(ViewData) { ["IsStaff"] = Model.IsStaff, ["IsManager"] = Model.IsManager }' />
        }
        @if (Model.IsManager || session.Status is "COMPLETED" or "REJECTED") { <partial name="_DetailsVariance" model="session" view-data='new ViewDataDictionary(ViewData) { ["IsManager"] = Model.IsManager }' /> }
    }
</main>
