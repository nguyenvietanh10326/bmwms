@page
@model BMWMS.Web.Pages.Stocktake.CreateModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create stocktake";
    ViewData["HeaderTitle"] = "Create stocktake session";
}

<div class="container-fluid" style="padding:24px; max-width:1000px; margin:0 auto;">
    <div class="mb-3">
        <div class="small text-muted mb-1">Warehouse operations / Stocktake</div>
        <h1 class="h4 fw-bold mb-1">Create stocktake session</h1>
        <div class="text-muted small">Tao thu cong, khong tao lich dinh ky trong v1.</div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <form method="post">
        @Html.AntiForgeryToken()

        <div class="border rounded bg-white p-4 mb-3">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Warehouse <span class="text-danger">*</span></label>
                    <select asp-for="WarehouseId" class="form-select" id="warehouse-select">
                        <option value="">-- Select warehouse --</option>
                        @foreach (var warehouse in Model.Warehouses)
                        {
                            <option value="@warehouse.WarehouseId">@warehouse.WarehouseCode - @warehouse.WarehouseName</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Planned date <span class="text-danger">*</span></label>
                    <input asp-for="PlannedDate" type="date" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Assigned staff</label>
                    <select asp-for="AssignedToUserId" class="form-select">
                        <option value="">-- Optional --</option>
                        @foreach (var user in Model.StaffUsers)
                        {
                            <option value="@user.UserId">@user.FullName (@user.RoleCode)</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Scope, reason, or special instruction..."></textarea>
                </div>
            </div>
        </div>

        <div class="border rounded bg-white p-4 mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label fw-semibold mb-0">Bins (optional)</label>
                <span class="small text-muted" id="location-count">@Model.Locations.Count locations</span>
            </div>
            <select asp-for="StorageLocationIds" class="form-select" id="location-select" multiple size="10">
                @foreach (var location in Model.Locations)
                {
                    <option value="@location.LocationId" selected="@(Model.StorageLocationIds.Contains(location.LocationId) ? "selected" : null)">
                        @location.LocationPath
                    </option>
                }
            </select>
            <div class="form-text">
                De trong de he thong lay toan bo bin active trong warehouse tai thoi diem Start.
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a href="/Stocktake/Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">
                <i class="ri-save-line me-1"></i> Create session
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const warehouseSelect = document.getElementById('warehouse-select');
        const locationSelect = document.getElementById('location-select');
        const locationCount = document.getElementById('location-count');

        warehouseSelect?.addEventListener('change', async function () {
            const warehouseId = this.value;
            locationSelect.innerHTML = '';
            locationCount.textContent = '0 locations';
            if (!warehouseId) return;

            try {
                const response = await fetch(`?handler=LocationsByWarehouse&warehouseId=${encodeURIComponent(warehouseId)}`);
                if (!response.ok) return;
                const locations = await response.json();
                for (const location of locations) {
                    const option = document.createElement('option');
                    option.value = location.locationId;
                    option.textContent = location.locationPath;
                    locationSelect.appendChild(option);
                }
                locationCount.textContent = `${locations.length} locations`;
            } catch {
                locationCount.textContent = 'Unable to load locations';
            }
        });
    </script>
}
