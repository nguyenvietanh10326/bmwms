@page
@model BMWMS.Web.Pages.Stocktake.CreateModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tạo phiếu kiểm kho";
    ViewData["ActivePage"] = "Stocktake";
}

<style>
  :root{
    --font-ui:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    --font-mono:"IBM Plex Mono",ui-monospace,monospace;

    --navy-950:#233a6b; --navy-900:#1b2d56;
    --accent:#3e5cf6; --accent-600:#3149d4;

    --bg:#f2f3f7; --card:#ffffff; --line:#e7e9f0; --line-strong:#d7dae5;
    --ink:#161b2e; --ink-2:#525a72; --ink-3:#8890a6; --ink-4:#aeb4c6;

    --sh-xs:0 1px 2px rgba(16,23,42,.05);
    --sh-sm:0 1px 2px rgba(16,23,42,.04),0 4px 10px -4px rgba(16,23,42,.07);
    --r-sm:6px; --r-md:8px; --r-lg:12px;
    --ease:cubic-bezier(.4,0,.2,1);
  }
  
  .transfer-page {
    font-family: var(--font-ui);
    color: var(--ink);
    font-size: 14px;
    line-height: 1.45;
    padding: 26px 30px 64px;
  }

  .transfer-page .pagehead{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px;gap:20px;}
  .transfer-page .pagehead h1{font-size:20px;margin:0 0 5px;font-weight:700;}
  .transfer-page .breadcrumb{font-size:11.5px;color:var(--ink-3);margin-bottom:8px;font-weight:600;letter-spacing:.02em;text-transform:uppercase;}

  .transfer-page .btn{display:inline-flex;align-items:center;gap:7px;border:none;border-radius:var(--r-sm);padding:9px 15px;font-size:13px;font-weight:600;cursor:pointer;transition:all .15s;text-decoration:none;}
  .transfer-page .btn-dark{background:var(--navy-950);color:#fff;box-shadow:var(--sh-xs);}
  .transfer-page .btn-dark:hover{background:#1c2340;color:#fff;transform:translateY(-1px);box-shadow:var(--sh-sm);}
  .transfer-page .btn-primary{background:#2563eb;color:#fff;box-shadow:var(--sh-xs);}
  .transfer-page .btn-primary:hover{background:#1d4ed8;color:#fff;transform:translateY(-1px);box-shadow:var(--sh-sm);}
  .transfer-page .btn-light{background:#fff;border:1px solid var(--line-strong);color:var(--ink);}
  .transfer-page .btn-light:hover{border-color:var(--ink-4);background:#fafafd;}

  .transfer-page .card{background:var(--card);border:1px solid var(--line);border-radius:var(--r-lg);padding:24px;margin-bottom:16px;box-shadow:var(--sh-xs);}

  .grid2 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field label { font-size: 12.5px; font-weight: 600; color: var(--ink-2); }
  .field input, .field select, .field textarea { width: 100%; padding: 9px 12px; border: 1px solid var(--line-strong); border-radius: var(--r-sm); font-size: 13px; color: var(--ink); font-family: inherit; }
  .field input:disabled { background: var(--bg); color: var(--ink-3); }
  .field input:focus, .field select:focus, .field textarea:focus { outline: none; border-color: var(--accent); }
  
    .scope-options { display:grid; grid-template-columns:repeat(4, 1fr); gap:10px; margin-bottom:18px; }
    .scope-option { position:relative; }
    .scope-option input { position:absolute; opacity:0; pointer-events:none; }
    .scope-option label { display:block; height:100%; padding:14px; border:1px solid var(--line-strong); border-radius:var(--r-sm); cursor:pointer; background:#fff; }
    .scope-option input:checked + label { border-color:var(--accent); background:#f3f6ff; box-shadow:0 0 0 2px rgba(62,92,246,.12); }
    .scope-option strong { display:block; font-size:13px; margin-bottom:4px; }
    .scope-option span { display:block; color:var(--ink-3); font-size:11.5px; }
    .scope-panel { padding:16px; background:#f8fafc; border:1px solid var(--line); border-radius:var(--r-sm); margin-bottom:16px; }
    .selection-table { width:100%; border-collapse:collapse; background:#fff; border:1px solid var(--line); border-radius:var(--r-sm); overflow:hidden; font-size:13px; }
    .selection-table th, .selection-table td { padding:10px 12px; border-bottom:1px solid var(--line); text-align:left; }
    .selection-table th { background:#f8fafc; color:var(--ink-2); font-size:11px; text-transform:uppercase; letter-spacing:.03em; }
    .selection-table tr:last-child td { border-bottom:0; }
    .selection-table tr:hover td { background:#f8faff; }
    .selection-table .check-col { width:44px; text-align:center; }
    .selection-table input[type=checkbox] { width:16px; height:16px; accent-color:var(--accent); }
    .selection-toolbar { display:flex; justify-content:space-between; align-items:center; gap:10px; margin:16px 0 8px; }
    .selection-toolbar h4 { margin:0; font-size:13px; }
    .selection-toolbar button { border:0; background:transparent; color:var(--accent-600); font-size:12px; font-weight:600; cursor:pointer; }
    .table-scroll { overflow-x:auto; }
    .selection-summary { display:flex; gap:10px; flex-wrap:wrap; margin-top:12px; color:var(--ink-2); font-size:12px; }
    .selection-summary strong { color:var(--accent-600); }
    @@media (max-width: 760px) { .scope-options { grid-template-columns:repeat(2, 1fr); } }
  
  .filter-bar { background: #f8fafc; border: 1px solid var(--line); padding: 12px 16px; border-radius: var(--r-sm); display: flex; gap: 12px; align-items: flex-end; margin-bottom: 12px; }
  .filter-bar .field { flex: 1; }
</style>

<div class="transfer-page" style="max-width: 1000px; margin: 0 auto;">
    <div class="pagehead">
        <div>
            <div class="breadcrumb">Nghiệp vụ kho / Kiểm kho / Tạo phiếu</div>
            <h1>Tạo phiếu kiểm kho</h1>
            <p>Giao nhiệm vụ kiểm kho theo toàn kho, Zone, Rack hoặc Bin.</p>
        </div>
        <div style="display: flex; gap: 10px;">
            <a href="/Stocktake/Index" class="btn btn-light">Hủy bỏ</a>
            <button type="button" class="btn btn-primary" onclick="submitForm()">Tạo phiếu</button>
        </div>
    </div>

    <form method="post" id="createForm">
        @Html.AntiForgeryToken()

        <div class="card">
            <h3 style="font-size:15px; font-weight:700; color:var(--ink); margin-top:0; margin-bottom:18px;">Thông tin chung</h3>
            <div class="grid2">
                <div class="field">
                    <label>Mã phiếu kiểm kho</label>
                    <input type="text" value="Tự động sinh khi tạo" disabled />
                </div>
                <div class="field">
                    <label>Kho hàng <span style="color:#dc2626;">*</span></label>
                    <select asp-for="WarehouseId" id="warehouse-select" required>
                        <option value="">-- Chọn kho --</option>
                        @foreach (var warehouse in Model.Warehouses)
                        {
                            <option value="@warehouse.WarehouseId">@warehouse.WarehouseCode - @warehouse.WarehouseName</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Ngày dự kiến <span style="color:#dc2626;">*</span></label>
                    <input asp-for="PlannedDate" type="date" required />
                </div>
                <div class="field">
                    <label>Người phụ trách</label>
                    <select asp-for="AssignedToUserId" required>
                        <option value="">-- Chọn nhân viên kho --</option>
                        @foreach (var user in Model.StaffUsers)
                        {
                            <option value="@user.UserId">@user.FullName (@user.RoleName)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="grid2" style="margin-top:14px">
                <div class="field" style="grid-column: span 4;">
                    <label>Ghi chú</label>
                    <input asp-for="Notes" placeholder="Lý do kiểm kê, hướng dẫn đặc biệt..." />
                </div>
            </div>
        </div>

        <div class="card">
            <h3 style="font-size:15px; font-weight:700; color:var(--ink); margin-top:0; margin-bottom:18px;">Phạm vi kiểm kê</h3>
            
            <div class="scope-options">
                <div class="scope-option"><input type="radio" name="CountScope" id="scopeFull" value="FULL" checked onchange="toggleScope()" /><label for="scopeFull"><strong>Toàn bộ kho</strong><span>Tất cả vị trí đang hoạt động.</span></label></div>
                <div class="scope-option"><input type="radio" name="CountScope" id="scopeZone" value="ZONE" onchange="toggleScope()" /><label for="scopeZone"><strong>Theo Zone</strong><span>Chọn một hoặc nhiều khu vực.</span></label></div>
                <div class="scope-option"><input type="radio" name="CountScope" id="scopeRack" value="RACK" onchange="toggleScope()" /><label for="scopeRack"><strong>Theo Rack</strong><span>Chọn các kệ cần kiểm.</span></label></div>
                <div class="scope-option"><input type="radio" name="CountScope" id="scopeBin" value="BIN" onchange="toggleScope()" /><label for="scopeBin"><strong>Theo Bin</strong><span>Chọn chính xác vị trí.</span></label></div>
            </div>

            <div id="scopePanel" class="scope-panel" style="display:none;">
                <div id="zoneField">
                    <div class="selection-toolbar"><h4>Chọn Zone</h4><button type="button" onclick="toggleTableSelection('zone-table', true)">Chọn tất cả</button></div>
                    <div class="table-scroll"><table class="selection-table" id="zone-table"><thead><tr><th class="check-col"></th><th>Mã Zone</th><th>Tên Zone</th></tr></thead><tbody></tbody></table></div>
                </div>
                <div id="rackField">
                    <div class="selection-toolbar"><h4>Chọn Rack</h4><button type="button" onclick="toggleTableSelection('rack-table', true)">Chọn tất cả</button></div>
                    <div class="table-scroll"><table class="selection-table" id="rack-table"><thead><tr><th class="check-col"></th><th>Mã Rack</th><th>Tên Rack</th><th>Zone</th></tr></thead><tbody></tbody></table></div>
                </div>
                <div class="selection-summary"><span id="scopeHint">Chọn phạm vi để tải danh sách vị trí.</span></div>
            </div>

            <div id="locationResultsSection" style="display:none;">
                <div class="selection-toolbar"><h4>Chọn Bin kiểm kho <span style="color:#dc2626;">*</span></h4><span id="location-count" style="font-size:12px; font-weight:600; color:var(--accent-600);">@Model.Locations.Count vị trí khả dụng</span></div>
                <div class="selection-toolbar" style="justify-content:flex-end; margin-top:0;"><button type="button" onclick="toggleTableSelection('location-table', true)">Chọn tất cả</button><button type="button" onclick="toggleTableSelection('location-table', false)">Bỏ chọn tất cả</button></div>
                <div class="table-scroll"><table class="selection-table" id="location-table"><thead><tr><th class="check-col"></th><th>Bin</th><th>Zone</th><th>Rack</th></tr></thead><tbody></tbody></table></div>
                <div style="font-size:11.5px; color:var(--ink-3); margin-top:6px;"><i class="ri-information-line"></i> Các dòng đã tick sẽ được đưa vào phiếu kiểm kho.</div>
                </div>
            </div>
    </form>
</div>

@section Scripts {
    <script>
        const warehouseSelect = document.getElementById('warehouse-select');
        const zoneTable = document.getElementById('zone-table');
        const rackTable = document.getElementById('rack-table');
        const locationTable = document.getElementById('location-table');
        const locationCount = document.getElementById('location-count');
        const scopePanel = document.getElementById('scopePanel');
        const locationResultsSection = document.getElementById('locationResultsSection');
        const zoneField = document.getElementById('zoneField');
        const rackField = document.getElementById('rackField');
        const scopeHint = document.getElementById('scopeHint');
        const scopeFull = document.getElementById('scopeFull');
        const scopeZone = document.getElementById('scopeZone');
        const scopeRack = document.getElementById('scopeRack');
        const scopeBin = document.getElementById('scopeBin');
        const form = document.getElementById('createForm');

        function selectedValues(table) {
            return [...table.querySelectorAll('input[type="checkbox"]:checked')].map(input => input.value);
        }

        function toggleTableSelection(tableId, checked) {
            document.querySelectorAll(`#${tableId} input[type="checkbox"]`).forEach(input => input.checked = checked);
            if (tableId === 'zone-table') loadRacks();
            if (tableId === 'rack-table') loadLocations();
        }

        function renderEmpty(table, message) {
            table.querySelector('tbody').innerHTML = `<tr><td colspan="4" style="color:var(--ink-3); text-align:center;">${message}</td></tr>`;
        }

        function toggleScope() {
            const scoped = !scopeFull.checked;
            scopePanel.style.display = scoped ? 'block' : 'none';
            locationResultsSection.style.display = scopeFull.checked ? 'none' : 'block';
            zoneField.style.display = scopeZone.checked || scopeRack.checked || scopeBin.checked ? 'block' : 'none';
            rackField.style.display = scopeZone.checked ? 'none' : 'block';
            scopeHint.textContent = scopeZone.checked
                ? 'Chọn Zone; hệ thống sẽ đưa toàn bộ Rack và Bin thuộc Zone vào phiếu.'
                : scopeRack.checked
                    ? 'Chọn một hoặc nhiều Rack; các Bin thuộc Rack sẽ được đưa vào phiếu.'
                    : scopeBin.checked
                        ? 'Chọn trực tiếp các Bin cần kiểm.'
                        : 'Toàn bộ kho sẽ được kiểm khi tạo phiếu.';

            if (warehouseSelect.value && scoped) loadZones().then(() => scopeZone.checked || scopeBin.checked ? loadRacks() : loadLocations());
        }
        
        document.addEventListener('DOMContentLoaded', function() {
            toggleScope();
        });

        warehouseSelect?.addEventListener('change', async function () {
            if (!scopeFull.checked) {
                await loadZones();
                await loadRacks();
                await loadLocations();
            }
        });

        async function loadZones() {
            const wid = warehouseSelect.value;
            zoneTable.querySelector('tbody').innerHTML = '';
            rackTable.querySelector('tbody').innerHTML = '';
            if (!wid) return;

            try {
                const res = await fetch(`?handler=ZonesByWarehouse&warehouseId=${encodeURIComponent(wid)}`);
                if (res.ok) {
                    const zones = await res.json();
                    zones.forEach(z => {
                        zoneTable.querySelector('tbody').insertAdjacentHTML('beforeend', `<tr><td class="check-col"><input type="checkbox" value="${z.zoneId}" onchange="loadRacks()" /></td><td><strong>${z.zoneCode}</strong></td><td>${z.zoneName}</td></tr>`);
                    });
                    if (!zones.length) renderEmpty(zoneTable, 'Kho chưa có Zone hoạt động.');
                }
            } catch(e) { console.error("Error loading zones", e); }
        }

        async function loadRacks() {
            const wid = warehouseSelect.value;
            rackTable.querySelector('tbody').innerHTML = '';
            const zoneIds = selectedValues(zoneTable);
            if (!zoneIds.length) {
                renderEmpty(rackTable, 'Chọn Zone để tải Rack.');
                locationTable.querySelector('tbody').innerHTML = '';
                locationCount.textContent = '0 vị trí khả dụng';
                return;
            }
            try {
                const racks = (await Promise.all(zoneIds.map(zoneId =>
                    fetch(`?handler=RacksByZone&warehouseId=${encodeURIComponent(wid)}&zoneId=${encodeURIComponent(zoneId)}`).then(res => res.ok ? res.json() : [])
                ))).flat();
                racks.forEach(r => {
                    rackTable.querySelector('tbody').insertAdjacentHTML('beforeend', `<tr><td class="check-col"><input type="checkbox" value="${r.rackId}" ${scopeZone.checked ? 'checked' : ''} onchange="loadLocations()" /></td><td><strong>${r.rackCode}</strong></td><td>${r.rackName}</td><td>${r.zoneCode || ''}</td></tr>`);
                });
                if (!racks.length) renderEmpty(rackTable, 'Zone chưa có Rack hoạt động.');
                if (scopeZone.checked) loadLocations();
            } catch(e) { console.error('Error loading racks', e); }
        }

        async function loadLocations() {
            const wid = warehouseSelect.value;
            const rackIds = selectedValues(rackTable);
            const tbody = locationTable.querySelector('tbody');
            tbody.innerHTML = '';
            locationCount.textContent = 'Đang tải...';
            if (!wid) return;

            let url = `?handler=Locations&warehouseId=${encodeURIComponent(wid)}`;
            rackIds.forEach(id => url += `&rackIds=${encodeURIComponent(id)}`);

            try {
                const res = await fetch(url);
                if (res.ok) {
                    const locations = await res.json();
                    locations.forEach(loc => {
                        const path = (loc.locationPath || loc.locationCode || '').split(' / ');
                        const checked = scopeZone.checked || scopeRack.checked;
                        tbody.insertAdjacentHTML('beforeend', `<tr><td class="check-col"><input type="checkbox" name="StorageLocationIds" value="${loc.locationId || loc.storageLocationId}" ${checked ? 'checked' : ''} /></td><td><strong>${path.at(-1) || loc.locationCode}</strong></td><td>${path.length > 2 ? path[0] : ''}</td><td>${path.length > 1 ? path.at(-2) : ''}</td></tr>`);
                    });
                    if (!locations.length) renderEmpty(locationTable, 'Không có Bin phù hợp với phạm vi đã chọn.');
                    locationCount.textContent = `${locations.length} vị trí khả dụng`;
                }
            } catch(e) { 
                console.error("Error loading locations", e); 
                locationCount.textContent = 'Lỗi khi tải vị trí';
            }
        }
        
        function submitForm() {
            if (!form.reportValidity()) {
                return;
            }

            if (!scopeFull.checked) {
                const hasSelection = locationTable.querySelectorAll('input[name="StorageLocationIds"]:checked').length > 0;
                
                if (!hasSelection) {
                    if (typeof Toastify !== 'undefined') {
                        Toastify({
                            text: "Vui lòng chọn ít nhất 1 vị trí (Bin) để kiểm kê.",
                            duration: 3000,
                            gravity: "top",
                            position: "right",
                            backgroundColor: "#ef4444",
                        }).showToast();
                    } else {
                        alert("Vui lòng chọn ít nhất 1 vị trí (Bin) để kiểm kê.");
                    }
                    return;
                }
            }
            
            // Submitting...
            form.submit();
        }
    </script>
}
