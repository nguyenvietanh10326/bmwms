@page
@model BMWMS.Web.Pages.IndexModel
@{
    Layout = null;
    ViewData["Title"] = "BMWMS - Hệ Thống Quản Lý Kho Vật Liệu Xây Dựng";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <style>
        :root {
            --navy: #1e3a6e;
            --navy-dark: #152d57;
            --navy-light: #2d5a9e;
            --blue: #2563b8;
            --blue-light: #3b82f6;
            --blue-soft: #eff6ff;
            --slate-900: #0f172a;
            --slate-800: #1e293b;
            --slate-700: #334155;
            --slate-600: #475569;
            --slate-500: #64748b;
            --slate-400: #94a3b8;
            --slate-200: #e2e8f0;
            --slate-100: #f1f5f9;
            --slate-50: #f8fafc;
            --white: #ffffff;
            --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.07), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -4px rgba(0, 0, 0, 0.04);
            --radius-md: 8px;
            --radius-lg: 12px;
            --radius-xl: 16px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: var(--slate-50);
            color: var(--slate-800);
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Top Navbar ── */
        .navbar {
            position: sticky;
            top: 0;
            background: var(--white);
            border-bottom: 1px solid var(--slate-200);
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 48px;
            z-index: 100;
            box-shadow: var(--shadow-sm);
        }

        .brand-link {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .brand-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--navy), var(--blue));
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: var(--white);
        }

        .brand-text {
            display: flex;
            flex-direction: column;
        }

        .brand-title {
            font-size: 18px;
            font-weight: 700;
            color: var(--navy);
            line-height: 1.2;
            letter-spacing: 0.3px;
        }

        .brand-subtitle {
            font-size: 11px;
            color: var(--slate-500);
            font-weight: 500;
        }

        .nav-menu {
            display: flex;
            align-items: center;
            gap: 28px;
            list-style: none;
        }

        .nav-item a {
            text-decoration: none;
            color: var(--slate-600);
            font-size: 14px;
            font-weight: 500;
            transition: color 0.15s ease;
        }

        .nav-item a:hover {
            color: var(--blue);
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .btn-outline {
            text-decoration: none;
            color: var(--slate-700);
            background: var(--white);
            border: 1px solid var(--slate-200);
            font-size: 13.5px;
            font-weight: 600;
            padding: 8px 16px;
            border-radius: var(--radius-md);
            transition: all 0.15s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .btn-outline:hover {
            background: var(--slate-100);
            color: var(--navy);
            border-color: var(--slate-300);
        }

        .btn-primary {
            text-decoration: none;
            background: linear-gradient(135deg, var(--navy) 0%, var(--blue) 100%);
            color: var(--white);
            font-size: 13.5px;
            font-weight: 600;
            padding: 9px 18px;
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .btn-primary:hover {
            opacity: 0.95;
            transform: translateY(-1px);
            box-shadow: var(--shadow-md);
        }

        /* ── Hero Section ── */
        .hero {
            background: linear-gradient(180deg, var(--white) 0%, var(--slate-50) 100%);
            border-bottom: 1px solid var(--slate-200);
            padding: 64px 24px 72px;
            text-align: center;
        }

        .hero-inner {
            max-width: 860px;
            margin: 0 auto;
        }

        .hero-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            background: var(--blue-soft);
            border: 1px solid #dbeafe;
            border-radius: 20px;
            font-size: 12.5px;
            font-weight: 600;
            color: var(--blue);
            margin-bottom: 20px;
        }

        .hero-title {
            font-size: 38px;
            font-weight: 700;
            color: var(--navy);
            line-height: 1.25;
            letter-spacing: -0.5px;
            margin-bottom: 16px;
        }

        .hero-desc {
            font-size: 16px;
            color: var(--slate-600);
            line-height: 1.6;
            margin-bottom: 32px;
            max-width: 720px;
            margin-left: auto;
            margin-right: auto;
        }

        .hero-buttons {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .btn-hero-main {
            text-decoration: none;
            background: linear-gradient(135deg, var(--navy), var(--blue));
            color: var(--white);
            font-size: 15px;
            font-weight: 600;
            padding: 12px 24px;
            border-radius: var(--radius-md);
            box-shadow: 0 4px 12px rgba(30, 58, 110, 0.25);
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-hero-main:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(30, 58, 110, 0.35);
        }

        .btn-hero-sub {
            text-decoration: none;
            background: var(--white);
            color: var(--slate-700);
            font-size: 15px;
            font-weight: 600;
            padding: 12px 22px;
            border-radius: var(--radius-md);
            border: 1px solid var(--slate-200);
            box-shadow: var(--shadow-sm);
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-hero-sub:hover {
            background: var(--slate-50);
            color: var(--navy);
            border-color: var(--slate-300);
        }

        /* ── Container & Section Header ── */
        .container {
            max-width: 1160px;
            margin: 0 auto;
            padding: 56px 24px;
        }

        .section-header {
            margin-bottom: 36px;
        }

        .section-title {
            font-size: 22px;
            font-weight: 700;
            color: var(--slate-900);
            margin-bottom: 6px;
        }

        .section-desc {
            font-size: 14px;
            color: var(--slate-500);
        }

        /* ── Direct Screen Navigation Cards ── */
        .grid-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 20px;
        }

        .screen-card {
            background: var(--white);
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-lg);
            padding: 24px;
            box-shadow: var(--shadow-sm);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        }

        .screen-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
            border-color: #cbd5e1;
        }

        .card-top {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            margin-bottom: 12px;
        }

        .card-icon {
            width: 44px;
            height: 44px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .icon-blue   { background: #eff6ff; color: var(--blue); }
        .icon-navy   { background: #f0f4f8; color: var(--navy); }
        .icon-teal   { background: #f0fdfa; color: #0d9488; }
        .icon-amber  { background: #fffbeb; color: #d97706; }
        .icon-purple { background: #faf5ff; color: #7c3aed; }
        .icon-rose   { background: #fff1f2; color: #e11d48; }

        .card-title {
            font-size: 16px;
            font-weight: 600;
            color: var(--slate-900);
            margin-bottom: 2px;
        }

        .card-tag {
            font-size: 11.5px;
            color: var(--slate-500);
            font-weight: 500;
        }

        .card-desc {
            font-size: 13.5px;
            color: var(--slate-600);
            line-height: 1.5;
            margin-bottom: 20px;
        }

        .card-links {
            display: flex;
            flex-direction: column;
            gap: 8px;
            border-top: 1px solid var(--slate-100);
            padding-top: 16px;
        }

        .screen-btn {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 9px 12px;
            background: var(--slate-50);
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-md);
            text-decoration: none;
            color: var(--slate-700);
            font-size: 13px;
            font-weight: 500;
            transition: all 0.15s ease;
        }

        .screen-btn:hover {
            background: var(--blue-soft);
            color: var(--blue);
            border-color: #bfdbfe;
        }

        .screen-btn i {
            font-size: 15px;
            color: var(--slate-400);
            transition: transform 0.15s ease;
        }

        .screen-btn:hover i {
            color: var(--blue);
            transform: translateX(3px);
        }

        /* ── Core Domain Overview ── */
        .features-wrap {
            background: var(--white);
            border-top: 1px solid var(--slate-200);
            border-bottom: 1px solid var(--slate-200);
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 24px;
        }

        .feature-item {
            padding: 16px 0;
        }

        .feature-icon {
            font-size: 24px;
            color: var(--blue);
            margin-bottom: 8px;
            display: inline-block;
        }

        .feature-title {
            font-size: 15px;
            font-weight: 600;
            color: var(--slate-900);
            margin-bottom: 6px;
        }

        .feature-desc {
            font-size: 13px;
            color: var(--slate-600);
            line-height: 1.5;
        }

        /* ── Footer ── */
        .footer {
            background: var(--white);
            padding: 32px 24px;
            text-align: center;
            border-top: 1px solid var(--slate-200);
        }

        .footer-logo {
            font-size: 14px;
            font-weight: 700;
            color: var(--navy);
            margin-bottom: 4px;
        }

        .footer-text {
            font-size: 12.5px;
            color: var(--slate-500);
        }

        /* ── Responsive ── */
        @@media (max-width: 768px) {
            .navbar { padding: 0 20px; }
            .nav-menu { display: none; }
            .hero-title { font-size: 28px; }
            .grid-cards { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <!-- ── Top Navbar ── -->
    <header class="navbar">
        <a href="/" class="brand-link">
            <div class="brand-icon">
                <i class="ri-building-4-line"></i>
            </div>
            <div class="brand-text">
                <span class="brand-title">BMWMS</span>
                <span class="brand-subtitle">Quản Lý Kho Vật Liệu Xây Dựng</span>
            </div>
        </a>

        <ul class="nav-menu">
            <li class="nav-item"><a href="#screens">Danh sách chức năng</a></li>
            <li class="nav-item"><a href="#features">Nghiệp vụ kho</a></li>
            <li class="nav-item"><a href="http://localhost:5076/swagger" target="_blank">Tài liệu API</a></li>
        </ul>

        <div class="nav-actions">
            @if (Model.IsLoggedIn)
            {
                <a href="/Admin/Dashboard" class="btn-primary">
                    <i class="ri-dashboard-line"></i> Bảng điều khiển (@Model.FullName)
                </a>
            }
            else
            {
                <a href="/Auth/Login" class="btn-primary">
                    <i class="ri-login-box-line"></i> Đăng nhập hệ thống
                </a>
            }
        </div>
    </header>

    <!-- ── Hero Section ── -->
    <section class="hero">
        <div class="hero-inner">
            <div class="hero-tag">
                <i class="ri-checkbox-circle-line"></i>
                <span>Hệ Thống Quản Lý Kho Doanh Nghiệp (v3.0)</span>
            </div>

            <h1 class="hero-title">
                Hệ Thống Quản Lý Kho<br>Vật Liệu Xây Dựng
            </h1>

            <p class="hero-desc">
                Cung cấp giải pháp quản lý toàn diện cho kho bãi vật liệu xây dựng: quản lý kho kín và bãi tập kết lộ thiên, theo dõi tồn kho theo đơn vị đặc thù (Bao, Tấn, m³, Viên), cảnh báo ngưỡng an toàn và quản trị đối tác cung ứng.
            </p>

            <div class="hero-buttons">
                @if (Model.IsLoggedIn)
                {
                    <a href="/Admin/Dashboard" class="btn-hero-main">
                        <i class="ri-dashboard-3-line"></i> Vào Bảng Điều Khiển
                    </a>
                }
                else
                {
                    <a href="/Auth/Login" class="btn-hero-main">
                        <i class="ri-login-circle-line"></i> Đăng Nhập Hệ Thống
                    </a>
                }
                <a href="#screens" class="btn-hero-sub">
                    <i class="ri-layout-grid-line"></i> Xem Màn Hình Chức Năng
                </a>
            </div>
        </div>
    </section>

    <!-- ── Direct Screen Navigation Cards ── -->
    <main class="container" id="screens">
        <div class="section-header">
            <h2 class="section-title">Màn hình chức năng đã sẵn sàng</h2>
            <p class="section-desc">Truy cập trực tiếp vào các phân hệ nghiệp vụ và use case của hệ thống</p>
        </div>

        <div class="grid-cards">
            <!-- 1. Bảng điều khiển -->
            <div class="screen-card">
                <div>
                    <div class="card-top">
                        <div class="card-icon icon-navy">
                            <i class="ri-dashboard-line"></i>
                        </div>
                        <div>
                            <h3 class="card-title">Tổng quan hệ thống</h3>
                            <span class="card-tag">Bảng điều khiển quản trị</span>
                        </div>
                    </div>
                    <p class="card-desc">
                        Theo dõi nhanh các chỉ số hoạt động kho: tổng số sản phẩm, số kho đang hoạt động, cảnh báo hàng sắp hết và hoạt động giao dịch gần đây.
                    </p>
                </div>
                <div class="card-links">
                    <a href="/Admin/Dashboard" class="screen-btn">
                        <span>Bảng điều khiển (Dashboard)</span>
                        <i class="ri-arrow-right-line"></i>
                    </a>
                </div>
            </div>

            <!-- 2. Quản lý Kho bãi -->
            <div class="screen-card">
                <div>
                    <div class="card-top">
                        <div class="card-icon icon-blue">
                            <i class="ri-store-2-line"></i>
                        </div>
                        <div>
                            <h3 class="card-title">Quản lý Kho & Bãi</h3>
                            <span class="card-tag">Phân khu lưu trữ</span>
                        </div>
                    </div>
                    <p class="card-desc">
                        Quản lý danh sách kho vật liệu, thông tin sức chứa, địa chỉ kho chính/phụ và trạng thái hoạt động của từng điểm lưu trữ.
                    </p>
                </div>
                <div class="card-links">
                    <a href="/Warehouse/Index" class="screen-btn">
                        <span>Danh sách kho bãi</span>
                        <i class="ri-arrow-right-line"></i>
                    </a>
                    <a href="/Warehouse/Create" class="screen-btn">
                        <span>Thêm mới kho hàng</span>
                        <i class="ri-arrow-right-line"></i>
                    </a>
                </div>
            </div>

            <!-- 3. Nhà cung cấp -->
            <div class="screen-card">
                <div>
                    <div class="card-top">
                        <div class="card-icon icon-teal">
                            <i class="ri-truck-line"></i>
                        </div>
                        <div>
                            <h3 class="card-title">Nhà cung cấp</h3>
                            <span class="card-tag">Đối tác cung ứng</span>
                        </div>
                    </div>
                    <p class="card-desc">
                        Theo dõi danh bạ các đối tác cung cấp vật liệu xây dựng (xi măng, sắt thép, gạch ngói), mã số thuế, đầu mối liên hệ và lịch sử giao dịch.
                    </p>
                </div>
                <div class="card-links">
                    <a href="/Admin/Suppliers" class="screen-btn">
                        <span>Danh sách nhà cung cấp</span>
                        <i class="ri-arrow-right-line"></i>
                    </a>
                    <a href="/Admin/Suppliers/Create" class="screen-btn">
                        <span>Thêm nhà cung cấp mới</span>
                        <i class="ri-arrow-right-line"></i>
                    </a>
                </div>
            </div>

            <!-- 4. Danh mục hàng hóa -->
            <div class="screen-card">
                <div>
                    <div class="card-top">
                        <div class="card-icon icon-amber">
                            <i class="ri-box-3-line"></i>
                        </div>
                        <div>
                            <h3 class="card-title">Danh mục hàng hóa</h3>
                            <span class="card-tag">Phân loại sản phẩm</span>
                        </div>
                    </div>
                    <p class="card-desc">
                        Phân nhóm chủng loại vật liệu xây dựng (vật liệu thô, sắt thép, hoàn thiện, thiết bị vệ sinh) và cấu hình đơn vị tính.
                    </p>
                </div>
                <div class="card-links">
                    <a href="/Categories/Index" class="screen-btn">
                        <span>Quản lý danh mục</span>
                        <i class="ri-arrow-right-line"></i>
                    </a>
                </div>
            </div>

            <!-- 5. Tồn kho -->
            <div class="screen-card">
                <div>
                    <div class="card-top">
                        <div class="card-icon icon-purple">
                            <i class="ri-archive-line"></i>
                        </div>
                        <div>
                            <h3 class="card-title">Kiểm soát tồn kho</h3>
                            <span class="card-tag">Tồn thực tế & Khả dụng</span>
                        </div>
                    </div>
                    <p class="card-desc">
                        Giám sát lượng hàng tồn kho thực tế (On-hand), số lượng đang giữ theo đơn (Reserved) và số lượng khả dụng xuất bán.
                    </p>
                </div>
                <div class="card-links">
                    <a href="/Inventory/Index" class="screen-btn">
                        <span>Theo dõi số lượng tồn kho</span>
                        <i class="ri-arrow-right-line"></i>
                    </a>
                    <a href="/Inventory/Inventory" class="screen-btn">
                        <span>Tồn kho theo vị trí lưu trữ</span>
                        <i class="ri-arrow-right-line"></i>
                    </a>
                </div>
            </div>

            <!-- 6. Quản trị & Người dùng -->
            <div class="screen-card">
                <div>
                    <div class="card-top">
                        <div class="card-icon icon-rose">
                            <i class="ri-shield-user-line"></i>
                        </div>
                        <div>
                            <h3 class="card-title">Tài khoản & Phân quyền</h3>
                            <span class="card-tag">Bảo mật & Người dùng</span>
                        </div>
                    </div>
                    <p class="card-desc">
                        Quản lý nhân viên kho, phân quyền theo vai trò (Quản trị viên, Quản lý kho, Nhân viên kho), đổi mật khẩu và bảo mật thông tin.
                    </p>
                </div>
                <div class="card-links">
                    <a href="/Admin/Users" class="screen-btn">
                        <span>Danh sách người dùng</span>
                        <i class="ri-arrow-right-line"></i>
                    </a>
                    <a href="/Admin/Profile" class="screen-btn">
                        <span>Thông tin tài khoản</span>
                        <i class="ri-arrow-right-line"></i>
                    </a>
                </div>
            </div>
        </div>
    </main>

    <!-- ── Core Domain Overview ── -->
    <section class="features-wrap" id="features">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Đặc thù nghiệp vụ kho vật liệu xây dựng</h2>
                <p class="section-desc">Hệ thống được thiết kế bám sát quy trình vận hành kho bãi thực tế</p>
            </div>

            <div class="features-grid">
                <div class="feature-item">
                    <i class="ri-stack-line feature-icon"></i>
                    <h4 class="feature-title">Đa Dạng Đơn Vị Tính</h4>
