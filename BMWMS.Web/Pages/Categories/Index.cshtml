@section Scripts {
    <script>
        let currentGroupId = 0;
        let allSystemAttributes = [];

        function openEditGroupModal(id, code, name, desc, status) {
            document.getElementById('editGroupId').value = id;
            document.getElementById('editGroupCode').value = code;
            document.getElementById('editGroupName').value = name;
            document.getElementById('editGroupDescription').value = desc;
            document.getElementById('editGroupStatus').value = status;
            
            const form = document.getElementById('editGroupForm');
            form.action = `/Categories/Index?handler=UpdateGroup&id=${id}`;

            const modalEl = document.getElementById('editGroupModal');
            if (window.bootstrap && bootstrap.Modal) {
                bootstrap.Modal.getOrCreateInstance(modalEl).show();
            }
        }

        async function openAttributeModal(groupId, groupCode, groupName) {
            currentGroupId = groupId;
            document.getElementById('modalGroupSubtitle').innerText = `Nhóm: ${groupCode} - ${groupName}`;
            
            const modalEl = document.getElementById('groupAttributesModal');
            if (window.bootstrap && bootstrap.Modal) {
                bootstrap.Modal.getOrCreateInstance(modalEl).show();
            }

            document.getElementById('attrLoadingSpinner').classList.remove('d-none');
            document.getElementById('attrContent').classList.add('d-none');

            try {
                // 1. Fetch all system attributes if not already cached
                if (allSystemAttributes.length === 0) {
                    const allAttrsRes = await fetch('/Categories/Index?handler=AttributesAll');
                    if (allAttrsRes.ok) {
                        allSystemAttributes = await allAttrsRes.json();
                    }
                }

                // 2. Fetch assigned attributes for this group
                const groupAttrsRes = await fetch(`/Categories/Index?handler=GroupAttributes&id=${groupId}`);
                let assignedAttrs = [];
                if (groupAttrsRes.ok) {
                    assignedAttrs = await groupAttrsRes.json();
                }

                renderAttributeTable(assignedAttrs);
            } catch (err) {
                console.error("Lỗi tải thuộc tính:", err);
                alert("Không thể tải danh sách thuộc tính từ máy chủ.");
            } finally {
                document.getElementById('attrLoadingSpinner').classList.add('d-none');
                document.getElementById('attrContent').classList.remove('d-none');
            }
        }

        function renderAttributeTable(assignedAttrs) {
            const tbody = document.getElementById('groupAttrTableBody');
            tbody.innerHTML = '';

            const assignedMap = new Map();
            assignedAttrs.forEach(a => assignedMap.set(a.productAttributeId, a));

            // Merge all system attributes
            allSystemAttributes.forEach((attr, idx) => {
                const assigned = assignedMap.get(attr.productAttributeId);
                const isCapacityAttribute = attr.attributeCode === 'STORAGE_VOLUME_M3_PER_BASE_UOM'
                    || attr.attributeCode === 'STORAGE_WEIGHT_KG_PER_BASE_UOM';
                const isChecked = !!assigned;
                const isRequired = assigned ? assigned.isRequired : false;
                const displayOrder = assigned ? assigned.displayOrder : (idx + 1);
                const defaultValue = assigned ? (assigned.defaultValue || '') : '';

                let typeBadge = `<span class="badge bg-secondary" style="font-size: 11px;">${attr.dataType}</span>`;
                if (attr.dataType === 'NUMBER') typeBadge = `<span class="badge bg-info text-dark" style="font-size: 11px;">SỐ (${attr.unitLabel || 'ĐVT'})</span>`;
                if (attr.dataType === 'OPTION') typeBadge = `<span class="badge bg-primary" style="font-size: 11px;">LỰA CHỌN</span>`;
                if (attr.dataType === 'DATE') typeBadge = `<span class="badge bg-warning text-dark" style="font-size: 11px;">NGÀY</span>`;

                let optionsHint = '';
                if (attr.options && attr.options.length > 0) {
                    optionsHint = `<div class="text-muted small mt-1" style="font-size: 11px;">Lựa chọn: ${attr.options.map(o => o.optionValue).join(', ')}</div>`;
                }

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="text-center">
                        <input type="checkbox" class="form-check-input attr-enabled" data-id="${attr.productAttributeId}" data-code="${attr.attributeCode}" ${isChecked ? 'checked' : ''} onchange="toggleRowInputs(this)" />
                    </td>
                    <td>
                        <div class="fw-bold text-dark">${attr.attributeName}</div>
                        ${isCapacityAttribute ? '<div class="text-warning-emphasis small mt-1">Hồ sơ lưu kho tùy chọn theo nhóm</div>' : ''}
                        ${optionsHint}
                    </td>
                    <td>
                        <code class="text-primary small">${attr.attributeCode}</code>
                        <div class="mt-1">${typeBadge}</div>
                    </td>
                    <td class="text-center">
                        <input type="checkbox" class="form-check-input attr-required" data-id="${attr.productAttributeId}" ${isRequired ? 'checked' : ''} ${!isChecked ? 'disabled' : ''} />
                    </td>
                    <td>
                        <input type="number" class="form-control form-control-sm text-center attr-order" data-id="${attr.productAttributeId}" value="${displayOrder}" min="0" ${!isChecked ? 'disabled' : ''} style="font-size: 12px;" />
                    </td>
                    <td>
                        <input type="text" class="form-control form-control-sm attr-default" data-id="${attr.productAttributeId}" value="${defaultValue}" placeholder="Mặc định..." ${!isChecked ? 'disabled' : ''} style="font-size: 12px;" />
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function toggleRowInputs(checkbox) {
            const tr = checkbox.closest('tr');
            const required = tr.querySelector('.attr-required');
            const order = tr.querySelector('.attr-order');
            const defVal = tr.querySelector('.attr-default');

            if (checkbox.checked) {
                required.removeAttribute('disabled');
                order.removeAttribute('disabled');
                defVal.removeAttribute('disabled');
            } else {
                required.setAttribute('disabled', 'disabled');
                required.checked = false;
                order.setAttribute('disabled', 'disabled');
                defVal.setAttribute('disabled', 'disabled');
            }
        }

        async function saveGroupAttributes() {
            const btn = document.getElementById('btnSaveAttributes');
            const enabledCodes = new Set(Array.from(document.querySelectorAll('#groupAttrTableBody .attr-enabled:checked'))
                .map(input => input.getAttribute('data-code')));
            const usesPhysicalFactor = enabledCodes.has('STORAGE_VOLUME_M3_PER_BASE_UOM')
                || enabledCodes.has('STORAGE_WEIGHT_KG_PER_BASE_UOM');
            if (usesPhysicalFactor &&
                (!enabledCodes.has('STORAGE_FACTOR_BASIS') || !enabledCodes.has('STORAGE_FACTOR_REFERENCE'))) {
                alert('Khi bật hệ số kg/m³, cần bật cả Cơ sở xác định và Nguồn tham chiếu hệ số lưu kho.');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...';

            const payload = [];
            const rows = document.querySelectorAll('#groupAttrTableBody tr');

            rows.forEach(tr => {
                const enabled = tr.querySelector('.attr-enabled');
                if (enabled && enabled.checked) {
                    const attrId = parseInt(enabled.getAttribute('data-id'));
                    const required = tr.querySelector('.attr-required').checked;
                    const order = parseInt(tr.querySelector('.attr-order').value) || 0;
                    const defVal = tr.querySelector('.attr-default').value;

                    payload.push({
                        productAttributeId: attrId,
                        isRequired: required,
                        displayOrder: order,
                        defaultValue: defVal ? defVal.trim() : null
                    });
                }
            });

            try {
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const headers = {
                    'Content-Type': 'application/json'
                };
                if (tokenInput) {
                    headers['RequestVerificationToken'] = tokenInput.value;
                }

                const response = await fetch(`/Categories/Index?handler=SaveGroupAttributes&id=${currentGroupId}`, {
                    method: 'POST',
                    headers: headers,
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    alert('Lưu cấu hình thuộc tính cho nhóm thành công!');
                    location.reload();
                } else {
                    const err = await response.json();
                    alert('Lỗi: ' + (err.message || 'Không thể lưu cấu hình thuộc tính.'));
                }
            } catch (ex) {
                alert('Lỗi kết nối máy chủ: ' + ex.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="ri-save-line me-1"></i> Lưu Cấu Hình Thuộc Tính';
            }
        }

        function changeCatPageSize(size) {
            document.getElementById('catPageSizeInput').value = size;
            document.getElementById('categoryFilterForm').submit();
        }
    </script>
}
