                        <textarea name="Description" id="editGroupDescription" class="form-control" rows="3" style="font-size: 13px;"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium small text-dark">Trạng thái hoạt động</label>
                        <select name="Status" id="editGroupStatus" class="form-select" style="font-size: 13px;">
