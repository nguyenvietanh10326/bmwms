                            <thead class="table-light small">
                                <tr>
                                    <th style="width: 50px;" class="text-center">Bật</th>
                                    <th>Tên thuộc tính kỹ thuật</th>
                                    <th>Mã & Kiểu dữ liệu</th>
                                    <th style="width: 110px;" class="text-center">Bắt buộc</th>
                                    <th style="width: 90px;" class="text-center">Thứ tự</th>
                                    <th style="min-width: 150px;">Giá trị mặc định</th>
                                </tr>
                            </thead>
                            <tbody id="groupAttrTableBody">
                                <!-- Rendered dynamically by JavaScript -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid #e2e8f0; padding: 12px 20px;">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary btn-sm" id="btnSaveAttributes" onclick="saveGroupAttributes()">
                    <i class="ri-save-line me-1"></i> Lưu Cấu Hình Thuộc Tính
                </button>
            </div>
        </div>
    </div>
</div>

