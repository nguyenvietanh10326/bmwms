@page "/sales-orders/create"
@model BMWMS.Web.Pages.SalesOrders.CreateModel


@{
   Layout = "_AdminLayout";
    ViewData["Title"] = "T?o don bán hàng";
}

<!-- =========================================================
     HEADER
     ========================================================= -->
<div class="d-flex justify-content-between align-items-center mb-3">
  

    <div class="text-end">
        <span class="fw-bold d-block text-dark">
            Nguy?n Van An
        </span>

        <small class="text-muted">
            System Administrator
        </small>
    </div>
</div>


<!-- =========================================================
     MAIN FORM
     ========================================================= -->
<form method="post" id="createSoForm">

    <!-- =====================================================
         TITLE + ACTION
         ===================================================== -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">

        <div>
            <div class="d-flex align-items-center gap-2">

                <h2 class="fw-bold mb-0">
                    T?o don bán hàng
                </h2>

                <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 fs-6 rounded-pill">
                    Nháp
                </span>

            </div>

            <p class="text-muted mb-0 mt-1 small">
                SO ph?i ki?m tra và gi? t?n kho tru?c khi kh?i t?o Outbound Order.
            </p>
        </div>


        <div class="d-flex gap-2">

            <a href="/sales-orders"
               class="btn btn-outline-secondary px-3">

                <i class="bi bi-x-circle me-1"></i>
                H?y

            </a>


            <button type="submit"
                    name="action"
                    value="draft"
                    class="btn btn-light border px-3">

                <i class="bi bi-save me-1"></i>
                Luu nháp

            </button>


            <button type="submit"
                    name="action"
                    value="create"
                    class="btn btn-primary px-4 fw-semibold shadow-sm">

                <i class="bi bi-check2-circle me-1"></i>
                T?o don bán hàng

            </button>

        </div>
    </div>


    <!-- =====================================================
         ERROR
         ===================================================== -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @Model.ErrorMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }


    <!-- =====================================================
         DOCUMENT INFORMATION
         ===================================================== -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-3 text-primary">
                <i class="bi bi-file-earmark-text me-2"></i>
                Thông tin ch?ng t?
            </h5>


            <div class="row g-3 mb-3">

                <!-- Customer -->
                <div class="col-md-3">

                    <label class="form-label fw-semibold">
                        Khách hàng
                        <span class="text-danger">*</span>
                    </label>

                    <select asp-for="SalesOrder.CustomerId"
                            asp-items="Model.CustomerOptions"
                            class="form-select shadow-none">
                    </select>

                </div>


                <!-- Order date -->
                <div class="col-md-3">

                    <label class="form-label fw-semibold">
                        Ngày d?t hàng
                        <span class="text-danger">*</span>
                    </label>

                    <input type="date"
                           asp-for="SalesOrder.OrderDate"
                           class="form-control shadow-none" />

                </div>


                <!-- Expected issue date -->
                <div class="col-md-3">

                    <label class="form-label fw-semibold">
                        Ngày xu?t d? ki?n
                    </label>

                    <input type="date"
                           asp-for="SalesOrder.ExpectedIssueDate"
                           class="form-control shadow-none" />

                </div>


                <!-- Warehouse -->
                <div class="col-md-3">

                    <label class="form-label fw-semibold">
                        Kho xu?t d? ki?n
                    </label>

                    <select class="form-select shadow-none"
                            asp-items="Model.WarehouseOptions">
                    </select>

                </div>

            </div>


            <div class="row g-3">

                <!-- Delivery terms -->
                <div class="col-md-3">

                    <label class="form-label text-muted small">
                        Ði?u kho?n giao hàng
                    </label>

                    <input type="text"
                           class="form-control shadow-none"
                           value="Giao t?i kho"
                           placeholder="Nh?p di?u kho?n..." />

                </div>


                <!-- Responsible -->
                <div class="col-md-3">

                    <label class="form-label text-muted small">
                        Ngu?i ph? trách
                    </label>

                    <select class="form-select shadow-none">
                        <option>Warehouse Staff</option>
                    </select>

                </div>


                <!-- Priority -->
                <div class="col-md-3">

                    <label class="form-label text-muted small">
                        M?c uu tiên
                    </label>

                    <select class="form-select shadow-none">

                        <option value="normal">
                            Bình thu?ng
                        </option>

                        <option value="high">
                            Cao
                        </option>

                        <option value="urgent">
                            G?p
                        </option>

                    </select>

                </div>


                <!-- Reference -->
                <div class="col-md-3">

                    <label class="form-label text-muted small">
                        Mã tham chi?u
                    </label>

                    <input type="text"
                           class="form-control bg-light shadow-none"
                           value="T? d?ng sinh khi luu"
                           readonly />

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         PRODUCT CARD
         ===================================================== -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">

        <div class="card-body p-4">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="fw-bold mb-0 text-primary">

                    <i class="bi bi-box-seam me-2"></i>
                    Danh sách s?n ph?m

                </h5>


                <button type="button"
                        id="btnOpenProductModal"
                        class="btn btn-outline-primary shadow-sm btn-sm px-3"
                        data-bs-toggle="modal"
                        data-bs-target="#productModal">

                    <i class="bi bi-plus-lg me-1"></i>
                    Thêm s?n ph?m

                </button>

            </div>


            <!-- =================================================
                 PRODUCT TABLE
                 ================================================= -->
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="productTable">

                    <thead class="table-light text-muted small text-uppercase">

                        <tr>

                            <th>
                                S?n ph?m
                            </th>

                            <th style="width:130px;"
                                class="text-center">
                                SL d?t
                            </th>

                            <th style="width:120px;"
                                class="text-center">
                                Kh? d?ng
                            </th>

                            <th style="width:90px;">
                                ÐVT
                            </th>

                            <th style="width:160px;"
                                class="text-end">
                                Ðon giá (VNÐ)
                            </th>

                            <th style="width:170px;"
                                class="text-end">
                                Thành ti?n
                            </th>

                            <th style="width:50px;">
                            </th>

                        </tr>

                    </thead>


                    <tbody id="productTableBody">

                        @if (Model.SalesOrder?.Items != null &&
                                                Model.SalesOrder.Items.Any())
                        {
                            @for (int i = 0;
                                                    i < Model.SalesOrder.Items.Count;
                                                    i++)
                            {
                                var item = Model.SalesOrder.Items[i];

                                var product =
                                Model.ProductList?
                                .FirstOrDefault(x =>
                                x.ProductId == item.ProductId);

                                <tr data-index="@i">

                                    <td>

                                        <input type="hidden"
                                               class="product-id"
                                               name="SalesOrder.Items[@i].ProductId"
                                               value="@item.ProductId" />


                                        @if (product != null)
                                        {
                                            <span class="fw-bold text-primary">
                                                @product.ProductCode
                                            </span>

                                            <span class="text-dark">
                                                — @product.ProductName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Mã SP: #@item.ProductId
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <input type="number"
                                               name="SalesOrder.Items[@i].OrderedQuantity"
                                               class="form-control text-center input-qty shadow-none"
                                               value="@item.OrderedQuantity"
                                               min="1"
                                               step="any" />

                                    </td>


                                    <td class="text-muted text-center align-middle">

                                        @(product?.AvailableQuantity.ToString("N0") ?? "0")

                                    </td>


                                    <td class="text-muted align-middle">

                                        @(product?.UnitName ?? "-")

                                    </td>


                                    <td>

                                        <input type="number"
                                               asp-for="SalesOrder.Items[i].UnitPrice"
                                               class="form-control text-end input-price shadow-none"
                                               min="0"
                                               step="any" />


                                    </td>


                                    <td class="fw-bold text-end align-middle col-amount">
                                        0
                                    </td>


                                    <td class="text-center align-middle">

                                        <button type="button"
                                                class="btn btn-link text-danger p-0 btn-remove">

                                            <i class="bi bi-trash fs-5"></i>

                                        </button>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>


            <!-- =================================================
                 EMPTY STATE
                 ================================================= -->
            <div id="emptyProductMessage"
                 class="text-center text-muted py-5 border rounded-3 bg-light-subtle my-2 @(Model.SalesOrder?.Items?.Any() == true ? "d-none" : "")">

                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>

                <p class="mb-1">
                    Chua có s?n ph?m nào trong don hàng này.
                </p>

                <small>
                    Nh?n nút
                    <strong>"Thêm s?n ph?m"</strong>
                    phía trên d? ch?n m?t hàng.
                </small>

            </div>


            <!-- =================================================
                 TOTAL
                 ================================================= -->
            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">

                <div class="text-muted small">

                    <i class="bi bi-info-circle me-1"></i>

                    T?n kho ch? du?c gi? sau khi
                    <strong>T?o don hàng</strong>
                    thành công.

                </div>


                <div class="d-flex align-items-baseline gap-2">

                    <span class="fs-6 text-muted">
                        T?ng c?ng:
                    </span>

                    <span id="lblGrandTotal"
                          class="fs-3 fw-bold text-danger">
                        0 d
                    </span>

                </div>

            </div>

        </div>

    </div>

</form>


<!-- =========================================================
     PRODUCT MODAL
     ========================================================= -->
<div class="modal fade"
     id="productModal"
     tabindex="-1"
     aria-labelledby="productModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-scrollable">

        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header border-bottom-0 pb-0">

                <div>

                    <h5 class="modal-title fw-bold"
                        id="productModalLabel">

                        Ch?n s?n ph?m bán

                    </h5>

                    <p class="text-muted small mb-0">

                        Ch?n t? danh sách s?n ph?m kh? d?ng trong kho

                    </p>

                </div>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- Body -->
            <div class="modal-body pt-3">

                <!-- Search -->
                <div class="input-group mb-3">

                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>

                    <input type="text"
                           id="modalSearchInput"
                           class="form-control border-start-0 shadow-none"
                           placeholder="Tìm theo mã ho?c tên s?n ph?m..." />

                </div>


                <!-- Product list -->
                @if (Model.ProductList != null &&
                                Model.ProductList.Any())
                {
                    <div class="list-group list-group-flush"
                         id="modalProductList">

                        @foreach (var product in Model.ProductList)
                        {
                            var available =
                            product.AvailableQuantity
                            .ToString(System.Globalization.CultureInfo.InvariantCulture);

                            var price =
                            product.UnitPrice
                            .ToString(System.Globalization.CultureInfo.InvariantCulture);

                            <button type="button"
                                    class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 btn-select-prod border rounded-2 mb-2"
                                    data-product-id="@product.ProductId"
                                    data-product-code="@product.ProductCode"
                                    data-product-name="@product.ProductName"
                                    data-product-unit="@product.UnitName"
                                    data-product-available="@available"
                                    data-product-price="@price">

                                <div>

                                    <div class="fw-bold text-dark mb-1">

                                        <span class="badge bg-primary-subtle text-primary me-1">
                                            @product.ProductCode
                                        </span>

                                        @product.ProductName

                                    </div>


                                    <small class="text-muted">

                                        T?n kh? d?ng:

                                        <strong class="text-dark">
                                            @product.AvailableQuantity.ToString("N0")
                                        </strong>

                                        @product.UnitName

                                    </small>

                                </div>


                                <div class="text-end">

                                    <span class="fw-bold fs-6 text-primary d-block">

                                        @product.UnitPrice.ToString("N0") d

                                    </span>


                                    <span class="btn btn-sm btn-light border mt-1">

                                        Ch?n
                                        <i class="bi bi-chevron-right"></i>

                                    </span>

                                </div>

                            </button>
                        }

                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">

                        Không có s?n ph?m kh? d?ng trong h? th?ng.

                    </div>
                }

            </div>

        </div>

    </div>

</div>
@section Scripts {
    <script>
        $(function () {
            // 1. Tìm ki?m trong Modal
            $('#modalSearchInput').on('input', function () {
                const keyword = ($(this).val() || '').toString().trim().toLowerCase();
                $('#modalProductList .btn-select-prod').each(function () {
                    const text = $(this).text().toLowerCase();
                    $(this).toggle(text.indexOf(keyword) !== -1);
                });
            });

            // 2. Thay d?i s? lu?ng / don giá
            $(document).on('input', '.input-qty, .input-price', function () {
                const row = $(this).closest('tr');
                calculateRowAmount(row);
                calculateTotal();
            });

            // 3. Xóa s?n ph?m
            $(document).on('click', '.btn-remove', function (e) {
                e.preventDefault();
                $(this).closest('tr').remove();
                reIndexRows();
                calculateAll();
            });

            // 4. Ch?n s?n ph?m t? Modal (ÐÃ FIX TRI?T Ð? L?I KHÔNG LOAD)
            $(document).on('click', '.btn-select-prod', function (e) {
                e.preventDefault();

                // L?y dúng th? button g?c b?t k? b?m trúng th? con nào (span, div, icon...)
                const button = $(e.target).closest('.btn-select-prod');

                // L?y d? li?u b?ng vanilla JS dataset d? tránh l?i jQuery cache/attr
                const btnEl = button[0];
                if (!btnEl) return;

                const product = {
                    id: btnEl.getAttribute('data-product-id'),
                    code: btnEl.getAttribute('data-product-code') || '',
                    name: btnEl.getAttribute('data-product-name') || '',
                    unit: btnEl.getAttribute('data-product-unit') || '-',
                    available: parseFloat(btnEl.getAttribute('data-product-available')) || 0,
                    price: parseFloat(btnEl.getAttribute('data-product-price')) || 0
                };

                console.log("D? li?u s?n ph?m ch?n du?c:", product); // Ki?m tra qua Console F12

                if (!product.id) {
                    alert('L?i: S?n ph?m không có ID!');
                    return;
                }

                if (addProductRow(product)) {
                    // Ðóng Modal an toàn
                    const modalEl = document.getElementById('productModal');
                    if (window.bootstrap && bootstrap.Modal) {
                        const modalObj = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                        modalObj.hide();
                    } else {
                        $('#productModal').modal('hide');
                    }
                }
            });

            calculateAll();
        });

        function addProductRow(product) {
            let exists = false;

            // Ki?m tra trùng s?n ph?m
            $('#productTableBody input.product-id').each(function () {
                if (String($(this).val()) === String(product.id)) {
                    exists = true;
                    return false;
                }
            });

            if (exists) {
                alert('S?n ph?m này dã du?c thêm vào danh sách!');
                return false;
            }

            const index = $('#productTableBody tr').length;
            const rowHtml = `
                <tr data-index="${index}">
                    <td>
                        <input type="hidden" class="product-id" name="SalesOrder.Items[${index}].ProductId" value="${product.id}" />
                        <span class="fw-bold text-primary">${product.code}</span> — ${product.name}
                    </td>
                    <td>
                        <input type="number" name="SalesOrder.Items[${index}].OrderedQuantity" class="form-control text-center input-qty shadow-none" value="1" min="1" step="any" />
                    </td>
                    <td class="text-center align-middle text-muted">
                        ${new Intl.NumberFormat('vi-VN').format(product.available)}
                    </td>
                    <td class="align-middle text-muted">
                        ${product.unit}
                    </td>
                    <td>
                        <input type="number" name="SalesOrder.Items[${index}].UnitPrice" class="form-control text-end input-price shadow-none" value="${product.price}" min="0" step="any" />
                    </td>
                    <td class="fw-bold text-end align-middle col-amount">0</td>
                    <td class="text-center align-middle">
                        <button type="button" class="btn btn-link text-danger p-0 btn-remove">
                            <i class="bi bi-trash fs-5"></i>
                        </button>
                    </td>
                </tr>`;

            // Thêm dòng m?i vào tbody
            $('#productTableBody').append(rowHtml);

            // Tính l?i ti?n dòng m?i và t?ng don hàng
            const $newRow = $('#productTableBody tr').last();
            calculateRowAmount($newRow);
            calculateTotal();

            // ?n thông báo "Chua có s?n ph?m"
            $('#emptyProductMessage').addClass('d-none');
            return true;
        }

        function calculateRowAmount(row) {
            const qty = parseFloat(row.find('.input-qty').val()) || 0;
            const price = parseFloat(row.find('.input-price').val()) || 0;
            row.find('.col-amount').text(new Intl.NumberFormat('vi-VN').format(qty * price));
        }

        function calculateTotal() {
            let total = 0;
            $('#productTableBody tr').each(function () {
                const qty = parseFloat($(this).find('.input-qty').val()) || 0;
                const price = parseFloat($(this).find('.input-price').val()) || 0;
                total += (qty * price);
            });
            $('#lblGrandTotal').text(new Intl.NumberFormat('vi-VN').format(total) + ' d');
        }

        function calculateAll() {
            $('#productTableBody tr').each(function () { calculateRowAmount($(this)); });
            calculateTotal();
        }

        function reIndexRows() {
            const rows = $('#productTableBody tr');
            if (rows.length === 0) {
                $('#emptyProductMessage').removeClass('d-none');
            }
            rows.each(function (i) {
                $(this).attr('data-index', i);
                $(this).find('input.product-id').attr('name', `SalesOrder.Items[${i}].ProductId`);
                $(this).find('.input-qty').attr('name', `SalesOrder.Items[${i}].OrderedQuantity`);
                $(this).find('.input-price').attr('name', `SalesOrder.Items[${i}].UnitPrice`);
            });
        }
    </script>
}
