@page "/sales-orders/create"
@model BMWMS.Web.Pages.SalesOrders.CreateModel


@{
   // Layout = "/Pages/Shared/Inventory/_Layout.cshtml";
    ViewData["Title"] = "Tạo đơn bán hàng";
}

<!-- =========================================================
     HEADER
     ========================================================= -->
<div class="d-flex justify-content-between align-items-center mb-3">
  

    <div class="text-end">
        <span class="fw-bold d-block text-dark">
            Nguyễn Văn An
        </span>

        <small class="text-muted">
            System Administrator
        </small>
    </div>
</div>


<!-- =========================================================
     MAIN FORM
     ========================================================= -->
<form method="post" id="createSoForm">

    <!-- =====================================================
         TITLE + ACTION
         ===================================================== -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">

        <div>
            <div class="d-flex align-items-center gap-2">

                <h2 class="fw-bold mb-0">
                    Tạo đơn bán hàng
                </h2>

                <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 fs-6 rounded-pill">
                    Nháp
                </span>

            </div>

            <p class="text-muted mb-0 mt-1 small">
                SO phải kiểm tra và giữ tồn kho trước khi khởi tạo Outbound Order.
            </p>
        </div>


        <div class="d-flex gap-2">

            <a href="/sales-orders"
               class="btn btn-outline-secondary px-3">

                <i class="bi bi-x-circle me-1"></i>
                Hủy

            </a>


            <button type="submit"
                    name="action"
                    value="draft"
                    class="btn btn-light border px-3">

                <i class="bi bi-save me-1"></i>
                Lưu nháp

            </button>


            <button type="submit"
                    name="action"
                    value="create"
                    class="btn btn-primary px-4 fw-semibold shadow-sm">

                <i class="bi bi-check2-circle me-1"></i>
                Tạo đơn bán hàng

            </button>

        </div>
    </div>


    <!-- =====================================================
         ERROR
         ===================================================== -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @Model.ErrorMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }


    <!-- =====================================================
         DOCUMENT INFORMATION
         ===================================================== -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-3 text-primary">
                <i class="bi bi-file-earmark-text me-2"></i>
                Thông tin chứng từ
            </h5>


            <div class="row g-3 mb-3">

                <!-- Customer -->
                <div class="col-md-3">

                    <label class="form-label fw-semibold">
                        Khách hàng
                        <span class="text-danger">*</span>
                    </label>

                    <select asp-for="SalesOrder.CustomerId"
                            asp-items="Model.CustomerOptions"
                            class="form-select shadow-none">
                    </select>

                </div>


                <!-- Order date -->
                <div class="col-md-3">

                    <label class="form-label fw-semibold">
                        Ngày đặt hàng
                        <span class="text-danger">*</span>
                    </label>

                    <input type="date"
                           asp-for="SalesOrder.OrderDate"
                           class="form-control shadow-none" />

                </div>


                <!-- Expected issue date -->
                <div class="col-md-3">

                    <label class="form-label fw-semibold">
                        Ngày xuất dự kiến
                    </label>

                    <input type="date"
                           asp-for="SalesOrder.ExpectedIssueDate"
                           class="form-control shadow-none" />

                </div>


                <!-- Warehouse -->
                <div class="col-md-3">

                    <label class="form-label fw-semibold">
                        Kho xuất dự kiến
                    </label>

                    <select class="form-select shadow-none"
                            asp-items="Model.WarehouseOptions">
                    </select>

                </div>

            </div>


            <div class="row g-3">

                <!-- Delivery terms -->
                <div class="col-md-3">

                    <label class="form-label text-muted small">
                        Điều khoản giao hàng
                    </label>

                    <input type="text"
                           class="form-control shadow-none"
                           value="Giao tại kho"
                           placeholder="Nhập điều khoản..." />

                </div>


                <!-- Responsible -->
                <div class="col-md-3">

                    <label class="form-label text-muted small">
                        Người phụ trách
                    </label>

                    <select class="form-select shadow-none">
                        <option>Warehouse Staff</option>
                    </select>

                </div>


                <!-- Priority -->
                <div class="col-md-3">

                    <label class="form-label text-muted small">
                        Mức ưu tiên
                    </label>

                    <select class="form-select shadow-none">

                        <option value="normal">
                            Bình thường
                        </option>

                        <option value="high">
                            Cao
                        </option>

                        <option value="urgent">
                            Gấp
                        </option>

                    </select>

                </div>


                <!-- Reference -->
                <div class="col-md-3">

                    <label class="form-label text-muted small">
                        Mã tham chiếu
                    </label>

                    <input type="text"
                           class="form-control bg-light shadow-none"
                           value="Tự động sinh khi lưu"
                           readonly />

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         PRODUCT CARD
         ===================================================== -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">

        <div class="card-body p-4">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="fw-bold mb-0 text-primary">

                    <i class="bi bi-box-seam me-2"></i>
                    Danh sách sản phẩm

                </h5>


                <button type="button"
                        id="btnOpenProductModal"
                        class="btn btn-outline-primary shadow-sm btn-sm px-3"
                        data-bs-toggle="modal"
                        data-bs-target="#productModal">

                    <i class="bi bi-plus-lg me-1"></i>
                    Thêm sản phẩm

                </button>

            </div>


            <!-- =================================================
                 PRODUCT TABLE
                 ================================================= -->
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="productTable">

                    <thead class="table-light text-muted small text-uppercase">

                        <tr>

                            <th>
                                Sản phẩm
                            </th>

                            <th style="width:130px;"
                                class="text-center">
                                SL đặt
                            </th>

                            <th style="width:120px;"
                                class="text-center">
                                Khả dụng
                            </th>

                            <th style="width:90px;">
                                ĐVT
                            </th>

                            <th style="width:160px;"
                                class="text-end">
                                Đơn giá (VNĐ)
                            </th>

                            <th style="width:170px;"
                                class="text-end">
                                Thành tiền
                            </th>

                            <th style="width:50px;">
                            </th>

                        </tr>

                    </thead>


                    <tbody id="productTableBody">

                        @if (Model.SalesOrder?.Items != null &&
                                                Model.SalesOrder.Items.Any())
                        {
                            @for (int i = 0;
                                                    i < Model.SalesOrder.Items.Count;
                                                    i++)
                            {
                                var item = Model.SalesOrder.Items[i];

                                var product =
                                Model.ProductList?
                                .FirstOrDefault(x =>
                                x.ProductId == item.ProductId);

                                <tr data-index="@i">

                                    <td>

                                        <input type="hidden"
                                               class="product-id"
                                               name="SalesOrder.Items[@i].ProductId"
                                               value="@item.ProductId" />


                                        @if (product != null)
                                        {
                                            <span class="fw-bold text-primary">
                                                @product.ProductCode
                                            </span>

                                            <span class="text-dark">
                                                — @product.ProductName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Mã SP: #@item.ProductId
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <input type="number"
                                               name="SalesOrder.Items[@i].OrderedQuantity"
                                               class="form-control text-center input-qty shadow-none"
                                               value="@item.OrderedQuantity"
                                               min="1"
                                               step="any" />

                                    </td>


                                    <td class="text-muted text-center align-middle">

                                        @(product?.AvailableQuantity.ToString("N0") ?? "0")

                                    </td>


                                    <td class="text-muted align-middle">

                                        @(product?.UnitName ?? "-")

                                    </td>


                                    <td>

                                        <input type="number"
                                               asp-for="SalesOrder.Items[i].UnitPrice"
                                               class="form-control text-end input-price shadow-none"
                                               min="0"
                                               step="any" />


                                    </td>


                                    <td class="fw-bold text-end align-middle col-amount">
                                        0
                                    </td>


                                    <td class="text-center align-middle">

                                        <button type="button"
                                                class="btn btn-link text-danger p-0 btn-remove">

                                            <i class="bi bi-trash fs-5"></i>

                                        </button>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>


            <!-- =================================================
                 EMPTY STATE
                 ================================================= -->
            <div id="emptyProductMessage"
                 class="text-center text-muted py-5 border rounded-3 bg-light-subtle my-2 @(Model.SalesOrder?.Items?.Any() == true ? "d-none" : "")">

                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>

                <p class="mb-1">
                    Chưa có sản phẩm nào trong đơn hàng này.
                </p>

                <small>
                    Nhấn nút
                    <strong>"Thêm sản phẩm"</strong>
                    phía trên để chọn mặt hàng.
                </small>

            </div>


            <!-- =================================================
                 TOTAL
                 ================================================= -->
            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">

                <div class="text-muted small">

                    <i class="bi bi-info-circle me-1"></i>

                    Tồn kho chỉ được giữ sau khi
                    <strong>Tạo đơn hàng</strong>
                    thành công.

                </div>


                <div class="d-flex align-items-baseline gap-2">

                    <span class="fs-6 text-muted">
                        Tổng cộng:
                    </span>

                    <span id="lblGrandTotal"
                          class="fs-3 fw-bold text-danger">
                        0 đ
                    </span>

                </div>

            </div>

        </div>

    </div>

</form>


<!-- =========================================================
     PRODUCT MODAL
     ========================================================= -->
<div class="modal fade"
     id="productModal"
     tabindex="-1"
     aria-labelledby="productModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-scrollable">

        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header border-bottom-0 pb-0">

                <div>

                    <h5 class="modal-title fw-bold"
                        id="productModalLabel">

                        Chọn sản phẩm bán

                    </h5>

                    <p class="text-muted small mb-0">

                        Chọn từ danh sách sản phẩm khả dụng trong kho

                    </p>

                </div>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- Body -->
            <div class="modal-body pt-3">

                <!-- Search -->
                <div class="input-group mb-3">

                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>

                    <input type="text"
                           id="modalSearchInput"
                           class="form-control border-start-0 shadow-none"
                           placeholder="Tìm theo mã hoặc tên sản phẩm..." />

                </div>


                <!-- Product list -->
                @if (Model.ProductList != null &&
                                Model.ProductList.Any())
                {
                    <div class="list-group list-group-flush"
                         id="modalProductList">

                        @foreach (var product in Model.ProductList)
                        {
                            var available =
                            product.AvailableQuantity
                            .ToString(System.Globalization.CultureInfo.InvariantCulture);

                            var price =
                            product.UnitPrice
                            .ToString(System.Globalization.CultureInfo.InvariantCulture);

                            <button type="button"
                                    class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 btn-select-prod border rounded-2 mb-2"
                                    data-product-id="@product.ProductId"
                                    data-product-code="@product.ProductCode"
                                    data-product-name="@product.ProductName"
                                    data-product-unit="@product.UnitName"
                                    data-product-available="@available"
                                    data-product-price="@price">

                                <div>

                                    <div class="fw-bold text-dark mb-1">

                                        <span class="badge bg-primary-subtle text-primary me-1">
                                            @product.ProductCode
                                        </span>

                                        @product.ProductName

                                    </div>


                                    <small class="text-muted">

                                        Tồn khả dụng:

                                        <strong class="text-dark">
                                            @product.AvailableQuantity.ToString("N0")
                                        </strong>

                                        @product.UnitName

                                    </small>

                                </div>


                                <div class="text-end">

                                    <span class="fw-bold fs-6 text-primary d-block">

                                        @product.UnitPrice.ToString("N0") đ

                                    </span>


                                    <span class="btn btn-sm btn-light border mt-1">

                                        Chọn
                                        <i class="bi bi-chevron-right"></i>

                                    </span>

                                </div>

                            </button>
                        }

                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">

                        Không có sản phẩm khả dụng trong hệ thống.

                    </div>
                }

            </div>

        </div>

    </div>

</div>
@section Scripts {
    <script>
        $(function () {
            // 1. Tìm kiếm trong Modal
            $('#modalSearchInput').on('input', function () {
                const keyword = ($(this).val() || '').toString().trim().toLowerCase();
                $('#modalProductList .btn-select-prod').each(function () {
                    const text = $(this).text().toLowerCase();
                    $(this).toggle(text.indexOf(keyword) !== -1);
                });
            });

            // 2. Thay đổi số lượng / đơn giá
            $(document).on('input', '.input-qty, .input-price', function () {
                const row = $(this).closest('tr');
                calculateRowAmount(row);
                calculateTotal();
            });

            // 3. Xóa sản phẩm
            $(document).on('click', '.btn-remove', function (e) {
                e.preventDefault();
                $(this).closest('tr').remove();
                reIndexRows();
                calculateAll();
            });

            // 4. Chọn sản phẩm từ Modal (ĐÃ FIX TRIỆT ĐỂ LỖI KHÔNG LOAD)
            $(document).on('click', '.btn-select-prod', function (e) {
                e.preventDefault();

                // Lấy đúng thẻ button gốc bất kể bấm trúng thẻ con nào (span, div, icon...)
                const button = $(e.target).closest('.btn-select-prod');

                // Lấy dữ liệu bằng vanilla JS dataset để tránh lỗi jQuery cache/attr
                const btnEl = button[0];
                if (!btnEl) return;

                const product = {
                    id: btnEl.getAttribute('data-product-id'),
                    code: btnEl.getAttribute('data-product-code') || '',
                    name: btnEl.getAttribute('data-product-name') || '',
                    unit: btnEl.getAttribute('data-product-unit') || '-',
                    available: parseFloat(btnEl.getAttribute('data-product-available')) || 0,
                    price: parseFloat(btnEl.getAttribute('data-product-price')) || 0
                };

                console.log("Dữ liệu sản phẩm chọn được:", product); // Kiểm tra qua Console F12

                if (!product.id) {
                    alert('Lỗi: Sản phẩm không có ID!');
                    return;
                }

                if (addProductRow(product)) {
                    // Đóng Modal an toàn
                    const modalEl = document.getElementById('productModal');
                    if (window.bootstrap && bootstrap.Modal) {
                        const modalObj = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                        modalObj.hide();
                    } else {
                        $('#productModal').modal('hide');
                    }
                }
            });

            calculateAll();
        });

        function addProductRow(product) {
            let exists = false;

            // Kiểm tra trùng sản phẩm
            $('#productTableBody input.product-id').each(function () {
                if (String($(this).val()) === String(product.id)) {
                    exists = true;
                    return false;
                }
            });

            if (exists) {
                alert('Sản phẩm này đã được thêm vào danh sách!');
                return false;
            }

            const index = $('#productTableBody tr').length;
            const rowHtml = `
                <tr data-index="${index}">
                    <td>
                        <input type="hidden" class="product-id" name="SalesOrder.Items[${index}].ProductId" value="${product.id}" />
                        <span class="fw-bold text-primary">${product.code}</span> — ${product.name}
                    </td>
                    <td>
                        <input type="number" name="SalesOrder.Items[${index}].OrderedQuantity" class="form-control text-center input-qty shadow-none" value="1" min="1" step="any" />
                    </td>
                    <td class="text-center align-middle text-muted">
                        ${new Intl.NumberFormat('vi-VN').format(product.available)}
                    </td>
                    <td class="align-middle text-muted">
                        ${product.unit}
                    </td>
                    <td>
                        <input type="number" name="SalesOrder.Items[${index}].UnitPrice" class="form-control text-end input-price shadow-none" value="${product.price}" min="0" step="any" />
                    </td>
                    <td class="fw-bold text-end align-middle col-amount">0</td>
                    <td class="text-center align-middle">
                        <button type="button" class="btn btn-link text-danger p-0 btn-remove">
                            <i class="bi bi-trash fs-5"></i>
                        </button>
                    </td>
                </tr>`;

            // Thêm dòng mới vào tbody
            $('#productTableBody').append(rowHtml);

            // Tính lại tiền dòng mới và tổng đơn hàng
            const $newRow = $('#productTableBody tr').last();
            calculateRowAmount($newRow);
            calculateTotal();

            // Ẩn thông báo "Chưa có sản phẩm"
            $('#emptyProductMessage').addClass('d-none');
            return true;
        }

        function calculateRowAmount(row) {
            const qty = parseFloat(row.find('.input-qty').val()) || 0;
            const price = parseFloat(row.find('.input-price').val()) || 0;
            row.find('.col-amount').text(new Intl.NumberFormat('vi-VN').format(qty * price));
        }

        function calculateTotal() {
            let total = 0;
            $('#productTableBody tr').each(function () {
                const qty = parseFloat($(this).find('.input-qty').val()) || 0;
                const price = parseFloat($(this).find('.input-price').val()) || 0;
                total += (qty * price);
            });
            $('#lblGrandTotal').text(new Intl.NumberFormat('vi-VN').format(total) + ' đ');
        }

        function calculateAll() {
            $('#productTableBody tr').each(function () { calculateRowAmount($(this)); });
            calculateTotal();
        }

        function reIndexRows() {
            const rows = $('#productTableBody tr');
            if (rows.length === 0) {
                $('#emptyProductMessage').removeClass('d-none');
            }
            rows.each(function (i) {
                $(this).attr('data-index', i);
                $(this).find('input.product-id').attr('name', `SalesOrder.Items[${i}].ProductId`);
                $(this).find('.input-qty').attr('name', `SalesOrder.Items[${i}].OrderedQuantity`);
                $(this).find('.input-price').attr('name', `SalesOrder.Items[${i}].UnitPrice`);
            });
        }
    </script>
}