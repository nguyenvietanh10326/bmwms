@page "/sales-orders/details/{id:int}"
@model BMWMS.Web.Pages.SaleOrder.DetailsModel
@using BMWMS.Web.Helpers
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Chi tiết đơn bán hàng - {Model.SalesOrder?.SalesOrderNumber}";
    var order = Model.SalesOrder;
    var itemCount = order?.Items.Count ?? 0;
    var fullyReservedCount = order?.Items.Count(x => x.ReservedQuantity >= x.OrderedQuantity) ?? 0;
    var fullyIssuedCount = order?.Items.Count(x => x.FulfilledQuantity >= x.OrderedQuantity) ?? 0;
    var pendingBatches = order?.OutboundBatches.Where(o => o.Status == "PENDING_APPROVAL").ToList() ?? new();
    var canReview = User.IsInRole("WAREHOUSE_MANAGER") || User.IsInRole("SYSTEM_ADMIN");
    var hasRemainder = order?.Items.Any(x => x.FulfilledQuantity < x.OrderedQuantity) == true;
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <div class="text-muted small mb-1"><a href="/sales-orders" class="text-decoration-none">Đơn bán hàng</a> / Chi tiết</div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="mb-0">@order?.SalesOrderNumber</h2>
            <span class="badge @StatusClass(order?.Status)">@StatusLabel(order?.Status)</span>
            @if (pendingBatches.Any()) { <span class="badge bg-primary">Chờ duyệt đợt xuất</span> }
        </div>
        <div class="text-muted mt-1">Theo dõi giữ tồn và lượng hàng đã xuất; không bao gồm giá bán hoặc hóa đơn.</div>
    </div>
      <div class="d-flex gap-2 no-print">
          <a href="/sales-orders" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
          @if (order?.Status == "DRAFT" && (User.IsInRole("SALES_STAFF") || User.IsInRole("SYSTEM_ADMIN")))
          {
              <a href="/sales-orders/create?id=@order.SalesOrderId" class="btn btn-outline-warning"><i class="bi bi-pencil me-1"></i>Chỉnh sửa</a>
              <form method="post" asp-page-handler="Cancel" asp-route-id="@order.SalesOrderId" onsubmit="return confirm('Hủy SO nháp và giải phóng giữ tồn?');">
                  <input name="reason" class="form-control" placeholder="Lý do hủy" minlength="10" maxlength="500" required />
                  <button class="btn btn-outline-danger">Hủy SO nháp</button>
              </form>
          }
          @if (order?.Status == "DRAFT" && (User.IsInRole("WAREHOUSE_MANAGER") || User.IsInRole("SYSTEM_ADMIN")))
          {
              <form method="post" asp-page-handler="Confirm" asp-route-id="@order.SalesOrderId" onsubmit="return confirm('Bạn có chắc chắn muốn xác nhận đơn hàng này? Hệ thống sẽ giữ tồn kho cho các sản phẩm.');">
                  <button type="submit" class="btn btn-success"><i class="bi bi-check-circle me-1"></i>Duyệt SO &amp; giữ tồn</button>
              </form>
              <form method="post" asp-page-handler="Reject" asp-route-id="@order.SalesOrderId" onsubmit="return confirm('Từ chối SO và giải phóng giữ tồn?');">
                  <input name="reason" class="form-control" placeholder="Lý do từ chối" minlength="10" maxlength="500" required />
                  <button class="btn btn-outline-danger">Từ chối SO</button>
              </form>
          }
          <button type="button" class="btn btn-outline-primary" onclick="window.print()"><i class="bi bi-printer me-1"></i>In phiếu</button>
      </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4"><div class="text-muted small">Khách hàng</div><strong>[@order?.CustomerCode] @order?.CustomerName</strong></div>
            <div class="col-md-2"><div class="text-muted small">Ngày đặt hàng</div><span>@order?.OrderDate.ToString("dd/MM/yyyy")</span></div>
            <div class="col-md-2"><div class="text-muted small">Ngày xuất dự kiến</div><span>@(order?.ExpectedIssueDate?.ToString("dd/MM/yyyy") ?? "Chưa xác định")</span></div>
            <div class="col-md-2"><div class="text-muted small">Người xác nhận</div><span>@(order?.ConfirmedByName ?? "Chưa xác nhận")</span></div>
            <div class="col-md-4"><div class="text-muted small">Người tạo</div><span>@order?.CreatedByName · @order?.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span></div>
            <div class="col-md-8"><div class="text-muted small">Ghi chú</div><span>@(string.IsNullOrWhiteSpace(order?.Notes) ? "Không có ghi chú" : order.Notes)</span></div>
        </div>
    </div>
</div>

@foreach (var batch in pendingBatches)
{
    <section class="card border-primary shadow-sm mb-4" aria-label="Duyệt đợt xuất">
        <div class="card-header bg-primary-subtle d-flex justify-content-between align-items-center">
            <strong>Chờ Quản lý kho duyệt · @batch.OutboundOrderNumber</strong>
            <a asp-page="/OutboundOrders/Details" asp-route-id="@batch.OutboundOrderId" class="btn btn-sm btn-outline-primary">Xem phiếu xuất</a>
        </div>
        <div class="card-body">
            @if (canReview)
            {
                <form method="post" asp-page-handler="ReviewOutboundCompletion" asp-route-id="@order!.SalesOrderId" class="row g-3" onsubmit="return confirm('Chốt số thực giao và quyết định phần còn lại của SO?');">
                    <input type="hidden" name="outboundOrderId" value="@batch.OutboundOrderId" />
                    @if (hasRemainder)
                    {
                        <div class="col-md-4"><label class="form-label">Quyết định theo ý khách hàng</label><select name="remainderAction" class="form-select" required><option value="">Chọn quyết định</option><option value="CONTINUE">Xuất tiếp phần còn lại</option><option value="CLOSE">Đóng SO — Đã xuất</option></select></div>
                        <div class="col-md-8"><label class="form-label">Căn cứ đã thống nhất với khách hàng</label><textarea name="reason" class="form-control" rows="2" minlength="10" maxlength="500" required></textarea></div>
                    }
                    else { <div class="col-12 text-muted">Đã giao đủ số lượng đặt. Duyệt đợt này để hoàn tất SO.</div> }
                    <div class="col-12 text-end"><button type="submit" class="btn btn-primary">Duyệt chốt đợt xuất</button></div>
                </form>
            }
            else { <p class="mb-0">Chờ Quản lý kho duyệt đợt này trước khi tạo phiếu xuất tiếp theo.</p> }
        </div>
    </section>
}
@if (order?.Status == "CLOSED")
{
    <div class="alert alert-success">SO đã xuất và đã kết thúc theo thỏa thuận với khách hàng. Phần chưa giao bên dưới không được lập đợt xuất tiếp.</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-muted">Số dòng vật tư</div><div class="fs-4 fw-semibold">@itemCount</div></div></div></div>
    <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-muted">Dòng đã giữ đủ tồn</div><div class="fs-4 fw-semibold text-primary">@fullyReservedCount / @itemCount</div></div></div></div>
    <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-muted">Dòng đã xuất đủ</div><div class="fs-4 fw-semibold text-success">@fullyIssuedCount / @itemCount</div></div></div></div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3"><h5 class="mb-0">Danh sách vật tư</h5></div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Mã vật tư</th><th>Tên vật tư</th><th>Đơn vị</th><th class="text-end">Số lượng đặt</th><th class="text-end">Đã giữ tồn</th><th class="text-end">Đã xuất</th><th class="text-end">Chưa giao</th><th>Ghi chú</th></tr></thead>
            <tbody>
            @if (order?.Items.Any() == true)
            {
                foreach (var item in order.Items)
                {
                    var remaining = Math.Max(0, item.OrderedQuantity - item.FulfilledQuantity);
                    <tr>
                        <td><strong>@item.ProductCode</strong></td>
                        <td>@item.ProductName</td>
                        <td>@item.UnitName</td>
                        <td class="text-end">@FormatQuantity(item.OrderedQuantity, item.QuantityScale)</td>
                        <td class="text-end">@FormatQuantity(item.ReservedQuantity, item.QuantityScale)</td>
                        <td class="text-end">@FormatQuantity(item.FulfilledQuantity, item.QuantityScale)</td>
                        <td class="text-end">@FormatQuantity(remaining, item.QuantityScale)</td>
                        <td>@(string.IsNullOrWhiteSpace(item.Notes) ? "—" : item.Notes)</td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="8" class="text-center text-muted py-4">Đơn bán hàng chưa có vật tư.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (order?.OutboundBatches.Any() == true)
{
    <div class="card border-0 shadow-sm mt-4">
        <div class="card-header bg-white"><h5 class="mb-0">Các đợt xuất của SO</h5></div>
        <div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>Phiếu xuất</th><th>Ngày tạo</th><th>Nhân viên kho</th><th>Trạng thái</th><th>Người duyệt chốt</th></tr></thead><tbody>
        @foreach (var batch in order.OutboundBatches)
        {
            <tr><td><a asp-page="/OutboundOrders/Details" asp-route-id="@batch.OutboundOrderId">@batch.OutboundOrderNumber</a></td><td>@batch.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td><td>@(batch.AssignedToUserName ?? "—")</td><td>@BatchStatusLabel(batch.Status)</td><td>@(batch.ReviewedByName ?? "—") @batch.ReviewedAt?.ToString("dd/MM/yyyy HH:mm")</td></tr>
        }
        </tbody></table></div>
    </div>
}

@functions {
    string StatusLabel(string? status) => status switch
    {
        "DRAFT" => "Nháp",
        "CONFIRMED" => "Đã xác nhận",
        "ALLOCATED" => "Đã giữ tồn",
        "PARTIALLY_FULFILLED" => "Đã xuất một phần",
        "FULFILLED" or "COMPLETED" or "CLOSED" or "ISSUED" => "Đã xuất",
        "CANCELLED" => "Đã hủy",
        "REJECTED" => "Quản lý từ chối",
        _ => status ?? "Không xác định"
    };

    string StatusClass(string? status) => status switch
    {
        "DRAFT" => "bg-secondary",
        "CONFIRMED" => "bg-info text-dark",
        "ALLOCATED" => "bg-primary",
        "PARTIALLY_FULFILLED" => "bg-warning text-dark",
        "FULFILLED" or "COMPLETED" or "CLOSED" or "ISSUED" => "bg-success",
        "CANCELLED" => "bg-danger",
        _ => "bg-light text-dark"
    };
    string FormatQuantity(decimal value, byte scale) => FormatHelper.FormatQuantity(value, scale);
    string BatchStatusLabel(string status) => status switch
    {
        "PENDING_APPROVAL" => "Chờ duyệt chốt đợt", "COMPLETED" => "Đã xuất",
        "ASSIGNED" or "READY" => "Sẵn sàng xuất", "IN_PROGRESS" or "ISSUING" => "Đang xuất hàng",
        "CANCELLED" => "Đã hủy", "DRAFT" => "Nháp", _ => status
    };
}
