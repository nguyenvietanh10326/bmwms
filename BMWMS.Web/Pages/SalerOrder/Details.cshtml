@page "/sales-orders/details/{id:int}"
@model BMWMS.Web.Pages.SaleOrder.DetailsModel
@{
    Layout = "_AdminLayout";

    ViewData["Title"] = $"Chi ti?t don bán hàng - {Model.SalesOrder?.SalesOrderNumber}";
}

<!-- Header Breadcrumb & User Info -->
<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="#" class="text-decoration-none">Ðon hàng</a></li>
            <li class="breadcrumb-item"><a href="/sales-orders" class="text-decoration-none">Ðon bán hàng</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.SalesOrder?.SalesOrderNumber</li>
        </ol>
    </nav>
    <div class="text-end">
        <span class="fw-bold d-block text-dark">Nguy?n Van An</span>
        <small class="text-muted">System Administrator</small>
    </div>
</div>

<!-- Title & Action Buttons Section -->
<div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div>
        <div class="d-flex align-items-center gap-3">
            <h2 class="fw-bold mb-0">@Model.SalesOrder?.SalesOrderNumber</h2>

            <!-- Badge Tr?ng thái theo Enum t? API -->
            @switch (Model.SalesOrder?.Status)
            {
                case "DRAFT":
                    <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 fs-6 rounded-pill">Nháp</span>
                    break;
                case "CONFIRMED":
                case "Approved":
                    <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2 fs-6 rounded-pill">Ðã xác nh?n</span>
                    break;
                case "COMPLETED":
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6 rounded-pill">Hoàn thành</span>
                    break;
                case "CANCELLED":
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 fs-6 rounded-pill">Ðã h?y</span>
                    break;
                default:
                    <span class="badge bg-light text-dark border px-3 py-2 fs-6 rounded-pill">@Model.SalesOrder?.Status</span>
                    break;
            }
        </div>
        <p class="text-muted mb-0 mt-1 small">
            Kh?i t?o ngày <strong>@Model.SalesOrder?.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong> b?i <strong>@Model.SalesOrder?.CreatedByName</strong>
        </p>
    </div>

    <!-- Actions -->
    <div class="d-flex gap-2 no-print">
        <a href="/sales-orders" class="btn btn-outline-secondary px-3">
            <i class="bi bi-arrow-left me-1"></i> Quay l?i
        </a>
        <button type="button" class="btn btn-light border px-3" onclick="window.print();">
            <i class="bi bi-printer me-1"></i> In phi?u
        </button>
    </div>
</div>

<div class="row g-4">
    <!-- C?t bên trái: Thông tin chính & S?n ph?m (8 cols) -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3 text-primary">
                    <i class="bi bi-info-circle me-2"></i>Thông tin chung
                </h5>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Mã / Tên khách hàng</span>
                        <strong class="text-dark fs-6">[@Model.SalesOrder?.CustomerCode] @Model.SalesOrder?.CustomerName</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Ngày d?t hàng</span>
                        <span class="text-dark">@Model.SalesOrder?.OrderDate.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Ngày xu?t d? ki?n</span>
                        <span class="text-dark">@(Model.SalesOrder?.ExpectedIssueDate?.ToString("dd/MM/yyyy") ?? "Chua xác d?nh")</span>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Ngu?i xác nh?n</span>
                        <span class="text-dark">@(Model.SalesOrder?.ConfirmedByName ?? "Chua xác nh?n")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- B?ng danh sách s?n ph?m -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3 text-primary">
                    <i class="bi bi-box-seam me-2"></i>Danh sách m?t hàng (@(Model.SalesOrder?.Items?.Count ?? 0))
                </h5>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th>#</th>
                                <th>S?n ph?m</th>
                                <th class="text-center">ÐVT</th>
                                <th class="text-center">SL Ð?t</th>
                                <th class="text-end">Ðon giá</th>
                                <th class="text-end">Thành ti?n</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.SalesOrder?.Items != null && Model.SalesOrder.Items.Any())
                            {
                                int stt = 1;
                                foreach (var item in Model.SalesOrder.Items)
                                {
                                    <tr>
                                        <td class="text-muted">@(stt++)</td>
                                        <td>
                                            <span class="fw-bold text-primary d-block">@item.ProductCode</span>
                                            <span class="text-dark small">@item.ProductName</span>
                                        </td>
                                        <td class="text-center text-muted">@item.UnitName</td>
                                        <td class="text-center fw-bold">@item.OrderedQuantity.ToString("N0")</td>
                                        <td class="text-end text-muted">@item.UnitPrice.ToString("N0") d</td>
                                        <td class="text-end fw-bold text-dark">@item.TotalAmount.ToString("N0") d</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-end align-items-center mt-3 pt-3 border-top">
                    <div class="text-end">
                        <span class="fs-6 text-muted me-2">T?ng giá tr? don hàng:</span>
                        <span class="fs-3 fw-bold text-danger">
                            @(Model.SalesOrder?.Items?.Sum(x => x.TotalAmount).ToString("N0") ?? "0") d
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- C?t bên ph?i: Ghi chú & L?ch s? -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3 text-primary">
                    <i class="bi bi-journal-text me-2"></i>Ghi chú & Thông tin b? sung
                </h5>
                <div class="bg-light p-3 rounded-2 mb-3">
                    <small class="fw-bold text-dark d-block mb-1">Ghi chú don hàng:</small>
                    <p class="small text-muted mb-0">@(string.IsNullOrEmpty(Model.SalesOrder?.Notes) ? "Không có ghi chú." : Model.SalesOrder.Notes)</p>
                </div>
                <div class="small text-muted">
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span>Ngu?i t?o:</span>
                        <strong class="text-dark">@Model.SalesOrder?.CreatedByName</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span>Th?i gian t?o:</span>
                        <strong class="text-dark">@Model.SalesOrder?.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
