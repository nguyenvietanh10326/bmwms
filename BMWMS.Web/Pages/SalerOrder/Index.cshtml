@page "/sales-orders"
@model BMWMS.Web.Pages.SalesOrders.IndexModel
@{
    Layout = "_AdminLayout";

    ViewData["Title"] = "Ðon bán hàng";
}

<!-- Header Navigation / Breadcrumb -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="#">Ðon hàng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Ðon bán hàng</li>
        </ol>
    </nav>
    <div class="text-end">
        <span class="fw-bold d-block">Nguy?n Van An</span>
        <small class="text-muted">System Administrator</small>
    </div>
</div>

<!-- Main Section Title & Button -->
<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2 class="fw-bold mb-1">Ðon bán hàng</h2>
        <p class="text-muted mb-0">Sales Order ph?i ki?m tra và gi? t?n tru?c khi t?o l?nh xu?t kho.</p>
    </div>
    <a href="/sales-orders/create" class="btn btn-dark btn-lg px-4 fs-6">
        <i class="bi bi-plus-lg me-1"></i> T?o don bán hàng
    </a>
</div>

<!-- Display Alert Messages -->
@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filter Bar -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <!-- Reset PageIndex khi Submit Filter -->
            <input type="hidden" name="PageIndex" value="1" />

            <!-- Search Keyword -->
            <div class="col-md-5">
                <div class="input-group">
                    <input type="text" asp-for="Filter.Keyword" class="form-control bg-light border-end-0"
                           placeholder="Tìm theo mã ho?c d?i tác">
                    <span class="input-group-text bg-light border-start-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                </div>
            </div>

            <!-- Status Filter -->
            <div class="col-md-3">
                <select asp-for="Filter.Status" asp-items="Model.StatusOptions" class="form-select bg-light"></select>
            </div>

         
            <!-- Action Buttons -->
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-dark w-100">Tìm ki?m</button>
                <a href="/sales-orders" class="btn btn-light border w-100 text-center">Ð?t l?i</a>
            </div>
        </form>
    </div>
</div>

<!-- Data Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4">Mã SO</th>
                        <th>Khách hàng</th>
                        <th>Ngày d?t</th>
                        <th>Xu?t d? ki?n</th>
                        <th>Tr?ng thái</th>
                        <th>T?ng SL</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PagedResult.Items != null && Model.PagedResult.Items.Any())
                    {
                        @foreach (var item in Model.PagedResult.Items)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">
                                    <a href="/sales-orders/detail/@item.SalesOrderId" class="text-primary text-decoration-none">
                                        @item.SalesOrderNumber
                                    </a>
                                </td>
                                <td>
                                    <span class="fw-semibold">@item.CustomerCode</span>
                                    <span class="text-muted">— @item.CustomerName</span>
                                </td>
                                <td>@item.OrderDate.ToString("dd/MM/yyyy")</td>
                                <td>@(item.ExpectedIssueDate.HasValue? item.ExpectedIssueDate.Value.ToString("dd/MM/yyyy") : "—")</td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case "DRAFT":
                                        case "Nháp":
                                            <span class="badge bg-light text-dark border px-3 py-2 fw-normal">Nháp</span>
                                            break;
                                        case "ALLOCATED":
                                        case "Ðã gi? t?n":
                                            <span class="badge bg-dark text-white px-3 py-2 fw-normal">Ðã gi? t?n</span>
                                            break;
                                        case "CONFIRMED":
                                        case "Ðã xác nh?n":
                                            <span class="badge bg-secondary text-white px-3 py-2 fw-normal">Ðã xác nh?n</span>
                                            break;
                                        case "FULFILLED":
                                        case "Hoàn t?t":
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-normal">Hoàn t?t</span>
                                            break;
                                        case "CANCELLED":
                                        case "Ðã h?y":
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 fw-normal">Ðã h?y</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark px-3 py-2">@item.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="fw-semibold">
                                    @item.TotalQuantity.ToString("N0") @item.PrimaryUnitName
                                </td>
                                <td class="text-end pe-4">
                                    <a href="/sales-orders/details/@item.SalesOrderId" class="btn btn-sm btn-outline-primary">
                                        Xem chi ti?t
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                Không tìm th?y b?n ghi nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Table Footer / Pagination -->
    @{
        var totalCount = Model.PagedResult.TotalCount;
        var pageIndex = Model.PagedResult.PageIndex;
        var pageSize = Model.PagedResult.PageSize;
        var totalPages = Model.PagedResult.TotalPages;

        var start = totalCount == 0 ? 0 : (pageIndex - 1) * pageSize + 1;
        var end = Math.Min(pageIndex * pageSize, totalCount);
    }

    <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
        <span class="text-muted fs-7">
            Hi?n th? @start–@end trong @totalCount b?n ghi
        </span>

        @if (totalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <!-- Nút Previous -->
                    <li class="page-item @(pageIndex == 1 ? "disabled" : "")">
                        <a class="page-link" asp-page="./Index"
                           asp-route-Keyword="@Model.Filter.Keyword"
                           asp-route-Status="@Model.Filter.Status"
                           asp-route-PageIndex="@(pageIndex - 1)">&lsaquo;</a>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == pageIndex ? "active" : "")">
                            <a class="page-link @(i == pageIndex ? "bg-dark border-dark" : "")"
                               asp-page="./Index"
                               asp-route-Keyword="@Model.Filter.Keyword"
                               asp-route-Status="@Model.Filter.Status"
                               asp-route-PageIndex="@i">@i</a>
                        </li>
                    }

                    <!-- Nút Next -->
                    <li class="page-item @(pageIndex == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-page="./Index"
                           asp-route-Keyword="@Model.Filter.Keyword"
                           asp-route-Status="@Model.Filter.Status"
                           asp-route-PageIndex="@(pageIndex + 1)">&rsaquo;</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
