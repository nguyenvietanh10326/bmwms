@page "/sales-orders"
@model BMWMS.Web.Pages.SalesOrders.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Danh sách đơn bán hàng";

    var totalCount = Model.PagedResult.TotalCount;
    var pageIndex = Model.PagedResult.PageIndex > 0 ? Model.PagedResult.PageIndex : Model.PageIndex;
    var pageSize = Model.PagedResult.PageSize > 0 ? Model.PagedResult.PageSize : Model.PageSize;
    var totalPages = Model.PagedResult.TotalPages;
    var start = totalCount == 0 ? 0 : (pageIndex - 1) * pageSize + 1;
    var end = Math.Min(pageIndex * pageSize, totalCount);
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1 text-gray-800">Danh sách đơn bán hàng (SO)</h1>
        <p class="text-muted mb-0">Theo dõi đơn bán hàng từ khi tạo nháp đến khi xuất hàng hoặc hủy đơn.</p>
    </div>
    <a href="/sales-orders/create" class="btn btn-primary shadow-sm flex-shrink-0">
        <i class="bi bi-plus-lg me-2"></i>Tạo đơn bán hàng
    </a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng thông báo"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
    </div>
}

<div class="alert alert-light border d-flex align-items-start gap-2 py-2" role="note">
    <i class="bi bi-diagram-3 text-primary mt-1"></i>
    <div class="small text-muted">
        <span class="fw-semibold text-dark">Quy trình trạng thái:</span>
        Nháp → Đã xác nhận → Đã xuất một phần → Đã xuất.
        Đơn nháp hoặc đã xác nhận có thể chuyển sang Đã hủy.
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <input type="hidden" name="PageIndex" value="1" />

            <div class="col-lg-4 col-md-6">
                <label asp-for="Keyword" class="form-label">Tìm kiếm</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                    <input asp-for="Keyword" class="form-control" placeholder="Nhập mã đơn, mã hoặc tên khách hàng" />
                </div>
            </div>

            <div class="col-lg-2 col-md-6">
                <label asp-for="Status" class="form-label">Trạng thái</label>
                <select asp-for="Status" asp-items="Model.StatusOptions" class="form-select"></select>
            </div>

            <div class="col-lg-2 col-md-4">
                <label asp-for="FromDate" class="form-label">Từ ngày</label>
                <input asp-for="FromDate" type="date" class="form-control" />
            </div>

            <div class="col-lg-2 col-md-4">
                <label asp-for="ToDate" class="form-label">Đến ngày</label>
                <input asp-for="ToDate" type="date" class="form-control" />
            </div>

            <div class="col-lg-2 col-md-4">
                <label asp-for="PageSize" class="form-label">Số dòng mỗi trang</label>
                <select asp-for="PageSize" asp-items="Model.PageSizeOptions" class="form-select"></select>
            </div>

            <div class="col-12 d-flex flex-wrap justify-content-end gap-2">
                @if (Model.HasActiveFilters || Model.PageSize != 10)
                {
                    <a href="/sales-orders" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Xóa bộ lọc
                    </a>
                }
                <button type="submit" class="btn btn-dark">
                    <i class="bi bi-funnel me-1"></i>Áp dụng
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small">
                    <tr>
                        <th class="ps-4">Mã đơn bán hàng</th>
                        <th>Khách hàng</th>
                        <th>Ngày đặt / dự kiến xuất</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Mặt hàng</th>
                        <th>Người tạo</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PagedResult.Items?.Any() == true)
                    {
                        @foreach (var item in Model.PagedResult.Items)
                        {
                            <tr>
                                <td class="ps-4">
                                    <a href="/sales-orders/details/@item.SalesOrderId" class="fw-semibold text-primary text-decoration-none">
                                        @item.SalesOrderNumber
                                    </a>
                                </td>
                                <td>
                                    <span class="fw-semibold d-block">@item.CustomerName</span>
                                    <span class="text-muted small">@item.CustomerCode</span>
                                </td>
                                <td>
                                    <span class="d-block">@item.OrderDate.ToString("dd/MM/yyyy")</span>
                                    <span class="text-muted small">
                                        Dự kiến: @(item.ExpectedIssueDate?.ToString("dd/MM/yyyy") ?? "Chưa xác định")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge border px-3 py-2 fw-normal @Model.GetStatusBadgeClass(item.Status)">
                                        @Model.GetStatusLabel(item.Status)
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="fw-semibold">@item.ItemCount.ToString("N0")</span>
                                </td>
                                <td>
                                    <span class="d-block">@(string.IsNullOrWhiteSpace(item.CreatedByName) ? "Chưa xác định" : item.CreatedByName)</span>
                                    <span class="text-muted small">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a href="/sales-orders/details/@item.SalesOrderId" class="btn btn-sm btn-outline-primary"
                                       aria-label="Xem chi tiết đơn @item.SalesOrderNumber">
                                        <i class="bi bi-eye me-1"></i>Xem chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <i class="bi bi-inbox fs-2 text-muted d-block mb-2"></i>
                                <span class="fw-semibold d-block">Không có đơn bán hàng phù hợp</span>
                                <span class="text-muted small">Hãy thay đổi điều kiện tìm kiếm hoặc xóa bộ lọc.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card-footer bg-white border-top py-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <span class="text-muted small">Hiển thị @start–@end trong tổng số @totalCount bản ghi</span>

        @if (totalPages > 1)
        {
            var firstPage = Math.Max(1, pageIndex - 2);
            var lastPage = Math.Min(totalPages, firstPage + 4);
            firstPage = Math.Max(1, lastPage - 4);

            <nav aria-label="Phân trang danh sách đơn bán hàng">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(pageIndex == 1 ? "disabled" : string.Empty)">
                        <a class="page-link" asp-page="./Index"
                           asp-route-Keyword="@Model.Keyword"
                           asp-route-Status="@Model.Status"
                           asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                           asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-PageIndex="@(pageIndex - 1)"
                           aria-label="Trang trước">‹</a>
                    </li>

                    @for (var i = firstPage; i <= lastPage; i++)
                    {
                        <li class="page-item @(i == pageIndex ? "active" : string.Empty)">
                            <a class="page-link" asp-page="./Index"
                               asp-route-Keyword="@Model.Keyword"
                               asp-route-Status="@Model.Status"
                               asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                               asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                               asp-route-PageSize="@Model.PageSize"
                               asp-route-PageIndex="@i">@i</a>
                        </li>
                    }

                    <li class="page-item @(pageIndex == totalPages ? "disabled" : string.Empty)">
                        <a class="page-link" asp-page="./Index"
                           asp-route-Keyword="@Model.Keyword"
                           asp-route-Status="@Model.Status"
                           asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                           asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-PageIndex="@(pageIndex + 1)"
                           aria-label="Trang sau">›</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
