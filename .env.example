MSSQL_SA_PASSWORD=replace-with-a-strong-sql-server-password
MSSQL_PORT=1433

# Docker image configuration
DOCKERHUB_NAMESPACE=nguyenvietanh10326
IMAGE_TAG=latest
BMWMS_NETWORK=bmwms_net

# SMTP Settings
SmtpSettings__Host=smtp.example.com
SmtpSettings__Port=587
SmtpSettings__Username=replace-with-smtp-username
SmtpSettings__Password=replace-with-smtp-password
SmtpSettings__EnableSsl=true
SmtpSettings__FromEmail=no-reply@example.com

# JWT Configuration
Jwt__Key=replace-with-a-random-secret-at-least-32-characters
Jwt__Issuer=BMWMS.API
Jwt__Audience=BMWMS.Web
Jwt__ExpireMinutes=480

# Warehouse capacity configuration
WarehouseCapacity__Enabled=true
WarehouseCapacity__EnforcementMode=ADVISORY

# Web Configuration
ApiSettings__BaseUrl=http://api:8080
API_PORT=5076
WEB_PORT=5100
ASPNETCORE_ENVIRONMENT=Production
