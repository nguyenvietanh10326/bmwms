# Docker Hub image namespace and the single time-based image tag.
DOCKERHUB_NAMESPACE=your-dockerhub-namespace
IMAGE_TAG=20260918-143012

# Host ports.
API_PORT=7112
WEB_PORT=7113
MSSQL_PORT=1433

# Docker network.
BMWMS_NETWORK=bmwms

# SQL Server.
ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=ChangeMe_StrongPassword123!

# API database connection string. Keep the password in sync with MSSQL_SA_PASSWORD.
ConnectionStrings__DefaultConnection=Server=db;Database=BMWMS;User Id=sa;Password=ChangeMe_StrongPassword123!;TrustServerCertificate=True

# ASP.NET Core.
ASPNETCORE_ENVIRONMENT=Production
ApiSettings__BaseUrl=http://api:8080

# JWT. Replace the key with a private value of at least 32 characters.
Jwt__Key=ChangeThisDevelopmentJwtKeyToAtLeast32Characters!
Jwt__Issuer=BMWMS.API
Jwt__Audience=BMWMS.Web
Jwt__ExpireMinutes=480

# SMTP.
SmtpSettings__Host=smtp.example.com
SmtpSettings__Port=587
SmtpSettings__Username=
SmtpSettings__Password=
SmtpSettings__EnableSsl=true
SmtpSettings__FromEmail=no-reply@example.com

# Warehouse capacity.
WarehouseCapacity__Enabled=true
WarehouseCapacity__EnforcementMode=WARN
